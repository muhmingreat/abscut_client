#/* /* =========================
   ABS CUT COLOR SYSTEM
========================= */

:root {
  --primary: #0b3d2e;
  --primary-dark: #10251d;
  --secondary: #c9a227;
  --background: #f8f5ed;
  --white: #ffffff;
  --text: #1e2924;
  --muted: #66736d;
  --border: #dedbd2;
}

/* =========================
   GLOBAL
========================= */

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  font-family: Arial, sans-serif;
  background: var(--background);
  color: var(--text);
}

button {
  border: none;
  cursor: pointer;
  padding: 14px 24px;
  font-weight: 700;
  font-size: 14px;
}

a {
  text-decoration: none;
  color: inherit;
}

/* =========================
   NAVBAR
========================= */

nav {
  min-height: 75px;
  padding: 0 6%;
  display: flex;
  align-items: center;
  justify-content: space-between;

  background: var(--primary);
  color: var(--white);

  border-bottom: 3px solid var(--secondary);
}

nav h2 {
  color: var(--secondary);
  letter-spacing: 3px;
}

nav a {
  margin: 0 12px;
  font-size: 14px;
}

nav a:hover {
  color: var(--secondary);
}

nav button {
  background: var(--secondary);
  color: var(--primary);
}

/* =========================
   HERO
========================= */

.hero {
  min-height: 650px;
  padding: 70px 6%;

  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 50px;
  align-items: center;

  background: var(--background);
}

.hero-tag {
  font-size: 13px;
  font-weight: bold;
  letter-spacing: 3px;
  color: var(--secondary);
  margin-bottom: 20px;
}

.hero h1 {
  font-size: clamp(50px, 7vw, 90px);
  line-height: 0.95;
  color: var(--primary);
  margin-bottom: 25px;
}

.hero-text {
  max-width: 550px;
  line-height: 1.7;
  color: var(--muted);
  margin-bottom: 30px;
}

.hero-buttons {
  display: flex;
  gap: 15px;
}

.hero-buttons button {
  background: var(--primary);
  color: var(--white);
}

.hero-buttons button:hover {
  background: var(--primary-dark);
}

.hero-buttons .outline-btn {
  background: transparent;
  color: var(--primary);
  border: 1px solid var(--primary);
}

.hero-buttons .outline-btn:hover {
  background: var(--primary);
  color: var(--white);
}

/* =========================
   HERO IMAGE
========================= */

.hero-image {
  height: 500px;
}

.image-placeholder {
  width: 100%;
  height: 100%;

  display: flex;
  align-items: center;
  justify-content: center;

  background: var(--primary);
  color: var(--secondary);

  border: 8px solid var(--secondary);

  font-size: 35px;
  font-weight: bold;
  letter-spacing: 5px;
}

/* =========================
   SERVICES
========================= */

.services {
  padding: 100px 6%;
  background: var(--white);
}

.section-heading {
  text-align: center;
  max-width: 650px;
  margin: 0 auto 50px;
}

.section-heading > p:first-child {
  font-size: 13px;
  letter-spacing: 3px;
  font-weight: bold;
  color: var(--secondary);
  margin-bottom: 15px;
}

.section-heading h2 {
  font-size: 42px;
  color: var(--primary);
  margin-bottom: 15px;
}

.section-heading p {
  line-height: 1.7;
  color: var(--muted);
}

.service-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20px;
}

.service-card {
  padding: 35px 25px;

  background: var(--background);

  border: 1px solid var(--border);
  border-top: 4px solid var(--secondary);

  transition: 0.3s ease;
}

.service-card:hover {
  transform: translateY(-6px);
  box-shadow: 0 15px 30px rgba(11, 61, 46, 0.12);
}

.service-card h3 {
  color: var(--primary);
  margin-bottom: 15px;
}

.service-card p {
  color: var(--muted);
  line-height: 1.6;
}

/* =========================
   CUSTOM SECTION
========================= */

.custom-section {
  background: var(--primary);
  color: var(--white);

  padding: 100px 10%;

  border-top: 5px solid var(--secondary);
}

.custom-section > div {
  max-width: 650px;
}

.custom-section .hero-tag {
  color: var(--secondary);
}

.custom-section h2 {
  font-size: 55px;
  line-height: 1;
  margin-bottom: 25px;
}

.custom-section p {
  color: #d9e2dd;
  line-height: 1.7;
  margin-bottom: 30px;
}

.custom-section button {
  background: var(--secondary);
  color: var(--primary);
}

.custom-section button:hover {
  background: var(--white);
}

/* =========================
   AI SECTION
========================= */

.ai-section {
  padding: 100px 6%;
  text-align: center;
  background: var(--background);
}

.ai-section button {
  background: var(--primary);
  color: var(--white);
}

.ai-section button:hover {
  background: var(--secondary);
  color: var(--primary);
}

/* =========================
   MOBILE
========================= */

@media (max-width: 900px) {
  nav {
    padding: 20px;
    flex-wrap: wrap;
    gap: 15px;
  }

  nav div:nth-child(2) {
    order: 3;
    width: 100%;
    text-align: center;
  }

  .hero {
    grid-template-columns: 1fr;
    padding: 50px 20px;
  }

  .hero-image {
    height: 500px;
    overflow: hidden;
    border: 8px solid var(--secondary);
  }

  .hero-image img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }
  .service-grid {
    grid-template-columns: 1fr 1fr;
  }
}

/* =========================
   SHOP PAGE
========================= */

.shop-page {
  min-height: 100vh;
  padding: 80px 6%;
  background: var(--background);
}

.shop-header {
  text-align: center;
  max-width: 700px;
  margin: 0 auto 40px;
}

.shop-header p {
  color: var(--secondary);
  font-weight: bold;
  letter-spacing: 3px;
  font-size: 13px;
  margin-bottom: 15px;
}

.shop-header h1 {
  color: var(--primary);
  font-size: 50px;
  margin-bottom: 15px;
}

.shop-header span {
  color: var(--muted);
}

/* CATEGORIES */

.categories {
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
  gap: 10px;
  margin-bottom: 50px;
}

.categories button {
  background: var(--white);
  color: var(--primary);
  border: 1px solid var(--border);
}

.categories button:first-child {
  background: var(--primary);
  color: var(--white);
}

/* PRODUCTS */

.products {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 25px;
}

.product-card {
  background: var(--white);
  border: 1px solid var(--border);
  overflow: hidden;
  transition: 0.3s ease;
}

.product-card:hover {
  transform: translateY(-6px);
  box-shadow: 0 15px 35px rgba(11, 61, 46, 0.12);
}

/* .product-image {
  height: 380px;
  background: var(--primary);

  display: flex;
  align-items: center;
  justify-content: center;

  color: var(--secondary);
  font-weight: bold;
  letter-spacing: 2px;
} */

.product-image {
  height: 380px;
  background: var(--primary);
  overflow: hidden;
}

.product-image img {
  width: 100%;
  height: 100%;
  display: block;
  object-fit: cover;
  transition: transform 0.4s ease;
}

.product-card:hover .product-image img {
  transform: scale(1.05);
}
.product-info {
  padding: 25px;
}

.product-info p {
  color: var(--secondary);
  font-size: 12px;
  font-weight: bold;
  letter-spacing: 2px;
  margin-bottom: 10px;
}

.product-info h2 {
  color: var(--primary);
  font-size: 22px;
  margin-bottom: 15px;
}

.product-info h3 {
  color: var(--text);
  margin-bottom: 20px;
}

.product-info button {
  width: 100%;
  background: var(--primary);
  color: var(--white);
}

.product-info button:hover {
  background: var(--secondary);
  color: var(--primary);
}

/* SHOP MOBILE */

@media (max-width: 900px) {
  .products {
    grid-template-columns: 1fr 1fr;
  }
}

@media (max-width: 600px) {
  .shop-page {
    padding: 50px 20px;
  }

  .shop-header h1 {
    font-size: 38px;
  }

  .products {
    grid-template-columns: 1fr;
  }
}

/* =========================================
   PRODUCT DETAILS
========================================= */

.product-details-page {
  min-height: 80vh;
  padding: 80px 7%;
  background: var(--background);
  overflow: hidden;
}

.product-details {
  max-width: 1200px;
  margin: 0 auto;

  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 70px;

  align-items: center;
}

/* =========================================
   PRODUCT IMAGE
========================================= */

.product-details-image {
  animation: productImageReveal 0.9s ease forwards;
}

.image-wrapper {
  position: relative;

  width: 100%;
  height: 600px;

  overflow: hidden;

  border: 2px solid var(--secondary);

  background: var(--primary);

  box-shadow: 0 20px 50px rgba(16, 37, 29, 0.15);
}

.image-wrapper::after {
  content: "";

  position: absolute;

  inset: 0;

  background: linear-gradient(
    120deg,
    transparent 30%,
    rgba(255, 255, 255, 0.18) 50%,
    transparent 70%
  );

  transform: translateX(-100%);

  transition: transform 0.8s ease;
}

.image-wrapper:hover::after {
  transform: translateX(100%);
}

.image-wrapper img {
  width: 100%;
  height: 100%;

  object-fit: cover;

  transition: transform 0.8s cubic-bezier(0.2, 0.8, 0.2, 1);
}

.image-wrapper:hover img {
  transform: scale(1.06);
}

/* =========================================
   PRODUCT INFORMATION
========================================= */

.product-details-info {
  animation: productInfoReveal 0.9s ease 0.15s both;
}

.product-category {
  color: var(--secondary);

  font-size: 0.9rem;

  font-weight: 700;

  letter-spacing: 3px;

  text-transform: uppercase;

  margin-bottom: 15px;
}

.product-details-info h1 {
  color: var(--primary);

  font-size: clamp(2.2rem, 5vw, 4rem);

  line-height: 1.1;

  margin-bottom: 20px;
}

.product-price {
  color: var(--secondary);

  font-size: 2rem;

  margin-bottom: 25px;

  animation: priceReveal 0.8s ease 0.35s both;
}

.product-divider {
  width: 80px;

  height: 3px;

  background: var(--secondary);

  margin-bottom: 30px;

  animation: dividerReveal 0.8s ease 0.45s both;
}

.product-description {
  color: var(--muted);

  font-size: 1.05rem;

  line-height: 1.8;

  max-width: 550px;

  margin-bottom: 25px;
}

.product-type {
  display: flex;

  gap: 10px;

  margin-bottom: 30px;

  color: var(--text);
}

.product-type span {
  color: var(--muted);

  text-transform: capitalize;
}

/* =========================================
   QUANTITY
========================================= */

.quantity-section {
  margin-bottom: 30px;
}

.quantity-section > p {
  font-weight: 700;

  margin-bottom: 10px;
}

.quantity-control {
  display: inline-flex;

  align-items: center;

  border: 1px solid var(--border);

  background: var(--white);
}

.quantity-control button {
  width: 48px;
  height: 48px;

  border: none;

  background: var(--primary);

  color: var(--white);

  font-size: 1.4rem;

  cursor: pointer;

  transition:
    background 0.3s ease,
    transform 0.2s ease;
}

.quantity-control button:hover {
  background: var(--secondary);

  color: var(--primary);

  transform: scale(1.05);
}

.quantity-control button:active {
  transform: scale(0.92);
}

.quantity-control span {
  width: 55px;

  text-align: center;

  font-weight: 700;

  color: var(--text);
}

/* =========================================
   ADD TO CART
========================================= */

.add-to-cart {
  position: relative;

  overflow: hidden;

  width: 100%;

  max-width: 400px;

  padding: 18px 30px;

  border: 2px solid var(--secondary);

  background: var(--primary);

  color: var(--white);

  font-weight: 700;

  letter-spacing: 1.5px;

  cursor: pointer;

  transition:
    color 0.4s ease,
    transform 0.3s ease;
}

.add-to-cart::before {
  content: "";

  position: absolute;

  top: 0;
  left: -100%;

  width: 100%;
  height: 100%;

  background: var(--secondary);

  transition: left 0.4s ease;

  z-index: 0;
}

.add-to-cart:hover::before {
  left: 0;
}

.add-to-cart:hover {
  color: var(--primary);

  transform: translateY(-3px);

  box-shadow: 0 10px 25px rgba(201, 162, 39, 0.25);
}

.add-to-cart:active {
  transform: translateY(0);
}

.add-to-cart {
  isolation: isolate;
}

.add-to-cart::before {
  z-index: -1;
}

/* =========================================
   NOT FOUND
========================================= */

.product-not-found {
  min-height: 70vh;

  display: flex;

  flex-direction: column;

  justify-content: center;

  align-items: center;

  text-align: center;

  padding: 40px;

  background: var(--background);

  animation: productInfoReveal 0.7s ease;
}

.product-not-found h1 {
  color: var(--primary);

  margin-bottom: 15px;
}

.product-not-found p {
  color: var(--muted);
}

/* =========================================
   ANIMATIONS
========================================= */

@keyframes productImageReveal {
  from {
    opacity: 0;
    transform: translateX(-50px);
  }

  to {
    opacity: 1;
    transform: translateX(0);
  }
}

@keyframes productInfoReveal {
  from {
    opacity: 0;
    transform: translateX(50px);
  }

  to {
    opacity: 1;
    transform: translateX(0);
  }
}

@keyframes priceReveal {
  from {
    opacity: 0;
    transform: translateY(15px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes dividerReveal {
  from {
    width: 0;
    opacity: 0;
  }

  to {
    width: 80px;
    opacity: 1;
  }
}
/* =========================================
   CART PAGE
========================================= */

.cart-page {
  min-height: 100vh;
  padding: 80px 6%;
  background: var(--background);
}

/* =========================================
   CART HEADER
========================================= */

.cart-header {
  max-width: 750px;
  margin: 0 auto 55px;
  text-align: center;
  animation: cartHeaderReveal 0.8s ease both;
}

.cart-label {
  color: var(--secondary);
  font-size: 13px;
  font-weight: 700;
  letter-spacing: 3px;
  margin-bottom: 15px;
}

.cart-header h1 {
  color: var(--primary);
  font-size: clamp(40px, 6vw, 60px);
  line-height: 1.05;
  margin-bottom: 18px;
}

.cart-header p:last-child {
  color: var(--muted);
  line-height: 1.7;
}

/* =========================================
   CART CONTENT
========================================= */

.cart-content {
  max-width: 1250px;
  margin: 0 auto;
  display: grid;
  grid-template-columns: 1fr 360px;
  gap: 35px;
  align-items: start;
}

/* =========================================
   CART ITEMS
========================================= */

.cart-items {
  display: flex;
  flex-direction: column;
  gap: 20px;
}

/* =========================================
   CART ITEM
========================================= */

.cart-item {
  position: relative;
  display: grid;
  grid-template-columns: 150px 1fr auto;
  gap: 25px;
  align-items: center;

  padding: 20px;

  background: var(--white);
  border: 1px solid var(--border);

  overflow: hidden;

  animation: cartItemReveal 0.7s ease both;

  transition:
    transform 0.3s ease,
    box-shadow 0.3s ease,
    border-color 0.3s ease;
}

.cart-item:hover {
  transform: translateY(-4px);

  border-color: var(--secondary);

  box-shadow: 0 15px 35px rgba(11, 61, 46, 0.1);
}

/* =========================================
   GOLD ACCENT
========================================= */

.cart-item::before {
  content: "";

  position: absolute;

  left: 0;
  top: 0;

  width: 4px;
  height: 100%;

  background: var(--secondary);

  transform: scaleY(0);
  transform-origin: bottom;

  transition: transform 0.35s ease;
}

.cart-item:hover::before {
  transform: scaleY(1);
}

/* =========================================
   CART ITEM IMAGE
========================================= */

.cart-item-image {
  width: 150px;
  height: 170px;

  overflow: hidden;

  background: var(--primary);

  border: 1px solid var(--border);
}

.cart-item-image img {
  width: 100%;
  height: 100%;

  display: block;

  object-fit: cover;

  transition: transform 0.5s ease;
}

.cart-item:hover .cart-item-image img {
  transform: scale(1.07);
}

/* =========================================
   CART ITEM DETAILS
========================================= */

.cart-item-details {
  min-width: 0;
}

.cart-item-category {
  color: var(--secondary);

  font-size: 11px;
  font-weight: 700;

  letter-spacing: 2px;

  text-transform: uppercase;

  margin-bottom: 8px;
}

.cart-item-details h2 {
  color: var(--primary);

  font-size: 23px;

  margin-bottom: 12px;

  line-height: 1.2;
}

.cart-item-price {
  color: var(--muted);

  font-size: 15px;

  margin-bottom: 18px;
}

/* =========================================
   CART QUANTITY
========================================= */

.cart-quantity {
  display: inline-flex;
  align-items: center;

  border: 1px solid var(--border);

  background: var(--background);

  overflow: hidden;
}

.cart-quantity button {
  width: 40px;
  height: 40px;

  padding: 0;

  display: flex;
  align-items: center;
  justify-content: center;

  background: var(--primary);
  color: var(--white);

  font-size: 20px;

  transition:
    background 0.25s ease,
    color 0.25s ease,
    transform 0.2s ease;
}

.cart-quantity button:hover {
  background: var(--secondary);
  color: var(--primary);
}

.cart-quantity button:active {
  transform: scale(0.9);
}

.cart-quantity span {
  width: 50px;

  text-align: center;

  font-weight: 700;

  color: var(--text);
}

/* =========================================
   CART ITEM ACTIONS
========================================= */

.cart-item-actions {
  height: 100%;

  display: flex;
  flex-direction: column;

  justify-content: space-between;
  align-items: flex-end;

  min-width: 120px;
}

.cart-item-actions strong {
  color: var(--primary);

  font-size: 18px;
}

.cart-item-image img {
  width: 100%;
  height: 100%;
  display: block;
  object-fit: cover;
}
/* =========================================
   REMOVE BUTTON
========================================= */

.remove-item {
  padding: 8px 0;

  background: transparent;

  color: var(--muted);

  font-size: 12px;

  letter-spacing: 1px;

  transition:
    color 0.25s ease,
    transform 0.25s ease;
}

.remove-item:hover {
  color: var(--secondary);

  transform: translateX(-3px);
}

/* =========================================
   CART SUMMARY
========================================= */

.cart-summary {
  position: sticky;
  top: 25px;

  padding: 30px;

  background: var(--primary);

  color: var(--white);

  border-top: 4px solid var(--secondary);

  box-shadow: 0 20px 45px rgba(11, 61, 46, 0.16);

  animation: summaryReveal 0.8s ease 0.15s both;
}

.cart-summary h2 {
  color: var(--white);

  font-size: 25px;

  margin-bottom: 30px;
}

/* =========================================
   SUMMARY ROW
========================================= */

.summary-row {
  display: flex;

  justify-content: space-between;
  align-items: center;

  gap: 20px;

  margin-bottom: 18px;

  color: #d9e2dd;
}

.summary-row span:last-child {
  color: var(--white);

  font-weight: 700;
}

/* =========================================
   SUMMARY DIVIDER
========================================= */

.summary-divider {
  width: 100%;
  height: 1px;

  margin: 25px 0;

  background: rgba(255, 255, 255, 0.18);
}

/* =========================================
   SUMMARY TOTAL
========================================= */

.summary-total {
  display: flex;

  justify-content: space-between;
  align-items: center;

  gap: 20px;

  margin-bottom: 30px;
}

.summary-total span {
  color: #d9e2dd;

  font-size: 16px;
}

.summary-total strong {
  color: var(--secondary);

  font-size: 22px;
}

/* =========================================
   CHECKOUT BUTTON
========================================= */

.checkout-button {
  position: relative;

  display: flex;

  align-items: center;
  justify-content: center;

  width: 100%;

  padding: 17px 20px;

  background: var(--secondary);

  color: var(--primary);

  font-weight: 700;

  font-size: 13px;

  letter-spacing: 1.2px;

  overflow: hidden;

  transition:
    transform 0.3s ease,
    box-shadow 0.3s ease;
}

.checkout-button::before {
  content: "";

  position: absolute;

  top: 0;
  left: -100%;

  width: 100%;
  height: 100%;

  background: var(--white);

  transition: left 0.4s ease;

  z-index: 0;
}

.checkout-button:hover::before {
  left: 0;
}

.checkout-button:hover {
  transform: translateY(-3px);

  box-shadow: 0 10px 25px rgba(201, 162, 39, 0.25);
}

.checkout-button {
  isolation: isolate;
}

.checkout-button::before {
  z-index: -1;
}

/* =========================================
   CONTINUE SHOPPING
========================================= */

.continue-shopping-link {
  display: block;

  margin-top: 18px;

  text-align: center;

  color: #d9e2dd;

  font-size: 13px;

  transition: color 0.25s ease;
}

.continue-shopping-link:hover {
  color: var(--secondary);
}

/* =========================================
   EMPTY CART
========================================= */

.empty-cart {
  min-height: 65vh;

  display: flex;
  flex-direction: column;

  align-items: center;
  justify-content: center;

  text-align: center;

  padding: 50px;

  animation: emptyCartReveal 0.8s ease both;
}

.empty-cart .cart-label {
  margin-bottom: 15px;
}

.empty-cart h1 {
  color: var(--primary);

  font-size: clamp(40px, 6vw, 60px);

  margin-bottom: 15px;
}

.empty-cart > p:not(.cart-label) {
  color: var(--muted);

  line-height: 1.7;

  margin-bottom: 30px;
}

/* =========================================
   CONTINUE SHOPPING BUTTON
========================================= */

.continue-shopping {
  display: inline-flex;

  align-items: center;
  justify-content: center;

  padding: 16px 30px;

  background: var(--primary);

  color: var(--white);

  font-weight: 700;

  font-size: 13px;

  letter-spacing: 1px;

  transition:
    background 0.3s ease,
    color 0.3s ease,
    transform 0.3s ease;
}

.continue-shopping:hover {
  background: var(--secondary);

  color: var(--primary);

  transform: translateY(-3px);
}

/* =========================================
   CART ANIMATIONS
========================================= */

@keyframes cartHeaderReveal {
  from {
    opacity: 0;
    transform: translateY(30px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes cartItemReveal {
  from {
    opacity: 0;
    transform: translateX(-35px);
  }

  to {
    opacity: 1;
    transform: translateX(0);
  }
}

@keyframes summaryReveal {
  from {
    opacity: 0;
    transform: translateX(35px);
  }

  to {
    opacity: 1;
    transform: translateX(0);
  }
}

@keyframes emptyCartReveal {
  from {
    opacity: 0;
    transform: translateY(30px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* =========================================
   CART TABLET
========================================= */

@media (max-width: 1000px) {
  .cart-content {
    grid-template-columns: 1fr;
  }

  .cart-summary {
    position: relative;
    top: auto;
  }
}

/* =========================================
   CART MOBILE
========================================= */

@media (max-width: 650px) {
  .cart-page {
    padding: 55px 20px;
  }

  .cart-header {
    margin-bottom: 40px;
  }

  .cart-header h1 {
    font-size: 40px;
  }

  .cart-item {
    grid-template-columns: 100px 1fr;

    gap: 18px;

    padding: 15px;
  }

  .cart-item-image {
    width: 100px;
    height: 125px;

    grid-row: span 2;
  }

  .cart-item-details h2 {
    font-size: 18px;
  }

  .cart-item-actions {
    grid-column: 2;

    height: auto;

    flex-direction: row;

    align-items: center;

    margin-top: -5px;
  }

  .cart-item-actions strong {
    font-size: 16px;
  }

  .cart-summary {
    padding: 25px 20px;
  }
}

/* =========================================
   CHECKOUT PAGE
========================================= */

.checkout-page {
  min-height: 100vh;
  padding: 80px 6%;
  background: var(--background);
}

/* =========================================
   CHECKOUT HEADER
========================================= */

.checkout-header {
  max-width: 750px;
  margin: 0 auto 55px;
  text-align: center;

  animation: checkoutHeaderReveal 0.8s ease both;
}

.checkout-header > p {
  color: var(--secondary);
  font-size: 13px;
  font-weight: 700;
  letter-spacing: 3px;
  margin-bottom: 15px;
}

.checkout-header h1 {
  color: var(--primary);
  font-size: clamp(42px, 6vw, 60px);
  margin-bottom: 15px;
}

.checkout-header span {
  color: var(--muted);
  line-height: 1.7;
}

/* =========================================
   CHECKOUT CONTENT
========================================= */

.checkout-content {
  max-width: 1250px;
  margin: 0 auto;

  display: grid;
  grid-template-columns: 1fr 390px;

  gap: 40px;

  align-items: start;
}

/* =========================================
   CHECKOUT FORM
========================================= */

.checkout-form {
  padding: 35px;

  background: var(--white);

  border: 1px solid var(--border);

  animation: checkoutFormReveal 0.8s ease both;
}

/* =========================================
   CHECKOUT SECTION
========================================= */

.checkout-section {
  margin-bottom: 30px;
}

.checkout-section h2 {
  color: var(--primary);
  font-size: 25px;
  margin-bottom: 8px;
}

.checkout-section p {
  color: var(--muted);
  line-height: 1.6;
}

/* =========================================
   FORM ROW
========================================= */

.form-row {
  display: grid;

  grid-template-columns: 1fr 1fr;

  gap: 20px;
}

/* =========================================
   FORM GROUP
========================================= */

.form-group {
  display: flex;
  flex-direction: column;

  margin-bottom: 22px;
}

.form-group label {
  color: var(--primary);

  font-size: 13px;

  font-weight: 700;

  margin-bottom: 9px;
}

.optional {
  margin-left: 8px;

  color: var(--muted);

  font-size: 11px;

  font-weight: 400;
}

/* =========================================
   INPUTS
========================================= */

.form-group input,
.form-group textarea {
  width: 100%;

  padding: 14px 15px;

  border: 1px solid var(--border);

  background: var(--background);

  color: var(--text);

  font-family: inherit;

  font-size: 14px;

  outline: none;

  transition:
    border-color 0.25s ease,
    box-shadow 0.25s ease,
    background 0.25s ease;
}

.form-group textarea {
  resize: vertical;
  min-height: 110px;
}

.form-group input::placeholder,
.form-group textarea::placeholder {
  color: #9aa49f;
}

.form-group input:focus,
.form-group textarea:focus {
  background: var(--white);

  border-color: var(--secondary);

  box-shadow: 0 0 0 3px rgba(201, 162, 39, 0.12);
}

/* =========================================
   DELIVERY OPTIONS
========================================= */

.delivery-options {
  display: grid;

  grid-template-columns: 1fr 1fr;

  gap: 15px;

  margin-bottom: 30px;
}

.delivery-option {
  display: flex;

  align-items: center;

  gap: 12px;

  padding: 17px;

  border: 1px solid var(--border);

  background: var(--background);

  color: var(--primary);

  font-weight: 700;

  cursor: pointer;

  transition:
    border-color 0.25s ease,
    background 0.25s ease;
}

.delivery-option:hover {
  border-color: var(--secondary);
}

.delivery-option input {
  accent-color: var(--primary);
}

/* =========================================
   PLACE ORDER / PAYMENT BUTTON
========================================= */

.place-order-button {
  position: relative;

  width: 100%;

  padding: 18px 25px;

  background: var(--primary);

  color: var(--white);

  border: 2px solid var(--secondary);

  overflow: hidden;

  letter-spacing: 1.5px;

  z-index: 1;

  transition:
    color 0.3s ease,
    transform 0.3s ease,
    box-shadow 0.3s ease;
}

.place-order-button::before {
  content: "";

  position: absolute;

  inset: 0;

  background: var(--secondary);

  transform: translateX(-100%);

  transition: transform 0.4s ease;

  z-index: -1;
}

.place-order-button:hover::before {
  transform: translateX(0);
}

.place-order-button:hover {
  color: var(--primary);

  transform: translateY(-3px);

  box-shadow: 0 12px 25px rgba(201, 162, 39, 0.2);
}

.place-order-button:active {
  transform: translateY(0);
}

/* =========================================
   CHECKOUT SUMMARY
========================================= */

.checkout-summary {
  position: sticky;

  top: 25px;

  padding: 30px;

  background: var(--primary);

  color: var(--white);

  border-top: 4px solid var(--secondary);

  box-shadow: 0 20px 45px rgba(11, 61, 46, 0.16);

  animation: checkoutSummaryReveal 0.8s ease 0.15s both;
}

.checkout-summary h2 {
  font-size: 25px;

  margin-bottom: 25px;
}

/* =========================================
   CHECKOUT ITEMS
========================================= */

.checkout-items {
  display: flex;

  flex-direction: column;

  gap: 18px;
}

.checkout-item {
  display: grid;

  grid-template-columns: 65px 1fr auto;

  gap: 12px;

  align-items: center;
}

.checkout-item-image {
  position: relative;

  width: 65px;
  height: 75px;

  overflow: visible;
}

.checkout-item-image img {
  width: 100%;
  height: 100%;

  display: block;

  object-fit: cover;

  border: 1px solid rgba(255, 255, 255, 0.15);
}

.checkout-item-image span {
  position: absolute;

  top: -8px;
  right: -8px;

  min-width: 23px;
  height: 23px;

  display: flex;

  align-items: center;
  justify-content: center;

  padding: 0 5px;

  border-radius: 50%;

  background: var(--secondary);

  color: var(--primary);

  font-size: 11px;

  font-weight: 700;
}

.checkout-item-info {
  min-width: 0;
}

.checkout-item-info h3 {
  color: var(--white);

  font-size: 14px;

  line-height: 1.3;

  margin-bottom: 5px;
}

.checkout-item-info p {
  color: #c7d3cd;

  font-size: 12px;
}

.checkout-item > strong {
  color: var(--secondary);

  font-size: 13px;

  white-space: nowrap;
}

/* =========================================
   SUMMARY DIVIDER
========================================= */

.checkout-summary-divider {
  width: 100%;
  height: 1px;

  margin: 25px 0;

  background: rgba(255, 255, 255, 0.16);
}

/* =========================================
   SUMMARY ROW
========================================= */

.checkout-summary-row {
  display: flex;

  justify-content: space-between;

  gap: 15px;

  margin-bottom: 15px;

  color: #d9e2dd;

  font-size: 14px;
}

.checkout-summary-row strong {
  color: var(--white);
}

/* =========================================
   CHECKOUT TOTAL
========================================= */

.checkout-total {
  display: flex;

  justify-content: space-between;

  align-items: center;

  gap: 15px;
}

.checkout-total span {
  color: var(--white);

  font-weight: 700;
}

.checkout-total strong {
  color: var(--secondary);

  font-size: 23px;
}

/* =========================================
   BACK TO CART
========================================= */

.back-to-cart {
  display: block;

  margin-top: 25px;

  padding-top: 20px;

  border-top: 1px solid rgba(255, 255, 255, 0.12);

  text-align: center;

  color: #d9e2dd;

  font-size: 12px;

  letter-spacing: 1px;

  transition: color 0.25s ease;
}

.back-to-cart:hover {
  color: var(--secondary);
}

/* =========================================
   EMPTY CHECKOUT
========================================= */

.checkout-empty {
  min-height: 65vh;

  display: flex;

  flex-direction: column;

  align-items: center;
  justify-content: center;

  text-align: center;

  animation: checkoutEmptyReveal 0.8s ease both;
}

.checkout-empty > p {
  color: var(--secondary);

  font-size: 13px;

  font-weight: 700;

  letter-spacing: 3px;

  margin-bottom: 15px;
}

.checkout-empty h1 {
  color: var(--primary);

  font-size: 50px;

  margin-bottom: 15px;
}

.checkout-empty span {
  color: var(--muted);

  margin-bottom: 30px;
}

.checkout-empty a {
  padding: 16px 30px;

  background: var(--primary);

  color: var(--white);

  font-weight: 700;

  font-size: 13px;

  letter-spacing: 1px;

  transition:
    background 0.3s ease,
    color 0.3s ease,
    transform 0.3s ease;
}

.checkout-empty a:hover {
  background: var(--secondary);

  color: var(--primary);

  transform: translateY(-3px);
}

/* =========================================
   CHECKOUT ANIMATIONS
========================================= */

@keyframes checkoutHeaderReveal {
  from {
    opacity: 0;
    transform: translateY(30px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes checkoutFormReveal {
  from {
    opacity: 0;
    transform: translateX(-35px);
  }

  to {
    opacity: 1;
    transform: translateX(0);
  }
}

@keyframes checkoutSummaryReveal {
  from {
    opacity: 0;
    transform: translateX(35px);
  }

  to {
    opacity: 1;
    transform: translateX(0);
  }
}

@keyframes checkoutEmptyReveal {
  from {
    opacity: 0;
    transform: translateY(30px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* =========================================
   CHECKOUT TABLET
========================================= */

@media (max-width: 1000px) {
  .checkout-content {
    grid-template-columns: 1fr;
  }

  .checkout-summary {
    position: relative;
    top: auto;
  }
}

/* =========================================
   CHECKOUT MOBILE
========================================= */

@media (max-width: 650px) {
  .checkout-page {
    padding: 55px 20px;
  }

  .checkout-form {
    padding: 25px 20px;
  }

  .form-row {
    grid-template-columns: 1fr;
    gap: 0;
  }

  .delivery-options {
    grid-template-columns: 1fr;
  }

  .checkout-header h1 {
    font-size: 40px;
  }

  .checkout-summary {
    padding: 25px 20px;
  }
}

/* =========================================
   SMALL MOBILE
========================================= */

@media (max-width: 420px) {
  .checkout-page {
    padding: 45px 15px;
  }

  .checkout-header h1 {
    font-size: 34px;
  }

  .checkout-form {
    padding: 22px 16px;
  }

  .checkout-item {
    grid-template-columns: 55px 1fr;
  }

  .checkout-item-image {
    width: 55px;
    height: 65px;
  }

  .checkout-item > strong {
    grid-column: 2;
  }
}

/* =========================================
   CHECKOUT FORM ERRORS
========================================= */

.form-error {
  display: block;

  margin-top: 7px;

  color: #b42318;

  font-size: 12px;

  line-height: 1.4;

  animation: formErrorReveal 0.25s ease both;
}

.form-group input:has(+ .form-error),
.form-group textarea:has(+ .form-error) {
  border-color: #b42318;
}

@keyframes formErrorReveal {
  from {
    opacity: 0;
    transform: translateY(-4px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* =========================================
   ORDER CONFIRMATION
========================================= */

.order-confirmation-page {
  min-height: 85vh;

  display: flex;
  align-items: center;
  justify-content: center;

  padding: 80px 20px;

  background: var(--background);
}

.order-confirmation {
  width: 100%;
  max-width: 650px;

  padding: 55px 45px;

  text-align: center;

  background: var(--white);

  border: 1px solid var(--border);

  border-top: 5px solid var(--secondary);

  box-shadow: 0 25px 60px rgba(11, 61, 46, 0.1);

  animation: confirmationReveal 0.8s ease both;
}

/* CHECK ICON */

.confirmation-icon {
  width: 70px;
  height: 70px;

  display: flex;
  align-items: center;
  justify-content: center;

  margin: 0 auto 25px;

  border-radius: 50%;

  background: var(--primary);

  color: var(--secondary);

  font-size: 32px;
  font-weight: 700;

  border: 3px solid var(--secondary);

  animation: confirmationIconReveal 0.7s ease 0.2s both;
}

/* LABEL */

.confirmation-label {
  color: var(--secondary);

  font-size: 13px;

  font-weight: 700;

  letter-spacing: 3px;

  margin-bottom: 15px;
}

/* TITLE */

.order-confirmation h1 {
  color: var(--primary);

  font-size: clamp(40px, 6vw, 55px);

  margin-bottom: 18px;
}

/* MESSAGE */

.confirmation-message {
  max-width: 500px;

  margin: 0 auto 30px;

  color: var(--muted);

  line-height: 1.7;
}

/* ORDER NUMBER */

.order-number {
  padding: 20px;

  margin-bottom: 25px;

  background: var(--background);

  border: 1px solid var(--border);
}

.order-number span {
  display: block;

  color: var(--muted);

  font-size: 11px;

  letter-spacing: 2px;

  margin-bottom: 8px;
}

.order-number strong {
  color: var(--primary);

  font-size: 18px;

  letter-spacing: 1px;
}

/* SUMMARY */

.confirmation-summary {
  display: grid;

  grid-template-columns: repeat(3, 1fr);

  gap: 15px;

  margin-bottom: 30px;
}

.confirmation-summary div {
  padding: 18px 10px;

  background: var(--background);

  border: 1px solid var(--border);
}

.confirmation-summary span {
  display: block;

  color: var(--muted);

  font-size: 11px;

  margin-bottom: 8px;
}

.confirmation-summary strong {
  color: var(--primary);

  font-size: 14px;
}

/* ACTIONS */

.confirmation-actions {
  display: flex;

  gap: 12px;

  justify-content: center;
}

.confirmation-primary,
.confirmation-secondary {
  padding: 15px 22px;

  font-size: 12px;

  font-weight: 700;

  letter-spacing: 1px;

  transition:
    transform 0.3s ease,
    background 0.3s ease,
    color 0.3s ease;
}

.confirmation-primary {
  background: var(--primary);

  color: var(--white);
}

.confirmation-primary:hover {
  background: var(--secondary);

  color: var(--primary);

  transform: translateY(-3px);
}

.confirmation-secondary {
  border: 1px solid var(--primary);

  color: var(--primary);
}

.confirmation-secondary:hover {
  background: var(--primary);

  color: var(--white);

  transform: translateY(-3px);
}

/* ANIMATIONS */

@keyframes confirmationReveal {
  from {
    opacity: 0;
    transform: translateY(35px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes confirmationIconReveal {
  from {
    opacity: 0;
    transform: scale(0.5);
  }

  to {
    opacity: 1;
    transform: scale(1);
  }
}

/* MOBILE */

@media (max-width: 600px) {
  .order-confirmation-page {
    padding: 50px 15px;
  }

  .order-confirmation {
    padding: 40px 20px;
  }

  .confirmation-summary {
    grid-template-columns: 1fr;
  }

  .confirmation-actions {
    flex-direction: column;
  }

  .confirmation-primary,
  .confirmation-secondary {
    width: 100%;
  }
}
/* =========================================
   SMALL MOBILE
========================================= */

@media (max-width: 420px) {
  .cart-page {
    padding: 45px 15px;
  }

  .cart-header h1 {
    font-size: 34px;
  }

  .cart-item {
    grid-template-columns: 85px 1fr;

    gap: 14px;
  }

  .cart-item-image {
    width: 85px;
    height: 110px;
  }

  .cart-item-details h2 {
    font-size: 16px;
  }

  .cart-quantity button {
    width: 35px;
    height: 35px;
  }

  .cart-quantity span {
    width: 40px;
  }
}

/* =========================================
   MOBILE
========================================= */
/* =========================================
   MY ORDERS
========================================= */

.my-orders-page {
  min-height: 85vh;
  padding: 80px 6%;
  background: var(--background);
}

/* =========================================
   HEADER
========================================= */

.my-orders-header {
  max-width: 900px;
  margin: 0 auto 55px;
  text-align: center;
  animation: myOrdersHeaderReveal 0.7s ease both;
}

.orders-label {
  margin-bottom: 12px;
  color: var(--secondary);
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 3px;
}

.my-orders-header h1 {
  margin-bottom: 15px;
  color: var(--primary);
  font-size: clamp(40px, 6vw, 58px);
  line-height: 1.05;
}

.my-orders-header span {
  color: var(--muted);
  font-size: 15px;
  line-height: 1.7;
}

/* =========================================
   ORDERS CONTAINER
========================================= */

.orders-container {
  width: 100%;
  max-width: 1000px;
  margin: 0 auto;
  display: grid;
  gap: 24px;
}

/* =========================================
   ORDER CARD
========================================= */

.order-card {
  position: relative;
  overflow: hidden;
  background: var(--white);
  border: 1px solid var(--border);
  padding: 30px;
  box-shadow: 0 12px 35px rgba(11, 61, 46, 0.06);
  animation: orderCardReveal 0.6s ease both;
  transition:
    transform 0.3s ease,
    box-shadow 0.3s ease,
    border-color 0.3s ease;
}

.order-card::before {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  width: 4px;
  height: 100%;
  background: var(--secondary);
  transform: scaleY(0);
  transform-origin: bottom;
  transition: transform 0.35s ease;
}

.order-card:hover {
  transform: translateY(-5px);
  border-color: rgba(201, 162, 39, 0.5);
  box-shadow: 0 20px 45px rgba(11, 61, 46, 0.11);
}

.order-card:hover::before {
  transform: scaleY(1);
}

/* =========================================
   ORDER TOP
========================================= */

.order-card-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 25px;
  padding-bottom: 24px;
  border-bottom: 1px solid var(--border);
}

.order-card-top span,
.order-status span {
  display: block;
  margin-bottom: 8px;
  color: var(--muted);
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 1.8px;
}

.order-card-top h2 {
  color: var(--primary);
  font-size: 17px;
  letter-spacing: 0.5px;
}

.order-status {
  text-align: right;
}

.order-status strong {
  display: inline-block;
  padding: 7px 13px;
  background: rgba(201, 162, 39, 0.12);
  border: 1px solid rgba(201, 162, 39, 0.35);
  color: var(--primary);
  font-size: 11px;
  letter-spacing: 0.8px;
}

/* =========================================
   ORDER INFORMATION
========================================= */

.order-card-info {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20px;
  padding: 25px 0;
}

.order-card-info div {
  min-width: 0;
}

.order-card-info span {
  display: block;
  margin-bottom: 7px;
  color: var(--muted);
  font-size: 11px;
}

.order-card-info strong {
  display: block;
  color: var(--text);
  font-size: 14px;
}

/* =========================================
   ACTIONS
========================================= */

.order-card-actions {
  display: flex;
  gap: 12px;
  padding-top: 22px;
  border-top: 1px solid var(--border);
}

.view-order-button,
.track-order-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 44px;
  padding: 12px 20px;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 1px;
  transition:
    transform 0.3s ease,
    background 0.3s ease,
    color 0.3s ease,
    border-color 0.3s ease;
}

.view-order-button {
  background: var(--primary);
  color: var(--white);
}

.view-order-button:hover {
  background: var(--secondary);
  color: var(--primary);
  transform: translateY(-2px);
}

.track-order-button {
  border: 1px solid var(--primary);
  color: var(--primary);
}

.track-order-button:hover {
  background: var(--primary);
  color: var(--white);
  transform: translateY(-2px);
}

/* =========================================
   EMPTY ORDERS
========================================= */

.empty-orders {
  width: 100%;
  max-width: 650px;
  margin: 70px auto;
  padding: 55px 40px;
  text-align: center;
  background: var(--white);
  border: 1px solid var(--border);
  border-top: 5px solid var(--secondary);
  box-shadow: 0 20px 50px rgba(11, 61, 46, 0.08);
  animation: emptyOrdersReveal 0.7s ease both;
}

.empty-orders h1 {
  margin-bottom: 15px;
  color: var(--primary);
  font-size: clamp(36px, 5vw, 52px);
}

.empty-orders > p:not(.orders-label) {
  max-width: 480px;
  margin: 0 auto 30px;
  color: var(--muted);
  line-height: 1.7;
}

.orders-shop-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 15px 24px;
  background: var(--primary);
  color: var(--white);
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 1px;
  transition:
    transform 0.3s ease,
    background 0.3s ease;
}

.orders-shop-button:hover {
  background: var(--secondary);
  color: var(--primary);
  transform: translateY(-3px);
}

/* =========================================
   ANIMATIONS
========================================= */

@keyframes myOrdersHeaderReveal {
  from {
    opacity: 0;
    transform: translateY(25px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes orderCardReveal {
  from {
    opacity: 0;
    transform: translateY(25px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes emptyOrdersReveal {
  from {
    opacity: 0;
    transform: translateY(30px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* =========================================
   TABLET
========================================= */

@media (max-width: 800px) {
  .my-orders-page {
    padding: 65px 5%;
  }

  .order-card-info {
    grid-template-columns: repeat(2, 1fr);
  }
}

/* =========================================
   MOBILE
========================================= */

@media (max-width: 600px) {
  .my-orders-page {
    padding: 50px 20px;
  }

  .my-orders-header {
    margin-bottom: 35px;
  }

  .order-card {
    padding: 22px;
  }

  .order-card-top {
    align-items: flex-start;
    flex-direction: column;
  }

  .order-status {
    text-align: left;
  }

  .order-card-info {
    grid-template-columns: 1fr 1fr;
    gap: 22px 15px;
  }

  .order-card-actions {
    flex-direction: column;
  }

  .view-order-button,
  .track-order-button {
    width: 100%;
  }

  .empty-orders {
    padding: 40px 22px;
  }
}
/* =========================================
   TRACK ORDER PAGE
========================================= */

.track-order-page {
  min-height: 85vh;
  padding: 80px 6%;
  background: var(--background);
}

/* =========================================
   HEADER
========================================= */

.track-order-header {
  max-width: 900px;
  margin: 0 auto 50px;
  text-align: center;
  animation: trackHeaderReveal 0.7s ease both;
}

.track-label {
  margin-bottom: 12px;
  color: var(--secondary);
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 3px;
}

.track-order-header h1 {
  margin-bottom: 15px;
  color: var(--primary);
  font-size: clamp(40px, 6vw, 58px);
  line-height: 1.05;
}

.track-order-header span {
  color: var(--muted);
  font-size: 15px;
  line-height: 1.7;
}

/* =========================================
   MAIN CONTAINER
========================================= */

.tracking-container {
  width: 100%;
  max-width: 900px;
  margin: 0 auto;
}

/* =========================================
   ORDER NUMBER
========================================= */

.tracking-order-number {
  padding: 25px 30px;
  margin-bottom: 24px;
  background: var(--white);
  border: 1px solid var(--border);
  border-left: 4px solid var(--secondary);
  box-shadow: 0 12px 35px rgba(11, 61, 46, 0.06);
  animation: trackingCardReveal 0.6s ease both;
}

.tracking-order-number span {
  display: block;
  margin-bottom: 8px;
  color: var(--muted);
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 2px;
}

.tracking-order-number strong {
  color: var(--primary);
  font-size: 18px;
  letter-spacing: 1px;
}

/* =========================================
   CURRENT STATUS
========================================= */

.tracking-status {
  padding: 35px;
  margin-bottom: 24px;
  background: var(--white);
  border: 1px solid var(--border);
  box-shadow: 0 12px 35px rgba(11, 61, 46, 0.06);
  animation: trackingCardReveal 0.7s ease both;
}

.tracking-status-header {
  padding-bottom: 25px;
  border-bottom: 1px solid var(--border);
}

.tracking-status-header span {
  display: block;
  margin-bottom: 8px;
  color: var(--muted);
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 2px;
}

.tracking-status-header h2 {
  color: var(--primary);
  font-size: 28px;
}

/* =========================================
   TIMELINE
========================================= */

.tracking-timeline {
  padding-top: 30px;
}

.tracking-step {
  display: flex;
  align-items: flex-start;
  gap: 20px;
  position: relative;
}

.tracking-dot {
  flex: 0 0 42px;
  width: 42px;
  height: 42px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--background);
  border: 2px solid var(--border);
  color: var(--muted);
  font-size: 13px;
  font-weight: 700;
  transition:
    background 0.3s ease,
    color 0.3s ease,
    border-color 0.3s ease,
    transform 0.3s ease;
}

.tracking-step.active .tracking-dot {
  background: var(--primary);
  border-color: var(--secondary);
  color: var(--secondary);
  box-shadow: 0 0 0 5px rgba(201, 162, 39, 0.12);
}

.tracking-step.active:hover .tracking-dot {
  transform: scale(1.08);
}

.tracking-step-content {
  padding-top: 3px;
}

.tracking-step-content h3 {
  margin-bottom: 6px;
  color: var(--primary);
  font-size: 16px;
}

.tracking-step-content p {
  color: var(--muted);
  font-size: 13px;
  line-height: 1.6;
}

/* =========================================
   TIMELINE LINE
========================================= */

.tracking-line {
  width: 2px;
  height: 45px;
  margin-left: 20px;
  background: var(--border);
}

/* =========================================
   ORDER SUMMARY
========================================= */

.tracking-summary {
  padding: 30px 35px;
  margin-bottom: 24px;
  background: var(--white);
  border: 1px solid var(--border);
  box-shadow: 0 12px 35px rgba(11, 61, 46, 0.06);
  animation: trackingCardReveal 0.8s ease both;
}

.tracking-summary h2 {
  margin-bottom: 22px;
  color: var(--primary);
  font-size: 21px;
}

.tracking-summary-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  padding: 15px 0;
  border-bottom: 1px solid var(--border);
}

.tracking-summary-row:last-child {
  border-bottom: none;
}

.tracking-summary-row span {
  color: var(--muted);
  font-size: 13px;
}

.tracking-summary-row strong {
  color: var(--primary);
  font-size: 14px;
}

/* =========================================
   ACTIONS
========================================= */

.tracking-actions {
  display: flex;
  gap: 12px;
  justify-content: center;
  animation: trackingActionsReveal 0.9s ease both;
}

.tracking-primary-button,
.tracking-secondary-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 48px;
  padding: 14px 25px;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 1px;
  transition:
    transform 0.3s ease,
    background 0.3s ease,
    color 0.3s ease;
}

.tracking-primary-button {
  background: var(--primary);
  color: var(--white);
}

.tracking-primary-button:hover {
  background: var(--secondary);
  color: var(--primary);
  transform: translateY(-3px);
}

.tracking-secondary-button {
  border: 1px solid var(--primary);
  color: var(--primary);
}

.tracking-secondary-button:hover {
  background: var(--primary);
  color: var(--white);
  transform: translateY(-3px);
}

/* =========================================
   ORDER NOT FOUND
========================================= */

.track-order-not-found {
  width: 100%;
  max-width: 650px;
  margin: 70px auto;
  padding: 55px 40px;
  text-align: center;
  background: var(--white);
  border: 1px solid var(--border);
  border-top: 5px solid var(--secondary);
  box-shadow: 0 20px 50px rgba(11, 61, 46, 0.08);
  animation: trackNotFoundReveal 0.7s ease both;
}

.track-order-not-found h1 {
  margin-bottom: 15px;
  color: var(--primary);
  font-size: clamp(36px, 5vw, 52px);
}

.track-order-not-found > p:not(.track-label) {
  margin-bottom: 30px;
  color: var(--muted);
  line-height: 1.7;
}

.track-back-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 15px 24px;
  background: var(--primary);
  color: var(--white);
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 1px;
  transition:
    transform 0.3s ease,
    background 0.3s ease;
}

.track-back-button:hover {
  background: var(--secondary);
  color: var(--primary);
  transform: translateY(-3px);
}

/* =========================================
   ANIMATIONS
========================================= */

@keyframes trackHeaderReveal {
  from {
    opacity: 0;
    transform: translateY(25px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes trackingCardReveal {
  from {
    opacity: 0;
    transform: translateY(25px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes trackingActionsReveal {
  from {
    opacity: 0;
    transform: translateY(15px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes trackNotFoundReveal {
  from {
    opacity: 0;
    transform: translateY(30px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* =========================================
   TABLET
========================================= */

@media (max-width: 700px) {
  .track-order-page {
    padding: 65px 5%;
  }

  .tracking-status {
    padding: 28px 25px;
  }

  .tracking-summary {
    padding: 25px;
  }
}

/* =========================================================
   ACCOUNT PAGE
   ========================================================= */

.account-page {
  min-height: 100vh;
  padding: 90px 6% 100px;
  background: var(--background);
}

/* ---------- Header ---------- */

.account-header {
  max-width: 1200px;
  margin: 0 auto 55px;
  text-align: center;
  animation: accountHeaderReveal 0.8s ease forwards;
}

.account-label {
  color: var(--secondary);
  font-size: 13px;
  font-weight: 700;
  letter-spacing: 3px;
  margin-bottom: 12px;
}

.account-header h1 {
  color: var(--primary-dark);
  font-size: clamp(38px, 5vw, 64px);
  margin-bottom: 15px;
  line-height: 1.1;
}

.account-header span {
  display: block;
  color: var(--muted);
  font-size: 16px;
  line-height: 1.7;
}

/* ---------- Main Content ---------- */

.account-content {
  max-width: 1200px;
  margin: 0 auto;
  display: grid;
  grid-template-columns: minmax(0, 1fr) 340px;
  gap: 35px;
  align-items: start;
}

/* ---------- Profile Card ---------- */

.account-card {
  background: var(--white);
  border: 1px solid var(--border);
  padding: 38px;
  box-shadow: 0 18px 45px rgba(16, 37, 29, 0.07);
  animation: accountCardReveal 0.9s ease forwards;
}

.account-card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  padding-bottom: 28px;
  margin-bottom: 30px;
  border-bottom: 1px solid var(--border);
}

.account-card-header p {
  color: var(--secondary);
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 2px;
  margin-bottom: 8px;
}

.account-card-header h2 {
  color: var(--primary-dark);
  font-size: 25px;
}

/* ---------- Avatar ---------- */

.account-avatar {
  width: 65px;
  height: 65px;
  flex-shrink: 0;

  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 50%;
  background: var(--primary);
  color: var(--secondary);

  font-size: 24px;
  font-weight: 700;

  border: 2px solid var(--secondary);

  box-shadow: 0 8px 20px rgba(11, 61, 46, 0.18);

  transition:
    transform 0.3s ease,
    box-shadow 0.3s ease;
}

.account-avatar:hover {
  transform: translateY(-4px) scale(1.04);
  box-shadow: 0 12px 28px rgba(11, 61, 46, 0.25);
}

/* ---------- Form ---------- */

.account-form {
  display: flex;
  flex-direction: column;
  gap: 22px;
}

.account-form-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20px;
}

.account-form-group {
  display: flex;
  flex-direction: column;
  gap: 9px;
}

.account-form-group label {
  color: var(--text);
  font-size: 13px;
  font-weight: 700;
}

.account-form-group input {
  width: 100%;
  padding: 15px 16px;

  border: 1px solid var(--border);
  background: #fcfbf7;

  color: var(--text);
  font-family: inherit;
  font-size: 15px;

  outline: none;

  transition:
    border-color 0.3s ease,
    box-shadow 0.3s ease,
    background 0.3s ease,
    transform 0.3s ease;
}

.account-form-group input::placeholder {
  color: #9aa19d;
}

.account-form-group input:hover {
  border-color: #b9b5aa;
}

.account-form-group input:focus {
  background: var(--white);
  border-color: var(--primary);

  box-shadow: 0 0 0 3px rgba(11, 61, 46, 0.08);

  transform: translateY(-1px);
}

/* ---------- Save Button ---------- */

.save-account-button {
  width: 100%;
  margin-top: 8px;

  background: var(--primary);
  color: var(--white);

  letter-spacing: 1px;

  transition:
    background 0.3s ease,
    transform 0.3s ease,
    box-shadow 0.3s ease;
}

.save-account-button:hover {
  background: var(--primary-dark);
  transform: translateY(-3px);
  box-shadow: 0 10px 24px rgba(11, 61, 46, 0.2);
}

.save-account-button:active {
  transform: translateY(-1px);
}

/* ---------- Saved Message ---------- */

.account-saved-message {
  padding: 13px 16px;

  background: rgba(11, 61, 46, 0.07);
  border-left: 3px solid var(--primary);

  color: var(--primary);
  font-size: 14px;
  font-weight: 600;

  animation: accountMessageReveal 0.4s ease forwards;
}

/* ---------- Sidebar ---------- */

.account-sidebar {
  background: var(--primary);
  padding: 32px 28px;

  box-shadow: 0 18px 45px rgba(16, 37, 29, 0.12);

  animation: accountSidebarReveal 1s ease forwards;
}

.account-sidebar h2 {
  color: var(--white);
  font-size: 23px;
  margin-bottom: 25px;
  padding-bottom: 20px;
  border-bottom: 1px solid rgba(255, 255, 255, 0.15);
}

/* ---------- Sidebar Links ---------- */

.account-sidebar a {
  display: flex;
  align-items: center;
  justify-content: space-between;

  padding: 17px 0;

  color: rgba(255, 255, 255, 0.82);

  border-bottom: 1px solid rgba(255, 255, 255, 0.1);

  font-size: 14px;
  font-weight: 600;

  transition:
    color 0.3s ease,
    padding-left 0.3s ease;
}

.account-sidebar a:last-child {
  border-bottom: none;
}

.account-sidebar a strong {
  color: var(--secondary);
  font-size: 20px;

  transition: transform 0.3s ease;
}

.account-sidebar a:hover {
  color: var(--white);
  padding-left: 7px;
}

.account-sidebar a:hover strong {
  transform: translateX(5px);
}

/* =========================================================
   ACCOUNT ANIMATIONS
   ========================================================= */

@keyframes accountHeaderReveal {
  from {
    opacity: 0;
    transform: translateY(-25px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes accountCardReveal {
  from {
    opacity: 0;
    transform: translateX(-30px);
  }

  to {
    opacity: 1;
    transform: translateX(0);
  }
}

@keyframes accountSidebarReveal {
  from {
    opacity: 0;
    transform: translateX(30px);
  }

  to {
    opacity: 1;
    transform: translateX(0);
  }
}

@keyframes accountMessageReveal {
  from {
    opacity: 0;
    transform: translateY(-8px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* =========================================================
   ACCOUNT RESPONSIVE DESIGN
   ========================================================= */

@media (max-width: 900px) {
  .account-content {
    grid-template-columns: 1fr;
  }

  .account-sidebar {
    order: 2;
  }
}

@media (max-width: 650px) {
  .account-page {
    padding: 65px 20px 80px;
  }

  .account-header {
    margin-bottom: 40px;
  }

  .account-card {
    padding: 25px 20px;
  }

  .account-card-header {
    align-items: flex-start;
  }

  .account-card-header h2 {
    font-size: 21px;
  }

  .account-avatar {
    width: 55px;
    height: 55px;
    font-size: 20px;
  }

  .account-form-row {
    grid-template-columns: 1fr;
    gap: 22px;
  }

  .account-sidebar {
    padding: 28px 22px;
  }
}

@media (max-width: 420px) {
  .account-page {
    padding-left: 15px;
    padding-right: 15px;
  }

  .account-header h1 {
    font-size: 38px;
  }

  .account-card {
    padding: 22px 16px;
  }

  .account-card-header {
    gap: 12px;
  }

  .account-card-header h2 {
    font-size: 19px;
  }
}

/* =========================================
   MOBILE
========================================= */

@media (max-width: 600px) {
  .track-order-page {
    padding: 50px 20px;
  }

  .track-order-header {
    margin-bottom: 35px;
  }

  .tracking-order-number {
    padding: 22px;
  }

  .tracking-status {
    padding: 25px 20px;
  }

  .tracking-step {
    gap: 14px;
  }

  .tracking-dot {
    flex-basis: 38px;
    width: 38px;
    height: 38px;
  }

  .tracking-line {
    margin-left: 18px;
    height: 40px;
  }

  .tracking-step-content h3 {
    font-size: 15px;
  }

  .tracking-step-content p {
    font-size: 12px;
  }

  .tracking-actions {
    flex-direction: column;
  }

  .tracking-primary-button,
  .tracking-secondary-button {
    width: 100%;
  }

  .track-order-not-found {
    padding: 40px 22px;
  }
}

/* =========================================
   SMALL MOBILE
========================================= */

/*=========================================================
  ABS
  CUT
  —
  CUSTOM
  ORDER
  PAGE
  =========================================================*/
.custom-order-page {
  min-height: 100vh;
  padding: 90px 6% 110px;
  background: var(--background);
}
/* ========================================================= HEADER ========================================================= */
.custom-order-header {
  max-width: 900px;
  margin: 0 auto 60px;
  text-align: center;
  animation: customHeaderReveal 0.8s ease forwards;
}
.custom-order-header > p {
  color: var(--secondary);
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 3px;
  margin-bottom: 14px;
}
.custom-order-header h1 {
  color: var(--primary-dark);
  font-size: clamp(38px, 5vw, 64px);
  line-height: 1.08;
  margin-bottom: 18px;
}
.custom-order-header > span {
  display: block;
  max-width: 700px;
  margin: 0 auto;
  color: var(--muted);
  font-size: 16px;
  line-height: 1.8;
} /* ========================================================= MAIN CONTENT ========================================================= */
.custom-order-content {
  max-width: 1200px;
  margin: 0 auto;
  display: grid;
  grid-template-columns: minmax(0, 1fr) 350px;
  gap: 35px;
  align-items: start;
} /* ========================================================= FORM ========================================================= */
.custom-order-form {
  background: var(--white);
  border: 1px solid var(--border);
  padding: 42px;
  box-shadow: 0 20px 50px rgba(16, 37, 29, 0.07);
  animation: customFormReveal 0.9s ease forwards;
} /* ========================================================= SECTION HEADINGS ========================================================= */
.custom-order-section {
  padding-bottom: 25px;
  margin-bottom: 28px;
  border-bottom: 1px solid var(--border);
}
.custom-order-section:not(:first-child) {
  margin-top: 42px;
}
.custom-section-label {
  color: var(--secondary);
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 2px;
  margin-bottom: 9px;
}
.custom-order-section h2 {
  color: var(--primary-dark);
  font-size: 25px;
  margin-bottom: 9px;
}
.custom-order-section > span {
  display: block;
  color: var(--muted);
  font-size: 14px;
  line-height: 1.7;
} /* ========================================================= FORM GROUPS ========================================================= */
.custom-form-group {
  display: flex;
  flex-direction: column;
  gap: 9px;
  margin-bottom: 23px;
}
.custom-form-group label {
  color: var(--text);
  font-size: 13px;
  font-weight: 700;
}
.custom-form-group input,
.custom-form-group select,
.custom-form-group textarea {
  width: 100%;
  padding: 15px 16px;
  border: 1px solid var(--border);
  background: #fcfbf7;
  color: var(--text);
  font-family: inherit;
  font-size: 15px;
  outline: none;
  transition:
    border-color 0.3s ease,
    box-shadow 0.3s ease,
    background 0.3s ease,
    transform 0.3s ease;
}
.custom-form-group input::placeholder,
.custom-form-group textarea::placeholder {
  color: #9aa19d;
}
.custom-form-group input:hover,
.custom-form-group select:hover,
.custom-form-group textarea:hover {
  border-color: #b9b5aa;
}
.custom-form-group input:focus,
.custom-form-group select:focus,
.custom-form-group textarea:focus {
  background: var(--white);
  border-color: var(--primary);
  box-shadow: 0 0 0 3px rgba(11, 61, 46, 0.08);
  transform: translateY(-1px);
}
.custom-form-group textarea {
  resize: vertical;
  min-height: 130px;
  line-height: 1.6;
} /* ========================================================= SELECT ========================================================= */
.custom-form-group select {
  cursor: pointer;
  appearance: auto;
} /* ========================================================= TWO COLUMN FORM ========================================================= */
.custom-form-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20px;
} /* ========================================================= RADIO OPTIONS ========================================================= */
.custom-radio-options {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 15px;
}
.custom-radio-options > label {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 17px;
  border: 1px solid var(--border);
  background: #fcfbf7;
  color: var(--text);
  font-size: 14px;
  font-weight: 600;
  cursor: pointer;
  transition:
    border-color 0.3s ease,
    background 0.3s ease,
    transform 0.3s ease,
    box-shadow 0.3s ease;
}
.custom-radio-options > label:hover {
  border-color: var(--primary);
  transform: translateY(-2px);
  box-shadow: 0 7px 18px rgba(16, 37, 29, 0.06);
}
.custom-radio-options input {
  width: 17px;
  height: 17px;
  accent-color: var(--primary);
  cursor: pointer;
} /* ========================================================= OPTIONAL LABEL ========================================================= */
.optional {
  margin-left: 7px;
  color: var(--muted);
  font-size: 11px;
  font-weight: 400;
} /* ========================================================= FILE UPLOAD ========================================================= */
.custom-form-group input[type="file"] {
  padding: 12px;
  cursor: pointer;
}
.custom-form-group input[type="file"]::file-selector-button {
  margin-right: 12px;
  padding: 9px 14px;
  border: none;
  background: var(--primary);
  color: var(--white);
  font-family: inherit;
  font-size: 12px;
  font-weight: 700;
  cursor: pointer;
  transition: background 0.3s ease;
}
.custom-form-group input[type="file"]::file-selector-button:hover {
  background: var(--primary-dark);
}
.selected-file {
  display: block;
  padding: 10px 13px;
  background: rgba(11, 61, 46, 0.06);
  border-left: 3px solid var(--primary);
  color: var(--primary);
  font-size: 13px;
  font-weight: 600;
} /* ========================================================= ERROR ========================================================= */
.custom-order-error {
  margin: 10px 0 20px;
  padding: 14px 16px;
  background: #fff4f2;
  border-left: 3px solid #b44a3a;
  color: #8f3327;
  font-size: 14px;
  line-height: 1.5;
  animation: customErrorReveal 0.3s ease forwards;
} /* ========================================================= SUBMIT BUTTON ========================================================= */
.submit-custom-order {
  width: 100%;
  margin-top: 8px;
  padding: 17px 25px;
  background: var(--primary);
  color: var(--white);
  font-size: 14px;
  font-weight: 700;
  letter-spacing: 1px;
  transition:
    background 0.3s ease,
    transform 0.3s ease,
    box-shadow 0.3s ease;
}
.submit-custom-order:hover {
  background: var(--primary-dark);
  transform: translateY(-3px);
  box-shadow: 0 12px 28px rgba(11, 61, 46, 0.2);
}
.submit-custom-order:active {
  transform: translateY(-1px);
}

/* ========================================================= SIDEBAR ========================================================= */
.custom-order-sidebar {
  display: flex;
  flex-direction: column;
  gap: 22px;
  position: sticky;
  top: 30px;
  animation: customSidebarReveal 1s ease forwards;
} /* ========================================================= HOW IT WORKS CARD ========================================================= */
.custom-sidebar-card {
  padding: 32px 28px;
  background: var(--primary);
  box-shadow: 0 20px 45px rgba(16, 37, 29, 0.13);
}
.custom-sidebar-card > p {
  color: var(--secondary);
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 3px;
  margin-bottom: 10px;
}
.custom-sidebar-card h2 {
  color: var(--white);
  font-size: 25px;
  margin-bottom: 27px;
} /* ========================================================= PROCESS ========================================================= */
.custom-process {
  display: flex;
  flex-direction: column;
}
.custom-process > div {
  display: grid;
  grid-template-columns: 45px 1fr;
  gap: 14px;
  padding: 18px 0;
  border-top: 1px solid rgba(255, 255, 255, 0.12);
}
.custom-process > div:first-child {
  border-top: none;
  padding-top: 0;
}
.custom-process strong {
  color: var(--secondary);
  font-size: 13px;
  letter-spacing: 1px;
}
.custom-process span {
  color: rgba(255, 255, 255, 0.78);
  font-size: 13px;
  line-height: 1.6;
} /* ========================================================= HELP CARD ========================================================= */
.custom-sidebar-note {
  padding: 28px;
  background: var(--white);
  border: 1px solid var(--border);
  box-shadow: 0 15px 35px rgba(16, 37, 29, 0.06);
}
.custom-sidebar-note h3 {
  color: var(--primary-dark);
  font-size: 20px;
  margin-bottom: 12px;
}
.custom-sidebar-note p {
  color: var(--muted);
  font-size: 14px;
  line-height: 1.7;
  margin-bottom: 20px;
}
.custom-sidebar-note a {
  display: inline-block;
  color: var(--primary);
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 1px;
  transition:
    color 0.3s ease,
    transform 0.3s ease;
}
.custom-sidebar-note a:hover {
  color: var(--secondary);
} /* ========================================================= SUCCESS STATE ========================================================= */
.custom-order-submitted {
  max-width: 650px;
  margin: 100px auto;
  padding: 60px 40px;
  background: var(--white);
  border: 1px solid var(--border);
  text-align: center;
  box-shadow: 0 20px 50px rgba(16, 37, 29, 0.08);
  animation: customSuccessReveal 0.7s ease forwards;
}
.custom-success-icon {
  width: 70px;
  height: 70px;
  margin: 0 auto 25px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--primary);
  color: var(--secondary);
  font-size: 30px;
  font-weight: 700;
}
.custom-order-submitted > p {
  color: var(--secondary);
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 3px;
  margin-bottom: 12px;
}
.custom-order-submitted h1 {
  color: var(--primary-dark);
  font-size: 40px;
  margin-bottom: 15px;
}
.custom-order-submitted > span {
  color: var(--muted);
  font-size: 15px;
} /* ========================================================= ANIMATIONS ========================================================= */
@keyframes customHeaderReveal {
  from {
    opacity: 0;
    transform: translateY(-25px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
@keyframes customFormReveal {
  from {
    opacity: 0;
    transform: translateX(-30px);
  }
  to {
    opacity: 1;
    transform: translateX(0);
  }
}
@keyframes customSidebarReveal {
  from {
    opacity: 0;
    transform: translateX(30px);
  }
  to {
    opacity: 1;
    transform: translateX(0);
  }
}
@keyframes customErrorReveal {
  from {
    opacity: 0;
    transform: translateY(-8px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
@keyframes customSuccessReveal {
  from {
    opacity: 0;
    transform: scale(0.96) translateY(15px);
  }
  to {
    opacity: 1;
    transform: scale(1) translateY(0);
  }
} /* ========================================================= TABLET ========================================================= */
@media (max-width: 950px) {
  .custom-order-content {
    grid-template-columns: 1fr;
  }
  .custom-order-sidebar {
    position: static;
  }
  .custom-sidebar-card {
    width: 100%;
  }
} /* ========================================================= MOBILE ========================================================= */
@media (max-width: 650px) {
  .custom-order-page {
    padding: 65px 20px 80px;
  }
  .custom-order-header {
    margin-bottom: 40px;
  }
  .custom-order-header h1 {
    font-size: 39px;
  }
  .custom-order-header > span {
    font-size: 14px;
  }
  .custom-order-form {
    padding: 25px 20px;
  }
  .custom-order-section h2 {
    font-size: 22px;
  }
  .custom-form-row {
    grid-template-columns: 1fr;
    gap: 0;
  }
  .custom-radio-options {
    grid-template-columns: 1fr;
  }
  .custom-sidebar-card,
  .custom-sidebar-note {
    padding: 25px 20px;
  }
  .custom-order-submitted {
    margin: 60px auto;
    padding: 45px 25px;
  }
  .custom-order-submitted h1 {
    font-size: 32px;
  }
} /* ========================================================= SMALL PHONES ========================================================= */
@media (max-width: 420px) {
  .custom-order-page {
    padding-left: 15px;
    padding-right: 15px;
  }
  .custom-order-form {
    padding: 22px 16px;
  }
  .custom-order-header h1 {
    font-size: 35px;
  }
  .custom-order-section:not(:first-child) {
    margin-top: 35px;
  }
  .custom-radio-options > label {
    padding: 14px;
  }
}
@media (max-width: 400px) {
  .order-card-info {
    grid-template-columns: 1fr;
  }

  .my-orders-header h1 {
    font-size: 40px;
  }
}

@media (max-width: 900px) {
  .product-details-page {
    padding: 60px 5%;
  }

  .product-details {
    grid-template-columns: 1fr;

    gap: 45px;
  }

  .image-wrapper {
    height: 500px;
  }

  .product-details-info h1 {
    font-size: 2.7rem;
  }
}

@media (max-width: 600px) {
  .product-details-page {
    padding: 40px 5%;
  }

  .image-wrapper {
    height: 420px;
  }

  .product-details-info h1 {
    font-size: 2.2rem;
  }

  .product-price {
    font-size: 1.6rem;
  }

  .add-to-cart {
    max-width: 100%;
  }
}

/* =========================================
   QUANTITY CONTROL INTERACTION
========================================= */

.quantity-section {
  position: relative;
  z-index: 10;
}

.quantity-control {
  position: relative;
  z-index: 20;

  display: inline-flex;

  align-items: center;

  pointer-events: auto;
}

.quantity-control button {
  position: relative;
  z-index: 30;

  cursor: pointer;

  pointer-events: auto;

  user-select: none;
}

.quantity-control span {
  user-select: none;
}
@media (max-width: 600px) {
  .service-grid {
    grid-template-columns: 1fr;
  }

  .hero h1 {
    font-size: 55px;
  }

  .custom-section h2 {
    font-size: 42px;
  }

  .hero-buttons {
    flex-direction: column;
  }

  .hero-buttons button {
    width: 100%;
  }
}

/* =========================================
   CUSTOM ORDER CONFIRMATION
========================================= */

.custom-confirmation-page {
  min-height: 100vh;
  padding: 80px 20px;
  display: flex;
  justify-content: center;
  align-items: center;
  background: var(--background);
}

.custom-confirmation {
  width: 100%;
  max-width: 850px;
  padding: 60px;
  background: var(--white);
  border: 1px solid var(--border);
  text-align: center;
  box-shadow: 0 20px 60px rgba(16, 37, 29, 0.08);
  border-radius: 4px;
  animation: customConfirmationReveal 0.8s ease forwards;
}

/* =========================================
   SUCCESS ICON
========================================= */

.custom-confirmation-icon {
  width: 78px;
  height: 78px;
  margin: 0 auto 25px;

  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 50%;
  background: var(--primary);
  color: var(--white);

  font-size: 34px;
  font-weight: 700;

  box-shadow: 0 12px 30px rgba(11, 61, 46, 0.22);

  animation: customIconPop 0.7s ease 0.2s both;
}

/* =========================================
   HEADER
========================================= */

.custom-confirmation-label {
  margin-bottom: 12px;

  color: var(--secondary);

  font-size: 13px;
  font-weight: 800;
  letter-spacing: 2px;
  text-transform: uppercase;
}

.custom-confirmation h1 {
  margin-bottom: 18px;

  color: var(--primary-dark);

  font-size: 42px;
  line-height: 1.15;
  font-weight: 800;

  animation: customTitleReveal 0.7s ease 0.25s both;
}

.custom-confirmation-message {
  max-width: 650px;
  margin: 0 auto 35px;

  color: var(--muted);

  font-size: 16px;
  line-height: 1.8;

  animation: customMessageReveal 0.7s ease 0.35s both;
}

/* =========================================
   REQUEST NUMBER
========================================= */

.custom-request-number {
  margin-bottom: 35px;
  padding: 22px;

  background: var(--background);
  border: 1px solid var(--border);

  animation: customCardReveal 0.7s ease 0.45s both;
}

.custom-request-number span {
  display: block;
  margin-bottom: 8px;

  color: var(--muted);

  font-size: 11px;
  font-weight: 800;
  letter-spacing: 1.5px;
}

.custom-request-number strong {
  display: block;

  color: var(--primary);

  font-size: 22px;
  letter-spacing: 1px;
}

/* =========================================
   REQUEST SUMMARY
========================================= */

.custom-request-summary {
  display: grid;
  grid-template-columns: repeat(3, 1fr);

  margin-bottom: 35px;

  border: 1px solid var(--border);

  animation: customCardReveal 0.7s ease 0.55s both;
}

.custom-request-summary > div {
  padding: 20px;

  text-align: left;

  border-right: 1px solid var(--border);
  border-bottom: 1px solid var(--border);

  transition:
    background 0.25s ease,
    transform 0.25s ease;
}

.custom-request-summary > div:nth-child(3n) {
  border-right: none;
}

.custom-request-summary > div:nth-child(n + 4) {
  border-bottom: none;
}

.custom-request-summary > div:hover {
  background: var(--background);
  transform: translateY(-2px);
}

.custom-request-summary span {
  display: block;
  margin-bottom: 7px;

  color: var(--muted);

  font-size: 11px;
  font-weight: 700;
  letter-spacing: 1px;
  text-transform: uppercase;
}

.custom-request-summary strong {
  display: block;

  color: var(--text);

  font-size: 15px;
}

/* =========================================
   WHAT HAPPENS NEXT
========================================= */

.custom-confirmation-note {
  margin-bottom: 35px;
  padding: 28px;

  text-align: left;

  background: var(--primary-dark);
  color: var(--white);

  border-left: 4px solid var(--secondary);

  animation: customNoteReveal 0.7s ease 0.65s both;
}

.custom-confirmation-note h2 {
  margin-bottom: 12px;

  color: var(--secondary);

  font-size: 19px;
}

.custom-confirmation-note p {
  color: rgba(255, 255, 255, 0.82);

  font-size: 14px;
  line-height: 1.8;
}

/* =========================================
   ACTION BUTTONS
========================================= */

.custom-confirmation-actions {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12px;

  animation: customActionsReveal 0.7s ease 0.75s both;
}

.custom-confirmation-primary,
.custom-confirmation-secondary,
.custom-confirmation-home {
  width: 100%;
  max-width: 400px;
  padding: 15px 24px;

  display: flex;
  justify-content: center;
  align-items: center;

  font-size: 13px;
  font-weight: 800;
  letter-spacing: 0.5px;

  transition:
    transform 0.25s ease,
    box-shadow 0.25s ease,
    background 0.25s ease;
}

.custom-confirmation-primary {
  background: var(--primary);
  color: var(--white);
}

.custom-confirmation-primary:hover {
  background: var(--primary-dark);
  transform: translateY(-3px);
  box-shadow: 0 10px 25px rgba(11, 61, 46, 0.2);
}

.custom-confirmation-secondary {
  background: var(--secondary);
  color: var(--primary-dark);
}

.custom-confirmation-secondary:hover {
  transform: translateY(-3px);
  box-shadow: 0 10px 25px rgba(201, 162, 39, 0.2);
}

.custom-confirmation-home {
  color: var(--primary);
  background: transparent;
}

.custom-confirmation-home:hover {
  transform: translateY(-2px);
}

/* =========================================
   NOT FOUND
========================================= */

.custom-confirmation-not-found {
  width: 100%;
  max-width: 600px;
  padding: 60px 40px;

  background: var(--white);
  border: 1px solid var(--border);

  text-align: center;

  box-shadow: 0 20px 60px rgba(16, 37, 29, 0.08);

  animation: customConfirmationReveal 0.8s ease forwards;
}

.custom-confirmation-not-found h1 {
  margin-bottom: 15px;

  color: var(--primary-dark);

  font-size: 34px;
}

.custom-confirmation-not-found p:not(.custom-confirmation-label) {
  margin-bottom: 30px;

  color: var(--muted);

  line-height: 1.7;
}

.custom-confirmation-not-found .custom-confirmation-primary {
  margin: 0 auto;
}

/* =========================================
   ANIMATIONS
========================================= */

@keyframes customConfirmationReveal {
  from {
    opacity: 0;
    transform: translateY(35px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes customIconPop {
  0% {
    opacity: 0;
    transform: scale(0.5);
  }

  70% {
    transform: scale(1.08);
  }

  100% {
    opacity: 1;
    transform: scale(1);
  }
}

@keyframes customTitleReveal {
  from {
    opacity: 0;
    transform: translateY(15px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes customMessageReveal {
  from {
    opacity: 0;
    transform: translateY(12px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes customCardReveal {
  from {
    opacity: 0;
    transform: translateY(18px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes customNoteReveal {
  from {
    opacity: 0;
    transform: translateY(18px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes customActionsReveal {
  from {
    opacity: 0;
    transform: translateY(18px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* =========================================
   RESPONSIVE
========================================= */

@media (max-width: 750px) {
  .custom-confirmation {
    padding: 45px 30px;
  }

  .custom-confirmation h1 {
    font-size: 34px;
  }

  .custom-request-summary {
    grid-template-columns: repeat(2, 1fr);
  }

  .custom-request-summary > div:nth-child(3n) {
    border-right: 1px solid var(--border);
  }

  .custom-request-summary > div:nth-child(2n) {
    border-right: none;
  }

  .custom-request-summary > div:nth-child(n + 4) {
    border-bottom: 1px solid var(--border);
  }

  .custom-request-summary > div:nth-child(n + 5) {
    border-bottom: none;
  }
}

@media (max-width: 500px) {
  .custom-confirmation-page {
    padding: 40px 15px;
  }

  .custom-confirmation {
    padding: 35px 20px;
  }

  .custom-confirmation-icon {
    width: 65px;
    height: 65px;

    font-size: 28px;
  }

  .custom-confirmation h1 {
    font-size: 29px;
  }

  .custom-confirmation-message {
    font-size: 14px;
  }

  .custom-request-summary {
    grid-template-columns: 1fr;
  }

  .custom-request-summary > div,
  .custom-request-summary > div:nth-child(2n),
  .custom-request-summary > div:nth-child(3n) {
    border-right: none;
    border-bottom: 1px solid var(--border);
  }

  .custom-request-summary > div:last-child {
    border-bottom: none;
  }

  .custom-confirmation-note {
    padding: 22px;
  }
}

/* =========================================================
   MY CUSTOM ORDERS
========================================================= */

.my-custom-orders-page {
  min-height: 100vh;
  padding: 90px 6% 100px;
  background: var(--background);
}

/* =========================================================
   HEADER
========================================================= */

.my-custom-orders-header {
  max-width: 850px;
  margin: 0 auto 55px;
  text-align: center;
  animation: customOrdersHeaderReveal 0.8s ease forwards;
}

.custom-orders-label {
  margin-bottom: 12px;
  color: var(--secondary);
  font-size: 12px;
  font-weight: 800;
  letter-spacing: 3px;
}

.my-custom-orders-header h1 {
  margin-bottom: 14px;
  color: var(--primary-dark);
  font-size: 48px;
  line-height: 1.15;
}

.my-custom-orders-header span {
  color: var(--muted);
  font-size: 15px;
  line-height: 1.7;
}

/* =========================================================
   CUSTOM ORDERS CONTAINER
========================================================= */

.custom-orders-container {
  max-width: 1050px;
  margin: 0 auto;
  display: flex;
  flex-direction: column;
  gap: 24px;
}

/* =========================================================
   CUSTOM ORDER CARD
========================================================= */

.custom-order-card {
  background: var(--white);
  border: 1px solid var(--border);
  box-shadow: 0 15px 40px rgba(16, 37, 29, 0.06);
  animation: customOrderCardReveal 0.7s ease forwards;
  transition:
    transform 0.3s ease,
    box-shadow 0.3s ease;
}

.custom-order-card:hover {
  transform: translateY(-5px);
  box-shadow: 0 22px 50px rgba(16, 37, 29, 0.11);
}

/* =========================================================
   CARD TOP
========================================================= */

.custom-order-card-top {
  padding: 25px 28px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20px;
  background: var(--primary-dark);
}

.custom-order-card-top span,
.custom-order-status span {
  display: block;
  margin-bottom: 7px;
  color: rgba(255, 255, 255, 0.6);
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 1.5px;
}

.custom-order-card-top h2 {
  color: var(--white);
  font-size: 18px;
  letter-spacing: 0.5px;
}

/* =========================================================
   STATUS
========================================================= */

.custom-order-status {
  text-align: right;
}

.custom-order-status strong {
  display: inline-block;
  padding: 7px 12px;
  background: rgba(201, 162, 39, 0.14);
  border: 1px solid rgba(201, 162, 39, 0.35);
  color: var(--secondary);
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 0.5px;
}

/* =========================================================
   CARD INFORMATION
========================================================= */

.custom-order-card-info {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  border-bottom: 1px solid var(--border);
}

.custom-order-card-info > div {
  padding: 22px 25px;
  border-right: 1px solid var(--border);
  border-bottom: 1px solid var(--border);
  transition: background 0.25s ease;
}

.custom-order-card-info > div:nth-child(3n) {
  border-right: none;
}

.custom-order-card-info > div:nth-child(n + 4) {
  border-bottom: none;
}

.custom-order-card-info > div:hover {
  background: var(--background);
}

.custom-order-card-info span {
  display: block;
  margin-bottom: 8px;
  color: var(--muted);
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 1.2px;
  text-transform: uppercase;
}

.custom-order-card-info strong {
  display: block;
  color: var(--text);
  font-size: 14px;
  line-height: 1.4;
}

/* =========================================================
   ACTIONS
========================================================= */

.custom-order-card-actions {
  padding: 20px 25px;
  display: flex;
  justify-content: flex-end;
  align-items: center;
  gap: 12px;
}

.view-custom-order-button,
.new-custom-order-button {
  display: inline-flex;
  justify-content: center;
  align-items: center;
  padding: 13px 20px;
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 0.7px;
  transition:
    transform 0.25s ease,
    background 0.25s ease,
    box-shadow 0.25s ease;
}

.view-custom-order-button {
  background: var(--primary);
  color: var(--white);
}

.view-custom-order-button:hover {
  background: var(--primary-dark);
  transform: translateY(-2px);
  box-shadow: 0 8px 20px rgba(11, 61, 46, 0.18);
}

.new-custom-order-button {
  background: var(--background);
  border: 1px solid var(--border);
  color: var(--primary);
}

.new-custom-order-button:hover {
  background: var(--secondary);
  border-color: var(--secondary);
  color: var(--primary-dark);
  transform: translateY(-2px);
}

/* =========================================================
   EMPTY STATE
========================================================= */

.empty-custom-orders {
  max-width: 650px;
  margin: 80px auto;
  padding: 65px 40px;
  background: var(--white);
  border: 1px solid var(--border);
  text-align: center;
  box-shadow: 0 20px 50px rgba(16, 37, 29, 0.07);
  animation: customEmptyReveal 0.8s ease forwards;
}

.empty-custom-orders h1 {
  margin-bottom: 15px;
  color: var(--primary-dark);
  font-size: 38px;
}

.empty-custom-orders > p:not(.custom-orders-label) {
  max-width: 500px;
  margin: 0 auto 30px;
  color: var(--muted);
  font-size: 15px;
  line-height: 1.8;
}

.custom-orders-create-button {
  display: inline-flex;
  justify-content: center;
  align-items: center;
  padding: 15px 25px;
  background: var(--primary);
  color: var(--white);
  font-size: 12px;
  font-weight: 800;
  letter-spacing: 0.8px;
  transition:
    transform 0.25s ease,
    background 0.25s ease,
    box-shadow 0.25s ease;
}

.custom-orders-create-button:hover {
  background: var(--primary-dark);
  transform: translateY(-3px);
  box-shadow: 0 10px 25px rgba(11, 61, 46, 0.2);
}

/* =========================================================
   ANIMATIONS
========================================================= */

@keyframes customOrdersHeaderReveal {
  from {
    opacity: 0;
    transform: translateY(-25px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes customOrderCardReveal {
  from {
    opacity: 0;
    transform: translateY(25px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes customEmptyReveal {
  from {
    opacity: 0;
    transform: scale(0.97) translateY(20px);
  }

  to {
    opacity: 1;
    transform: scale(1) translateY(0);
  }
}

/* =========================================================
   TABLET
========================================================= */

@media (max-width: 800px) {
  .my-custom-orders-page {
    padding: 70px 5% 80px;
  }

  .my-custom-orders-header h1 {
    font-size: 42px;
  }

  .custom-order-card-info {
    grid-template-columns: repeat(2, 1fr);
  }

  .custom-order-card-info > div:nth-child(3n) {
    border-right: 1px solid var(--border);
  }

  .custom-order-card-info > div:nth-child(2n) {
    border-right: none;
  }

  .custom-order-card-info > div:nth-child(n + 4) {
    border-bottom: 1px solid var(--border);
  }

  .custom-order-card-info > div:nth-child(n + 5) {
    border-bottom: none;
  }
}

/* =========================================================
   MOBILE
========================================================= */

@media (max-width: 600px) {
  .my-custom-orders-page {
    padding: 60px 20px 70px;
  }

  .my-custom-orders-header {
    margin-bottom: 40px;
  }

  .my-custom-orders-header h1 {
    font-size: 35px;
  }

  .my-custom-orders-header span {
    font-size: 14px;
  }

  .custom-order-card-top {
    padding: 22px 20px;
    align-items: flex-start;
    flex-direction: column;
  }

  .custom-order-status {
    text-align: left;
  }

  .custom-order-card-info {
    grid-template-columns: 1fr;
  }

  .custom-order-card-info > div,
  .custom-order-card-info > div:nth-child(2n),
  .custom-order-card-info > div:nth-child(3n) {
    border-right: none;
    border-bottom: 1px solid var(--border);
  }

  .custom-order-card-info > div:last-child {
    border-bottom: none;
  }

  .custom-order-card-actions {
    padding: 18px 20px;
    flex-direction: column;
  }

  .view-custom-order-button,
  .new-custom-order-button {
    width: 100%;
  }

  .empty-custom-orders {
    margin: 50px auto;
    padding: 45px 25px;
  }

  .empty-custom-orders h1 {
    font-size: 31px;
  }
}

/* =========================================================
   SMALL PHONES
========================================================= */

@media (max-width: 420px) {
  .my-custom-orders-page {
    padding-left: 15px;
    padding-right: 15px;
  }

  .my-custom-orders-header h1 {
    font-size: 31px;
  }

  .custom-order-card-top h2 {
    font-size: 15px;
    word-break: break-word;
  }

  .empty-custom-orders {
    padding: 40px 20px;
  }
}
,
/* =========================================================
   CONTACT PAGE
   ========================================================= */

.contact-page {
  min-height: 100vh;
  padding: 90px 6% 100px;
  background: var(--background);
}

/* =========================
   HEADER
   ========================= */

.contact-header {
  max-width: 850px;
  margin: 0 auto 60px;
  text-align: center;
  animation: contactHeaderReveal 0.8s ease forwards;
}

.contact-label {
  margin-bottom: 12px;
  color: var(--secondary);
  font-size: 12px;
  font-weight: 800;
  letter-spacing: 3px;
}

.contact-header h1 {
  margin-bottom: 14px;
  color: var(--primary-dark);
  font-size: 48px;
  line-height: 1.15;
}

.contact-header span {
  display: block;
  color: var(--muted);
  font-size: 15px;
  line-height: 1.8;
}

/* =========================
   MAIN CONTENT
   ========================= */

.contact-content {
  max-width: 1100px;
  margin: 0 auto;

  display: grid;
  grid-template-columns: 0.9fr 1.1fr;

  gap: 35px;
  align-items: start;
}

/* =========================
   CONTACT INFORMATION
   ========================= */

.contact-information {
  display: flex;
  flex-direction: column;
  gap: 16px;

  animation: contactInfoReveal 0.8s ease 0.15s both;
}

.contact-info-card {
  padding: 35px;

  background: var(--primary-dark);
  box-shadow: 0 20px 50px rgba(16, 37, 29, 0.12);
}

.contact-info-card p {
  margin-bottom: 12px;

  color: var(--secondary);
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 2px;
}

.contact-info-card h2 {
  margin-bottom: 15px;

  color: var(--white);
  font-size: 29px;
  line-height: 1.25;
}

.contact-info-card span {
  display: block;

  color: rgba(255, 255, 255, 0.68);
  font-size: 14px;
  line-height: 1.8;
}

/* =========================
   CONTACT DETAILS
   ========================= */

.contact-detail {
  padding: 24px 25px;

  background: var(--white);
  border: 1px solid var(--border);

  box-shadow: 0 10px 30px rgba(16, 37, 29, 0.04);

  transition:
    transform 0.3s ease,
    box-shadow 0.3s ease,
    border-color 0.3s ease;
}

.contact-detail:hover {
  transform: translateY(-4px);

  border-color: rgba(201, 162, 39, 0.5);

  box-shadow: 0 18px 40px rgba(16, 37, 29, 0.09);
}

.contact-detail span {
  display: block;

  margin-bottom: 9px;

  color: var(--secondary);

  font-size: 10px;
  font-weight: 800;
  letter-spacing: 1.7px;
}

.contact-detail strong {
  display: block;

  margin-bottom: 4px;

  color: var(--text);

  font-size: 14px;
  line-height: 1.6;
}

/* =========================
   SERVICES
   ========================= */

.contact-services {
  padding: 25px;

  background: var(--white);
  border: 1px solid var(--border);

  box-shadow: 0 10px 30px rgba(16, 37, 29, 0.04);
}

.contact-services > span {
  display: block;

  margin-bottom: 15px;

  color: var(--secondary);

  font-size: 10px;
  font-weight: 800;
  letter-spacing: 1.7px;
}

.contact-services > div {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

.contact-services strong {
  padding: 8px 12px;

  background: var(--background);
  border: 1px solid var(--border);

  color: var(--primary);

  font-size: 11px;
  font-weight: 700;

  transition:
    background 0.25s ease,
    color 0.25s ease,
    transform 0.25s ease;
}

.contact-services strong:hover {
  background: var(--secondary);
  color: var(--primary-dark);

  transform: translateY(-2px);
}

/* =========================
   CONTACT FORM CARD
   ========================= */

.contact-form-card {
  padding: 38px;

  background: var(--white);
  border: 1px solid var(--border);

  box-shadow: 0 20px 50px rgba(16, 37, 29, 0.07);

  animation: contactFormReveal 0.8s ease 0.25s both;
}

.contact-form-header {
  margin-bottom: 30px;
}

.contact-form-header p {
  margin-bottom: 9px;

  color: var(--secondary);

  font-size: 10px;
  font-weight: 800;
  letter-spacing: 2px;
}

.contact-form-header h2 {
  color: var(--primary-dark);

  font-size: 28px;
}

/* =========================
   FORM
   ========================= */

.contact-form-card form {
  display: flex;
  flex-direction: column;
  gap: 20px;
}

.contact-form-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18px;
}

.contact-form-group {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.contact-form-group label {
  color: var(--text);

  font-size: 11px;
  font-weight: 800;
  letter-spacing: 0.5px;
}

.contact-form-group input,
.contact-form-group select,
.contact-form-group textarea {
  width: 100%;

  padding: 14px 15px;

  background: var(--background);

  border: 1px solid var(--border);

  outline: none;

  color: var(--text);

  font-family: inherit;
  font-size: 14px;

  transition:
    border-color 0.25s ease,
    background 0.25s ease,
    box-shadow 0.25s ease,
    transform 0.25s ease;
}

.contact-form-group textarea {
  min-height: 145px;

  resize: vertical;
  line-height: 1.6;
}

.contact-form-group input::placeholder,
.contact-form-group textarea::placeholder {
  color: #9aa39e;
}

.contact-form-group input:hover,
.contact-form-group select:hover,
.contact-form-group textarea:hover {
  border-color: rgba(11, 61, 46, 0.35);
}

.contact-form-group input:focus,
.contact-form-group select:focus,
.contact-form-group textarea:focus {
  background: var(--white);

  border-color: var(--primary);

  box-shadow: 0 0 0 3px rgba(11, 61, 46, 0.08);
}

/* =========================
   SUBMIT BUTTON
   ========================= */

.contact-submit-button {
  width: 100%;

  padding: 16px 25px;

  background: var(--primary);
  color: var(--white);

  border: none;

  font-family: inherit;

  font-size: 11px;
  font-weight: 800;
  letter-spacing: 1px;

  cursor: pointer;

  transition:
    background 0.3s ease,
    transform 0.3s ease,
    box-shadow 0.3s ease;
}

.contact-submit-button:hover {
  background: var(--primary-dark);

  transform: translateY(-3px);

  box-shadow: 0 12px 25px rgba(11, 61, 46, 0.2);
}

.contact-submit-button:active {
  transform: translateY(-1px);
}

/* =========================
   SUCCESS MESSAGE
   ========================= */

.contact-success-message {
  display: flex;
  flex-direction: column;
  gap: 5px;

  padding: 18px 20px;

  background: rgba(11, 61, 46, 0.06);

  border-left: 3px solid var(--secondary);

  animation: contactSuccessReveal 0.5s ease forwards;
}

.contact-success-message strong {
  color: var(--primary);

  font-size: 13px;
}

.contact-success-message span {
  color: var(--muted);

  font-size: 13px;
  line-height: 1.6;
}

/* =========================
   ANIMATIONS
   ========================= */

@keyframes contactHeaderReveal {
  from {
    opacity: 0;
    transform: translateY(-25px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes contactInfoReveal {
  from {
    opacity: 0;
    transform: translateX(-30px);
  }

  to {
    opacity: 1;
    transform: translateX(0);
  }
}

@keyframes contactFormReveal {
  from {
    opacity: 0;
    transform: translateX(30px);
  }

  to {
    opacity: 1;
    transform: translateX(0);
  }
}

@keyframes contactSuccessReveal {
  from {
    opacity: 0;
    transform: translateY(10px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* =========================
   TABLET
   ========================= */

@media (max-width: 900px) {
  .contact-page {
    padding: 75px 5% 85px;
  }

  .contact-content {
    grid-template-columns: 1fr;
  }

  .contact-information {
    display: grid;
    grid-template-columns: 1fr 1fr;
  }

  .contact-info-card {
    grid-column: 1 / -1;
  }

  .contact-services {
    grid-column: 1 / -1;
  }
}

/* =========================
   MOBILE
   ========================= */

@media (max-width: 650px) {
  .contact-page {
    padding: 60px 20px 70px;
  }

  .contact-header {
    margin-bottom: 40px;
  }

  .contact-header h1 {
    font-size: 36px;
  }

  .contact-header span {
    font-size: 14px;
  }

  .contact-information {
    display: flex;
  }

  .contact-info-card {
    padding: 28px 24px;
  }

  .contact-info-card h2 {
    font-size: 25px;
  }

  .contact-form-card {
    padding: 28px 22px;
  }

  .contact-form-header h2 {
    font-size: 25px;
  }

  .contact-form-row {
    grid-template-columns: 1fr;
    gap: 20px;
  }
}

/* =========================
   SMALL PHONES
   ========================= */

@media (max-width: 420px) {
  .contact-page {
    padding-left: 15px;
    padding-right: 15px;
  }

  .contact-header h1 {
    font-size: 31px;
  }

  .contact-info-card {
    padding: 25px 20px;
  }

  .contact-form-card {
    padding: 24px 18px;
  }

  .contact-detail,
  .contact-services {
    padding: 20px;
  }

  .contact-services > div {
    flex-direction: column;
  }

  .contact-services strong {
    width: 100%;
  }
}

/* =========================================================
   ABOUT PAGE
   ========================================================= */

.about-page {
  min-height: 100vh;
  background: var(--background);
  overflow: hidden;
}

/* =========================
   ABOUT HERO
   ========================= */

.about-hero {
  position: relative;

  padding: 120px 6% 110px;

  background:
    radial-gradient(
      circle at 80% 20%,
      rgba(201, 162, 39, 0.12),
      transparent 32%
    ),
    var(--primary-dark);

  text-align: center;

  animation: aboutHeroReveal 0.9s ease forwards;
}

.about-hero::before {
  content: "";

  position: absolute;
  width: 260px;
  height: 260px;

  top: -120px;
  left: -100px;

  border: 1px solid rgba(201, 162, 39, 0.16);
  border-radius: 50%;

  animation: aboutCircleFloat 8s ease-in-out infinite;
}

.about-hero::after {
  content: "";

  position: absolute;
  width: 180px;
  height: 180px;

  right: -70px;
  bottom: -90px;

  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 50%;

  animation: aboutCircleFloat 7s ease-in-out infinite reverse;
}

.about-label {
  position: relative;
  z-index: 1;

  margin-bottom: 18px;

  color: var(--secondary);

  font-size: 12px;
  font-weight: 800;
  letter-spacing: 4px;

  animation: aboutLabelReveal 0.7s ease 0.1s both;
}

.about-hero h1 {
  position: relative;
  z-index: 1;

  max-width: 900px;
  margin: 0 auto 22px;

  color: var(--white);

  font-size: clamp(42px, 6vw, 72px);
  line-height: 1.08;
  letter-spacing: -1.5px;

  animation: aboutTitleReveal 0.8s ease 0.2s both;
}

.about-hero-text {
  position: relative;
  z-index: 1;

  max-width: 700px;
  margin: 0 auto;

  color: rgba(255, 255, 255, 0.68);

  font-size: 16px;
  line-height: 1.9;

  animation: aboutTextReveal 0.8s ease 0.35s both;
}

/* =========================
   STORY
   ========================= */

.about-story {
  max-width: 1100px;

  margin: 0 auto;

  padding: 100px 6%;

  display: grid;
  grid-template-columns: 1.2fr 0.8fr;

  gap: 70px;

  align-items: center;
}

.about-story-content {
  animation: aboutStoryLeftReveal 0.8s ease 0.1s both;
}

.about-section-label {
  margin-bottom: 12px;

  color: var(--secondary);

  font-size: 10px;
  font-weight: 800;
  letter-spacing: 2.5px;
}

.about-story-content h2 {
  margin-bottom: 25px;

  color: var(--primary-dark);

  font-size: 40px;
  line-height: 1.2;
}

.about-story-content p:not(.about-section-label) {
  margin-bottom: 17px;

  color: var(--muted);

  font-size: 15px;
  line-height: 1.9;
}

/* =========================
   STORY CARD
   ========================= */

.about-story-card {
  position: relative;

  min-height: 330px;

  padding: 45px 38px;

  display: flex;
  flex-direction: column;
  justify-content: center;

  background: var(--primary-dark);

  box-shadow: 0 25px 60px rgba(16, 37, 29, 0.14);

  overflow: hidden;

  animation: aboutStoryRightReveal 0.8s ease 0.25s both;
}

.about-story-card::before {
  content: "";

  position: absolute;

  width: 210px;
  height: 210px;

  right: -90px;
  top: -90px;

  border: 1px solid rgba(201, 162, 39, 0.2);
  border-radius: 50%;
}

.about-story-card::after {
  content: "";

  position: absolute;

  width: 120px;
  height: 120px;

  left: -60px;
  bottom: -60px;

  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 50%;
}

.about-story-card span {
  position: relative;
  z-index: 1;

  margin-bottom: 15px;

  color: var(--secondary);

  font-size: 11px;
  font-weight: 800;
  letter-spacing: 3px;
}

.about-story-card h3 {
  position: relative;
  z-index: 1;

  margin-bottom: 18px;

  color: var(--white);

  font-size: 32px;
  line-height: 1.2;
}

.about-story-card p {
  position: relative;
  z-index: 1;

  color: rgba(255, 255, 255, 0.65);

  font-size: 14px;
  line-height: 1.8;
}

/* =========================
   SERVICES
   ========================= */

.about-services {
  padding: 100px 6% 110px;

  background: var(--white);

  border-top: 1px solid var(--border);
  border-bottom: 1px solid var(--border);
}

.about-services-header {
  max-width: 700px;

  margin: 0 auto 55px;

  text-align: center;

  animation: aboutServicesHeaderReveal 0.8s ease both;
}

.about-services-header h2 {
  margin-bottom: 12px;

  color: var(--primary-dark);

  font-size: 42px;
  line-height: 1.2;
}

.about-services-header > span {
  color: var(--muted);

  font-size: 15px;
  line-height: 1.7;
}

/* =========================
   SERVICE GRID
   ========================= */

.about-service-grid {
  max-width: 1100px;

  margin: 0 auto;

  display: grid;
  grid-template-columns: repeat(3, 1fr);

  gap: 18px;
}

.about-service-card {
  position: relative;

  min-height: 235px;

  padding: 30px;

  background: var(--background);

  border: 1px solid var(--border);

  overflow: hidden;

  transition:
    transform 0.35s ease,
    box-shadow 0.35s ease,
    border-color 0.35s ease,
    background 0.35s ease;

  animation: aboutServiceReveal 0.7s ease both;
}

.about-service-card:nth-child(1) {
  animation-delay: 0.05s;
}

.about-service-card:nth-child(2) {
  animation-delay: 0.1s;
}

.about-service-card:nth-child(3) {
  animation-delay: 0.15s;
}

.about-service-card:nth-child(4) {
  animation-delay: 0.2s;
}

.about-service-card:nth-child(5) {
  animation-delay: 0.25s;
}

.about-service-card:nth-child(6) {
  animation-delay: 0.3s;
}

.about-service-card::after {
  content: "";

  position: absolute;

  width: 70px;
  height: 3px;

  left: 30px;
  bottom: 0;

  background: var(--secondary);

  transform: scaleX(0);
  transform-origin: left;

  transition: transform 0.35s ease;
}

.about-service-card:hover {
  transform: translateY(-7px);

  background: var(--white);

  border-color: rgba(201, 162, 39, 0.4);

  box-shadow: 0 20px 45px rgba(16, 37, 29, 0.09);
}

.about-service-card:hover::after {
  transform: scaleX(1);
}

.about-service-card > span {
  display: inline-flex;

  margin-bottom: 20px;

  color: var(--secondary);

  font-size: 12px;
  font-weight: 800;
  letter-spacing: 1px;
}

.about-service-card h3 {
  margin-bottom: 12px;

  color: var(--primary-dark);

  font-size: 21px;
}

.about-service-card p {
  color: var(--muted);

  font-size: 13px;
  line-height: 1.8;
}

/* =========================
   CTA
   ========================= */

.about-cta {
  max-width: 850px;

  margin: 0 auto;

  padding: 110px 6%;

  text-align: center;

  animation: aboutCtaReveal 0.8s ease both;
}

.about-cta h2 {
  margin-bottom: 15px;

  color: var(--primary-dark);

  font-size: 42px;
  line-height: 1.2;
}

.about-cta > p:not(.about-section-label) {
  max-width: 600px;

  margin: 0 auto 30px;

  color: var(--muted);

  font-size: 15px;
  line-height: 1.8;
}

.about-cta-actions {
  display: flex;

  justify-content: center;

  gap: 12px;

  flex-wrap: wrap;
}

.about-cta-actions a {
  display: inline-flex;

  align-items: center;
  justify-content: center;

  min-width: 190px;

  padding: 15px 22px;

  font-size: 11px;
  font-weight: 800;
  letter-spacing: 0.8px;

  transition:
    transform 0.3s ease,
    background 0.3s ease,
    color 0.3s ease,
    box-shadow 0.3s ease;
}

.about-cta-actions a:first-child {
  background: var(--primary);
  color: var(--white);
}

.about-cta-actions a:first-child:hover {
  background: var(--primary-dark);

  transform: translateY(-3px);

  box-shadow: 0 12px 25px rgba(11, 61, 46, 0.2);
}

.about-cta-actions a:last-child {
  background: var(--background);

  border: 1px solid var(--border);

  color: var(--primary);
}

.about-cta-actions a:last-child:hover {
  background: var(--secondary);

  border-color: var(--secondary);

  color: var(--primary-dark);

  transform: translateY(-3px);
}

/* =========================
   ANIMATIONS
   ========================= */

@keyframes aboutHeroReveal {
  from {
    opacity: 0;
    transform: translateY(-20px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes aboutLabelReveal {
  from {
    opacity: 0;
    transform: translateY(-12px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes aboutTitleReveal {
  from {
    opacity: 0;
    transform: translateY(25px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes aboutTextReveal {
  from {
    opacity: 0;
    transform: translateY(18px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes aboutStoryLeftReveal {
  from {
    opacity: 0;
    transform: translateX(-30px);
  }

  to {
    opacity: 1;
    transform: translateX(0);
  }
}

@keyframes aboutStoryRightReveal {
  from {
    opacity: 0;
    transform: translateX(30px);
  }

  to {
    opacity: 1;
    transform: translateX(0);
  }
}

@keyframes aboutServicesHeaderReveal {
  from {
    opacity: 0;
    transform: translateY(25px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes aboutServiceReveal {
  from {
    opacity: 0;
    transform: translateY(25px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes aboutCtaReveal {
  from {
    opacity: 0;
    transform: translateY(25px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes aboutCircleFloat {
  0%,
  100% {
    transform: translate(0, 0);
  }

  50% {
    transform: translate(15px, 12px);
  }
}

/* =========================
   TABLET
   ========================= */

@media (max-width: 900px) {
  .about-hero {
    padding: 95px 5% 90px;
  }

  .about-story {
    padding: 80px 5%;
    grid-template-columns: 1fr;

    gap: 45px;
  }

  .about-story-card {
    min-height: 280px;
  }

  .about-services {
    padding: 80px 5% 90px;
  }

  .about-service-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .about-cta {
    padding: 85px 5%;
  }
}

/* =========================
   MOBILE
   ========================= */

@media (max-width: 650px) {
  .about-hero {
    padding: 75px 20px 80px;
  }

  .about-hero h1 {
    font-size: 40px;
    letter-spacing: -0.8px;
  }

  .about-hero-text {
    font-size: 14px;
  }

  .about-story {
    padding: 70px 20px;
    gap: 35px;
  }

  .about-story-content h2 {
    font-size: 32px;
  }

  .about-story-content p:not(.about-section-label) {
    font-size: 14px;
  }

  .about-story-card {
    min-height: 260px;

    padding: 35px 28px;
  }

  .about-story-card h3 {
    font-size: 28px;
  }

  .about-services {
    padding: 70px 20px 80px;
  }

  .about-services-header {
    margin-bottom: 40px;
  }

  .about-services-header h2 {
    font-size: 34px;
  }

  .about-service-grid {
    grid-template-columns: 1fr;
  }

  .about-service-card {
    min-height: auto;
  }

  .about-cta {
    padding: 75px 20px;
  }

  .about-cta h2 {
    font-size: 34px;
  }

  .about-cta-actions {
    flex-direction: column;
  }

  .about-cta-actions a {
    width: 100%;
  }
}

/* =========================
   SMALL PHONES
   ========================= */

@media (max-width: 420px) {
  .about-hero {
    padding-left: 15px;
    padding-right: 15px;
  }

  .about-hero h1 {
    font-size: 34px;
  }

  .about-story {
    padding-left: 15px;
    padding-right: 15px;
  }

  .about-story-content h2 {
    font-size: 29px;
  }

  .about-services {
    padding-left: 15px;
    padding-right: 15px;
  }

  .about-services-header h2 {
    font-size: 30px;
  }

  .about-cta {
    padding-left: 15px;
    padding-right: 15px;
  }

  .about-cta h2 {
    font-size: 30px;
  }
}

```css
/* =========================================================
   CART PAGE
   ========================================================= */

.cart-page {
  min-height: 100vh;
  padding: 70px 6%;
  background: var(--background);
  animation: cartPageEnter 0.6s ease;
}

/* =========================================================
   CART HEADER
   ========================================================= */

.cart-header {
  max-width: 1400px;
  margin: 0 auto 45px;

  display: flex;
  align-items: flex-end;
  justify-content: space-between;

  gap: 30px;
}

.cart-label {
  margin: 0 0 10px;

  font-size: 12px;
  font-weight: 700;

  letter-spacing: 2.5px;

  color: var(--secondary);
}

.cart-header h1 {
  margin: 0 0 10px;

  font-size: clamp(38px, 5vw, 64px);
  line-height: 1.05;

  color: var(--text);
}

.cart-header > div:first-child > span {
  color: var(--muted);
  font-size: 16px;
}

/* =========================================================
   CART ITEM COUNT
   ========================================================= */

.cart-item-count {
  min-width: 100px;

  display: flex;
  flex-direction: column;

  align-items: center;
  justify-content: center;

  padding: 18px 24px;

  border: 1px solid var(--border);
  border-radius: 14px;

  background: var(--white);

  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.04);
}

.cart-item-count strong {
  font-size: 28px;
  color: var(--primary);
}

.cart-item-count span {
  margin-top: 3px;

  font-size: 12px;
  color: var(--muted);

  text-transform: uppercase;
  letter-spacing: 1px;
}

/* =========================================================
   CART CONTENT
   ========================================================= */

.cart-content {
  max-width: 1400px;
  margin: 0 auto;

  display: grid;
  grid-template-columns: minmax(0, 1fr) 360px;

  gap: 30px;

  align-items: start;
}

/* =========================================================
   CART ITEMS
   ========================================================= */

.cart-items {
  display: flex;
  flex-direction: column;

  gap: 18px;
}

.cart-item {
  position: relative;

  display: grid;

  grid-template-columns:
    120px
    minmax(180px, 1fr)
    130px
    140px
    30px;

  align-items: center;

  gap: 24px;

  padding: 20px;

  background: var(--white);

  border: 1px solid var(--border);
  border-radius: 18px;

  box-shadow: 0 10px 35px rgba(0, 0, 0, 0.04);

  transition:
    transform 0.3s ease,
    box-shadow 0.3s ease,
    border-color 0.3s ease;

  animation: cartItemEnter 0.5s ease both;
}

.cart-item:hover {
  transform: translateY(-3px);

  border-color: rgba(201, 162, 39, 0.5);

  box-shadow: 0 18px 45px rgba(0, 0, 0, 0.08);
}

/* =========================================================
   PRODUCT IMAGE
   ========================================================= */

.cart-item-image {
  width: 120px;
  height: 135px;

  overflow: hidden;

  border-radius: 12px;

  background: var(--background);
}

.cart-item-image img {
  width: 100%;
  height: 100%;

  display: block;

  object-fit: cover;

  transition: transform 0.5s ease;
}

.cart-item:hover .cart-item-image img {
  transform: scale(1.06);
}

/* =========================================================
   PRODUCT INFO
   ========================================================= */

.cart-item-info {
  min-width: 0;
}

.cart-item-category {
  margin: 0 0 7px;

  font-size: 11px;
  font-weight: 700;

  text-transform: uppercase;
  letter-spacing: 1.5px;

  color: var(--secondary);
}

.cart-item-info h2 {
  margin: 0 0 9px;

  font-size: 20px;
  line-height: 1.3;

  color: var(--text);
}

.cart-item-price {
  margin: 0;

  font-size: 14px;
  font-weight: 600;

  color: var(--muted);
}

/* =========================================================
   QUANTITY
   ========================================================= */

.cart-item-quantity > span,
.cart-item-total > span {
  display: block;

  margin-bottom: 9px;

  font-size: 10px;
  font-weight: 700;

  letter-spacing: 1.3px;
  text-transform: uppercase;

  color: var(--muted);
}

.quantity-control {
  display: inline-flex;
  align-items: center;

  overflow: hidden;

  border: 1px solid var(--border);
  border-radius: 9px;

  background: var(--background);
}

.quantity-control button {
  width: 36px;
  height: 36px;

  display: flex;
  align-items: center;
  justify-content: center;

  border: none;
  background: transparent;

  color: var(--text);

  font-size: 19px;

  cursor: pointer;

  transition:
    background 0.2s ease,
    color 0.2s ease;
}

.quantity-control button:hover {
  background: var(--primary);
  color: var(--white);
}

.quantity-control strong {
  min-width: 35px;

  text-align: center;

  font-size: 14px;

  color: var(--text);
}

/* =========================================================
   ITEM TOTAL
   ========================================================= */

.cart-item-total strong {
  display: block;

  font-size: 17px;

  color: var(--primary);
}

/* =========================================================
   REMOVE BUTTON
   ========================================================= */

.cart-remove-button {
  width: 30px;
  height: 30px;

  display: flex;
  align-items: center;
  justify-content: center;

  border: none;
  border-radius: 50%;

  background: transparent;

  color: var(--muted);

  font-size: 25px;
  line-height: 1;

  cursor: pointer;

  transition:
    background 0.2s ease,
    color 0.2s ease,
    transform 0.2s ease;
}

.cart-remove-button:hover {
  background: #f3e6e4;
  color: #a43d32;

  transform: rotate(90deg);
}

/* =========================================================
   CART SUMMARY
   ========================================================= */

.cart-summary {
  position: sticky;
  top: 25px;

  padding: 30px;

  background: var(--white);

  border: 1px solid var(--border);
  border-radius: 20px;

  box-shadow: 0 15px 45px rgba(0, 0, 0, 0.06);
}

.cart-summary-header {
  margin-bottom: 25px;
}

.cart-summary-header p {
  margin: 0 0 7px;

  font-size: 10px;
  font-weight: 700;

  letter-spacing: 2px;

  color: var(--secondary);
}

.cart-summary-header h2 {
  margin: 0;

  font-size: 25px;

  color: var(--text);
}

/* =========================================================
   SUMMARY ROWS
   ========================================================= */

.cart-summary-row {
  display: flex;
  align-items: center;
  justify-content: space-between;

  padding: 11px 0;
}

.cart-summary-row span {
  color: var(--muted);
  font-size: 14px;
}

.cart-summary-row strong {
  color: var(--text);
  font-size: 14px;
}

.cart-summary-divider {
  height: 1px;

  margin: 12px 0;

  background: var(--border);
}

/* =========================================================
   SUMMARY TOTAL
   ========================================================= */

.cart-summary-total {
  display: flex;
  align-items: center;
  justify-content: space-between;

  margin-bottom: 25px;
}

.cart-summary-total span {
  font-size: 16px;
  font-weight: 700;

  color: var(--text);
}

.cart-summary-total strong {
  font-size: 22px;

  color: var(--primary);
}

/* =========================================================
   CHECKOUT BUTTON
   ========================================================= */

.cart-checkout-button {
  min-height: 52px;

  display: flex;
  align-items: center;
  justify-content: center;

  gap: 15px;

  padding: 0 20px;

  border-radius: 10px;

  background: var(--primary);

  color: var(--white);

  font-size: 12px;
  font-weight: 700;

  letter-spacing: 1.2px;

  text-decoration: none;

  transition:
    transform 0.25s ease,
    background 0.25s ease,
    box-shadow 0.25s ease;
}

.cart-checkout-button:hover {
  transform: translateY(-2px);

  background: var(--primary-dark);

  box-shadow: 0 12px 25px rgba(11, 61, 46, 0.2);
}

.cart-checkout-button span {
  font-size: 18px;

  transition: transform 0.25s ease;
}

.cart-checkout-button:hover span {
  transform: translateX(4px);
}

/* =========================================================
   CONTINUE SHOPPING
   ========================================================= */

.cart-continue-button {
  min-height: 48px;

  display: flex;
  align-items: center;
  justify-content: center;

  margin-top: 10px;

  border: 1px solid var(--border);
  border-radius: 10px;

  color: var(--text);

  font-size: 11px;
  font-weight: 700;

  letter-spacing: 1px;

  text-decoration: none;

  transition:
    border-color 0.25s ease,
    color 0.25s ease,
    background 0.25s ease;
}

.cart-continue-button:hover {
  border-color: var(--primary);

  color: var(--primary);

  background: var(--background);
}

/* =========================================================
   CART SECURITY MESSAGE
   ========================================================= */

.cart-security {
  display: flex;
  align-items: center;

  gap: 9px;

  margin-top: 22px;
  padding-top: 18px;

  border-top: 1px solid var(--border);
}

.cart-security span {
  width: 22px;
  height: 22px;

  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 50%;

  background: var(--background);

  color: var(--primary);

  font-size: 12px;
  font-weight: 700;
}

.cart-security p {
  margin: 0;

  font-size: 11px;
  line-height: 1.5;

  color: var(--muted);
}

/* =========================================================
   EMPTY CART
   ========================================================= */

.cart-empty {
  max-width: 650px;

  min-height: 65vh;

  margin: auto;

  display: flex;
  flex-direction: column;

  align-items: center;
  justify-content: center;

  text-align: center;

  animation: cartPageEnter 0.6s ease;
}

.cart-empty-icon {
  width: 85px;
  height: 85px;

  display: flex;
  align-items: center;
  justify-content: center;

  margin-bottom: 25px;

  border-radius: 50%;

  background: var(--white);

  border: 1px solid var(--border);

  font-size: 34px;

  box-shadow: 0 15px 40px rgba(0, 0, 0, 0.05);
}

.cart-empty h1 {
  margin: 0 0 15px;

  font-size: clamp(34px, 5vw, 50px);

  color: var(--text);
}

.cart-empty-text {
  max-width: 520px;

  margin: 0 0 28px;

  font-size: 15px;
  line-height: 1.7;

  color: var(--muted);
}

.cart-shop-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;

  min-height: 52px;

  padding: 0 28px;

  border-radius: 10px;

  background: var(--primary);

  color: var(--white);

  font-size: 12px;
  font-weight: 700;

  letter-spacing: 1.2px;

  text-decoration: none;

  transition:
    transform 0.25s ease,
    box-shadow 0.25s ease;
}

.cart-shop-button:hover {
  transform: translateY(-3px);

  box-shadow: 0 12px 30px rgba(11, 61, 46, 0.2);
}

/* =========================================================
   ANIMATIONS
   ========================================================= */

@keyframes cartPageEnter {
  from {
    opacity: 0;
    transform: translateY(15px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes cartItemEnter {
  from {
    opacity: 0;
    transform: translateY(12px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* =========================================================
   TABLET
   ========================================================= */

@media (max-width: 1100px) {
  .cart-content {
    grid-template-columns: 1fr;
  }

  .cart-summary {
    position: static;

    max-width: 600px;
    width: 100%;

    margin-left: auto;
  }

  .cart-item {
    grid-template-columns:
      110px
      minmax(180px, 1fr)
      120px
      120px
      30px;
  }

  .cart-item-image {
    width: 110px;
    height: 125px;
  }
}

/* =========================================================
   MOBILE
   ========================================================= */

@media (max-width: 700px) {
  .cart-page {
    padding: 45px 5%;
  }

  .cart-header {
    align-items: flex-start;
    flex-direction: column;

    margin-bottom: 30px;
  }

  .cart-item-count {
    flex-direction: row;

    gap: 8px;

    min-width: auto;

    padding: 10px 15px;
  }

  .cart-item-count strong {
    font-size: 20px;
  }

  .cart-item {
    grid-template-columns: 90px 1fr 30px;

    gap: 15px;

    padding: 15px;
  }

  .cart-item-image {
    width: 90px;
    height: 105px;

    grid-row: span 2;
  }

  .cart-item-info h2 {
    font-size: 17px;
  }

  .cart-item-quantity {
    grid-column: 2;
  }

  .cart-item-total {
    grid-column: 2;
  }

  .cart-remove-button {
    grid-column: 3;
    grid-row: 1;
  }

  .cart-summary {
    padding: 24px;
  }
}

/* =========================================================
   SMALL MOBILE
   ========================================================= */

@media (max-width: 420px) {
  .cart-page {
    padding: 35px 4%;
  }

  .cart-item {
    grid-template-columns: 75px 1fr 25px;

    gap: 12px;
  }

  .cart-item-image {
    width: 75px;
    height: 90px;
  }

  .cart-item-info h2 {
    font-size: 15px;
  }

  .cart-item-price {
    font-size: 12px;
  }

  .quantity-control button {
    width: 31px;
    height: 32px;
  }

  .quantity-control strong {
    min-width: 30px;
  }

  .cart-summary {
    padding: 20px;
  }
}

```css
/* =========================================================
   CHECKOUT PAGE
   ========================================================= */

.checkout-page {
  min-height: 100vh;
  padding: 70px 6%;
  background: var(--background);
  animation: checkoutPageEnter 0.6s ease;
}

/* =========================================================
   CHECKOUT HEADER
   ========================================================= */

.checkout-header {
  max-width: 1400px;
  margin: 0 auto 45px;
}

.checkout-label {
  margin: 0 0 10px;

  color: var(--secondary);

  font-size: 12px;
  font-weight: 700;

  letter-spacing: 2.5px;
}

.checkout-header h1 {
  margin: 0 0 12px;

  color: var(--text);

  font-size: clamp(38px, 5vw, 62px);
  line-height: 1.05;
}

.checkout-header > span {
  color: var(--muted);

  font-size: 16px;
}

/* =========================================================
   CHECKOUT CONTENT
   ========================================================= */

.checkout-content {
  max-width: 1400px;
  margin: 0 auto;

  display: grid;
  grid-template-columns: minmax(0, 1fr) 390px;

  gap: 30px;

  align-items: start;
}

/* =========================================================
   CHECKOUT FORM
   ========================================================= */

.checkout-form {
  display: flex;
  flex-direction: column;

  gap: 22px;
}

/* =========================================================
   CHECKOUT CARD
   ========================================================= */

.checkout-card {
  padding: 30px;

  background: var(--white);

  border: 1px solid var(--border);
  border-radius: 20px;

  box-shadow: 0 12px 40px rgba(0, 0, 0, 0.04);

  animation: checkoutCardEnter 0.5s ease both;
}

.checkout-card:nth-child(2) {
  animation-delay: 0.08s;
}

.checkout-card:nth-child(3) {
  animation-delay: 0.16s;
}

/* =========================================================
   CARD HEADER
   ========================================================= */

.checkout-card-header {
  display: flex;
  align-items: center;

  gap: 16px;

  margin-bottom: 28px;
}

.checkout-step {
  width: 44px;
  height: 44px;

  flex-shrink: 0;

  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 50%;

  background: var(--primary);

  color: var(--white);

  font-size: 12px;
  font-weight: 700;

  letter-spacing: 1px;
}

.checkout-card-header p {
  margin: 0 0 4px;

  color: var(--secondary);

  font-size: 10px;
  font-weight: 700;

  letter-spacing: 1.8px;
}

.checkout-card-header h2 {
  margin: 0;

  color: var(--text);

  font-size: 22px;
}

/* =========================================================
   FORM ROW
   ========================================================= */

.checkout-form-row {
  display: grid;
  grid-template-columns: 1fr 1fr;

  gap: 18px;
}

/* =========================================================
   FORM GROUP
   ========================================================= */

.checkout-form-group {
  display: flex;
  flex-direction: column;

  margin-bottom: 18px;
}

.checkout-form-group:last-child {
  margin-bottom: 0;
}

.checkout-form-group label {
  margin-bottom: 8px;

  color: var(--text);

  font-size: 12px;
  font-weight: 700;

  letter-spacing: 0.3px;
}

.checkout-form-group input,
.checkout-form-group textarea {
  width: 100%;

  box-sizing: border-box;

  padding: 14px 15px;

  border: 1px solid var(--border);
  border-radius: 10px;

  outline: none;

  background: #fff;

  color: var(--text);

  font-family: inherit;
  font-size: 14px;

  transition:
    border-color 0.25s ease,
    box-shadow 0.25s ease,
    background 0.25s ease;
}

.checkout-form-group input {
  min-height: 50px;
}

.checkout-form-group textarea {
  min-height: 125px;

  resize: vertical;

  line-height: 1.6;
}

.checkout-form-group input::placeholder,
.checkout-form-group textarea::placeholder {
  color: #9aa39e;
}

.checkout-form-group input:focus,
.checkout-form-group textarea:focus {
  border-color: var(--primary);

  background: var(--background);

  box-shadow: 0 0 0 3px rgba(11, 61, 46, 0.08);
}

/* =========================================================
   VALIDATION ERROR
   ========================================================= */

.checkout-error {
  margin-top: 6px;

  color: #a43d32;

  font-size: 11px;
  line-height: 1.4;
}

/* =========================================================
   DELIVERY METHODS
   ========================================================= */

.delivery-methods {
  display: grid;

  grid-template-columns: 1fr 1fr;

  gap: 15px;

  margin-bottom: 25px;
}

.delivery-option {
  position: relative;

  display: flex;
  align-items: flex-start;

  gap: 12px;

  padding: 17px;

  border: 1px solid var(--border);
  border-radius: 12px;

  background: var(--white);

  cursor: pointer;

  transition:
    border-color 0.25s ease,
    background 0.25s ease,
    transform 0.25s ease,
    box-shadow 0.25s ease;
}

.delivery-option:hover {
  transform: translateY(-2px);

  border-color: rgba(201, 162, 39, 0.65);

  box-shadow: 0 8px 22px rgba(0, 0, 0, 0.05);
}

.delivery-option.active {
  border-color: var(--primary);

  background: rgba(11, 61, 46, 0.04);

  box-shadow: inset 0 0 0 1px var(--primary);
}

.delivery-option input {
  width: 17px;
  height: 17px;

  margin: 2px 0 0;

  accent-color: var(--primary);

  cursor: pointer;
}

.delivery-option span {
  display: flex;
  flex-direction: column;

  gap: 5px;
}

.delivery-option strong {
  color: var(--text);

  font-size: 14px;
}

.delivery-option small {
  color: var(--muted);

  font-size: 11px;
  line-height: 1.5;
}

/* =========================================================
   SUBMIT BUTTON
   ========================================================= */

.checkout-submit-button {
  width: 100%;
  min-height: 58px;

  display: flex;
  align-items: center;
  justify-content: space-between;

  padding: 0 24px;

  border: none;
  border-radius: 12px;

  background: var(--primary);

  color: var(--white);

  font-family: inherit;

  font-size: 12px;
  font-weight: 700;

  letter-spacing: 1.5px;

  cursor: pointer;

  box-shadow: 0 12px 30px rgba(11, 61, 46, 0.16);

  transition:
    transform 0.25s ease,
    background 0.25s ease,
    box-shadow 0.25s ease;
}

.checkout-submit-button:hover {
  transform: translateY(-3px);

  background: var(--primary-dark);

  box-shadow: 0 18px 35px rgba(11, 61, 46, 0.22);
}

.checkout-submit-button strong {
  font-size: 22px;
  font-weight: 400;

  transition: transform 0.25s ease;
}

.checkout-submit-button:hover strong {
  transform: translateX(6px);
}

/* =========================================================
   ORDER SUMMARY
   ========================================================= */

.checkout-summary {
  position: sticky;
  top: 25px;

  padding: 30px;

  background: var(--white);

  border: 1px solid var(--border);
  border-radius: 20px;

  box-shadow: 0 15px 45px rgba(0, 0, 0, 0.06);

  animation: checkoutSummaryEnter 0.6s ease;
}

.checkout-summary-header {
  padding-bottom: 22px;

  border-bottom: 1px solid var(--border);
}

.checkout-summary-header p {
  margin: 0 0 7px;

  color: var(--secondary);

  font-size: 10px;
  font-weight: 700;

  letter-spacing: 2px;
}

.checkout-summary-header h2 {
  margin: 0;

  color: var(--text);

  font-size: 25px;
}

/* =========================================================
   CHECKOUT PRODUCTS
   ========================================================= */

.checkout-products {
  display: flex;
  flex-direction: column;

  gap: 17px;

  padding: 22px 0;
}

.checkout-product {
  display: grid;

  grid-template-columns: 60px minmax(0, 1fr) auto;

  align-items: center;

  gap: 12px;
}

.checkout-product-image {
  position: relative;

  width: 60px;
  height: 68px;

  overflow: visible;

  border-radius: 9px;

  background: var(--background);
}

.checkout-product-image img {
  width: 100%;
  height: 100%;

  display: block;

  object-fit: cover;

  border-radius: 9px;
}

.checkout-product-image span {
  position: absolute;

  top: -7px;
  right: -7px;

  width: 21px;
  height: 21px;

  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 50%;

  background: var(--primary);

  color: var(--white);

  font-size: 10px;
  font-weight: 700;

  box-shadow: 0 3px 8px rgba(0, 0, 0, 0.15);
}

.checkout-product-info {
  min-width: 0;
}

.checkout-product-info h3 {
  margin: 0 0 4px;

  overflow: hidden;

  color: var(--text);

  font-size: 13px;
  line-height: 1.35;

  text-overflow: ellipsis;
  white-space: nowrap;
}

.checkout-product-info p {
  margin: 0;

  color: var(--muted);

  font-size: 10px;
}

.checkout-product > strong {
  color: var(--text);

  font-size: 12px;

  white-space: nowrap;
}

/* =========================================================
   SUMMARY DETAILS
   ========================================================= */

.checkout-summary-details {
  padding-top: 20px;

  border-top: 1px solid var(--border);
}

.checkout-summary-details > div {
  display: flex;
  align-items: center;
  justify-content: space-between;

  padding: 8px 0;
}

.checkout-summary-details span {
  color: var(--muted);

  font-size: 13px;
}

.checkout-summary-details strong {
  color: var(--text);

  font-size: 13px;
}

.checkout-summary-divider {
  height: 1px;

  margin: 10px 0;

  background: var(--border);
}

.checkout-summary-details .checkout-grand-total {
  padding-top: 14px;
}

.checkout-grand-total span {
  color: var(--text);

  font-size: 16px;
  font-weight: 700;
}

.checkout-grand-total strong {
  color: var(--primary);

  font-size: 21px;
}

/* =========================================================
   SUMMARY NOTE
   ========================================================= */

.checkout-summary-note {
  display: flex;
  align-items: flex-start;

  gap: 10px;

  margin-top: 22px;
  padding-top: 18px;

  border-top: 1px solid var(--border);
}

.checkout-summary-note span {
  width: 22px;
  height: 22px;

  flex-shrink: 0;

  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 50%;

  background: var(--background);

  color: var(--primary);

  font-size: 11px;
  font-weight: 700;
}

.checkout-summary-note p {
  margin: 0;

  color: var(--muted);

  font-size: 11px;
  line-height: 1.6;
}

/* =========================================================
   EMPTY CHECKOUT
   ========================================================= */

.checkout-empty {
  min-height: 70vh;

  max-width: 600px;

  margin: auto;

  display: flex;
  flex-direction: column;

  align-items: center;
  justify-content: center;

  text-align: center;
}

.checkout-empty-icon {
  width: 85px;
  height: 85px;

  display: flex;
  align-items: center;
  justify-content: center;

  margin-bottom: 25px;

  border: 1px solid var(--border);
  border-radius: 50%;

  background: var(--white);

  font-size: 32px;

  box-shadow: 0 15px 40px rgba(0, 0, 0, 0.05);
}

.checkout-empty h1 {
  margin: 0 0 12px;

  color: var(--text);

  font-size: clamp(34px, 5vw, 50px);
}

.checkout-empty p:not(.checkout-label) {
  max-width: 480px;

  margin: 0 0 28px;

  color: var(--muted);

  font-size: 15px;
  line-height: 1.7;
}

.checkout-shop-button {
  min-height: 52px;

  display: inline-flex;
  align-items: center;
  justify-content: center;

  padding: 0 28px;

  border-radius: 10px;

  background: var(--primary);

  color: var(--white);

  text-decoration: none;

  font-size: 12px;
  font-weight: 700;

  letter-spacing: 1.2px;

  transition:
    transform 0.25s ease,
    box-shadow 0.25s ease;
}

.checkout-shop-button:hover {
  transform: translateY(-3px);

  box-shadow: 0 12px 30px rgba(11, 61, 46, 0.2);
}

/* =========================================================
   ANIMATIONS
   ========================================================= */

@keyframes checkoutPageEnter {
  from {
    opacity: 0;
    transform: translateY(15px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes checkoutCardEnter {
  from {
    opacity: 0;
    transform: translateY(15px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes checkoutSummaryEnter {
  from {
    opacity: 0;
    transform: translateX(15px);
  }

  to {
    opacity: 1;
    transform: translateX(0);
  }
}

/* =========================================================
   TABLET
   ========================================================= */

@media (max-width: 1050px) {
  .checkout-content {
    grid-template-columns: 1fr;
  }

  .checkout-summary {
    position: static;

    max-width: 650px;

    width: 100%;

    margin: 0 auto;
  }
}

/* =========================================================
   MOBILE
   ========================================================= */

@media (max-width: 700px) {
  .checkout-page {
    padding: 45px 5%;
  }

  .checkout-header {
    margin-bottom: 30px;
  }

  .checkout-header h1 {
    font-size: 40px;
  }

  .checkout-card {
    padding: 22px 18px;

    border-radius: 16px;
  }

  .checkout-card-header {
    margin-bottom: 22px;
  }

  .checkout-card-header h2 {
    font-size: 19px;
  }

  .checkout-form-row {
    grid-template-columns: 1fr;

    gap: 0;
  }

  .delivery-methods {
    grid-template-columns: 1fr;
  }

  .checkout-summary {
    padding: 22px 18px;

    border-radius: 16px;
  }
}

/* =========================================================
   SMALL MOBILE
   ========================================================= */

@media (max-width: 420px) {
  .checkout-page {
    padding: 35px 4%;
  }

  .checkout-header h1 {
    font-size: 34px;
  }

  .checkout-header > span {
    font-size: 14px;
    line-height: 1.6;
  }

  .checkout-step {
    width: 38px;
    height: 38px;

    font-size: 10px;
  }

  .checkout-card-header {
    gap: 11px;
  }

  .checkout-card-header h2 {
    font-size: 17px;
  }

  .checkout-product {
    grid-template-columns: 52px minmax(0, 1fr) auto;

    gap: 9px;
  }

  .checkout-product-image {
    width: 52px;
    height: 60px;
  }

  .checkout-product-info h3 {
    font-size: 12px;
  }

  .checkout-product > strong {
    font-size: 11px;
  }

  .checkout-submit-button {
    min-height: 54px;

    padding: 0 18px;
  }
}
/* ========================================================= ORDER CONFIRMATION ========================================================= */
.order-confirmation-page {
  min-height: 100vh;
  padding: 70px 6% 90px;
  background: var(--background);
  animation: confirmationPageEnter 0.6s ease;
} /* ========================================================= SUCCESS HERO ========================================================= */
.order-confirmation-hero {
  max-width: 800px;
  margin: 0 auto 55px;
  text-align: center;
}
.confirmation-success-icon {
  width: 86px;
  height: 86px;
  margin: 0 auto 25px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--primary);
  color: var(--white);
  box-shadow: 0 15px 35px rgba(11, 61, 46, 0.2);
  animation:
    confirmationIconIn 0.7s ease,
    confirmationPulse 2.5s ease-in-out 0.8s infinite;
}
.confirmation-success-icon span {
  font-size: 40px;
  font-weight: 400;
  animation: confirmationCheck 0.6s ease 0.4s both;
}
.confirmation-label {
  margin: 0 0 10px;
  color: var(--secondary);
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 2.5px;
}
.order-confirmation-hero h1 {
  margin: 0 0 15px;
  color: var(--text);
  font-size: clamp(42px, 6vw, 70px);
  line-height: 1;
}
.confirmation-message {
  max-width: 650px;
  margin: 0 auto 28px;
  color: var(--muted);
  font-size: 16px;
  line-height: 1.7;
}
.confirmation-order-number {
  display: inline-flex;
  flex-direction: column;
  gap: 5px;
  padding: 14px 25px;
  border: 1px solid var(--border);
  border-radius: 12px;
  background: var(--white);
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.04);
}
.confirmation-order-number span {
  color: var(--muted);
  font-size: 9px;
  font-weight: 700;
  letter-spacing: 1.5px;
}
.confirmation-order-number strong {
  color: var(--primary);
  font-size: 16px;
  letter-spacing: 1px;
} /* ========================================================= CONTENT ========================================================= */
.confirmation-content {
  max-width: 1100px;
  margin: 0 auto;
  display: flex;
  flex-direction: column;
  gap: 22px;
} /* ========================================================= CARD ========================================================= */
.confirmation-card {
  padding: 30px;
  background: var(--white);
  border: 1px solid var(--border);
  border-radius: 20px;
  box-shadow: 0 12px 40px rgba(0, 0, 0, 0.04);
  animation: confirmationCardIn 0.6s ease both;
}
.confirmation-card:nth-child(2) {
  animation-delay: 0.08s;
}
.confirmation-card-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20px;
  margin-bottom: 25px;
}
.confirmation-card-header p,
.confirmation-next-header p {
  margin: 0 0 6px;
  color: var(--secondary);
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 1.8px;
}
.confirmation-card-header h2,
.confirmation-next-header h2 {
  margin: 0;
  color: var(--text);
  font-size: 23px;
} /* ========================================================= STATUS ========================================================= */
.confirmation-status {
  display: inline-flex;
  align-items: center;
  min-height: 32px;
  padding: 0 13px;
  border-radius: 20px;
  background: rgba(11, 61, 46, 0.08);
  color: var(--primary);
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.8px;
  text-transform: uppercase;
} /* ========================================================= ORDER META ========================================================= */
.confirmation-meta {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 15px;
}
.confirmation-meta > div {
  padding: 15px;
  border-radius: 10px;
  background: var(--background);
}
.confirmation-meta span,
.confirmation-detail-list span {
  display: block;
  margin-bottom: 5px;
  color: var(--muted);
  font-size: 10px;
  text-transform: uppercase;
  letter-spacing: 0.8px;
}
.confirmation-meta strong,
.confirmation-detail-list strong {
  color: var(--text);
  font-size: 13px;
  line-height: 1.5;
} /* ========================================================= PRODUCTS ========================================================= */
.confirmation-products {
  display: flex;
  flex-direction: column;
  gap: 13px;
}
.confirmation-product {
  display: grid;
  grid-template-columns: 65px minmax(0, 1fr) auto;
  align-items: center;
  gap: 15px;
  padding: 10px;
  border-radius: 12px;
  transition:
    background 0.25s ease,
    transform 0.25s ease;
}
.confirmation-product:hover {
  background: var(--background);
  transform: translateX(4px);
}
.confirmation-product-image {
  width: 65px;
  height: 72px;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 9px;
  background: var(--background);
}
.confirmation-product-image img {
  width: 100%;
  height: 100%;
  display: block;
  object-fit: cover;
  transition: transform 0.4s ease;
}
.confirmation-product:hover .confirmation-product-image img {
  transform: scale(1.06);
}
.confirmation-product-image span {
  color: var(--primary);
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 1px;
}
.confirmation-product-info h3 {
  margin: 0 0 5px;
  color: var(--text);
  font-size: 14px;
}
.confirmation-product-info p {
  margin: 0;
  color: var(--muted);
  font-size: 11px;
}
.confirmation-product > strong {
  color: var(--primary);
  font-size: 14px;
} /* ========================================================= TOTAL ========================================================= */
.confirmation-total {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20px;
  padding-top: 20px;
  border-top: 1px solid var(--border);
}
.confirmation-total span {
  color: var(--text);
  font-size: 15px;
  font-weight: 700;
}
.confirmation-total strong {
  color: var(--primary);
  font-size: 22px;
} /* ========================================================= CUSTOMER / DELIVERY GRID ========================================================= */
.confirmation-details-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 22px;
}
.confirmation-details-grid .confirmation-card {
  height: 100%;
  box-sizing: border-box;
}
.confirmation-detail-list {
  display: flex;
  flex-direction: column;
  gap: 18px;
}
.confirmation-detail-list > div {
  padding-bottom: 14px;
  border-bottom: 1px solid var(--border);
}
.confirmation-detail-list > div:last-child {
  padding-bottom: 0;
  border-bottom: none;
} /* ========================================================= NEXT STEPS ========================================================= */
.confirmation-next {
  padding: 32px;
  border-radius: 20px;
  background: var(--primary);
  color: var(--white);
  box-shadow: 0 18px 45px rgba(11, 61, 46, 0.16);
  animation: confirmationCardIn 0.6s ease 0.2s both;
}
.confirmation-next-header {
  margin-bottom: 30px;
}
.confirmation-next-header p {
  color: var(--secondary);
}
.confirmation-next-header h2 {
  color: var(--white);
}
.confirmation-steps {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 15px;
}
.confirmation-step {
  position: relative;
  padding: 18px;
  border: 1px solid rgba(255, 255, 255, 0.14);
  border-radius: 12px;
  background: rgba(255, 255, 255, 0.05);
  transition:
    background 0.25s ease,
    transform 0.25s ease;
}
.confirmation-step:hover {
  transform: translateY(-4px);
  background: rgba(255, 255, 255, 0.09);
}
.confirmation-step.active {
  border-color: rgba(201, 162, 39, 0.6);
}
.confirmation-step > span {
  display: block;
  margin-bottom: 15px;
  color: var(--secondary);
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 1px;
}
.confirmation-step strong {
  display: block;
  margin-bottom: 7px;
  color: var(--white);
  font-size: 13px;
}
.confirmation-step p {
  margin: 0;
  color: rgba(255, 255, 255, 0.65);
  font-size: 11px;
  line-height: 1.6;
} /* ========================================================= ACTIONS ========================================================= */
.confirmation-actions {
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
  gap: 10px;
  padding-top: 10px;
}
.confirmation-primary,
.confirmation-secondary {
  min-height: 50px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 0 22px;
  border-radius: 10px;
  text-decoration: none;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 1px;
  transition:
    transform 0.25s ease,
    background 0.25s ease,
    border-color 0.25s ease;
}
.confirmation-primary {
  gap: 12px;
  background: var(--primary);
  color: var(--white);
}
.confirmation-primary:hover {
  transform: translateY(-3px);
  background: var(--primary-dark);
}
.confirmation-primary span {
  font-size: 18px;
  transition: transform 0.25s ease;
}
.confirmation-primary:hover span {
  transform: translateX(4px);
}
.confirmation-secondary {
  border: 1px solid var(--border);
  background: var(--white);
  color: var(--text);
}
.confirmation-secondary:hover {
  transform: translateY(-3px);
  border-color: var(--primary);
  color: var(--primary);
} /* ========================================================= ANIMATIONS ========================================================= */
@keyframes confirmationPageEnter {
  from {
    opacity: 0;
    transform: translateY(15px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
@keyframes confirmationIconIn {
  from {
    opacity: 0;
    transform: scale(0.5);
  }
  to {
    opacity: 1;
    transform: scale(1);
  }
}
@keyframes confirmationCheck {
  from {
    opacity: 0;
    transform: scale(0.4);
  }
  to {
    opacity: 1;
    transform: scale(1);
  }
}
@keyframes confirmationPulse {
  0%,
  100% {
    transform: scale(1);
  }
  50% {
    transform: scale(1.04);
  }
}
@keyframes confirmationCardIn {
  from {
    opacity: 0;
    transform: translateY(15px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
} /* ========================================================= TABLET ========================================================= */
@media (max-width: 850px) {
  .confirmation-steps {
    grid-template-columns: repeat(2, 1fr);
  }
  .confirmation-details-grid {
    grid-template-columns: 1fr;
  }
} /* ========================================================= MOBILE ========================================================= */
@media (max-width: 650px) {
  .order-confirmation-page {
    padding: 45px 5% 65px;
  }
  .order-confirmation-hero {
    margin-bottom: 40px;
  }
  .order-confirmation-hero h1 {
    font-size: 44px;
  }
  .confirmation-message {
    font-size: 14px;
  }
  .confirmation-card {
    padding: 22px 18px;
    border-radius: 16px;
  }
  .confirmation-card-header {
    flex-direction: column;
    gap: 12px;
  }
  .confirmation-meta {
    grid-template-columns: 1fr;
  }
  .confirmation-next {
    padding: 24px 18px;
    border-radius: 16px;
  }
  .confirmation-steps {
    grid-template-columns: 1fr;
  }
  .confirmation-actions {
    flex-direction: column;
  }
  .confirmation-primary,
  .confirmation-secondary {
    width: 100%;
    box-sizing: border-box;
  }
} /* ========================================================= SMALL MOBILE ========================================================= */
@media (max-width: 420px) {
  .order-confirmation-page {
    padding: 35px 4% 55px;
  }
  .confirmation-success-icon {
    width: 72px;
    height: 72px;
  }
  .confirmation-success-icon span {
    font-size: 32px;
  }
  .order-confirmation-hero h1 {
    font-size: 37px;
  }
  .confirmation-order-number {
    max-width: 100%;
    box-sizing: border-box;
  }
  .confirmation-product {
    grid-template-columns: 55px minmax(0, 1fr);
    gap: 11px;
  }
  .confirmation-product-image {
    width: 55px;
    height: 62px;
  }
  .confirmation-product > strong {
    grid-column: 2;
  }
  .confirmation-total strong {
    font-size: 19px;
  }
}

/* ========================================================= MY ORDERS PAGE ========================================================= */
.my-orders-page {
  min-height: 100vh;
  padding: 70px 6% 90px;
  background: var(--background);
  animation: ordersPageEnter 0.6s ease;
} /* ========================================================= HEADER ========================================================= */
.my-orders-header {
  max-width: 1200px;
  margin: 0 auto 45px;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 25px;
}
.my-orders-label {
  margin: 0 0 10px;
  color: var(--secondary);
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 2.5px;
}
.my-orders-header h1 {
  margin: 0 0 10px;
  color: var(--text);
  font-size: clamp(40px, 5vw, 62px);
  line-height: 1;
}
.my-orders-header > div:first-child > span {
  color: var(--muted);
  font-size: 15px;
} /* ========================================================= ORDERS COUNT ========================================================= */
.orders-count {
  min-width: 95px;
  padding: 17px 20px;
  display: flex;
  flex-direction: column;
  align-items: center;
  border: 1px solid var(--border);
  border-radius: 14px;
  background: var(--white);
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.04);
}
.orders-count strong {
  color: var(--primary);
  font-size: 27px;
}
.orders-count span {
  color: var(--muted);
  font-size: 10px;
  letter-spacing: 1px;
  text-transform: uppercase;
} /* ========================================================= ORDERS LIST ========================================================= */
.orders-list {
  max-width: 1200px;
  margin: 0 auto;
  display: flex;
  flex-direction: column;
  gap: 20px;
} /* ========================================================= ORDER CARD ========================================================= */
.order-card {
  padding: 25px;
  background: var(--white);
  border: 1px solid var(--border);
  border-radius: 18px;
  box-shadow: 0 10px 35px rgba(0, 0, 0, 0.04);
  animation: orderCardEnter 0.5s ease both;
  transition:
    transform 0.3s ease,
    box-shadow 0.3s ease,
    border-color 0.3s ease;
}
.order-card:hover {
  transform: translateY(-3px);
  border-color: rgba(201, 162, 39, 0.45);
  box-shadow: 0 18px 45px rgba(0, 0, 0, 0.07);
} /* ========================================================= ORDER TOP ========================================================= */
.order-card-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20px;
  padding-bottom: 20px;
  border-bottom: 1px solid var(--border);
}
.order-card-top span,
.order-card-info span {
  display: block;
  margin-bottom: 6px;
  color: var(--muted);
  font-size: 9px;
  font-weight: 700;
  letter-spacing: 1.2px;
}
.order-card-top h2 {
  margin: 0;
  color: var(--text);
  font-size: 17px;
  letter-spacing: 0.4px;
}
.order-status {
  text-align: right;
}
.order-status strong {
  display: inline-flex;
  align-items: center;
  min-height: 30px;
  padding: 0 12px;
  border-radius: 20px;
  background: rgba(11, 61, 46, 0.08);
  color: var(--primary);
  font-size: 10px;
  letter-spacing: 0.5px;
  text-transform: uppercase;
} /* ========================================================= ORDER INFO ========================================================= */
.order-card-info {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12px;
  padding: 20px 0;
}
.order-card-info > div {
  padding: 13px;
  border-radius: 10px;
  background: var(--background);
}
.order-card-info strong {
  color: var(--text);
  font-size: 13px;
} /* ========================================================= PRODUCT PREVIEW ========================================================= */
.order-card-products {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10px;
  padding-bottom: 20px;
}
.order-product-preview {
  display: flex;
  align-items: center;
  gap: 9px;
  min-width: 200px;
  padding: 8px;
  border-radius: 10px;
  background: var(--background);
  transition:
    transform 0.25s ease,
    background 0.25s ease;
}
.order-product-preview:hover {
  transform: translateY(-2px);
  background: rgba(11, 61, 46, 0.07);
}
.order-product-image {
  width: 48px;
  height: 54px;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  border-radius: 7px;
  background: var(--white);
}
.order-product-image img {
  width: 100%;
  height: 100%;
  display: block;
  object-fit: cover;
}
.order-product-image span {
  color: var(--primary);
  font-size: 9px;
  font-weight: 700;
}
.order-product-preview > div:last-child {
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4px;
}
.order-product-preview strong {
  overflow: hidden;
  color: var(--text);
  font-size: 11px;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.order-product-preview span {
  color: var(--muted);
  font-size: 10px;
}
.order-more-products {
  min-height: 70px;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 15px;
  border: 1px dashed var(--border);
  border-radius: 10px;
  color: var(--muted);
  font-size: 11px;
  font-weight: 700;
} /* ========================================================= ACTIONS ========================================================= */
.order-card-actions {
  display: flex;
  justify-content: flex-end;
  gap: 10px;
  padding-top: 20px;
  border-top: 1px solid var(--border);
}
.order-track-button,
.order-view-button {
  min-height: 44px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 0 17px;
  border-radius: 9px;
  text-decoration: none;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 1px;
  transition:
    transform 0.25s ease,
    background 0.25s ease,
    border-color 0.25s ease;
}
.order-track-button {
  gap: 10px;
  background: var(--primary);
  color: var(--white);
}
.order-track-button:hover {
  transform: translateY(-2px);
  background: var(--primary-dark);
}
.order-track-button span {
  font-size: 16px;
  transition: transform 0.25s ease;
}
.order-track-button:hover span {
  transform: translateX(4px);
}
.order-view-button {
  border: 1px solid var(--border);
  background: var(--white);
  color: var(--text);
}
.order-view-button:hover {
  transform: translateY(-2px);
  border-color: var(--primary);
  color: var(--primary);
} /* ========================================================= BOTTOM CTA ========================================================= */
.my-orders-cta {
  max-width: 1200px;
  margin: 35px auto 0;
  padding: 28px 30px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 25px;
  border-radius: 18px;
  background: var(--primary);
  color: var(--white);
  box-shadow: 0 15px 40px rgba(11, 61, 46, 0.14);
}
.my-orders-cta p {
  margin: 0 0 7px;
  color: var(--secondary);
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 1.7px;
}
.my-orders-cta h2 {
  margin: 0 0 6px;
  font-size: 22px;
}
.my-orders-cta span {
  color: rgba(255, 255, 255, 0.65);
  font-size: 12px;
}
.my-orders-cta > a {
  min-height: 46px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  padding: 0 18px;
  flex-shrink: 0;
  border-radius: 9px;
  background: var(--white);
  color: var(--primary);
  text-decoration: none;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 1px;
  transition: transform 0.25s ease;
}
.my-orders-cta > a:hover {
  transform: translateY(-3px);
}
.my-orders-cta > a span {
  color: var(--primary);
  font-size: 17px;
  transition: transform 0.25s ease;
}
.my-orders-cta > a:hover span {
  transform: translateX(4px);
} /* ========================================================= EMPTY ORDERS ========================================================= */
.my-orders-empty {
  max-width: 600px;
  min-height: 70vh;
  margin: auto;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
}
.my-orders-empty-icon {
  width: 85px;
  height: 85px;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 25px;
  border: 1px solid var(--border);
  border-radius: 50%;
  background: var(--white);
  font-size: 31px;
  box-shadow: 0 15px 40px rgba(0, 0, 0, 0.05);
}
.my-orders-empty h1 {
  margin: 0 0 12px;
  color: var(--text);
  font-size: clamp(36px, 5vw, 52px);
}
.my-orders-empty > p:not(.my-orders-label) {
  max-width: 500px;
  margin: 0 0 28px;
  color: var(--muted);
  font-size: 15px;
  line-height: 1.7;
}
.my-orders-shop-button {
  min-height: 52px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 0 27px;
  border-radius: 10px;
  background: var(--primary);
  color: var(--white);
  text-decoration: none;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 1.2px;
  transition:
    transform 0.25s ease,
    box-shadow 0.25s ease;
}
.my-orders-shop-button:hover {
  transform: translateY(-3px);
  box-shadow: 0 12px 30px rgba(11, 61, 46, 0.2);
} /* ========================================================= ANIMATIONS ========================================================= */
@keyframes ordersPageEnter {
  from {
    opacity: 0;
    transform: translateY(15px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
@keyframes orderCardEnter {
  from {
    opacity: 0;
    transform: translateY(15px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
} /* ========================================================= TABLET ========================================================= */
@media (max-width: 850px) {
  .order-card-info {
    grid-template-columns: repeat(2, 1fr);
  }
  .my-orders-cta {
    align-items: flex-start;
    flex-direction: column;
  }
} /* ========================================================= MOBILE ========================================================= */
@media (max-width: 650px) {
  .my-orders-page {
    padding: 45px 5% 65px;
  }
  .my-orders-header {
    align-items: flex-start;
    flex-direction: column;
    margin-bottom: 30px;
  }
  .orders-count {
    flex-direction: row;
    gap: 8px;
    min-width: auto;
    padding: 10px 15px;
  }
  .orders-count strong {
    font-size: 20px;
  }
  .order-card {
    padding: 18px;
    border-radius: 15px;
  }
  .order-card-top {
    flex-direction: column;
  }
  .order-status {
    text-align: left;
  }
  .order-card-info {
    grid-template-columns: 1fr 1fr;
  }
  .order-card-actions {
    flex-direction: column;
  }
  .order-track-button,
  .order-view-button {
    width: 100%;
    box-sizing: border-box;
  }
  .my-orders-cta {
    padding: 24px 20px;
  }
  .my-orders-cta > a {
    width: 100%;
    box-sizing: border-box;
  }
} /* ========================================================= SMALL MOBILE ========================================================= */
@media (max-width: 420px) {
  .my-orders-page {
    padding: 35px 4% 55px;
  }
  .my-orders-header h1 {
    font-size: 38px;
  }
  .order-card-info {
    grid-template-columns: 1fr;
  }
  .order-product-preview {
    width: 100%;
    box-sizing: border-box;
  }
  .my-orders-cta h2 {
    font-size: 19px;
  }
}

```css
/* =========================================================
   ABS CUT - TRACK ORDER
   ========================================================= */

.track-order-page {
  min-height: 100vh;
  padding: 70px 6%;
  background: var(--background);
  animation: trackPageEnter 0.7s ease both;
}

.track-order-header {
  max-width: 1250px;
  margin: 0 auto 35px;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 30px;
}

.track-order-label {
  margin: 0 0 10px;
  color: var(--secondary);
  font-size: 0.75rem;
  font-weight: 800;
  letter-spacing: 2px;
}

.track-order-header h1 {
  margin: 0;
  color: var(--primary-dark);
  font-size: clamp(2.2rem, 5vw, 4rem);
  line-height: 1;
  letter-spacing: -1.5px;
}

.track-order-intro {
  max-width: 600px;
  margin: 18px 0 0;
  color: var(--muted);
  font-size: 1rem;
  line-height: 1.7;
}

.track-order-number {
  min-width: 220px;
  padding: 20px 24px;
  border: 1px solid var(--border);
  border-radius: 16px;
  background: var(--white);
  box-shadow: 0 12px 35px rgba(16, 37, 29, 0.07);
}

.track-order-number span,
.tracking-status-meta span,
.tracking-product-price span,
.tracking-info-details span {
  display: block;
  margin-bottom: 7px;
  color: var(--muted);
  font-size: 0.68rem;
  font-weight: 800;
  letter-spacing: 1.5px;
}

.track-order-number strong {
  display: block;
  color: var(--primary);
  font-size: 1rem;
  word-break: break-word;
}


/* =========================================================
   STATUS CARD
   ========================================================= */

.tracking-status-card {
  max-width: 1250px;
  margin: 0 auto 45px;
  padding: 30px;
  display: flex;
  justify-content: space-between;
  gap: 35px;
  border-radius: 22px;
  background: var(--primary-dark);
  color: var(--white);
  box-shadow: 0 25px 60px rgba(16, 37, 29, 0.16);
  overflow: hidden;
  position: relative;
}

.tracking-status-card::before {
  content: "";
  position: absolute;
  width: 280px;
  height: 280px;
  right: -100px;
  top: -130px;
  border: 1px solid rgba(201, 162, 39, 0.25);
  border-radius: 50%;
}

.tracking-status-card::after {
  content: "";
  position: absolute;
  width: 180px;
  height: 180px;
  right: 40px;
  bottom: -130px;
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 50%;
}

.tracking-status-main {
  display: flex;
  align-items: center;
  gap: 20px;
  position: relative;
  z-index: 1;
}

.tracking-status-icon {
  width: 65px;
  height: 65px;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1px solid rgba(201, 162, 39, 0.5);
  border-radius: 50%;
  color: var(--secondary);
  font-size: 1.6rem;
  animation: trackingPulse 2.2s ease-in-out infinite;
}

.tracking-status-main span {
  display: block;
  margin-bottom: 5px;
  color: rgba(255, 255, 255, 0.55);
  font-size: 0.68rem;
  font-weight: 800;
  letter-spacing: 1.5px;
}

.tracking-status-main h2 {
  margin: 0;
  color: var(--white);
  font-size: 1.7rem;
}

.tracking-status-main p {
  margin: 7px 0 0;
  max-width: 500px;
  color: rgba(255, 255, 255, 0.68);
  line-height: 1.5;
}

.tracking-status-meta {
  display: flex;
  align-items: center;
  gap: 30px;
  position: relative;
  z-index: 1;
}

.tracking-status-meta div {
  min-width: 90px;
}

.tracking-status-meta span {
  color: rgba(255, 255, 255, 0.45);
}

.tracking-status-meta strong {
  color: var(--white);
  font-size: 0.9rem;
}


/* =========================================================
   SECTION HEADINGS
   ========================================================= */

.tracking-section,
.tracking-products-section {
  max-width: 1250px;
  margin: 0 auto 45px;
  padding: 30px;
  border: 1px solid var(--border);
  border-radius: 22px;
  background: var(--white);
  box-shadow: 0 12px 40px rgba(16, 37, 29, 0.05);
}

.tracking-section-heading {
  margin-bottom: 35px;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 20px;
}

.tracking-section-heading p,
.tracking-info-card-heading p,
.tracking-notes p {
  margin: 0 0 7px;
  color: var(--secondary);
  font-size: 0.68rem;
  font-weight: 800;
  letter-spacing: 1.5px;
}

.tracking-section-heading h2,
.tracking-info-card-heading h2,
.tracking-notes h2 {
  margin: 0;
  color: var(--primary-dark);
  font-size: 1.6rem;
}

.tracking-section-heading > span {
  color: var(--muted);
  font-size: 0.85rem;
}


/* =========================================================
   TRACKING TIMELINE
   ========================================================= */

.tracking-timeline {
  position: relative;
}

.tracking-step {
  min-height: 92px;
  display: grid;
  grid-template-columns: 58px 1fr;
  column-gap: 20px;
  position: relative;
  animation: trackingStepEnter 0.55s ease both;
}

.tracking-step:nth-child(1) {
  animation-delay: 0.05s;
}

.tracking-step:nth-child(2) {
  animation-delay: 0.1s;
}

.tracking-step:nth-child(3) {
  animation-delay: 0.15s;
}

.tracking-step:nth-child(4) {
  animation-delay: 0.2s;
}

.tracking-step:nth-child(5) {
  animation-delay: 0.25s;
}

.tracking-step:nth-child(6) {
  animation-delay: 0.3s;
}

.tracking-step:nth-child(7) {
  animation-delay: 0.35s;
}

.tracking-step:nth-child(8) {
  animation-delay: 0.4s;
}

.tracking-step:nth-child(9) {
  animation-delay: 0.45s;
}

.tracking-step:nth-child(10) {
  animation-delay: 0.5s;
}

.tracking-step-marker {
  width: 44px;
  height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2px solid var(--border);
  border-radius: 50%;
  background: var(--white);
  color: var(--muted);
  position: relative;
  z-index: 2;
  transition:
    transform 0.3s ease,
    border-color 0.3s ease,
    background 0.3s ease,
    color 0.3s ease;
}

.tracking-step.completed .tracking-step-marker {
  border-color: var(--primary);
  background: var(--primary);
  color: var(--white);
}

.tracking-step.current .tracking-step-marker {
  border-color: var(--secondary);
  background: var(--secondary);
  color: var(--primary-dark);
  box-shadow:
    0 0 0 7px rgba(201, 162, 39, 0.12),
    0 8px 25px rgba(201, 162, 39, 0.2);
  animation: currentStepPulse 2s ease-in-out infinite;
}

.tracking-step:hover .tracking-step-marker {
  transform: scale(1.08);
}

.tracking-step-line {
  position: absolute;
  left: 21px;
  top: 44px;
  bottom: 0;
  width: 2px;
  background: var(--border);
  overflow: hidden;
}

.tracking-line-active {
  display: block;
  width: 100%;
  height: 100%;
  background: var(--primary);
  transform-origin: top;
  animation: lineGrow 0.8s ease both;
}

.tracking-step-content {
  padding: 3px 0 30px;
}

.tracking-step-heading {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10px;
}

.tracking-step-heading h3 {
  margin: 0;
  color: var(--primary-dark);
  font-size: 1rem;
}

.tracking-step.upcoming .tracking-step-heading h3 {
  color: var(--muted);
}

.tracking-step-content p {
  max-width: 650px;
  margin: 6px 0 0;
  color: var(--muted);
  font-size: 0.9rem;
  line-height: 1.6;
}

.tracking-step-content small {
  display: block;
  margin-top: 8px;
  color: var(--secondary);
  font-size: 0.72rem;
  font-weight: 700;
}

.tracking-complete-badge,
.tracking-current-badge {
  padding: 5px 9px;
  border-radius: 30px;
  font-size: 0.6rem;
  font-weight: 800;
  letter-spacing: 0.8px;
}

.tracking-complete-badge {
  background: rgba(11, 61, 46, 0.1);
  color: var(--primary);
}

.tracking-current-badge {
  background: rgba(201, 162, 39, 0.16);
  color: #8b6c05;
}


/* =========================================================
   PRODUCTS
   ========================================================= */

.tracking-products {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.tracking-product {
  min-height: 95px;
  padding: 13px;
  display: grid;
  grid-template-columns: 82px 1fr auto;
  align-items: center;
  gap: 20px;
  border: 1px solid var(--border);
  border-radius: 15px;
  transition:
    transform 0.3s ease,
    box-shadow 0.3s ease,
    border-color 0.3s ease;
}

.tracking-product:hover {
  transform: translateY(-3px);
  border-color: rgba(201, 162, 39, 0.5);
  box-shadow: 0 12px 30px rgba(16, 37, 29, 0.08);
}

.tracking-product-image {
  width: 82px;
  height: 82px;
  overflow: hidden;
  border-radius: 12px;
  background: var(--background);
  display: flex;
  align-items: center;
  justify-content: center;
}

.tracking-product-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.4s ease;
}

.tracking-product:hover .tracking-product-image img {
  transform: scale(1.06);
}

.tracking-product-image span {
  color: var(--primary);
  font-size: 0.65rem;
  font-weight: 800;
}

.tracking-product-info p {
  margin: 0 0 5px;
  color: var(--secondary);
  font-size: 0.65rem;
  font-weight: 800;
  letter-spacing: 1px;
}

.tracking-product-info h3 {
  margin: 0 0 6px;
  color: var(--primary-dark);
  font-size: 1rem;
}

.tracking-product-info > span {
  color: var(--muted);
  font-size: 0.8rem;
}

.tracking-product-price {
  text-align: right;
}

.tracking-product-price strong {
  color: var(--primary-dark);
  font-size: 1rem;
}

.tracking-total {
  margin-top: 20px;
  padding-top: 20px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-top: 1px solid var(--border);
}

.tracking-total span {
  color: var(--muted);
  font-size: 0.7rem;
  font-weight: 800;
  letter-spacing: 1.3px;
}

.tracking-total strong {
  color: var(--primary);
  font-size: 1.4rem;
}


/* =========================================================
   CUSTOMER / DELIVERY INFORMATION
   ========================================================= */

.tracking-information-grid {
  max-width: 1250px;
  margin: 0 auto 30px;
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 25px;
}

.tracking-info-card {
  padding: 30px;
  border: 1px solid var(--border);
  border-radius: 22px;
  background: var(--white);
  box-shadow: 0 12px 40px rgba(16, 37, 29, 0.05);
}

.tracking-info-card-heading {
  display: flex;
  align-items: center;
  gap: 15px;
  margin-bottom: 25px;
}

.tracking-info-icon {
  width: 42px;
  height: 42px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12px;
  background: rgba(11, 61, 46, 0.08);
  color: var(--primary);
}

.tracking-info-details {
  display: flex;
  flex-direction: column;
  gap: 18px;
}

.tracking-info-details strong {
  display: block;
  color: var(--primary-dark);
  font-size: 0.9rem;
  line-height: 1.5;
  word-break: break-word;
}


/* =========================================================
   ORDER NOTES
   ========================================================= */

.tracking-notes {
  max-width: 1250px;
  margin: 0 auto 30px;
  padding: 25px 30px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 30px;
  border: 1px solid var(--border);
  border-radius: 18px;
  background: var(--white);
}

.tracking-notes > span {
  max-width: 700px;
  padding: 13px 17px;
  border-radius: 10px;
  background: var(--background);
  color: var(--text);
  font-size: 0.9rem;
  line-height: 1.6;
}


/* =========================================================
   ACTIONS
   ========================================================= */

.tracking-actions {
  max-width: 1250px;
  margin: 0 auto 30px;
  display: flex;
  gap: 12px;
}

.track-primary-button,
.track-secondary-button {
  min-height: 50px;
  padding: 0 24px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  border-radius: 10px;
  text-decoration: none;
  font-size: 0.75rem;
  font-weight: 800;
  letter-spacing: 0.8px;
  transition:
    transform 0.3s ease,
    box-shadow 0.3s ease,
    background 0.3s ease;
}

.track-primary-button {
  background: var(--primary);
  color: var(--white);
}

.track-primary-button:hover {
  transform: translateY(-3px);
  background: var(--primary-dark);
  box-shadow: 0 12px 25px rgba(11, 61, 46, 0.18);
}

.track-secondary-button {
  border: 1px solid var(--border);
  background: var(--white);
  color: var(--primary);
}

.track-secondary-button:hover {
  transform: translateY(-3px);
  border-color: var(--secondary);
  box-shadow: 0 12px 25px rgba(16, 37, 29, 0.08);
}


/* =========================================================
   FOOTER NOTE
   ========================================================= */

.tracking-footer-note {
  max-width: 1250px;
  margin: 0 auto;
  padding: 16px 20px;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  border-top: 1px solid var(--border);
}

.tracking-footer-note > span {
  color: var(--primary);
  font-weight: 900;
}

.tracking-footer-note p {
  margin: 0;
  color: var(--muted);
  font-size: 0.75rem;
  text-align: center;
}


/* =========================================================
   NOT FOUND
   ========================================================= */

.track-order-not-found {
  max-width: 650px;
  margin: 60px auto;
  padding: 55px 35px;
  text-align: center;
  border: 1px solid var(--border);
  border-radius: 25px;
  background: var(--white);
  box-shadow: 0 20px 50px rgba(16, 37, 29, 0.08);
}

.track-error-icon {
  width: 65px;
  height: 65px;
  margin: 0 auto 20px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(201, 162, 39, 0.13);
  color: #8b6c05;
  font-size: 1.7rem;
  font-weight: 900;
}

.track-order-not-found h1 {
  margin: 5px 0 15px;
  color: var(--primary-dark);
  font-size: 2.2rem;
}

.track-order-not-found > p:not(.track-order-label) {
  color: var(--muted);
  line-height: 1.6;
}

.missing-order-id {
  display: inline-block;
  margin: 5px 0 25px;
  color: var(--primary);
  font-size: 0.9rem;
  word-break: break-word;
}

.track-not-found-actions {
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
  gap: 12px;
}


/* =========================================================
   ANIMATIONS
   ========================================================= */

@keyframes trackPageEnter {
  from {
    opacity: 0;
    transform: translateY(18px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes trackingPulse {
  0%,
  100% {
    transform: scale(1);
    box-shadow: 0 0 0 0 rgba(201, 162, 39, 0);
  }

  50% {
    transform: scale(1.04);
    box-shadow: 0 0 0 9px rgba(201, 162, 39, 0.07);
  }
}

@keyframes currentStepPulse {
  0%,
  100% {
    box-shadow:
      0 0 0 7px rgba(201, 162, 39, 0.12),
      0 8px 25px rgba(201, 162, 39, 0.2);
  }

  50% {
    box-shadow:
      0 0 0 12px rgba(201, 162, 39, 0.04),
      0 10px 30px rgba(201, 162, 39, 0.25);
  }
}

@keyframes trackingStepEnter {
  from {
    opacity: 0;
    transform: translateX(-15px);
  }

  to {
    opacity: 1;
    transform: translateX(0);
  }
}

@keyframes lineGrow {
  from {
    transform: scaleY(0);
  }

  to {
    transform: scaleY(1);
  }
}


/* =========================================================
   RESPONSIVE
   ========================================================= */

@media (max-width: 950px) {
  .track-order-header {
    align-items: flex-start;
    flex-direction: column;
  }

  .track-order-number {
    width: 100%;
  }

  .tracking-status-card {
    flex-direction: column;
  }

  .tracking-status-meta {
    padding-top: 25px;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    justify-content: space-between;
  }
}


@media (max-width: 750px) {
  .track-order-page {
    padding: 45px 5%;
  }

  .tracking-information-grid {
    grid-template-columns: 1fr;
  }

  .tracking-section,
  .tracking-products-section,
  .tracking-info-card {
    padding: 22px;
  }

  .tracking-product {
    grid-template-columns: 70px 1fr;
  }

  .tracking-product-image {
    width: 70px;
    height: 70px;
  }

  .tracking-product-price {
    grid-column: 2;
    text-align: left;
  }

  .tracking-product-price strong {
    font-size: 0.95rem;
  }

  .tracking-notes {
    align-items: flex-start;
    flex-direction: column;
    padding: 22px;
  }

  .tracking-notes > span {
    width: 100%;
    box-sizing: border-box;
  }
}


@media (max-width: 550px) {
  .track-order-page {
    padding: 35px 4%;
  }

  .track-order-header h1 {
    font-size: 2.25rem;
  }

  .tracking-status-card {
    padding: 22px;
    border-radius: 18px;
  }

  .tracking-status-main {
    align-items: flex-start;
  }

  .tracking-status-icon {
    width: 52px;
    height: 52px;
    font-size: 1.3rem;
  }

  .tracking-status-main h2 {
    font-size: 1.3rem;
  }

  .tracking-status-meta {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 15px;
  }

  .tracking-section-heading {
    align-items: flex-start;
    flex-direction: column;
    margin-bottom: 25px;
  }

  .tracking-section-heading h2 {
    font-size: 1.35rem;
  }

  .tracking-step {
    grid-template-columns: 48px 1fr;
    column-gap: 13px;
  }

  .tracking-step-marker {
    width: 38px;
    height: 38px;
    font-size: 0.8rem;
  }

  .tracking-step-line {
    left: 18px;
    top: 38px;
  }

  .tracking-step-content {
    padding-bottom: 25px;
  }

  .tracking-step-heading h3 {
    font-size: 0.92rem;
  }

  .tracking-step-content p {
    font-size: 0.8rem;
  }

  .tracking-actions {
    flex-direction: column;
  }

  .track-primary-button,
  .track-secondary-button {
    width: 100%;
    box-sizing: border-box;
  }

  .track-not-found-actions {
    flex-direction: column;
  }

  .track-not-found-actions .track-primary-button,
  .track-not-found-actions .track-secondary-button {
    width: 100%;
  }
}


@media (max-width: 400px) {
  .tracking-status-meta {
    grid-template-columns: 1fr;
  }

  .tracking-status-meta div {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 15px;
  }

  .tracking-status-meta span {
    margin: 0;
  }

  .tracking-product {
    gap: 12px;
  }

  .tracking-product-info h3 {
    font-size: 0.88rem;
  }

  .tracking-total strong {
    font-size: 1.1rem;
  }
}


/* =========================================================
   REDUCED MOTION ACCESSIBILITY
   ========================================================= */

@media (prefers-reduced-motion: reduce) {
  .track-order-page,
  .tracking-step,
  .tracking-status-icon,
  .tracking-step.current .tracking-step-marker,
  .tracking-line-active {
    animation: none;
  }

  .tracking-product,
  .tracking-step-marker,
  .track-primary-button,
  .track-secondary-button {
    transition: none;
  }
}

```css
/* =========================================================
   ABS CUT — ACCOUNT PAGE
   ========================================================= */

.account-page {
  min-height: 100vh;
  padding: 70px 6%;
  background: var(--background);
  animation: accountPageEnter 0.7s ease both;
}


/* =========================================================
   ACCOUNT HEADER
   ========================================================= */

.account-header {
  max-width: 1250px;
  margin: 0 auto 40px;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 30px;
}

.account-label {
  margin: 0 0 10px;
  color: var(--secondary);
  font-size: 0.72rem;
  font-weight: 800;
  letter-spacing: 2px;
}

.account-header h1 {
  margin: 0;
  color: var(--primary-dark);
  font-size: clamp(2.3rem, 5vw, 4rem);
  line-height: 1;
  letter-spacing: -1.5px;
}

.account-intro {
  max-width: 600px;
  margin: 17px 0 0;
  color: var(--muted);
  font-size: 0.98rem;
  line-height: 1.7;
}


/* =========================================================
   MINI PROFILE
   ========================================================= */

.account-profile-mini {
  min-width: 260px;
  padding: 15px 18px;
  display: flex;
  align-items: center;
  gap: 13px;
  border: 1px solid var(--border);
  border-radius: 17px;
  background: var(--white);
  box-shadow: 0 12px 35px rgba(16, 37, 29, 0.06);
}

.account-avatar {
  width: 50px;
  height: 50px;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--primary);
  color: var(--secondary);
  font-size: 0.95rem;
  font-weight: 900;
  letter-spacing: 1px;
  box-shadow: 0 8px 20px rgba(11, 61, 46, 0.16);
}

.account-profile-mini strong {
  display: block;
  color: var(--primary-dark);
  font-size: 0.9rem;
}

.account-profile-mini span {
  display: block;
  max-width: 170px;
  margin-top: 4px;
  overflow: hidden;
  color: var(--muted);
  font-size: 0.72rem;
  text-overflow: ellipsis;
  white-space: nowrap;
}


/* =========================================================
   MAIN CONTENT
   ========================================================= */

.account-content {
  max-width: 1250px;
  margin: 0 auto;
  display: grid;
  grid-template-columns: minmax(0, 1.55fr) minmax(300px, 0.85fr);
  gap: 28px;
  align-items: start;
}


/* =========================================================
   ACCOUNT CARD
   ========================================================= */

.account-card {
  padding: 32px;
  border: 1px solid var(--border);
  border-radius: 22px;
  background: var(--white);
  box-shadow: 0 15px 45px rgba(16, 37, 29, 0.06);
  animation: accountCardEnter 0.7s 0.1s ease both;
}

.account-card-header {
  padding-bottom: 25px;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20px;
  border-bottom: 1px solid var(--border);
}

.account-card-header p {
  margin: 0 0 7px;
  color: var(--secondary);
  font-size: 0.68rem;
  font-weight: 800;
  letter-spacing: 1.6px;
}

.account-card-header h2 {
  margin: 0;
  color: var(--primary-dark);
  font-size: 1.5rem;
}

.account-card-header > div:first-child > span {
  display: block;
  max-width: 550px;
  margin-top: 8px;
  color: var(--muted);
  font-size: 0.82rem;
  line-height: 1.6;
}

.account-card-icon {
  width: 45px;
  height: 45px;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 13px;
  background: rgba(11, 61, 46, 0.08);
  color: var(--primary);
  font-size: 1.15rem;
}


/* =========================================================
   ACCOUNT FORM
   ========================================================= */

.account-form {
  padding-top: 28px;
}

.account-form-row {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 18px;
}

.account-form-group {
  margin-bottom: 21px;
}

.account-form-group label {
  display: block;
  margin-bottom: 8px;
  color: var(--primary-dark);
  font-size: 0.76rem;
  font-weight: 800;
}

.account-form-group input {
  width: 100%;
  min-height: 50px;
  box-sizing: border-box;
  padding: 0 15px;
  border: 1px solid var(--border);
  border-radius: 10px;
  outline: none;
  background: #fff;
  color: var(--text);
  font-family: inherit;
  font-size: 0.9rem;
  transition:
    border-color 0.25s ease,
    box-shadow 0.25s ease,
    transform 0.25s ease,
    background 0.25s ease;
}

.account-form-group input::placeholder {
  color: #9ba39f;
}

.account-form-group input:hover {
  border-color: #bfc5c1;
}

.account-form-group input:focus {
  border-color: var(--primary);
  background: #fff;
  box-shadow: 0 0 0 4px rgba(11, 61, 46, 0.07);
  transform: translateY(-1px);
}

.account-form-group small {
  display: block;
  margin-top: 7px;
  color: var(--muted);
  font-size: 0.68rem;
  line-height: 1.5;
}


/* =========================================================
   ERROR MESSAGE
   ========================================================= */

.account-error-message {
  margin: 5px 0 20px;
  padding: 12px 15px;
  display: flex;
  align-items: center;
  gap: 10px;
  border: 1px solid rgba(180, 50, 50, 0.18);
  border-radius: 10px;
  background: rgba(180, 50, 50, 0.05);
  animation: accountMessageEnter 0.3s ease both;
}

.account-error-message > span {
  width: 23px;
  height: 23px;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(180, 50, 50, 0.1);
  color: #a33b3b;
  font-size: 0.75rem;
  font-weight: 900;
}

.account-error-message p {
  margin: 0;
  color: #8d3838;
  font-size: 0.78rem;
}


/* =========================================================
   FORM FOOTER
   ========================================================= */

.account-form-footer {
  min-height: 52px;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 15px;
}

.save-account-button {
  min-height: 50px;
  padding: 0 21px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 18px;
  border: none;
  border-radius: 10px;
  background: var(--primary);
  color: var(--white);
  cursor: pointer;
  font-family: inherit;
  font-size: 0.72rem;
  font-weight: 800;
  letter-spacing: 0.8px;
  transition:
    transform 0.3s ease,
    background 0.3s ease,
    box-shadow 0.3s ease;
}

.save-account-button:hover {
  transform: translateY(-3px);
  background: var(--primary-dark);
  box-shadow: 0 12px 25px rgba(11, 61, 46, 0.18);
}

.save-account-button:active {
  transform: translateY(-1px);
}

.account-saved-message {
  display: flex;
  align-items: center;
  gap: 7px;
  color: var(--primary);
  font-size: 0.78rem;
  font-weight: 700;
  animation: accountMessageEnter 0.35s ease both;
}

.account-saved-message span {
  width: 22px;
  height: 22px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(11, 61, 46, 0.1);
  color: var(--primary);
}


/* =========================================================
   SIDEBAR
   ========================================================= */

.account-sidebar {
  padding: 25px;
  border: 1px solid var(--border);
  border-radius: 22px;
  background: var(--white);
  box-shadow: 0 15px 45px rgba(16, 37, 29, 0.06);
  animation: accountCardEnter 0.7s 0.2s ease both;
}

.account-sidebar-header {
  padding: 4px 5px 18px;
}

.account-sidebar-header p {
  margin: 0 0 6px;
  color: var(--secondary);
  font-size: 0.68rem;
  font-weight: 800;
  letter-spacing: 1.5px;
}

.account-sidebar-header h2 {
  margin: 0;
  color: var(--primary-dark);
  font-size: 1.35rem;
}


/* =========================================================
   MENU ITEMS
   ========================================================= */

.account-menu-item {
  min-height: 68px;
  padding: 10px 12px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 15px;
  border-top: 1px solid var(--border);
  color: inherit;
  text-decoration: none;
  transition:
    background 0.3s ease,
    padding 0.3s ease,
    transform 0.3s ease;
}

.account-menu-item:hover {
  padding-left: 17px;
  background: rgba(11, 61, 46, 0.035);
}

.account-menu-item > div {
  display: flex;
  align-items: center;
  gap: 12px;
  min-width: 0;
}

.account-menu-icon {
  width: 38px;
  height: 38px;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 10px;
  background: var(--background);
  color: var(--primary);
  font-size: 0.9rem;
  transition:
    background 0.3s ease,
    transform 0.3s ease;
}

.account-menu-item:hover .account-menu-icon {
  background: rgba(201, 162, 39, 0.13);
  transform: scale(1.06);
}

.account-menu-item > div > span:last-child {
  min-width: 0;
}

.account-menu-item > div > span:last-child strong {
  display: block;
  color: var(--primary-dark);
  font-size: 0.8rem;
}

.account-menu-item > div > span:last-child small {
  display: block;
  max-width: 200px;
  margin-top: 4px;
  overflow: hidden;
  color: var(--muted);
  font-size: 0.68rem;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.account-menu-arrow {
  flex-shrink: 0;
  color: var(--secondary);
  font-size: 1rem;
  transition:
    transform 0.3s ease,
    color 0.3s ease;
}

.account-menu-item:hover .account-menu-arrow {
  transform: translateX(5px);
  color: var(--primary);
}


/* =========================================================
   SIDEBAR FOOTER
   ========================================================= */

.account-sidebar-footer {
  margin-top: 17px;
  padding: 18px;
  border-radius: 13px;
  background: var(--primary-dark);
}

.account-sidebar-footer > span {
  color: var(--secondary);
  font-size: 0.68rem;
  font-weight: 900;
  letter-spacing: 1.5px;
}

.account-sidebar-footer p {
  margin: 8px 0 0;
  color: rgba(255, 255, 255, 0.63);
  font-size: 0.72rem;
  line-height: 1.6;
}


/* =========================================================
   ANIMATIONS
   ========================================================= */

@keyframes accountPageEnter {
  from {
    opacity: 0;
    transform: translateY(18px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes accountCardEnter {
  from {
    opacity: 0;
    transform: translateY(20px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes accountMessageEnter {
  from {
    opacity: 0;
    transform: translateY(-6px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}


/* =========================================================
   TABLET
   ========================================================= */

@media (max-width: 950px) {
  .account-header {
    align-items: flex-start;
    flex-direction: column;
  }

  .account-profile-mini {
    width: 100%;
    box-sizing: border-box;
  }

  .account-content {
    grid-template-columns: 1fr;
  }

  .account-sidebar {
    order: 2;
  }
}


/* =========================================================
   MOBILE
   ========================================================= */

@media (max-width: 650px) {
  .account-page {
    padding: 45px 5%;
  }

  .account-header h1 {
    font-size: 2.5rem;
  }

  .account-card {
    padding: 23px;
    border-radius: 18px;
  }

  .account-sidebar {
    padding: 20px;
    border-radius: 18px;
  }

  .account-form-row {
    grid-template-columns: 1fr;
    gap: 0;
  }

  .account-card-header {
    align-items: flex-start;
  }

  .account-card-header h2 {
    font-size: 1.3rem;
  }

  .account-form-footer {
    align-items: stretch;
    flex-direction: column;
  }

  .save-account-button {
    width: 100%;
  }

  .account-saved-message {
    justify-content: center;
  }
}


/* =========================================================
   SMALL MOBILE
   ========================================================= */

@media (max-width: 420px) {
  .account-page {
    padding: 35px 4%;
  }

  .account-header h1 {
    font-size: 2.2rem;
  }

  .account-profile-mini {
    min-width: 0;
    padding: 13px;
  }

  .account-avatar {
    width: 44px;
    height: 44px;
  }

  .account-card {
    padding: 19px;
  }

  .account-card-icon {
    width: 38px;
    height: 38px;
  }

  .account-menu-item {
    padding: 10px 5px;
  }

  .account-menu-item:hover {
    padding-left: 10px;
  }

  .account-menu-item > div {
    gap: 9px;
  }

  .account-menu-icon {
    width: 34px;
    height: 34px;
  }

  .account-menu-item > div > span:last-child small {
    max-width: 145px;
  }
}


/* =========================================================
   REDUCED MOTION
   ========================================================= */

@media (prefers-reduced-motion: reduce) {
  .account-page,
  .account-card,
  .account-sidebar,
  .account-error-message,
  .account-saved-message {
    animation: none;
  }

  .account-form-group input,
  .save-account-button,
  .account-menu-item,
  .account-menu-icon,
  .account-menu-arrow {
    transition: none;
  }
}


/* =========================================================
ABS CUT — CUSTOM ORDER PAGE
PROFESSIONAL VERSION
========================================================= */

.custom-order-page {
min-height: 100vh;
padding: 70px 5%;
background:
radial-gradient(
circle at 5% 5%,
rgba(201, 162, 39, 0.08),
transparent 28%
),
radial-gradient(
circle at 95% 15%,
rgba(11, 61, 46, 0.08),
transparent 30%
),
var(--background);
color: var(--text);
animation: customOrderPageEnter 0.7s ease both;
}

/* =========================================================
HEADER / HERO
========================================================= */

.custom-order-header {
max-width: 1250px;
margin: 0 auto 55px;
display: grid;
grid-template-columns: minmax(0, 1fr) auto;
align-items: center;
gap: 50px;
}

.custom-order-header > div:first-child {
max-width: 850px;
}

.custom-order-label {
margin: 0 0 14px;
color: var(--secondary);
font-size: 0.75rem;
font-weight: 800;
letter-spacing: 0.2em;
text-transform: uppercase;
}

.custom-order-header h1 {
margin: 0;
max-width: 850px;
color: var(--primary-dark);
font-size: clamp(2.8rem, 5vw, 5rem);
line-height: 0.98;
letter-spacing: -0.045em;
font-weight: 850;
}

.custom-order-intro {
max-width: 720px;
margin: 22px 0 0;
color: var(--muted);
font-size: 1rem;
line-height: 1.75;
}

/* =========================================================
HERO BADGE
========================================================= */

.custom-order-header-badge {
min-width: 230px;
padding: 25px 28px;
border-left: 2px solid var(--secondary);
background: rgba(255, 255, 255, 0.55);
box-shadow: 0 15px 40px rgba(16, 37, 29, 0.05);
animation: customBadgeEnter 0.8s 0.15s ease both;
}

.custom-order-header-badge span {
display: block;
margin-bottom: 8px;
color: var(--secondary);
font-size: 1.1rem;
}

.custom-order-header-badge strong {
display: block;
color: var(--primary-dark);
font-size: 0.78rem;
letter-spacing: 0.14em;
}

.custom-order-header-badge small {
display: block;
margin-top: 7px;
color: var(--muted);
font-size: 0.76rem;
line-height: 1.5;
}

/* =========================================================
MAIN LAYOUT
========================================================= */

.custom-order-layout {
max-width: 1250px;
margin: 0 auto;
display: grid;
grid-template-columns: minmax(0, 1fr) 330px;
gap: 32px;
align-items: start;
}

/* =========================================================
FORM
========================================================= */

.custom-order-form {
min-width: 0;
display: flex;
flex-direction: column;
gap: 18px;
}

/* =========================================================
FORM CARD
========================================================= */

.custom-order-card {
position: relative;
padding: 32px 34px 35px;
background: var(--white);
border: 1px solid rgba(11, 61, 46, 0.08);
border-radius: 18px;
box-shadow: 0 12px 35px rgba(16, 37, 29, 0.055);
overflow: hidden;
animation: customCardEnter 0.7s ease both;
transition:
transform 0.3s ease,
box-shadow 0.3s ease,
border-color 0.3s ease;
}

.custom-order-card::before {
content: "";
position: absolute;
top: 0;
left: 0;
width: 4px;
height: 100%;
background: linear-gradient(
to bottom,
var(--secondary),
var(--primary)
);
opacity: 0.8;
}

.custom-order-card:hover {
transform: translateY(-2px);
border-color: rgba(11, 61, 46, 0.15);
box-shadow: 0 18px 45px rgba(16, 37, 29, 0.08);
}

/* =========================================================
CARD HEADING
========================================================= */

.custom-order-card-heading {
display: flex;
align-items: flex-start;
gap: 17px;
margin-bottom: 28px;
}

.custom-order-step {
width: 46px;
height: 46px;
flex-shrink: 0;
display: grid;
place-items: center;
border-radius: 12px;
background: var(--primary);
color: var(--white);
font-size: 0.78rem;
font-weight: 800;
letter-spacing: 0.08em;
box-shadow: 0 8px 20px rgba(11, 61, 46, 0.18);
transition:
transform 0.3s ease,
background 0.3s ease;
}

.custom-order-card:hover .custom-order-step {
transform: rotate(-3deg) scale(1.04);
background: var(--primary-dark);
}

.custom-order-card-heading p {
margin: 0 0 5px;
color: var(--secondary);
font-size: 0.68rem;
font-weight: 800;
letter-spacing: 0.17em;
}

.custom-order-card-heading h2 {
margin: 0;
color: var(--primary-dark);
font-size: 1.4rem;
line-height: 1.2;
letter-spacing: -0.02em;
}

.custom-order-card-heading span {
display: block;
margin-top: 7px;
color: var(--muted);
font-size: 0.84rem;
line-height: 1.55;
}

/* =========================================================
FORM GROUP
========================================================= */

.custom-form-group {
display: flex;
flex-direction: column;
gap: 9px;
}

.custom-form-group label {
color: var(--text);
font-size: 0.82rem;
font-weight: 750;
}

.custom-form-group input,
.custom-form-group select,
.custom-form-group textarea {
width: 100%;
border: 1px solid var(--border);
border-radius: 11px;
background: #fff;
color: var(--text);
font: inherit;
outline: none;
transition:
border-color 0.25s ease,
box-shadow 0.25s ease,
background 0.25s ease,
transform 0.25s ease;
}

.custom-form-group input,
.custom-form-group select {
min-height: 54px;
padding: 0 16px;
}

.custom-form-group textarea {
min-height: 145px;
padding: 15px 16px;
resize: vertical;
line-height: 1.65;
}

.custom-form-group input::placeholder,
.custom-form-group textarea::placeholder {
color: #a2aaa6;
}

.custom-form-group input:hover,
.custom-form-group select:hover,
.custom-form-group textarea:hover {
border-color: rgba(11, 61, 46, 0.35);
}

.custom-form-group input:focus,
.custom-form-group select:focus,
.custom-form-group textarea:focus {
border-color: var(--primary);
background: #fff;
box-shadow:
0 0 0 4px rgba(11, 61, 46, 0.07),
0 8px 20px rgba(16, 37, 29, 0.04);
transform: translateY(-1px);
}

.custom-form-group small {
color: var(--muted);
font-size: 0.73rem;
line-height: 1.5;
}

/* =========================================================
TWO COLUMN FORM ROW
========================================================= */

.custom-form-row {
display: grid;
grid-template-columns: repeat(2, minmax(0, 1fr));
gap: 20px;
}

/* =========================================================
SELECT
========================================================= */

.custom-form-group select {
appearance: auto;
cursor: pointer;
}

/* =========================================================
EMBROIDERY / MONOGRAM OPTIONS
========================================================= */

.custom-option-group {
margin-bottom: 24px;
}

.custom-option-group:last-child {
margin-bottom: 0;
}

.custom-option-group > label:first-child {
display: block;
margin-bottom: 11px;
color: var(--text);
font-size: 0.82rem;
font-weight: 750;
}

.custom-radio-options {
display: grid;
grid-template-columns: repeat(2, minmax(0, 1fr));
gap: 12px;
}

.custom-radio-options > label {
position: relative;
min-height: 58px;
padding: 0 18px;
display: flex;
align-items: center;
gap: 11px;
border: 1px solid var(--border);
border-radius: 11px;
background: #fff;
color: var(--text);
cursor: pointer;
transition:
border-color 0.25s ease,
background 0.25s ease,
box-shadow 0.25s ease,
transform 0.25s ease;
}

.custom-radio-options > label:hover {
border-color: rgba(11, 61, 46, 0.45);
transform: translateY(-2px);
box-shadow: 0 8px 22px rgba(16, 37, 29, 0.06);
}

.custom-radio-options > label.selected {
border-color: var(--primary);
background: rgba(11, 61, 46, 0.055);
box-shadow: 0 8px 22px rgba(11, 61, 46, 0.08);
}

.custom-radio-options > label.selected::before {
content: "";
width: 17px;
height: 17px;
flex-shrink: 0;
border-radius: 50%;
background: var(--primary);
box-shadow: inset 0 0 0 4px #fff;
}

.custom-radio-options > label:not(.selected)::before {
content: "";
width: 17px;
height: 17px;
flex-shrink: 0;
border: 2px solid #b8c0bc;
border-radius: 50%;
}

.custom-radio-options input {
position: absolute;
opacity: 0;
pointer-events: none;
}

/* =========================================================
MONOGRAM
========================================================= */

.custom-monogram-field {
margin-top: 5px;
padding: 18px;
border: 1px solid rgba(201, 162, 39, 0.3);
border-radius: 13px;
background:
linear-gradient(
135deg,
rgba(201, 162, 39, 0.08),
rgba(201, 162, 39, 0.025)
);
animation: monogramEnter 0.35s ease both;
}

.custom-monogram-field input {
background: rgba(255, 255, 255, 0.9);
}

/* =========================================================
FILE UPLOAD
========================================================= */

.custom-file-upload {
position: relative;
}

.custom-file-upload input[type="file"] {
position: absolute;
width: 1px;
height: 1px;
opacity: 0;
overflow: hidden;
pointer-events: none;
}

.custom-file-upload label {
min-height: 185px;
padding: 30px 20px;
display: flex;
flex-direction: column;
align-items: center;
justify-content: center;
text-align: center;
border: 2px dashed rgba(11, 61, 46, 0.22);
border-radius: 15px;
background:
linear-gradient(
135deg,
rgba(11, 61, 46, 0.025),
rgba(201, 162, 39, 0.035)
);
cursor: pointer;
transition:
border-color 0.3s ease,
background 0.3s ease,
transform 0.3s ease,
box-shadow 0.3s ease;
}

.custom-file-upload label:hover {
border-color: var(--primary);
background: rgba(11, 61, 46, 0.045);
transform: translateY(-2px);
box-shadow: 0 12px 28px rgba(16, 37, 29, 0.06);
}

.custom-upload-icon {
width: 52px;
height: 52px;
margin-bottom: 13px;
display: grid;
place-items: center;
border-radius: 50%;
background: var(--primary);
color: var(--white);
font-size: 1.25rem;
font-weight: 500;
box-shadow: 0 8px 20px rgba(11, 61, 46, 0.18);
transition:
transform 0.3s ease,
background 0.3s ease;
}

.custom-file-upload label:hover .custom-upload-icon {
transform: translateY(-3px);
background: var(--primary-dark);
}

.custom-file-upload strong {
max-width: 90%;
overflow: hidden;
color: var(--primary-dark);
font-size: 0.92rem;
text-overflow: ellipsis;
white-space: nowrap;
}

.custom-file-upload small {
margin-top: 7px;
color: var(--muted);
font-size: 0.73rem;
}

/* =========================================================
ERROR
========================================================= */

.custom-order-error {
padding: 15px 18px;
display: flex;
align-items: center;
gap: 11px;
border: 1px solid rgba(170, 50, 50, 0.2);
border-radius: 12px;
background: rgba(170, 50, 50, 0.055);
color: #9b3030;
animation: customErrorEnter 0.35s ease both;
}

.custom-order-error span {
width: 24px;
height: 24px;
flex-shrink: 0;
display: grid;
place-items: center;
border-radius: 50%;
background: #9b3030;
color: #fff;
font-size: 0.75rem;
font-weight: 800;
}

.custom-order-error p {
margin: 0;
font-size: 0.83rem;
line-height: 1.5;
}

/* =========================================================
SUBMIT AREA
========================================================= */

.custom-submit-area {
padding: 10px 3px 0;
text-align: center;
}

.custom-submit-button {
width: 100%;
min-height: 60px;
padding: 0 22px;
display: flex;
align-items: center;
justify-content: space-between;
gap: 20px;
border: none;
border-radius: 13px;
background: var(--primary);
color: var(--white);
font: inherit;
font-size: 0.82rem;
font-weight: 800;
letter-spacing: 0.1em;
cursor: pointer;
box-shadow: 0 13px 30px rgba(11, 61, 46, 0.2);
transition:
background 0.25s ease,
transform 0.25s ease,
box-shadow 0.25s ease;
}

.custom-submit-button span {
padding-left: 10px;
}

.custom-submit-button strong {
width: 38px;
height: 38px;
display: grid;
place-items: center;
border-radius: 50%;
background: rgba(255, 255, 255, 0.12);
font-size: 1.05rem;
transition:
transform 0.25s ease,
background 0.25s ease;
}

.custom-submit-button:hover:not(:disabled) {
background: var(--primary-dark);
transform: translateY(-3px);
box-shadow: 0 18px 38px rgba(11, 61, 46, 0.25);
}

.custom-submit-button:hover:not(:disabled) strong {
transform: translateX(4px);
background: rgba(255, 255, 255, 0.18);
}

.custom-submit-button:active:not(:disabled) {
transform: translateY(-1px);
}

.custom-submit-button:focus-visible {
outline: 3px solid rgba(201, 162, 39, 0.45);
outline-offset: 3px;
}

.custom-submit-button:disabled {
cursor: default;
background: var(--secondary);
color: var(--primary-dark);
box-shadow: 0 10px 25px rgba(201, 162, 39, 0.18);
}

.custom-submit-area > p {
max-width: 600px;
margin: 13px auto 0;
color: var(--muted);
font-size: 0.73rem;
line-height: 1.55;
}

/* =========================================================
SIDEBAR
========================================================= */

.custom-order-sidebar {
position: sticky;
top: 25px;
display: flex;
flex-direction: column;
gap: 18px;
}

/* =========================================================
SIDEBAR CARD
========================================================= */

.custom-sidebar-card {
position: relative;
padding: 27px;
border-radius: 18px;
background: var(--primary-dark);
color: var(--white);
box-shadow: 0 15px 40px rgba(16, 37, 29, 0.12);
overflow: hidden;
animation: sidebarEnter 0.75s ease both;
}

.custom-sidebar-card::before {
content: "";
position: absolute;
width: 150px;
height: 150px;
top: -90px;
right: -60px;
border: 1px solid rgba(201, 162, 39, 0.25);
border-radius: 50%;
}

.custom-sidebar-card::after {
content: "";
position: absolute;
width: 100px;
height: 100px;
bottom: -65px;
left: -45px;
border: 1px solid rgba(255, 255, 255, 0.06);
border-radius: 50%;
}

/* =========================================================
SIDEBAR HIGHLIGHT
========================================================= */

.custom-sidebar-highlight {
min-height: 265px;
padding: 31px;
display: flex;
flex-direction: column;
justify-content: center;
background:
radial-gradient(
circle at 90% 10%,
rgba(201, 162, 39, 0.16),
transparent 32%
),
var(--primary-dark);
}

.custom-sidebar-icon {
position: relative;
z-index: 1;
margin-bottom: 17px;
color: var(--secondary);
font-size: 1rem;
}

.custom-sidebar-highlight > p {
position: relative;
z-index: 1;
margin: 0 0 10px;
color: var(--secondary);
font-size: 0.68rem;
font-weight: 800;
letter-spacing: 0.18em;
}

.custom-sidebar-highlight h2 {
position: relative;
z-index: 1;
margin: 0;
color: #fff;
font-size: 1.85rem;
line-height: 1.12;
letter-spacing: -0.025em;
}

.custom-sidebar-highlight > span:last-child {
position: relative;
z-index: 1;
display: block;
margin-top: 17px;
color: rgba(255, 255, 255, 0.65);
font-size: 0.78rem;
line-height: 1.65;
}

/* =========================================================
SIDEBAR TITLE
========================================================= */

.custom-sidebar-title {
position: relative;
z-index: 1;
margin: 0 0 20px;
color: var(--secondary);
font-size: 0.68rem;
font-weight: 800;
letter-spacing: 0.17em;
}

/* =========================================================
PROCESS
========================================================= */

.custom-process {
position: relative;
z-index: 1;
}

.custom-process > div {
display: grid;
grid-template-columns: 38px 1fr;
gap: 12px;
padding: 15px 0;
border-bottom: 1px solid rgba(255, 255, 255, 0.09);
}

.custom-process > div:first-child {
padding-top: 0;
}

.custom-process > div:last-child {
padding-bottom: 0;
border-bottom: none;
}

.custom-process strong {
color: var(--secondary);
font-size: 0.76rem;
font-weight: 800;
}

.custom-process span {
color: rgba(255, 255, 255, 0.72);
font-size: 0.76rem;
line-height: 1.55;
}

/* =========================================================
HELP
========================================================= */

.custom-help-text {
position: relative;
z-index: 1;
margin: 0;
color: rgba(255, 255, 255, 0.65);
font-size: 0.77rem;
line-height: 1.7;
}

.custom-contact-link {
position: relative;
z-index: 1;
margin-top: 20px;
padding: 12px 15px;
display: flex;
align-items: center;
justify-content: space-between;
gap: 10px;
border: 1px solid rgba(201, 162, 39, 0.45);
border-radius: 9px;
color: var(--secondary);
font-size: 0.72rem;
font-weight: 800;
letter-spacing: 0.08em;
text-decoration: none;
transition:
background 0.25s ease,
border-color 0.25s ease,
color 0.25s ease,
transform 0.25s ease;
}

.custom-contact-link span {
font-size: 1rem;
transition: transform 0.25s ease;
}

.custom-contact-link:hover {
border-color: var(--secondary);
background: var(--secondary);
color: var(--primary-dark);
transform: translateY(-2px);
}

.custom-contact-link:hover span {
transform: translateX(4px);
}

/* =========================================================
ANIMATIONS
========================================================= */

@keyframes customOrderPageEnter {
from {
opacity: 0;
}

to {
opacity: 1;
}
}

@keyframes customCardEnter {
from {
opacity: 0;
transform: translateY(20px);
}

to {
opacity: 1;
transform: translateY(0);
}
}

@keyframes customBadgeEnter {
from {
opacity: 0;
transform: translateX(20px);
}

to {
opacity: 1;
transform: translateX(0);
}
}

@keyframes sidebarEnter {
from {
opacity: 0;
transform: translateX(20px);
}

to {
opacity: 1;
transform: translateX(0);
}
}

@keyframes monogramEnter {
from {
opacity: 0;
transform: translateY(-8px);
}

to {
opacity: 1;
transform: translateY(0);
}
}

@keyframes customErrorEnter {
from {
opacity: 0;
transform: translateY(-7px);
}

to {
opacity: 1;
transform: translateY(0);
}
}

/* =========================================================
TABLET
========================================================= */

@media (max-width: 1050px) {
.custom-order-page {
padding: 55px 4%;
}

.custom-order-header {
grid-template-columns: 1fr;
gap: 25px;
}

.custom-order-header-badge {
width: fit-content;
}

.custom-order-layout {
grid-template-columns: 1fr;
}

.custom-order-sidebar {
position: static;
display: grid;
grid-template-columns: 1.2fr 1fr;
align-items: start;
}

.custom-sidebar-highlight {
grid-row: span 2;
}
}

/* =========================================================
MOBILE
========================================================= */

@media (max-width: 700px) {
.custom-order-page {
padding: 40px 16px;
}

.custom-order-header {
margin-bottom: 35px;
}

.custom-order-header h1 {
font-size: clamp(2.4rem, 12vw, 3.5rem);
}

.custom-order-intro {
margin-top: 17px;
font-size: 0.88rem;
line-height: 1.65;
}

.custom-order-header-badge {
width: 100%;
min-width: 0;
padding: 20px;
}

.custom-order-layout {
gap: 20px;
}

.custom-order-card {
padding: 25px 20px 28px;
border-radius: 16px;
}

.custom-order-card-heading {
gap: 13px;
margin-bottom: 22px;
}

.custom-order-step {
width: 40px;
height: 40px;
border-radius: 10px;
font-size: 0.7rem;
}

.custom-order-card-heading h2 {
font-size: 1.18rem;
}

.custom-order-card-heading span {
font-size: 0.78rem;
}

.custom-form-row {
grid-template-columns: 1fr;
gap: 18px;
}

.custom-radio-options {
grid-template-columns: 1fr 1fr;
}

.custom-sidebar {
grid-template-columns: 1fr;
}

.custom-order-sidebar {
grid-template-columns: 1fr;
}

.custom-sidebar-highlight {
grid-row: auto;
}

.custom-sidebar-highlight h2 {
font-size: 1.65rem;
}
}

/* =========================================================
SMALL MOBILE
========================================================= */

@media (max-width: 430px) {
.custom-order-page {
padding: 30px 12px;
}

.custom-order-header h1 {
font-size: 2.25rem;
}

.custom-order-header-badge {
padding: 18px;
}

.custom-order-card {
padding: 22px 16px 25px;
}

.custom-radio-options {
grid-template-columns: 1fr;
}

.custom-file-upload label {
min-height: 165px;
padding: 25px 15px;
}

.custom-submit-button {
min-height: 56px;
font-size: 0.73rem;
}

.custom-submit-button strong {
width: 34px;
height: 34px;
}

.custom-sidebar-card {
padding: 22px;
}
}

/* =========================================================
REDUCED MOTION
========================================================= */

@media (prefers-reduced-motion: reduce) {
.custom-order-page,
.custom-order-card,
.custom-order-header-badge,
.custom-sidebar-card,
.custom-monogram-field,
.custom-order-error {
animation: none;
}

.custom-order-card,
.custom-order-step,
.custom-form-group input,
.custom-form-group select,
.custom-form-group textarea,
.custom-radio-options > label,
.custom-file-upload label,
.custom-upload-icon,
.custom-submit-button,
.custom-submit-button strong,
.custom-contact-link,
.custom-contact-link span {
transition: none;
}
}

/* =========================================================
   ABS CUT — REGISTER PAGE
   PROFESSIONAL VERSION
========================================================= */

.register-page {
  min-height: 100vh;
  padding: 70px 5%;
  display: grid;
  grid-template-columns: minmax(0, 0.9fr) minmax(500px, 1.1fr);
  gap: 70px;
  align-items: center;

  background:
    radial-gradient(
      circle at 5% 5%,
      rgba(201, 162, 39, 0.09),
      transparent 28%
    ),
    radial-gradient(
      circle at 95% 15%,
      rgba(11, 61, 46, 0.09),
      transparent 30%
    ),
    var(--background);

  color: var(--text);
  animation: registerPageEnter 0.7s ease both;
}


/* =========================================================
   INTRO SECTION
========================================================= */

.register-intro {
  max-width: 620px;
  width: 100%;
  justify-self: end;
  animation: registerIntroEnter 0.8s ease both;
}


/* =========================================================
   BRAND
========================================================= */

.register-brand {
  display: flex;
  align-items: center;
  gap: 4px;
  margin-bottom: 35px;

  color: var(--primary-dark);
  font-size: 1.45rem;
  letter-spacing: 0.12em;
  line-height: 1;
}

.register-brand span {
  color: var(--primary);
  font-weight: 500;
}

.register-brand strong {
  color: var(--primary-dark);
  font-weight: 900;
}


/* =========================================================
   INTRO LABEL
========================================================= */

.register-label {
  margin: 0 0 15px;

  color: var(--secondary);
  font-size: 0.72rem;
  font-weight: 800;
  letter-spacing: 0.2em;
  text-transform: uppercase;
}


/* =========================================================
   INTRO HEADING
========================================================= */

.register-intro h1 {
  max-width: 580px;
  margin: 0;

  color: var(--primary-dark);
  font-size: clamp(3.2rem, 5vw, 5.6rem);
  line-height: 0.96;
  letter-spacing: -0.055em;
  font-weight: 850;
}

.register-intro h1 span {
  position: relative;
  color: var(--primary);
}

.register-intro h1 span::after {
  content: "";

  position: absolute;
  left: 0;
  bottom: -7px;

  width: 65px;
  height: 3px;

  border-radius: 10px;
  background: var(--secondary);

  animation: registerHeadingLine 0.8s 0.5s ease both;
}


/* =========================================================
   INTRO DESCRIPTION
========================================================= */

.register-intro-text {
  max-width: 560px;
  margin: 25px 0 38px;

  color: var(--muted);
  font-size: 0.96rem;
  line-height: 1.8;
}


/* =========================================================
   INTRO FEATURES
========================================================= */

.register-intro-feature {
  max-width: 520px;
  min-height: 67px;

  margin-top: 13px;
  padding: 13px 0;

  display: grid;
  grid-template-columns: 46px 1fr;
  align-items: center;
  gap: 15px;

  border-bottom: 1px solid rgba(11, 61, 46, 0.08);

  animation: registerFeatureEnter 0.65s ease both;
}

.register-intro-feature:nth-of-type(1) {
  animation-delay: 0.15s;
}

.register-intro-feature:nth-of-type(2) {
  animation-delay: 0.25s;
}

.register-intro-feature:nth-of-type(3) {
  animation-delay: 0.35s;
}

.register-feature-number {
  width: 42px;
  height: 42px;

  display: grid;
  place-items: center;

  border-radius: 11px;

  background: var(--primary);
  color: var(--white);

  font-size: 0.68rem;
  font-weight: 800;
  letter-spacing: 0.08em;

  box-shadow:
    0 8px 20px rgba(11, 61, 46, 0.16);

  transition:
    transform 0.3s ease,
    background 0.3s ease,
    box-shadow 0.3s ease;
}

.register-intro-feature:hover .register-feature-number {
  transform: rotate(-4deg) scale(1.06);
  background: var(--primary-dark);
  box-shadow:
    0 12px 25px rgba(11, 61, 46, 0.2);
}

.register-intro-feature strong {
  display: block;

  color: var(--primary-dark);
  font-size: 0.82rem;
  font-weight: 800;
}

.register-intro-feature span {
  display: block;
  margin-top: 4px;

  color: var(--muted);
  font-size: 0.75rem;
  line-height: 1.5;
}


/* =========================================================
   REGISTER CARD
========================================================= */

.register-card {
  position: relative;

  width: 100%;
  max-width: 610px;
  justify-self: start;

  padding: 38px 40px 32px;

  background: var(--white);

  border: 1px solid rgba(11, 61, 46, 0.08);
  border-radius: 20px;

  box-shadow:
    0 18px 55px rgba(16, 37, 29, 0.075);

  overflow: hidden;

  animation: registerCardEnter 0.75s 0.12s ease both;

  transition:
    transform 0.3s ease,
    box-shadow 0.3s ease,
    border-color 0.3s ease;
}

.register-card::before {
  content: "";

  position: absolute;

  top: 0;
  left: 0;

  width: 4px;
  height: 100%;

  background:
    linear-gradient(
      to bottom,
      var(--secondary),
      var(--primary)
    );

  opacity: 0.9;
}

.register-card:hover {
  transform: translateY(-2px);

  border-color:
    rgba(11, 61, 46, 0.14);

  box-shadow:
    0 24px 65px rgba(16, 37, 29, 0.1);
}


/* =========================================================
   CARD HEADER
========================================================= */

.register-card-header {
  margin-bottom: 30px;
}

.register-card-header p {
  margin: 0 0 8px;

  color: var(--secondary);
  font-size: 0.67rem;
  font-weight: 800;
  letter-spacing: 0.18em;
}

.register-card-header h2 {
  margin: 0;

  color: var(--primary-dark);
  font-size: 1.65rem;
  line-height: 1.2;
  letter-spacing: -0.025em;
}

.register-card-header span {
  display: block;
  margin-top: 8px;

  color: var(--muted);
  font-size: 0.8rem;
  line-height: 1.55;
}


/* =========================================================
   FORM
========================================================= */

.register-form {
  display: flex;
  flex-direction: column;
  gap: 18px;
}


/* =========================================================
   FORM ROW
========================================================= */

.register-form-row {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18px;
}


/* =========================================================
   FORM GROUP
========================================================= */

.register-form-group {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.register-form-group label {
  color: var(--text);

  font-size: 0.79rem;
  font-weight: 750;
}


/* =========================================================
   INPUTS
========================================================= */

.register-form-group input {
  width: 100%;
  min-height: 54px;

  padding: 0 15px;

  border: 1px solid var(--border);
  border-radius: 11px;

  background: #fff;
  color: var(--text);

  font: inherit;
  font-size: 0.86rem;

  outline: none;

  transition:
    border-color 0.25s ease,
    box-shadow 0.25s ease,
    background 0.25s ease,
    transform 0.25s ease;
}

.register-form-group input::placeholder {
  color: #a2aaa6;
}

.register-form-group input:hover {
  border-color:
    rgba(11, 61, 46, 0.35);
}

.register-form-group input:focus {
  border-color: var(--primary);

  background: #fff;

  box-shadow:
    0 0 0 4px rgba(11, 61, 46, 0.07),
    0 8px 20px rgba(16, 37, 29, 0.04);

  transform: translateY(-1px);
}


/* =========================================================
   PASSWORD WRAPPER
========================================================= */

.register-password-wrapper {
  position: relative;
  width: 100%;
}

.register-password-wrapper input {
  padding-right: 78px;
}


/* =========================================================
   PASSWORD TOGGLE
========================================================= */

.register-password-toggle {
  position: absolute;

  top: 50%;
  right: 11px;

  transform: translateY(-50%);

  min-width: 50px;
  min-height: 32px;

  padding: 0 9px;

  border: none;
  border-radius: 7px;

  background: rgba(11, 61, 46, 0.055);
  color: var(--primary);

  font: inherit;
  font-size: 0.67rem;
  font-weight: 800;

  cursor: pointer;

  transition:
    background 0.25s ease,
    color 0.25s ease,
    transform 0.25s ease;
}

.register-password-toggle:hover {
  background: var(--primary);
  color: var(--white);

  transform:
    translateY(-50%)
    translateY(-1px);
}

.register-password-toggle:focus-visible {
  outline: 2px solid var(--secondary);
  outline-offset: 2px;
}


/* =========================================================
   PASSWORD HELP TEXT
========================================================= */

.register-form-group small {
  color: var(--muted);

  font-size: 0.7rem;
  line-height: 1.5;
}


/* =========================================================
   TERMS
========================================================= */

.register-terms {
  display: grid;
  grid-template-columns: 19px 1fr;
  align-items: start;
  gap: 10px;

  margin-top: 1px;

  cursor: pointer;
}

.register-terms input {
  width: 17px;
  height: 17px;

  margin: 2px 0 0;

  accent-color: var(--primary);

  cursor: pointer;
}

.register-terms span {
  color: var(--muted);

  font-size: 0.72rem;
  line-height: 1.6;
}


/* =========================================================
   ERROR
========================================================= */

.register-error {
  padding: 14px 16px;

  display: flex;
  align-items: center;
  gap: 11px;

  border: 1px solid rgba(170, 50, 50, 0.2);
  border-radius: 12px;

  background: rgba(170, 50, 50, 0.055);
  color: #9b3030;

  animation: registerErrorEnter 0.35s ease both;
}

.register-error strong {
  width: 24px;
  height: 24px;

  flex-shrink: 0;

  display: grid;
  place-items: center;

  border-radius: 50%;

  background: #9b3030;
  color: #fff;

  font-size: 0.72rem;
  font-weight: 800;
}

.register-error p {
  margin: 0;

  font-size: 0.78rem;
  line-height: 1.5;
}


/* =========================================================
   SUCCESS
========================================================= */

.register-success {
  padding: 14px 16px;

  display: flex;
  align-items: center;
  gap: 11px;

  border: 1px solid rgba(11, 61, 46, 0.18);
  border-radius: 12px;

  background: rgba(11, 61, 46, 0.055);
  color: var(--primary);

  animation: registerSuccessEnter 0.4s ease both;
}

.register-success strong {
  width: 24px;
  height: 24px;

  flex-shrink: 0;

  display: grid;
  place-items: center;

  border-radius: 50%;

  background: var(--primary);
  color: var(--white);

  font-size: 0.72rem;
  font-weight: 800;
}

.register-success p {
  margin: 0;

  font-size: 0.78rem;
  line-height: 1.5;
}


/* =========================================================
   SUBMIT BUTTON
========================================================= */

.register-submit-button {
  width: 100%;
  min-height: 60px;

  padding: 0 20px;

  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;

  border: none;
  border-radius: 13px;

  background: var(--primary);
  color: var(--white);

  font: inherit;
  font-size: 0.78rem;
  font-weight: 800;
  letter-spacing: 0.1em;

  cursor: pointer;

  box-shadow:
    0 13px 30px rgba(11, 61, 46, 0.2);

  transition:
    background 0.25s ease,
    transform 0.25s ease,
    box-shadow 0.25s ease;
}

.register-submit-button span {
  padding-left: 9px;
}

.register-submit-button strong {
  width: 38px;
  height: 38px;

  display: grid;
  place-items: center;

  border-radius: 50%;

  background: rgba(255, 255, 255, 0.12);

  font-size: 1.05rem;

  transition:
    transform 0.25s ease,
    background 0.25s ease;
}

.register-submit-button:hover:not(:disabled) {
  background: var(--primary-dark);

  transform: translateY(-3px);

  box-shadow:
    0 18px 38px rgba(11, 61, 46, 0.25);
}

.register-submit-button:hover:not(:disabled) strong {
  transform: translateX(4px);

  background: rgba(255, 255, 255, 0.18);
}

.register-submit-button:active:not(:disabled) {
  transform: translateY(-1px);
}

.register-submit-button:focus-visible {
  outline: 3px solid rgba(201, 162, 39, 0.45);
  outline-offset: 3px;
}

.register-submit-button:disabled {
  cursor: default;

  background: var(--secondary);
  color: var(--primary-dark);

  box-shadow:
    0 10px 25px rgba(201, 162, 39, 0.18);
}


/* =========================================================
   LOGIN LINK
========================================================= */

.register-login {
  margin-top: 25px;
  padding-top: 22px;

  display: flex;
  justify-content: center;
  align-items: center;
  gap: 6px;

  border-top: 1px solid rgba(11, 61, 46, 0.08);

  color: var(--muted);

  font-size: 0.76rem;
}

.register-login a {
  color: var(--primary);

  font-weight: 800;
  text-decoration: none;

  transition:
    color 0.25s ease,
    transform 0.25s ease;
}

.register-login a:hover {
  color: var(--secondary);
}


/* =========================================================
   ANIMATIONS
========================================================= */

@keyframes registerPageEnter {
  from {
    opacity: 0;
  }

  to {
    opacity: 1;
  }
}

@keyframes registerIntroEnter {
  from {
    opacity: 0;
    transform: translateX(-25px);
  }

  to {
    opacity: 1;
    transform: translateX(0);
  }
}

@keyframes registerCardEnter {
  from {
    opacity: 0;
    transform: translateX(25px) translateY(10px);
  }

  to {
    opacity: 1;
    transform: translateX(0) translateY(0);
  }
}

@keyframes registerFeatureEnter {
  from {
    opacity: 0;
    transform: translateY(12px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes registerHeadingLine {
  from {
    width: 0;
    opacity: 0;
  }

  to {
    width: 65px;
    opacity: 1;
  }
}

@keyframes registerErrorEnter {
  from {
    opacity: 0;
    transform: translateY(-7px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes registerSuccessEnter {
  from {
    opacity: 0;
    transform: translateY(-7px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}


/* =========================================================
   TABLET
========================================================= */

@media (max-width: 1050px) {
  .register-page {
    grid-template-columns: 1fr;

    gap: 45px;

    padding: 60px 4%;
  }

  .register-intro,
  .register-card {
    justify-self: center;
  }

  .register-intro {
    max-width: 760px;
  }

  .register-intro h1 {
    font-size: clamp(3rem, 8vw, 5rem);
  }

  .register-intro-text {
    max-width: 650px;
  }

  .register-intro-feature {
    max-width: 650px;
  }

  .register-card {
    max-width: 700px;
  }
}


/* =========================================================
   MOBILE
========================================================= */

@media (max-width: 700px) {
  .register-page {
    padding: 42px 16px;

    gap: 35px;
  }

  .register-intro {
    max-width: 100%;
  }

  .register-brand {
    margin-bottom: 27px;

    font-size: 1.25rem;
  }

  .register-label {
    margin-bottom: 12px;

    font-size: 0.65rem;
  }

  .register-intro h1 {
    font-size: clamp(2.6rem, 12vw, 4rem);
  }

  .register-intro h1 span::after {
    bottom: -5px;
    width: 50px;
  }

  .register-intro-text {
    margin: 20px 0 28px;

    font-size: 0.85rem;
    line-height: 1.7;
  }

  .register-intro-feature {
    min-height: 60px;

    grid-template-columns: 40px 1fr;

    gap: 12px;

    padding: 11px 0;
  }

  .register-feature-number {
    width: 38px;
    height: 38px;

    border-radius: 10px;

    font-size: 0.62rem;
  }

  .register-intro-feature strong {
    font-size: 0.77rem;
  }

  .register-intro-feature span {
    font-size: 0.7rem;
  }

  .register-card {
    max-width: 100%;

    padding: 27px 21px 26px;

    border-radius: 16px;
  }

  .register-card-header {
    margin-bottom: 25px;
  }

  .register-card-header h2 {
    font-size: 1.4rem;
  }

  .register-card-header span {
    font-size: 0.76rem;
  }

  .register-form {
    gap: 17px;
  }

  .register-form-row {
    grid-template-columns: 1fr;

    gap: 17px;
  }

  .register-form-group input {
    min-height: 52px;

    font-size: 0.82rem;
  }

  .register-submit-button {
    min-height: 57px;

    font-size: 0.72rem;
  }

  .register-submit-button strong {
    width: 36px;
    height: 36px;
  }

  .register-login {
    margin-top: 22px;
    padding-top: 20px;

    font-size: 0.72rem;
  }
}


/* =========================================================
   SMALL MOBILE
========================================================= */

@media (max-width: 430px) {
  .register-page {
    padding: 32px 12px;
    gap: 28px;
  }

  .register-brand {
    margin-bottom: 23px;
  }

  .register-intro h1 {
    font-size: 2.45rem;
  }

  .register-intro-text {
    font-size: 0.81rem;
  }

  .register-intro-feature {
    grid-template-columns: 36px 1fr;
    gap: 10px;
  }

  .register-feature-number {
    width: 35px;
    height: 35px;
  }

  .register-card {
    padding: 23px 16px 23px;
    border-radius: 15px;
  }

  .register-card-header h2 {
    font-size: 1.25rem;
  }

  .register-card-header span {
    font-size: 0.72rem;
  }

  .register-form-group label {
    font-size: 0.75rem;
  }

  .register-form-group input {
    min-height: 50px;
    padding: 0 13px;
  }

  .register-password-wrapper input {
    padding-right: 70px;
  }

  .register-password-toggle {
    right: 8px;
    min-width: 46px;
    font-size: 0.62rem;
  }

  .register-terms {
    grid-template-columns: 17px 1fr;
    gap: 8px;
  }

  .register-terms input {
    width: 16px;
    height: 16px;
  }

  .register-terms span {
    font-size: 0.67rem;
  }

  .register-submit-button {
    min-height: 55px;
    padding: 0 15px;

    font-size: 0.67rem;
  }

  .register-submit-button span {
    padding-left: 5px;
  }

  .register-submit-button strong {
    width: 34px;
    height: 34px;
  }

  .register-login {
    flex-direction: column;
    gap: 4px;
  }
}


/* =========================================================
   REDUCED MOTION
========================================================= */

@media (prefers-reduced-motion: reduce) {
  .register-page,
  .register-intro,
  .register-card,
  .register-intro-feature,
  .register-heading-line,
  .register-error,
  .register-success {
    animation: none;
  }

  .register-card,
  .register-feature-number,
  .register-form-group input,
  .register-password-toggle,
  .register-submit-button,
  .register-submit-button strong,
  .register-login a {
    transition: none;
  }
}


/* =========================================================
   ABS CUT — LOGIN PAGE
   Premium Green / Gold Authentication Design
========================================================= */

.login-page {
  min-height: 100vh;
  padding: 70px 5%;

  display: grid;
  grid-template-columns: minmax(0, 0.95fr) minmax(420px, 0.85fr);
  align-items: center;
  gap: 70px;

  position: relative;
  overflow: hidden;

  background:
    radial-gradient(
      circle at 10% 10%,
      rgba(201, 162, 39, 0.08),
      transparent 30%
    ),
    radial-gradient(
      circle at 90% 85%,
      rgba(11, 61, 46, 0.08),
      transparent 32%
    ),
    var(--background);

  animation: loginPageFade 0.8s ease both;
}


/* =========================================================
   BACKGROUND DECORATION
========================================================= */

.login-page::before {
  content: "";
  position: absolute;

  width: 420px;
  height: 420px;

  top: -220px;
  left: -180px;

  border-radius: 50%;

  background:
    radial-gradient(
      circle,
      rgba(201, 162, 39, 0.08),
      transparent 70%
    );

  pointer-events: none;

  animation: loginOrbFloat 9s ease-in-out infinite;
}

.login-page::after {
  content: "";
  position: absolute;

  width: 500px;
  height: 500px;

  right: -280px;
  bottom: -300px;

  border-radius: 50%;

  background:
    radial-gradient(
      circle,
      rgba(11, 61, 46, 0.08),
      transparent 70%
    );

  pointer-events: none;

  animation: loginOrbFloatReverse 11s ease-in-out infinite;
}


/* =========================================================
   LEFT INTRO SECTION
========================================================= */

.login-intro {
  max-width: 650px;

  position: relative;
  z-index: 2;

  animation: loginIntroEnter 0.85s ease 0.1s both;
}


/* =========================================================
   BRAND
========================================================= */

.login-brand {
  display: inline-flex;
  align-items: center;
  gap: 4px;

  margin-bottom: 22px;

  font-size: 24px;
  font-weight: 900;
  letter-spacing: -1px;
}

.login-brand span {
  color: var(--primary-dark);
}

.login-brand strong {
  color: var(--secondary);
}


/* =========================================================
   LABEL
========================================================= */

.login-label {
  margin: 0 0 18px;

  color: var(--secondary);

  font-size: 12px;
  font-weight: 800;

  letter-spacing: 2.5px;
  text-transform: uppercase;
}


/* =========================================================
   MAIN HEADING
========================================================= */

.login-intro h1 {
  margin: 0;

  color: var(--primary-dark);

  font-size: clamp(48px, 6vw, 82px);
  line-height: 0.95;

  font-weight: 900;
  letter-spacing: -4px;
}

.login-intro h1 span {
  color: var(--secondary);

  position: relative;
}

.login-intro h1 span::after {
  content: "";

  position: absolute;

  left: 3px;
  right: 0;
  bottom: -9px;

  height: 3px;

  border-radius: 10px;

  background:
    linear-gradient(
      90deg,
      var(--secondary),
      transparent
    );

  transform-origin: left;

  animation: loginUnderline 0.9s ease 0.9s both;
}


/* =========================================================
   INTRO DESCRIPTION
========================================================= */

.login-intro-text {
  max-width: 540px;

  margin: 30px 0 42px;

  color: var(--muted);

  font-size: 16px;
  line-height: 1.8;
}


/* =========================================================
   INTRO FEATURES
========================================================= */

.login-intro-feature {
  display: grid;
  grid-template-columns: 50px 1fr;
  gap: 18px;

  max-width: 540px;

  padding: 18px 0;

  border-top: 1px solid rgba(11, 61, 46, 0.08);

  animation: loginFeatureEnter 0.65s ease both;
}

.login-intro-feature:nth-of-type(4) {
  animation-delay: 0.15s;
}

.login-intro-feature:nth-of-type(5) {
  animation-delay: 0.25s;
}

.login-intro-feature:nth-of-type(6) {
  animation-delay: 0.35s;
}

.login-intro-feature:last-child {
  border-bottom: 1px solid rgba(11, 61, 46, 0.08);
}

.login-feature-number {
  width: 42px;
  height: 42px;

  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 50%;

  background:
    linear-gradient(
      135deg,
      var(--primary),
      var(--primary-dark)
    );

  color: var(--white);

  font-size: 11px;
  font-weight: 800;

  letter-spacing: 1px;

  box-shadow:
    0 8px 20px rgba(11, 61, 46, 0.15);

  transition:
    transform 0.3s ease,
    box-shadow 0.3s ease;
}

.login-intro-feature:hover .login-feature-number {
  transform: translateY(-3px) rotate(5deg);

  box-shadow:
    0 12px 25px rgba(11, 61, 46, 0.22);
}

.login-intro-feature div:last-child {
  display: flex;
  flex-direction: column;
  gap: 5px;
}

.login-intro-feature strong {
  color: var(--primary-dark);

  font-size: 15px;
  font-weight: 800;
}

.login-intro-feature span {
  color: var(--muted);

  font-size: 13px;
  line-height: 1.6;
}


/* =========================================================
   LOGIN CARD
========================================================= */

.login-card {
  width: 100%;
  max-width: 560px;

  justify-self: end;

  position: relative;
  z-index: 3;

  padding: 42px;

  background: var(--white);

  border: 1px solid rgba(11, 61, 46, 0.08);

  border-radius: 18px;

  box-shadow:
    0 25px 70px rgba(11, 61, 46, 0.10),
    0 8px 25px rgba(0, 0, 0, 0.04);

  overflow: hidden;

  animation: loginCardEnter 0.85s ease 0.15s both;

  transition:
    transform 0.35s ease,
    box-shadow 0.35s ease;
}


/* Premium left accent */

.login-card::before {
  content: "";

  position: absolute;

  top: 0;
  left: 0;
  bottom: 0;

  width: 4px;

  background:
    linear-gradient(
      180deg,
      var(--secondary),
      var(--primary)
    );
}


/* Soft internal glow */

.login-card::after {
  content: "";

  position: absolute;

  width: 220px;
  height: 220px;

  top: -130px;
  right: -110px;

  border-radius: 50%;

  background:
    radial-gradient(
      circle,
      rgba(201, 162, 39, 0.07),
      transparent 70%
    );

  pointer-events: none;
}

.login-card:hover {
  transform: translateY(-3px);

  box-shadow:
    0 30px 80px rgba(11, 61, 46, 0.13),
    0 10px 30px rgba(0, 0, 0, 0.05);
}


/* =========================================================
   CARD HEADER
========================================================= */

.login-card-header {
  position: relative;
  z-index: 2;

  margin-bottom: 34px;
}

.login-card-header p {
  margin: 0 0 10px;

  color: var(--secondary);

  font-size: 11px;
  font-weight: 800;

  letter-spacing: 2px;
  text-transform: uppercase;
}

.login-card-header h2 {
  margin: 0 0 10px;

  color: var(--primary-dark);

  font-size: clamp(28px, 3vw, 38px);
  line-height: 1.1;

  font-weight: 900;

  letter-spacing: -1.5px;
}

.login-card-header span {
  color: var(--muted);

  font-size: 14px;
  line-height: 1.7;
}


/* =========================================================
   FORM
========================================================= */

.login-form {
  position: relative;
  z-index: 2;

  display: flex;
  flex-direction: column;

  gap: 22px;
}


/* =========================================================
   FORM GROUP
========================================================= */

.login-form-group {
  display: flex;
  flex-direction: column;
  gap: 9px;

  animation: loginFieldEnter 0.55s ease both;
}

.login-form-group:nth-child(1) {
  animation-delay: 0.2s;
}

.login-form-group:nth-child(2) {
  animation-delay: 0.3s;
}

.login-form-group label {
  color: var(--primary-dark);

  font-size: 13px;
  font-weight: 800;

  letter-spacing: 0.2px;
}


/* =========================================================
   PASSWORD HEADING
========================================================= */

.login-password-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;

  gap: 15px;
}

.login-forgot-link {
  color: var(--secondary);

  font-size: 12px;
  font-weight: 700;

  text-decoration: none;

  transition:
    color 0.25s ease,
    transform 0.25s ease;
}

.login-forgot-link:hover {
  color: var(--primary-dark);

  transform: translateX(2px);
}


/* =========================================================
   INPUTS
========================================================= */

.login-form-group input {
  width: 100%;
  height: 54px;

  padding: 0 16px;

  box-sizing: border-box;

  border: 1px solid var(--border);

  border-radius: 11px;

  outline: none;

  background: var(--white);

  color: var(--text);

  font-family: inherit;
  font-size: 14px;

  transition:
    border-color 0.25s ease,
    box-shadow 0.25s ease,
    transform 0.25s ease,
    background 0.25s ease;
}

.login-form-group input::placeholder {
  color: var(--muted);

  opacity: 0.65;
}

.login-form-group input:hover {
  border-color: rgba(11, 61, 46, 0.25);
}

.login-form-group input:focus {
  border-color: var(--primary);

  background: var(--white);

  box-shadow:
    0 0 0 4px rgba(11, 61, 46, 0.08),
    0 8px 20px rgba(11, 61, 46, 0.06);

  transform: translateY(-1px);
}


/* =========================================================
   PASSWORD WRAPPER
========================================================= */

.login-password-wrapper {
  position: relative;

  width: 100%;
}

.login-password-wrapper input {
  padding-right: 78px;
}


/* =========================================================
   PASSWORD TOGGLE
========================================================= */

.login-password-toggle {
  position: absolute;

  top: 50%;
  right: 10px;

  transform: translateY(-50%);

  min-width: 55px;
  height: 34px;

  padding: 0 9px;

  display: flex;
  align-items: center;
  justify-content: center;

  border: 0;
  border-radius: 8px;

  background: rgba(11, 61, 46, 0.06);

  color: var(--primary-dark);

  font-family: inherit;

  font-size: 11px;
  font-weight: 800;

  cursor: pointer;

  transition:
    background 0.25s ease,
    color 0.25s ease,
    transform 0.25s ease;
}

.login-password-toggle:hover {
  background: var(--primary);

  color: var(--white);

  transform: translateY(-50%) scale(1.03);
}

.login-password-toggle:focus-visible {
  outline: 2px solid var(--secondary);
  outline-offset: 2px;
}


/* =========================================================
   ERROR MESSAGE
========================================================= */

.login-error {
  display: flex;
  align-items: flex-start;
  gap: 12px;

  padding: 14px 15px;

  border: 1px solid rgba(180, 50, 50, 0.16);

  border-radius: 11px;

  background: rgba(180, 50, 50, 0.05);

  animation: loginMessageEnter 0.35s ease both;
}

.login-error strong {
  width: 24px;
  height: 24px;

  flex-shrink: 0;

  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 50%;

  background: rgba(180, 50, 50, 0.12);

  color: #a52b2b;

  font-size: 12px;
}

.login-error p {
  margin: 2px 0 0;

  color: #8f2929;

  font-size: 13px;
  line-height: 1.5;
}


/* =========================================================
   SUCCESS MESSAGE
========================================================= */

.login-success {
  display: flex;
  align-items: flex-start;
  gap: 12px;

  padding: 14px 15px;

  border: 1px solid rgba(11, 61, 46, 0.14);

  border-radius: 11px;

  background: rgba(11, 61, 46, 0.06);

  animation: loginMessageEnter 0.35s ease both;
}

.login-success strong {
  width: 24px;
  height: 24px;

  flex-shrink: 0;

  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 50%;

  background: rgba(11, 61, 46, 0.12);

  color: var(--primary);

  font-size: 12px;
}

.login-success p {
  margin: 2px 0 0;

  color: var(--primary-dark);

  font-size: 13px;
  line-height: 1.5;
}


/* =========================================================
   LOGIN BUTTON
========================================================= */

.login-submit-button {
  width: 100%;
  min-height: 60px;

  padding: 8px 9px 8px 20px;

  display: flex;
  align-items: center;
  justify-content: space-between;

  border: none;
  border-radius: 13px;

  background:
    linear-gradient(
      135deg,
      var(--primary),
      var(--primary-dark)
    );

  color: var(--white);

  font-family: inherit;

  font-size: 12px;
  font-weight: 900;

  letter-spacing: 1px;

  cursor: pointer;

  box-shadow:
    0 10px 25px rgba(11, 61, 46, 0.16);

  transition:
    transform 0.3s ease,
    box-shadow 0.3s ease,
    background 0.3s ease;
}

.login-submit-button strong {
  width: 44px;
  height: 44px;

  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 50%;

  background: rgba(255, 255, 255, 0.14);

  font-size: 20px;

  transition:
    transform 0.3s ease,
    background 0.3s ease;
}

.login-submit-button:hover:not(:disabled) {
  background:
    linear-gradient(
      135deg,
      var(--primary-dark),
      var(--primary)
    );

  transform: translateY(-2px);

  box-shadow:
    0 15px 30px rgba(11, 61, 46, 0.22);
}

.login-submit-button:hover:not(:disabled) strong {
  transform: translateX(4px);

  background: rgba(201, 162, 39, 0.2);
}

.login-submit-button:active:not(:disabled) {
  transform: translateY(0);
}

.login-submit-button:focus-visible {
  outline: 3px solid rgba(201, 162, 39, 0.55);
  outline-offset: 4px;
}

.login-submit-button:disabled {
  background: var(--secondary);

  cursor: not-allowed;

  opacity: 0.9;

  box-shadow: none;
}


/* =========================================================
   REGISTER LINK
========================================================= */

.login-register {
  position: relative;
  z-index: 2;

  margin-top: 28px;
  padding-top: 23px;

  display: flex;
  align-items: center;
  justify-content: center;

  gap: 6px;

  border-top: 1px solid rgba(11, 61, 46, 0.08);

  font-size: 13px;
}

.login-register span {
  color: var(--muted);
}

.login-register a {
  color: var(--primary);

  font-weight: 800;

  text-decoration: none;

  transition:
    color 0.25s ease,
    transform 0.25s ease;
}

.login-register a:hover {
  color: var(--secondary);

  transform: translateX(2px);
}


/* =========================================================
   ANIMATIONS
========================================================= */

@keyframes loginPageFade {
  from {
    opacity: 0;
  }

  to {
    opacity: 1;
  }
}

@keyframes loginIntroEnter {
  from {
    opacity: 0;
    transform: translateX(-35px);
  }

  to {
    opacity: 1;
    transform: translateX(0);
  }
}

@keyframes loginCardEnter {
  from {
    opacity: 0;
    transform: translateX(35px) translateY(15px);
  }

  to {
    opacity: 1;
    transform: translateX(0) translateY(0);
  }
}

@keyframes loginFeatureEnter {
  from {
    opacity: 0;
    transform: translateY(15px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes loginFieldEnter {
  from {
    opacity: 0;
    transform: translateY(10px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes loginMessageEnter {
  from {
    opacity: 0;
    transform: translateY(-6px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes loginUnderline {
  from {
    opacity: 0;
    transform: scaleX(0);
  }

  to {
    opacity: 1;
    transform: scaleX(1);
  }
}

@keyframes loginOrbFloat {
  0%,
  100% {
    transform: translate(0, 0);
  }

  50% {
    transform: translate(25px, 20px);
  }
}

@keyframes loginOrbFloatReverse {
  0%,
  100% {
    transform: translate(0, 0);
  }

  50% {
    transform: translate(-25px, -20px);
  }
}


/* =========================================================
   TABLET
========================================================= */

@media (max-width: 1050px) {
  .login-page {
    grid-template-columns: 1fr;

    gap: 50px;

    padding: 60px 6%;
  }

  .login-intro {
    max-width: 750px;
  }

  .login-card {
    justify-self: start;

    max-width: 680px;
  }

  .login-intro h1 {
    font-size: clamp(50px, 8vw, 72px);
  }
}


/* =========================================================
   MOBILE
========================================================= */

@media (max-width: 700px) {
  .login-page {
    padding: 45px 5%;

    gap: 35px;
  }

  .login-intro h1 {
    font-size: clamp(44px, 14vw, 62px);

    letter-spacing: -3px;
  }

  .login-intro-text {
    margin: 25px 0 30px;

    font-size: 14px;
  }

  .login-intro-feature {
    grid-template-columns: 44px 1fr;

    gap: 14px;

    padding: 15px 0;
  }

  .login-feature-number {
    width: 38px;
    height: 38px;
  }

  .login-card {
    padding: 30px 24px;

    border-radius: 16px;
  }

  .login-card-header {
    margin-bottom: 28px;
  }

  .login-card-header h2 {
    font-size: 30px;
  }

  .login-form {
    gap: 19px;
  }

  .login-register {
    flex-direction: column;

    gap: 5px;
  }
}


/* =========================================================
   SMALL MOBILE
========================================================= */

@media (max-width: 430px) {
  .login-page {
    padding: 35px 4%;
  }

  .login-brand {
    font-size: 21px;
  }

  .login-label {
    font-size: 10px;

    letter-spacing: 1.8px;
  }

  .login-intro h1 {
    font-size: 44px;

    letter-spacing: -2.5px;
  }

  .login-intro-text {
    font-size: 13px;
  }

  .login-intro-feature strong {
    font-size: 14px;
  }

  .login-intro-feature span {
    font-size: 12px;
  }

  .login-card {
    padding: 25px 18px;
  }

  .login-card-header h2 {
    font-size: 26px;
  }

  .login-card-header span {
    font-size: 13px;
  }

  .login-form-group input {
    height: 52px;
  }

  .login-submit-button {
    min-height: 57px;

    padding-left: 16px;
  }

  .login-submit-button strong {
    width: 41px;
    height: 41px;
  }

  .login-password-heading {
    align-items: flex-start;
  }

  .login-forgot-link {
    font-size: 11px;
  }
}


/* =========================================================
   REDUCED MOTION
========================================================= */

@media (prefers-reduced-motion: reduce) {
  .login-page,
  .login-intro,
  .login-card,
  .login-intro-feature,
  .login-form-group,
  .login-error,
  .login-success {
    animation: none;
  }

  .login-page::before,
  .login-page::after {
    animation: none;
  }

  .login-intro h1 span::after {
    animation: none;
  }

  .login-card,
  .login-submit-button,
  .login-submit-button strong,
  .login-password-toggle,
  .login-feature-number,
  .login-forgot-link,
  .login-register a,
  .login-form-group input {
    transition: none;
  }
}

/* =========================================================
   ACCOUNT LOGOUT
========================================================= */

 .account-logout-button {
   width: 100%; 
  border: 0;
  font: inherit;
  text-align: left;
  cursor: pointer;
  color: inherit;
  background: transparent;
} 

.account-logout-button:hover {
  background: rgba(11, 61, 46, 0.04);
}

.account-logout-button:focus-visible {
  outline: 2px solid var(--secondary);
  outline-offset: 3px;
}

.account-logout-button .account-menu-arrow {
  transition: transform 0.25s ease;
}

.account-logout-button:hover .account-menu-arrow {
  transform: translateX(5px);
}

/* =========================================================
   ABS CUT — NAVBAR LOGOUT
========================================================= */

.navbar-logout-button {
  position: relative;

  display: inline-flex;
  align-items: center;
  justify-content: center;

  min-height: 40px;
  padding: 9px 18px;

  border: 1px solid rgba(201, 162, 39, 0.35);
  border-radius: 999px;

  background: transparent;

  color: lightgreen;
  margin-left: 10px;

  font-family: inherit;
  font-size: 14px;
  font-weight: 700;

  cursor: pointer;

  transition:
    color 0.25s ease,
    background 0.25s ease,
    border-color 0.25s ease,
    transform 0.25s ease,
    box-shadow 0.25s ease;
}


/* GOLD ACCENT */
.navbar-logout-button::before {
  content: "";

  position: absolute;

  left: 14px;
  right: 14px;
  bottom: 5px;

  height: 2px;

  background: var(--secondary);

  transform: scaleX(0);
  transform-origin: center;

  transition: transform 0.25s ease;
}


/* HOVER */
.navbar-logout-button:hover {
  color: var(--white);

  background: var(--primary);

  border-color: var(--primary);

  transform: translateY(-2px);

  box-shadow:
    0 8px 20px rgba(11, 61, 46, 0.16);
}

.navbar-logout-button:hover::before {
  transform: scaleX(1);
}


/* ACTIVE */
.navbar-logout-button:active {
  transform: translateY(0);
}


/* KEYBOARD FOCUS */
.navbar-logout-button:focus-visible {
  outline: 2px solid var(--secondary);
  outline-offset: 3px;
}


/* REDUCED MOTION */
@media (prefers-reduced-motion: reduce) {
  .navbar-logout-button,
  .navbar-logout-button::before {
    transition: none;
  }
}

/* =========================================================
   ABS CUT — NAVBAR CART
========================================================= */

.navbar-cart-link {
  display: inline-flex;
  align-items: center;
  justify-content: center;

  text-decoration: none;

  color: lightgreen;

  transition:
    color 0.25s ease,
    transform 0.25s ease;
}

.navbar-cart-icon {
  position: relative;

  display: inline-flex;
  align-items: center;
  justify-content: center;

  width: 42px;
  height: 42px;

  font-size: 19px;

  border-radius: 50%;

  transition:
    background 0.25s ease,
    transform 0.25s ease,
    box-shadow 0.25s ease;
}


/* HOVER */

.navbar-cart-link:hover {
  color: lightgreen;
}

.navbar-cart-link:hover .navbar-cart-icon {
  background: rgba(201, 162, 39, 0.10);

  transform: translateY(-2px);

  box-shadow:
    0 8px 18px rgba(11, 61, 46, 0.10);
}


/* CART BADGE */

.navbar-cart-badge {
  position: absolute;

  top: -4px;
  right: -5px;

  min-width: 19px;
  height: 19px;

  display: flex;
  align-items: center;
  justify-content: center;

  padding: 0 5px;

  border-radius: 999px;

  background: var(--secondary);
  color: gray;

  font-size: 10px;
  font-weight: 800;
  line-height: 1;

  border: 2px solid var(--white);

  animation: cartBadgePop 0.3s ease both;
}


/* BADGE ANIMATION */

@keyframes cartBadgePop {
  0% {
    opacity: 0;
    transform: scale(0.5);
  }

  70% {
    transform: scale(1.15);
  }

  100% {
    opacity: 1;
    transform: scale(1);
  }
}


/* ACCESSIBILITY */

.navbar-cart-link:focus-visible {
  outline: 2px solid var(--secondary);
  outline-offset: 3px;
  border-radius: 50%;
}


/* REDUCED MOTION */

@media (prefers-reduced-motion: reduce) {
  .navbar-cart-icon,
  .navbar-cart-badge {
    animation: none;
    transition: none;
  }
}

/* =========================================================
   ABS CUT — PREMIUM LOADING SCREEN
========================================================= */

.abs-loading-screen {
  min-height: 60vh;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 60px 20px;

  background:
    radial-gradient(
      circle at 50% 40%,
      rgba(201, 162, 39, 0.10),
      transparent 35%
    ),
    var(--background);
}


/* =========================================================
   LOADING CARD
========================================================= */

.abs-loading-card {
  position: relative;

  width: min(420px, 100%);
  min-height: 300px;

  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;

  padding: 45px 30px;

  background: rgba(255, 255, 255, 0.92);

  border: 1px solid var(--border);
  border-radius: 24px;

  box-shadow:
    0 25px 60px rgba(16, 37, 29, 0.10),
    0 8px 25px rgba(16, 37, 29, 0.06);

  overflow: hidden;
}


/* =========================================================
   GOLD ACCENT
========================================================= */

.abs-loading-card::before {
  content: "";

  position: absolute;

  top: 0;
  left: 0;
  right: 0;

  height: 4px;

  background: linear-gradient(
    90deg,
    var(--primary),
    var(--secondary),
    var(--primary)
  );

  background-size: 200% 100%;

  animation:
    absLoadingGradient 2.5s linear infinite;
}


/* =========================================================
   LOGO
========================================================= */

.abs-loading-logo {
  position: relative;

  z-index: 2;

  display: flex;
  align-items: center;
  justify-content: center;

  gap: 3px;

  width: 68px;
  height: 68px;

  margin-bottom: 20px;

  border-radius: 50%;

  background: var(--primary-dark);

  color: var(--secondary);

  font-size: 18px;
  font-weight: 800;
  letter-spacing: 1px;

  box-shadow:
    0 10px 30px rgba(11, 61, 46, 0.20);

  animation:
    absLoadingLogo 2s ease-in-out infinite;
}


/* =========================================================
   OUTER SPINNER
========================================================= */

.abs-loading-spinner {
  position: absolute;

  width: 100px;
  height: 100px;

  border-radius: 50%;

  border: 2px solid rgba(201, 162, 39, 0.12);

  border-top-color: var(--secondary);
  border-right-color: var(--primary);

  animation:
    absLoadingSpin 1.3s linear infinite;
}


/* =========================================================
   INNER SPINNER
========================================================= */

.abs-loading-spinner-inner {
  position: absolute;

  top: 10px;
  left: 10px;

  width: 76px;
  height: 76px;

  border-radius: 50%;

  border: 2px solid transparent;

  border-bottom-color: var(--primary);
  border-left-color: rgba(201, 162, 39, 0.55);

  animation:
    absLoadingSpinReverse 1.8s linear infinite;
}


/* =========================================================
   CONTENT
========================================================= */

.abs-loading-content {
  position: relative;

  z-index: 3;

  margin-top: 105px;

  text-align: center;
}


.abs-loading-content h2 {
  margin: 0;

  color: var(--primary-dark);

  font-size: 20px;
  font-weight: 800;

  letter-spacing: 3px;
}


.abs-loading-content p {
  margin: 8px 0 0;

  color: var(--muted);

  font-size: 14px;
}


/* =========================================================
   LOADING DOTS
========================================================= */

.abs-loading-dots {
  display: flex;
  justify-content: center;
  align-items: center;

  gap: 5px;

  margin-top: 14px;
}


.abs-loading-dots span {
  width: 5px;
  height: 5px;

  border-radius: 50%;

  background: var(--secondary);

  animation:
    absLoadingDot 1.2s ease-in-out infinite;
}


.abs-loading-dots span:nth-child(2) {
  animation-delay: 0.15s;
}


.abs-loading-dots span:nth-child(3) {
  animation-delay: 0.3s;
}


/* =========================================================
   ANIMATIONS
========================================================= */

@keyframes absLoadingSpin {
  from {
    transform: rotate(0deg);
  }

  to {
    transform: rotate(360deg);
  }
}


@keyframes absLoadingSpinReverse {
  from {
    transform: rotate(360deg);
  }

  to {
    transform: rotate(0deg);
  }
}


@keyframes absLoadingLogo {
  0%,
  100% {
    transform: scale(1);
  }

  50% {
    transform: scale(1.05);
  }
}


@keyframes absLoadingDot {
  0%,
  100% {
    opacity: 0.3;
    transform: translateY(0);
  }

  50% {
    opacity: 1;
    transform: translateY(-3px);
  }
}


@keyframes absLoadingGradient {
  0% {
    background-position: 0% 50%;
  }

  100% {
    background-position: 200% 50%;
  }
}


/* =========================================================
   REDUCED MOTION
========================================================= */

@media (prefers-reduced-motion: reduce) {
  .abs-loading-spinner,
  .abs-loading-spinner-inner,
  .abs-loading-logo,
  .abs-loading-dots span,
  .abs-loading-card::before {
    animation: none;
  }
}


/* =========================================================
   MOBILE
========================================================= */

@media (max-width: 500px) {
  .abs-loading-screen {
    min-height: 50vh;
    padding: 40px 16px;
  }

  .abs-loading-card {
    min-height: 270px;
    padding: 35px 20px;
    border-radius: 20px;
  }
}

.payment-callback-page {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40px 6%;
  background:
    radial-gradient(
      circle at 20% 20%,
      rgba(201, 162, 39, 0.12),
      transparent 35%
    ),
    var(--background);
}

.payment-callback-card {
  width: min(520px, 100%);
  padding: 50px 35px;
  text-align: center;
  background: var(--white);
  border: 1px solid var(--border);
  border-radius: 24px;
  box-shadow: 0 25px 70px rgba(16, 37, 29, 0.12);
  animation: paymentCardReveal 0.6s ease both;
}

.payment-callback-icon {
  width: 70px;
  height: 70px;
  margin: 0 auto 24px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(201, 162, 39, 0.14);
  color: var(--secondary);
  font-size: 32px;
  font-weight: 800;
}

.payment-callback-card h1 {
  margin-bottom: 12px;
  color: var(--primary-dark);
}

.payment-callback-card p {
  margin-bottom: 28px;
  color: var(--muted);
  line-height: 1.7;
}

.payment-callback-card button {
  min-height: 54px;
  padding: 0 28px;
  border: none;
  border-radius: 12px;
  background: var(--primary);
  color: var(--white);
  font-weight: 700;
  cursor: pointer;
  transition:
    transform 0.25s ease,
    background 0.25s ease,
    box-shadow 0.25s ease;
}

.payment-callback-card button:hover {
  transform: translateY(-3px);
  background: var(--primary-dark);
  box-shadow: 0 12px 25px rgba(11, 61, 46, 0.2);
}

@keyframes paymentCardReveal {
  from {
    opacity: 0;
    transform: translateY(25px) scale(0.97);
  }

  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

@media (prefers-reduced-motion: reduce) {
  .payment-callback-card {
    animation: none;
  }

  .payment-callback-card button {
    transition: none;
  }
}


/* =========================================================
   ABS CUT — RECEIPT MODAL
   Professional paid-order receipt
========================================================= */

.receipt-modal-overlay {
  position: fixed;
  inset: 0;
  z-index: 9999;

  display: flex;
  justify-content: center;
  align-items: center;

  padding: 30px;

  background: rgba(16, 37, 29, 0.72);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);

  animation: receiptOverlayReveal 0.3s ease both;
}

/* =========================================================
   MODAL
========================================================= */

.receipt-modal {
  position: relative;

  width: min(1000px, 100%);
  max-height: calc(100vh - 60px);

  overflow-y: auto;

  background: var(--white);
  border: 1px solid rgba(201, 162, 39, 0.3);

  box-shadow:
    0 35px 100px rgba(0, 0, 0, 0.28),
    0 10px 30px rgba(16, 37, 29, 0.15);

  animation: receiptModalReveal 0.45s cubic-bezier(0.22, 1, 0.36, 1)
    both;

  scrollbar-width: thin;
  scrollbar-color: var(--secondary) var(--background);
}

/* Top luxury accent */

.receipt-modal::before {
  content: "";

  position: absolute;
  top: 0;
  left: 0;

  width: 100%;
  height: 5px;

  background: linear-gradient(
    90deg,
    var(--primary),
    var(--secondary),
    var(--primary)
  );

  z-index: 2;
}

/* =========================================================
   CLOSE BUTTON
========================================================= */

.receipt-modal-close {
  position: absolute;
  top: 18px;
  right: 18px;

  width: 42px;
  height: 42px;

  display: grid;
  place-items: center;

  border: 1px solid var(--border);
  border-radius: 50%;

  background: rgba(248, 245, 237, 0.9);
  color: var(--primary-dark);

  font-size: 25px;
  line-height: 1;

  cursor: pointer;

  z-index: 10;

  transition:
    transform 0.25s ease,
    background 0.25s ease,
    color 0.25s ease,
    box-shadow 0.25s ease;
}

.receipt-modal-close:hover {
  transform: rotate(90deg) scale(1.08);

  background: var(--primary);
  color: var(--secondary);

  box-shadow: 0 8px 20px rgba(11, 61, 46, 0.2);
}

.receipt-modal-close:active {
  transform: rotate(90deg) scale(0.96);
}

.receipt-modal-close:focus-visible {
  outline: 3px solid rgba(201, 162, 39, 0.35);
  outline-offset: 3px;
}

/* =========================================================
   HEADER
========================================================= */

.receipt-modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;

  gap: 30px;

  padding: 55px 55px 35px;

  border-bottom: 1px solid var(--border);
}

.receipt-modal-brand {
  display: flex;
  align-items: center;
  gap: 18px;
}

.receipt-modal-logo {
  width: 68px;
  height: 68px;

  display: grid;
  place-items: center;

  background: var(--primary);
  color: var(--secondary);

  font-size: 18px;
  font-weight: 900;
  letter-spacing: 2px;

  box-shadow:
    8px 8px 0 rgba(201, 162, 39, 0.16);

  transition:
    transform 0.3s ease,
    box-shadow 0.3s ease;
}

.receipt-modal-logo:hover {
  transform: translateY(-3px);

  box-shadow:
    11px 11px 0 rgba(201, 162, 39, 0.2);
}

.receipt-modal-brand h2 {
  margin: 0;

  color: var(--primary-dark);

  font-size: 28px;
  font-weight: 900;

  letter-spacing: 3px;
}

.receipt-modal-brand p {
  margin: 6px 0 0;

  color: var(--muted);

  font-size: 12px;
}

.receipt-modal-title {
  text-align: right;

  padding-right: 45px;
}

.receipt-modal-title span {
  display: block;

  color: var(--secondary);

  font-size: 11px;
  font-weight: 900;

  letter-spacing: 2px;
}

.receipt-modal-title strong {
  display: inline-flex;
  align-items: center;
  justify-content: center;

  margin-top: 9px;

  min-height: 30px;
  padding: 0 14px;

  background: rgba(11, 61, 46, 0.08);

  color: var(--primary);

  font-size: 11px;
  letter-spacing: 1px;

  border: 1px solid rgba(11, 61, 46, 0.12);
}

/* =========================================================
   CUSTOMER / ORDER / PAYMENT DETAILS
========================================================= */

.receipt-modal-details {
  display: grid;
  grid-template-columns: repeat(3, 1fr);

  border-bottom: 1px solid var(--border);
}

.receipt-modal-details > div {
  min-width: 0;

  padding: 28px 30px;

  border-right: 1px solid var(--border);

  transition:
    background 0.25s ease,
    transform 0.25s ease;
}

.receipt-modal-details > div:last-child {
  border-right: none;
}

.receipt-modal-details > div:hover {
  background: rgba(248, 245, 237, 0.65);
}

.receipt-modal-details span {
  display: block;

  margin-bottom: 9px;

  color: var(--secondary);

  font-size: 10px;
  font-weight: 900;

  letter-spacing: 1.5px;
  text-transform: uppercase;
}

.receipt-modal-details strong {
  display: block;

  color: var(--primary-dark);

  font-size: 14px;

  word-break: break-word;
}

.receipt-modal-details p {
  margin: 5px 0 0;

  color: var(--muted);

  font-size: 12px;

  word-break: break-word;
}

/* =========================================================
   PRODUCTS
========================================================= */

.receipt-modal-products {
  padding: 35px 45px 10px;
}

.receipt-modal-products-heading {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 70px 130px;

  align-items: center;

  padding: 13px 18px;

  background: var(--primary);

  color: var(--white);

  font-size: 10px;
  font-weight: 900;

  letter-spacing: 1.2px;
}

.receipt-modal-products-heading span:nth-child(2),
.receipt-modal-products-heading span:nth-child(3) {
  text-align: right;
}

/* =========================================================
   PRODUCT ROW
========================================================= */

.receipt-modal-product {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 70px 130px;

  align-items: center;

  gap: 15px;

  padding: 18px;

  border: 1px solid var(--border);
  border-top: none;

  color: var(--text);

  transition:
    background 0.25s ease,
    transform 0.25s ease;
}

.receipt-modal-product:hover {
  background: rgba(248, 245, 237, 0.6);

  transform: translateX(3px);
}

.receipt-modal-product > span {
  text-align: right;

  color: var(--muted);

  font-size: 13px;
}

.receipt-modal-product > strong {
  text-align: right;

  color: var(--primary-dark);

  font-size: 14px;
}

/* =========================================================
   PRODUCT INFORMATION
========================================================= */

.receipt-modal-product-info {
  display: flex;
  align-items: center;

  gap: 15px;

  min-width: 0;
}

.receipt-modal-product-image {
  width: 65px;
  height: 65px;

  display: grid;
  place-items: center;

  flex-shrink: 0;

  overflow: hidden;

  background: var(--background);

  border: 1px solid var(--border);
}

.receipt-modal-product-image img {
  width: 100%;
  height: 100%;

  object-fit: cover;

  transition: transform 0.4s ease;
}

.receipt-modal-product:hover
  .receipt-modal-product-image img {
  transform: scale(1.08);
}

.receipt-modal-product-image span {
  color: var(--secondary);

  font-size: 12px;
  font-weight: 900;

  letter-spacing: 1px;
}

.receipt-modal-product-info > div:last-child {
  min-width: 0;
}

.receipt-modal-product-info strong {
  display: block;

  overflow: hidden;

  color: var(--primary-dark);

  font-size: 14px;

  text-overflow: ellipsis;
  white-space: nowrap;
}

.receipt-modal-product-info span {
  display: block;

  margin-top: 5px;

  color: var(--muted);

  font-size: 11px;
}

/* =========================================================
   SUMMARY
========================================================= */

.receipt-modal-summary {
  width: min(390px, calc(100% - 90px));

  margin: 25px 45px 35px auto;

  border-top: 2px solid var(--primary);
}

.receipt-modal-summary > div {
  display: flex;
  justify-content: space-between;
  align-items: center;

  gap: 20px;

  padding: 12px 0;

  border-bottom: 1px solid var(--border);

  color: var(--muted);

  font-size: 13px;
}

.receipt-modal-summary > div strong {
  color: var(--primary-dark);

  font-size: 14px;
}

.receipt-modal-summary .receipt-modal-total {
  margin-top: 5px;

  padding: 17px 18px;

  border: none;

  background: var(--primary);

  color: var(--white);
}

.receipt-modal-total span {
  color: var(--white);

  font-size: 13px;
  font-weight: 900;

  letter-spacing: 0.8px;
}

.receipt-modal-total strong {
  color: var(--secondary) !important;

  font-size: 20px !important;
}

/* =========================================================
   DELIVERY
========================================================= */

.receipt-modal-delivery {
  margin: 0 45px 35px;

  padding: 22px;

  background:
    linear-gradient(
      135deg,
      rgba(248, 245, 237, 0.95),
      rgba(248, 245, 237, 0.55)
    );

  border: 1px solid var(--border);

  border-left: 4px solid var(--secondary);

  transition:
    transform 0.25s ease,
    box-shadow 0.25s ease;
}

.receipt-modal-delivery:hover {
  transform: translateX(3px);

  box-shadow:
    0 10px 25px rgba(16, 37, 29, 0.07);
}

.receipt-modal-delivery > span {
  display: block;

  margin-bottom: 8px;

  color: var(--secondary);

  font-size: 10px;
  font-weight: 900;

  letter-spacing: 1.5px;
}

.receipt-modal-delivery strong {
  display: block;

  color: var(--primary-dark);

  font-size: 14px;
}

.receipt-modal-delivery p {
  margin: 6px 0 0;

  color: var(--muted);

  font-size: 13px;

  line-height: 1.6;
}

/* =========================================================
   FOOTER
========================================================= */

.receipt-modal-footer {
  padding: 30px 45px;

  border-top: 1px solid var(--border);

  background: var(--primary-dark);
}

.receipt-modal-footer > p {
  margin: 0 0 22px;

  color: rgba(255, 255, 255, 0.8);

  font-size: 13px;

  text-align: center;
}

/* =========================================================
   ACTION BUTTONS
========================================================= */

.receipt-modal-actions {
  display: grid;

  grid-template-columns: repeat(4, 1fr);

  gap: 10px;
}

.receipt-modal-actions button {
  min-height: 50px;

  padding: 0 15px;

  border: 1px solid transparent;

  font-size: 10px;
  font-weight: 900;

  letter-spacing: 0.7px;

  cursor: pointer;

  transition:
    transform 0.25s ease,
    box-shadow 0.25s ease,
    background 0.25s ease,
    color 0.25s ease,
    border-color 0.25s ease;
}

.receipt-modal-actions button:hover:not(:disabled) {
  transform: translateY(-3px);
}

.receipt-modal-actions button:active:not(:disabled) {
  transform: translateY(-1px);
}

.receipt-modal-actions button:focus-visible {
  outline: 3px solid rgba(201, 162, 39, 0.4);
  outline-offset: 2px;
}

.receipt-modal-actions button:disabled {
  opacity: 0.55;

  cursor: not-allowed;
}

/* Print */

.receipt-print-button {
  background: var(--secondary);

  color: var(--primary-dark);
}

.receipt-print-button:hover:not(:disabled) {
  box-shadow:
    0 10px 25px rgba(201, 162, 39, 0.2);
}

/* Download */

.receipt-download-button {
  background: var(--white);

  color: var(--primary-dark);
}

.receipt-download-button:hover:not(:disabled) {
  background: var(--background);

  box-shadow:
    0 10px 25px rgba(255, 255, 255, 0.12);
}

/* Share */

.receipt-share-button {
  background: transparent;

  border-color: var(--secondary) !important;

  color: var(--secondary);
}

.receipt-share-button:hover:not(:disabled) {
  background: var(--secondary);

  color: var(--primary-dark);
}

/* Close */

.receipt-close-button {
  background: transparent;

  border-color: rgba(255, 255, 255, 0.25) !important;

  color: rgba(255, 255, 255, 0.8);
}

.receipt-close-button:hover:not(:disabled) {
  background: rgba(255, 255, 255, 0.1);

  color: var(--white);
}

/* =========================================================
   ANIMATIONS
========================================================= */

@keyframes receiptOverlayReveal {
  from {
    opacity: 0;
  }

  to {
    opacity: 1;
  }
}

@keyframes receiptModalReveal {
  from {
    opacity: 0;
    transform: translateY(35px) scale(0.97);
  }

  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

/* =========================================================
   RESPONSIVE — TABLET
========================================================= */

@media (max-width: 850px) {
  .receipt-modal-overlay {
    padding: 20px;
  }

  .receipt-modal-header {
    padding: 45px 30px 30px;
  }

  .receipt-modal-details {
    grid-template-columns: 1fr;
  }

  .receipt-modal-details > div {
    border-right: none;

    border-bottom: 1px solid var(--border);
  }

  .receipt-modal-details > div:last-child {
    border-bottom: none;
  }

  .receipt-modal-products {
    padding: 30px 25px 10px;
  }

  .receipt-modal-summary {
    width: auto;

    margin: 25px;
  }

  .receipt-modal-delivery {
    margin: 0 25px 30px;
  }

  .receipt-modal-footer {
    padding: 25px;
  }

  .receipt-modal-actions {
    grid-template-columns: repeat(2, 1fr);
  }
}

/* =========================================================
   RESPONSIVE — MOBILE
========================================================= */

@media (max-width: 600px) {
  .receipt-modal-overlay {
    align-items: flex-start;

    padding: 10px;
  }

  .receipt-modal {
    max-height: calc(100vh - 20px);
  }

  .receipt-modal-close {
    top: 12px;
    right: 12px;

    width: 38px;
    height: 38px;

    font-size: 22px;
  }

  .receipt-modal-header {
    flex-direction: column;

    align-items: flex-start;

    padding: 45px 20px 25px;

    gap: 25px;
  }

  .receipt-modal-brand {
    gap: 12px;
  }

  .receipt-modal-logo {
    width: 55px;
    height: 55px;

    font-size: 15px;
  }

  .receipt-modal-brand h2 {
    font-size: 23px;
  }

  .receipt-modal-brand p {
    font-size: 10px;
  }

  .receipt-modal-title {
    width: 100%;

    padding-right: 0;

    text-align: left;
  }

  .receipt-modal-details > div {
    padding: 20px;
  }

  .receipt-modal-products {
    padding: 25px 15px 5px;
  }

  .receipt-modal-products-heading {
    grid-template-columns: minmax(0, 1fr) 50px 95px;

    padding: 11px 12px;

    font-size: 9px;
  }

  .receipt-modal-product {
    grid-template-columns: minmax(0, 1fr) 50px 95px;

    gap: 8px;

    padding: 13px 12px;
  }

  .receipt-modal-product-info {
    gap: 10px;
  }

  .receipt-modal-product-image {
    width: 48px;
    height: 48px;
  }

  .receipt-modal-product-info strong {
    font-size: 12px;
  }

  .receipt-modal-product-info span {
    font-size: 10px;
  }

  .receipt-modal-product > span {
    font-size: 12px;
  }

  .receipt-modal-product > strong {
    font-size: 12px;
  }

  .receipt-modal-summary {
    margin: 20px 15px 25px;
  }

  .receipt-modal-delivery {
    margin: 0 15px 25px;

    padding: 18px;
  }

  .receipt-modal-footer {
    padding: 22px 15px;
  }

  .receipt-modal-actions {
    grid-template-columns: 1fr;
  }

  .receipt-modal-actions button {
    width: 100%;
  }
}

/* =========================================================
   SMALL MOBILE
========================================================= */

@media (max-width: 400px) {
  .receipt-modal-brand h2 {
    font-size: 20px;
  }

  .receipt-modal-brand p {
    font-size: 9px;
  }

  .receipt-modal-products-heading {
    grid-template-columns: minmax(0, 1fr) 40px 82px;
  }

  .receipt-modal-product {
    grid-template-columns: minmax(0, 1fr) 40px 82px;
  }

  .receipt-modal-product-image {
    width: 42px;
    height: 42px;
  }

  .receipt-modal-product-info strong {
    font-size: 11px;
  }

  .receipt-modal-product > strong {
    font-size: 11px;
  }
}

/* =========================================================
   PRINT
========================================================= */

@media print {
  body {
    margin: 0;

    background: white !important;
  }

  /* Hide everything behind the receipt */

  body > * {
    visibility: hidden;
  }

  .receipt-modal-overlay {
    position: static;

    display: block;

    padding: 0;

    background: white !important;

    visibility: visible;

    backdrop-filter: none;
    -webkit-backdrop-filter: none;
  }

  .receipt-modal {
    position: static;

    width: 100%;
    max-height: none;

    overflow: visible;

    border: none;

    box-shadow: none;

    animation: none;

    visibility: visible;
  }

  .receipt-modal::before {
    display: none;
  }

  .receipt-modal-close {
    display: none;
  }

  .receipt-modal-header,
  .receipt-modal-details,
  .receipt-modal-products,
  .receipt-modal-summary,
  .receipt-modal-delivery,
  .receipt-modal-footer {
    visibility: visible;
  }

  .receipt-modal-footer {
    background: white !important;

    color: var(--primary-dark) !important;

    border-top: 1px solid var(--border);

    print-color-adjust: exact;
    -webkit-print-color-adjust: exact;
  }

  .receipt-modal-footer > p {
    color: var(--primary-dark) !important;
  }

  .receipt-modal-actions {
    display: none;
  }

  .receipt-modal-product:hover {
    transform: none;
  }

  .receipt-modal-product-image img {
    transition: none;
  }

  .receipt-modal-details > div:hover {
    background: transparent;
  }

  .receipt-modal-delivery:hover {
    transform: none;

    box-shadow: none;
  }

  .receipt-modal-header,
  .receipt-modal-details,
  .receipt-modal-products,
  .receipt-modal-summary,
  .receipt-modal-delivery,
  .receipt-modal-footer {
    break-inside: avoid;
  }
}

/* =========================================================
   REDUCED MOTION
========================================================= */

@media (prefers-reduced-motion: reduce) {
  .receipt-modal-overlay,
  .receipt-modal {
    animation: none;
  }

  .receipt-modal-close,
  .receipt-modal-logo,
  .receipt-modal-product,
  .receipt-modal-product-image img,
  .receipt-modal-actions button,
  .receipt-modal-details > div,
  .receipt-modal-delivery {
    transition: none;
  }
}


```css
/* =========================================================
   ABS CUT — ADMIN DASHBOARD
   Premium Green + Gold Management Interface
========================================================= */

.admin-dashboard-page {
  min-height: 100vh;
  padding: 30px;
  background:
    radial-gradient(
      circle at 90% 0%,
      rgba(201, 162, 39, 0.08),
      transparent 28%
    ),
    radial-gradient(
      circle at 0% 100%,
      rgba(11, 61, 46, 0.08),
      transparent 30%
    ),
    #f4f1e8;
  color: var(--text);
}

/* =========================================================
   MAIN SHELL
========================================================= */

.admin-dashboard-shell {
  display: grid;
  grid-template-columns: 260px minmax(0, 1fr);
  min-height: calc(100vh - 60px);
  max-width: 1600px;
  margin: 0 auto;

  background: rgba(255, 255, 255, 0.72);
  border: 1px solid rgba(11, 61, 46, 0.08);
  border-radius: 28px;
  overflow: hidden;

  box-shadow:
    0 25px 70px rgba(16, 37, 29, 0.10),
    0 5px 20px rgba(16, 37, 29, 0.05);

  animation: adminShellReveal 0.7s ease both;
}

/* =========================================================
   SIDEBAR
========================================================= */

.admin-sidebar {
  display: flex;
  flex-direction: column;
  min-height: 100%;
  padding: 28px 18px;

  background:
    linear-gradient(
      180deg,
      #0b3d2e 0%,
      #0a3327 55%,
      #081f18 100%
    );

  color: #ffffff;
  position: relative;
  overflow: hidden;
}

.admin-sidebar::before {
  content: "";
  position: absolute;
  width: 220px;
  height: 220px;
  top: -100px;
  right: -100px;

  background: rgba(201, 162, 39, 0.12);
  border-radius: 50%;
  filter: blur(5px);
}

.admin-sidebar::after {
  content: "";
  position: absolute;
  width: 180px;
  height: 180px;
  bottom: -100px;
  left: -90px;

  background: rgba(255, 255, 255, 0.035);
  border-radius: 50%;
}

/* =========================================================
   ADMIN BRAND
========================================================= */

.admin-brand {
  display: flex;
  align-items: center;
  gap: 13px;

  padding: 5px 8px 28px;
  position: relative;
  z-index: 1;
}

.admin-brand-mark {
  width: 46px;
  height: 46px;

  display: grid;
  place-items: center;

  border-radius: 14px;

  background:
    linear-gradient(
      135deg,
      #d8b637,
      #b18b18
    );

  color: #10251d;

  font-size: 21px;
  font-weight: 900;

  box-shadow:
    0 8px 22px rgba(201, 162, 39, 0.25);

  transition:
    transform 0.3s ease,
    box-shadow 0.3s ease;
}

.admin-brand:hover .admin-brand-mark {
  transform: rotate(-5deg) scale(1.06);

  box-shadow:
    0 12px 28px rgba(201, 162, 39, 0.35);
}

.admin-brand strong {
  display: block;

  font-size: 16px;
  letter-spacing: 1.5px;
}

.admin-brand span {
  display: block;

  margin-top: 3px;

  color: rgba(255, 255, 255, 0.5);

  font-size: 9px;
  font-weight: 700;
  letter-spacing: 1.5px;
}

/* =========================================================
   SIDEBAR NAV
========================================================= */

.admin-nav {
  display: flex;
  flex-direction: column;
  gap: 6px;

  position: relative;
  z-index: 1;
}

.admin-nav-link {
  position: relative;

  display: flex;
  align-items: center;
  gap: 13px;

  min-height: 48px;
  padding: 0 14px;

  border-radius: 13px;

  color: rgba(255, 255, 255, 0.62);
  text-decoration: none;

  font-size: 13px;
  font-weight: 600;

  transition:
    color 0.25s ease,
    background 0.25s ease,
    transform 0.25s ease;
}

.admin-nav-link span {
  width: 22px;

  display: inline-flex;
  justify-content: center;

  color: rgba(201, 162, 39, 0.75);

  font-size: 16px;

  transition:
    transform 0.25s ease,
    color 0.25s ease;
}

.admin-nav-link:hover {
  color: #ffffff;

  background: rgba(255, 255, 255, 0.07);

  transform: translateX(4px);
}

.admin-nav-link:hover span {
  color: #d8b637;
  transform: scale(1.12);
}

.admin-nav-link.active {
  color: #ffffff;

  background:
    linear-gradient(
      90deg,
      rgba(201, 162, 39, 0.20),
      rgba(201, 162, 39, 0.07)
    );

  box-shadow:
    inset 3px 0 0 #c9a227;
}

.admin-nav-link.active span {
  color: #d8b637;
}

/* =========================================================
   SIDEBAR FOOTER
========================================================= */

.admin-sidebar-footer {
  margin-top: auto;

  padding: 22px 8px 4px;

  position: relative;
  z-index: 1;
}

.admin-store-link {
  display: flex;
  align-items: center;

  min-height: 44px;
  padding: 0 12px;

  border: 1px solid rgba(255, 255, 255, 0.09);
  border-radius: 12px;

  color: rgba(255, 255, 255, 0.55);
  text-decoration: none;

  font-size: 12px;
  font-weight: 600;

  transition:
    all 0.25s ease;
}

.admin-store-link:hover {
  color: #ffffff;

  border-color: rgba(201, 162, 39, 0.4);

  background: rgba(201, 162, 39, 0.08);

  transform: translateY(-2px);
}

/* =========================================================
   MAIN CONTENT
========================================================= */

.admin-main {
  min-width: 0;

  padding: 42px;

  background:
    linear-gradient(
      135deg,
      rgba(255, 255, 255, 0.9),
      rgba(248, 245, 237, 0.75)
    );
}

/* =========================================================
   HEADER
========================================================= */

.admin-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 30px;

  margin-bottom: 34px;

  animation: adminFadeUp 0.55s ease both;
}

.admin-eyebrow {
  display: inline-block;

  margin-bottom: 9px;

  color: #a48416;

  font-size: 10px;
  font-weight: 800;
  letter-spacing: 2px;
}

.admin-header h1 {
  margin: 0;

  color: #10251d;

  font-size: clamp(32px, 4vw, 46px);
  line-height: 1.05;

  letter-spacing: -1.5px;
}

.admin-header p {
  margin: 10px 0 0;

  color: #718078;

  font-size: 14px;
}

.admin-header-badge {
  display: flex;
  align-items: center;
  gap: 8px;

  padding: 10px 15px;

  border: 1px solid rgba(11, 61, 46, 0.10);
  border-radius: 999px;

  background: rgba(255, 255, 255, 0.7);

  color: #0b3d2e;

  font-size: 11px;
  font-weight: 800;
  letter-spacing: 0.8px;

  box-shadow:
    0 8px 20px rgba(16, 37, 29, 0.05);
}

.admin-header-badge span {
  width: 8px;
  height: 8px;

  border-radius: 50%;

  background: #32a66b;

  box-shadow:
    0 0 0 5px rgba(50, 166, 107, 0.12);

  animation: adminPulse 2s infinite;
}

/* =========================================================
   STAT CARDS
========================================================= */

.admin-stat-grid {
  display: grid;

  grid-template-columns:
    repeat(4, minmax(0, 1fr));

  gap: 18px;

  margin-bottom: 22px;
}

.admin-stat-card {
  position: relative;

  min-width: 0;
  min-height: 170px;

  padding: 22px;

  border: 1px solid rgba(11, 61, 46, 0.08);
  border-radius: 20px;

  background: rgba(255, 255, 255, 0.88);

  box-shadow:
    0 10px 30px rgba(16, 37, 29, 0.05);

  overflow: hidden;

  animation:
    adminCardReveal 0.65s ease both;

  transition:
    transform 0.3s ease,
    box-shadow 0.3s ease,
    border-color 0.3s ease;
}

.admin-stat-card::before {
  content: "";

  position: absolute;

  width: 100px;
  height: 100px;

  right: -45px;
  bottom: -45px;

  border-radius: 50%;

  background: rgba(201, 162, 39, 0.07);

  transition:
    transform 0.4s ease;
}

.admin-stat-card:hover {
  transform: translateY(-6px);

  border-color: rgba(201, 162, 39, 0.25);

  box-shadow:
    0 18px 40px rgba(16, 37, 29, 0.10);
}

.admin-stat-card:hover::before {
  transform: scale(1.5);
}

.admin-stat-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 15px;
}

.admin-stat-title {
  color: #7a867f;

  font-size: 11px;
  font-weight: 800;
  letter-spacing: 1px;
  text-transform: uppercase;
}

.admin-stat-icon {
  width: 42px;
  height: 42px;

  display: grid;
  place-items: center;

  border-radius: 13px;

  background: rgba(11, 61, 46, 0.07);

  color: #0b3d2e;

  font-size: 17px;
  font-weight: 800;

  transition:
    transform 0.3s ease,
    background 0.3s ease;
}

.admin-stat-card:hover .admin-stat-icon {
  transform: rotate(-5deg) scale(1.08);

  background: rgba(201, 162, 39, 0.13);
  color: #a48416;
}

.admin-stat-value {
  display: block;

  margin-top: 25px;

  color: #10251d;

  font-size: clamp(23px, 2.5vw, 31px);
  line-height: 1;

  letter-spacing: -0.8px;
}

.admin-stat-line {
  width: 100%;
  height: 3px;

  margin-top: 26px;

  border-radius: 999px;

  background: #eeeae0;

  overflow: hidden;
}

.admin-stat-line span {
  display: block;

  width: 42%;
  height: 100%;

  border-radius: inherit;

  background:
    linear-gradient(
      90deg,
      #0b3d2e,
      #c9a227
    );

  transition:
    width 0.5s ease;
}

.admin-stat-card:hover .admin-stat-line span {
  width: 75%;
}

/* =========================================================
   OVERVIEW GRID
========================================================= */

.admin-overview-grid {
  display: grid;

  grid-template-columns:
    minmax(0, 1.2fr)
    minmax(0, 0.8fr);

  gap: 18px;

  margin-bottom: 22px;
}

/* =========================================================
   PANELS
========================================================= */

.admin-panel {
  padding: 25px;

  border: 1px solid rgba(11, 61, 46, 0.08);
  border-radius: 20px;

  background: rgba(255, 255, 255, 0.88);

  box-shadow:
    0 10px 30px rgba(16, 37, 29, 0.045);

  animation:
    adminFadeUp 0.65s ease both;
}

.admin-panel-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20px;

  margin-bottom: 24px;
}

.admin-panel-header span {
  color: #a48416;

  font-size: 9px;
  font-weight: 800;
  letter-spacing: 1.8px;
}

.admin-panel-header h2 {
  margin: 6px 0 0;

  color: #10251d;

  font-size: 19px;
  letter-spacing: -0.3px;
}

.admin-panel-header a {
  color: #0b3d2e;

  font-size: 11px;
  font-weight: 800;

  text-decoration: none;

  transition:
    color 0.25s ease,
    transform 0.25s ease;
}

.admin-panel-header a:hover {
  color: #a48416;
  transform: translateX(3px);
}

/* =========================================================
   ORDER SUMMARY
========================================================= */

.admin-order-summary {
  display: grid;

  grid-template-columns:
    repeat(2, minmax(0, 1fr));

  gap: 15px;
}

.admin-summary-item {
  display: flex;
  align-items: center;
  gap: 14px;

  padding: 18px;

  border: 1px solid #eeeae0;
  border-radius: 15px;

  background: #faf9f5;

  transition:
    transform 0.25s ease,
    border-color 0.25s ease;
}

.admin-summary-item:hover {
  transform: translateY(-3px);

  border-color: rgba(201, 162, 39, 0.25);
}

.admin-summary-icon {
  width: 42px;
  height: 42px;

  flex-shrink: 0;

  display: grid;
  place-items: center;

  border-radius: 12px;

  font-weight: 900;
}

.admin-summary-icon.pending {
  background: rgba(201, 162, 39, 0.13);
  color: #a48416;
}

.admin-summary-icon.paid {
  background: rgba(44, 143, 91, 0.11);
  color: #287f52;
}

.admin-summary-item strong {
  display: block;

  color: #10251d;

  font-size: 25px;
  line-height: 1;
}

.admin-summary-item span {
  display: block;

  margin-top: 5px;

  color: #7b867f;

  font-size: 10px;
  font-weight: 700;
}

/* =========================================================
   REVENUE
========================================================= */

.admin-revenue-panel {
  position: relative;
  overflow: hidden;
}

.admin-revenue-icon {
  width: 42px;
  height: 42px;

  display: grid;
  place-items: center;

  border-radius: 12px;

  background: rgba(201, 162, 39, 0.13);

  color: #a48416;

  font-size: 17px;
  font-weight: 900;
}

.admin-revenue-value {
  margin-top: 20px;

  color: #0b3d2e;

  font-size: clamp(28px, 3vw, 38px);
  font-weight: 900;
  letter-spacing: -1px;
}

.admin-revenue-panel p {
  margin: 8px 0 0;

  max-width: 330px;

  color: #7a867f;

  font-size: 12px;
  line-height: 1.6;
}

.admin-revenue-decoration {
  display: flex;
  align-items: flex-end;
  gap: 6px;

  height: 35px;

  margin-top: 20px;
}

.admin-revenue-decoration span {
  display: block;

  width: 7px;

  border-radius: 999px;

  background:
    linear-gradient(
      to top,
      #0b3d2e,
      #c9a227
    );

  animation:
    revenueBars 2s ease-in-out infinite alternate;
}

.admin-revenue-decoration span:nth-child(1) {
  height: 35%;
}

.admin-revenue-decoration span:nth-child(2) {
  height: 60%;
  animation-delay: 0.2s;
}

.admin-revenue-decoration span:nth-child(3) {
  height: 90%;
  animation-delay: 0.4s;
}

/* =========================================================
   QUICK ACTIONS
========================================================= */

.admin-quick-panel {
  margin-bottom: 0;
}

.admin-quick-grid {
  display: grid;

  grid-template-columns:
    repeat(4, minmax(0, 1fr));

  gap: 14px;
}

.admin-quick-card {
  position: relative;

  display: flex;
  flex-direction: column;

  min-height: 145px;
  padding: 20px;

  border: 1px solid #eeeae0;
  border-radius: 16px;

  background: #faf9f5;

  color: inherit;
  text-decoration: none;

  overflow: hidden;

  transition:
    transform 0.3s ease,
    border-color 0.3s ease,
    box-shadow 0.3s ease,
    background 0.3s ease;
}

.admin-quick-card::after {
  content: "→";

  position: absolute;

  right: 18px;
  bottom: 16px;

  color: #c9a227;

  font-size: 18px;

  opacity: 0;

  transform: translateX(-6px);

  transition:
    opacity 0.25s ease,
    transform 0.25s ease;
}

.admin-quick-card:hover {
  transform: translateY(-5px);

  border-color: rgba(201, 162, 39, 0.28);

  background: #ffffff;

  box-shadow:
    0 14px 28px rgba(16, 37, 29
, 0.08);
}

```css
/* =========================================================
   ABS CUT — ADMIN ORDERS
========================================================= */

.admin-orders-list-panel {
  animation-delay: 0.12s;
}

/* =========================================================
   ORDERS TABLE WRAPPER
========================================================= */

.admin-orders-table-wrapper {
  width: 100%;
  overflow-x: auto;

  border: 1px solid #eeeae0;
  border-radius: 16px;

  background: #faf9f5;

  scrollbar-width: thin;
  scrollbar-color: #c9a227 transparent;
}

.admin-orders-table-wrapper::-webkit-scrollbar {
  height: 6px;
}

.admin-orders-table-wrapper::-webkit-scrollbar-track {
  background: transparent;
}

.admin-orders-table-wrapper::-webkit-scrollbar-thumb {
  background: #c9a227;
  border-radius: 999px;
}

/* =========================================================
   TABLE
========================================================= */

.admin-orders-table {
  width: 100%;
  min-width: 850px;

  border-collapse: collapse;

  text-align: left;
}

.admin-orders-table thead {
  background:
    linear-gradient(
      90deg,
      rgba(11, 61, 46, 0.055),
      rgba(201, 162, 39, 0.045)
    );
}

.admin-orders-table th {
  padding: 15px 18px;

  color: #7a867f;

  font-size: 9px;
  font-weight: 900;
  letter-spacing: 1.3px;
  text-transform: uppercase;

  border-bottom: 1px solid #e8e4da;

  white-space: nowrap;
}

.admin-orders-table td {
  padding: 17px 18px;

  color: #435149;

  font-size: 12px;

  border-bottom: 1px solid #eeeae0;

  vertical-align: middle;
}

.admin-orders-table tbody tr {
  position: relative;

  background: rgba(255, 255, 255, 0.55);

  transition:
    background 0.25s ease,
    transform 0.25s ease;
}

.admin-orders-table tbody tr:last-child td {
  border-bottom: 0;
}

.admin-orders-table tbody tr:hover {
  background: #ffffff;
}

/* =========================================================
   ORDER NUMBER
========================================================= */

.admin-orders-table td:first-child strong {
  display: inline-flex;
  align-items: center;

  min-height: 30px;
  padding: 0 10px;

  border-radius: 8px;

  background: rgba(11, 61, 46, 0.07);

  color: #0b3d2e;

  font-size: 10px;
  letter-spacing: 0.7px;

  transition:
    background 0.25s ease,
    color 0.25s ease,
    transform 0.25s ease;
}

.admin-orders-table tbody tr:hover td:first-child strong {
  background: rgba(201, 162, 39, 0.13);

  color: #9a7912;

  transform: translateX(2px);
}

/* =========================================================
   CUSTOMER
========================================================= */

.admin-customer-cell {
  display: flex;
  flex-direction: column;

  min-width: 150px;
}

.admin-customer-cell strong {
  color: #10251d;

  font-size: 12px;
  font-weight: 800;
}

.admin-customer-cell span {
  margin-top: 4px;

  color: #89928d;

  font-size: 10px;
}

/* =========================================================
   ORDER DATE
========================================================= */

.admin-order-date {
  display: block;

  min-width: 145px;

  color: #77827c;

  font-size: 10px;
  line-height: 1.5;
}

/* =========================================================
   STATUS BADGES
========================================================= */

.admin-status-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;

  min-width: 72px;

  min-height: 27px;

  padding: 0 9px;

  border-radius: 999px;

  font-size: 9px;
  font-weight: 900;
  letter-spacing: 0.7px;

  text-transform: capitalize;

  white-space: nowrap;

  transition:
    transform 0.25s ease,
    box-shadow 0.25s ease;
}

.admin-status-badge:hover {
  transform: translateY(-2px);
}

/* =========================================================
   PAYMENT STATUS
========================================================= */

.payment-paid {
  background: rgba(39, 145, 88, 0.11);
  color: #277d51;
}

.payment-pending {
  background: rgba(201, 162, 39, 0.13);
  color: #9a7912;
}

.payment-failed {
  background: rgba(190, 64, 64, 0.10);
  color: #a33b3b;
}

/* =========================================================
   ORDER STATUS
========================================================= */

.order-pending {
  background: rgba(201, 162, 39, 0.13);
  color: #9a7912;
}

.order-confirmed {
  background: rgba(11, 61, 46, 0.09);
  color: #0b3d2e;
}

.order-processing {
  background: rgba(54, 116, 177, 0.10);
  color: #356e9f;
}

.order-shipped {
  background: rgba(116, 79, 165, 0.10);
  color: #684996;
}

.order-delivered {
  background: rgba(39, 145, 88, 0.11);
  color: #277d51;
}

.order-cancelled {
  background: rgba(190, 64, 64, 0.10);
  color: #a33b3b;
}

/* =========================================================
   EMPTY STATE
========================================================= */

.admin-empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;

  min-height: 280px;

  padding: 35px;

  text-align: center;

  border: 1px dashed #dedbd2;
  border-radius: 16px;

  background:
    radial-gradient(
      circle at center,
      rgba(201, 162, 39, 0.055),
      transparent 60%
    );

  animation:
    adminFadeUp 0.55s ease both;
}

.admin-empty-state > div {
  width: 58px;
  height: 58px;

  display: grid;
  place-items: center;

  margin-bottom: 17px;

  border-radius: 17px;

  background: rgba(11, 61, 46, 0.07);

  color: #0b3d2e;

  font-size: 23px;

  animation:
    adminEmptyFloat 3s ease-in-out infinite;
}

.admin-empty-state h3 {
  margin: 0;

  color: #10251d;

  font-size: 18px;
}

.admin-empty-state p {
  max-width: 330px;

  margin: 8px 0 0;

  color: #7c8780;

  font-size: 12px;
  line-height: 1.6;
}

/* =========================================================
   TABLE ENTRY ANIMATION
========================================================= */

.admin-orders-table tbody tr {
  animation:
    adminOrderRowReveal 0.45s ease both;
}

.admin-orders-table tbody tr:nth-child(1) {
  animation-delay: 0.05s;
}

.admin-orders-table tbody tr:nth-child(2) {
  animation-delay: 0.09s;
}

.admin-orders-table tbody tr:nth-child(3) {
  animation-delay: 0.13s;
}

.admin-orders-table tbody tr:nth-child(4) {
  animation-delay: 0.17s;
}

.admin-orders-table tbody tr:nth-child(5) {
  animation-delay: 0.21s;
}

.admin-orders-table tbody tr:nth-child(6) {
  animation-delay: 0.25s;
}

/* =========================================================
   ANIMATIONS
========================================================= */

@keyframes adminOrderRowReveal {
  from {
    opacity: 0;
    transform: translateY(8px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes adminEmptyFloat {
  0%,
  100% {
    transform: translateY(0);
  }

  50% {
    transform: translateY(-6px);
  }
}

/* =========================================================
   TABLET
========================================================= */

@media (max-width: 900px) {
  .admin-orders-list-panel {
    padding: 20px;
  }

  .admin-orders-table th,
  .admin-orders-table td {
    padding: 14px;
  }
}

/* =========================================================
   MOBILE
========================================================= */

@media (max-width: 600px) {
  .admin-orders-list-panel {
    padding: 16px;
  }

  .admin-orders-table-wrapper {
    border-radius: 13px;
  }

  .admin-orders-table {
    min-width: 780px;
  }

  .admin-orders-table th {
    font-size: 8px;
  }

  .admin-orders-table td {
    font-size: 11px;
  }
}

/* =========================================================
   REDUCED MOTION
========================================================= */

@media (prefers-reduced-motion: reduce) {
  .admin-orders-table tbody tr,
  .admin-empty-state,
  .admin-empty-state > div {
    animation: none;
  }

  .admin-status-badge,
  .admin-orders-table tbody tr,
  .admin-orders-table td:first-child strong {
    transition: none;
  }
}


```css
/* =========================================================
   ABS CUT — ADMIN ORDER DETAILS
   Premium order management interface
========================================================= */

.admin-order-detail-top {
  position: relative;
  margin-bottom: 32px;
  padding: 34px;
  overflow: hidden;

  background:
    radial-gradient(
      circle at 90% 10%,
      rgba(201, 162, 39, 0.12),
      transparent 30%
    ),
    linear-gradient(
      135deg,
      #ffffff 0%,
      #f8f5ed 100%
    );

  border: 1px solid var(--border);
  border-radius: 24px;

  box-shadow:
    0 18px 45px rgba(16, 37, 29, 0.07);

  animation: adminOrderHeaderReveal 0.7s ease both;
}

.admin-order-detail-top::before {
  content: "";
  position: absolute;
  top: 0;
  left: 0;

  width: 100%;
  height: 4px;

  background:
    linear-gradient(
      90deg,
      var(--primary),
      var(--secondary),
      var(--primary)
    );
}

.admin-order-detail-top::after {
  content: "";
  position: absolute;

  width: 220px;
  height: 220px;

  right: -100px;
  bottom: -120px;

  border-radius: 50%;

  background: rgba(201, 162, 39, 0.08);

  pointer-events: none;
}

.admin-back-link {
  display: inline-flex;
  align-items: center;
  gap: 8px;

  margin-bottom: 22px;

  color: var(--primary);
  text-decoration: none;

  font-size: 13px;
  font-weight: 800;
  letter-spacing: 0.04em;

  transition:
    transform 0.25s ease,
    color 0.25s ease;
}

.admin-back-link:hover {
  color: var(--secondary);
  transform: translateX(-5px);
}

.admin-order-detail-top .admin-eyebrow {
  display: block;

  margin-bottom: 8px;

  color: var(--secondary);

  font-size: 11px;
  font-weight: 900;
  letter-spacing: 0.18em;
  text-transform: uppercase;
}

.admin-order-detail-top h1 {
  position: relative;
  z-index: 1;

  margin: 0;

  color: var(--primary-dark);

  font-size: clamp(30px, 4vw, 48px);
  line-height: 1.05;
  letter-spacing: -0.04em;
}

.admin-order-detail-top > p {
  position: relative;
  z-index: 1;

  margin: 10px 0 0;

  color: var(--muted);

  font-size: 14px;
}


/* =========================================================
   DETAIL GRID
========================================================= */

.admin-order-detail-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 22px;

  margin-bottom: 22px;
}


/* =========================================================
   ADMIN PANELS
========================================================= */

.admin-order-detail-grid .admin-panel,
.admin-order-bottom-grid .admin-panel,
.admin-order-items-panel,
.admin-notes-panel {
  position: relative;

  overflow: hidden;

  background: var(--white);

  border: 1px solid var(--border);
  border-radius: 20px;

  box-shadow:
    0 12px 35px rgba(16, 37, 29, 0.055);

  transition:
    transform 0.3s ease,
    box-shadow 0.3s ease,
    border-color 0.3s ease;

  animation: adminPanelReveal 0.65s ease both;
}

.admin-order-detail-grid .admin-panel:hover,
.admin-order-bottom-grid .admin-panel:hover,
.admin-order-items-panel:hover,
.admin-notes-panel:hover {
  transform: translateY(-3px);

  border-color: rgba(201, 162, 39, 0.4);

  box-shadow:
    0 20px 45px rgba(16, 37, 29, 0.09);
}

.admin-panel-header {
  position: relative;

  display: flex;
  align-items: center;
  justify-content: space-between;

  padding: 24px 26px;

  border-bottom: 1px solid var(--border);

  background:
    linear-gradient(
      180deg,
      rgba(248, 245, 237, 0.75),
      rgba(255, 255, 255, 0)
    );
}

.admin-panel-header::before {
  content: "";

  position: absolute;
  left: 0;
  top: 0;

  width: 3px;
  height: 100%;

  background: var(--secondary);
}

.admin-panel-header span {
  display: block;

  margin-bottom: 5px;

  color: var(--secondary);

  font-size: 10px;
  font-weight: 900;
  letter-spacing: 0.16em;
}

.admin-panel-header h2 {
  margin: 0;

  color: var(--primary-dark);

  font-size: 19px;
  line-height: 1.2;
}


/* =========================================================
   CUSTOMER / SHIPPING DETAILS
========================================================= */

.admin-detail-list {
  padding: 8px 26px 18px;
}

.admin-detail-list > div {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 30px;

  padding: 17px 0;

  border-bottom: 1px solid rgba(222, 219, 210, 0.7);
}

.admin-detail-list > div:last-child {
  border-bottom: none;
}

.admin-detail-list span {
  flex-shrink: 0;

  color: var(--muted);

  font-size: 13px;
  font-weight: 600;
}

.admin-detail-list strong {
  max-width: 65%;

  color: var(--text);

  font-size: 14px;
  font-weight: 800;

  text-align: right;

  overflow-wrap: anywhere;
}


/* =========================================================
   ORDER ITEMS
========================================================= */

.admin-order-items-panel {
  margin-bottom: 22px;

  animation-delay: 0.1s;
}

.admin-order-items {
  padding: 8px 26px 20px;
}

.admin-order-item {
  display: grid;

  grid-template-columns: 76px minmax(0, 1fr) auto;

  align-items: center;

  gap: 18px;

  padding: 18px 0;

  border-bottom: 1px solid rgba(222, 219, 210, 0.7);

  transition:
    transform 0.25s ease,
    background 0.25s ease;
}

.admin-order-item:last-child {
  border-bottom: none;
}

.admin-order-item:hover {
  transform: translateX(5px);
}

.admin-order-item-image {
  width: 76px;
  height: 76px;

  display: flex;
  align-items: center;
  justify-content: center;

  overflow: hidden;

  border-radius: 14px;

  background:
    linear-gradient(
      135deg,
      var(--primary-dark),
      var(--primary)
    );

  box-shadow:
    0 8px 20px rgba(16, 37, 29, 0.12);
}

.admin-order-item-image img {
  width: 100%;
  height: 100%;

  object-fit: cover;

  transition:
    transform 0.45s ease;
}

.admin-order-item:hover
.admin-order-item-image img {
  transform: scale(1.08);
}

.admin-order-item-image span {
  color: var(--secondary);

  font-size: 16px;
  font-weight: 900;
  letter-spacing: 0.08em;
}

.admin-order-item-info {
  display: flex;
  flex-direction: column;
  gap: 7px;

  min-width: 0;
}

.admin-order-item-info strong {
  color: var(--primary-dark);

  font-size: 15px;
  font-weight: 850;
}

.admin-order-item-info span {
  color: var(--muted);

  font-size: 13px;
}

.admin-order-item-price {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 6px;
}

.admin-order-item-price span {
  color: var(--muted);

  font-size: 12px;
}

.admin-order-item-price strong {
  color: var(--primary);

  font-size: 15px;
  font-weight: 900;
}


/* =========================================================
   PAYMENT + TOTAL
========================================================= */

.admin-order-bottom-grid {
  display: grid;
  grid-template-columns: 1.25fr 0.75fr;
  gap: 22px;

  margin-bottom: 22px;
}

.admin-order-bottom-grid .admin-panel:first-child {
  animation-delay: 0.15s;
}

.admin-order-bottom-grid .admin-panel:last-child {
  animation-delay: 0.2s;
}

.admin-payment-detail {
  padding: 8px 26px 18px;
}

.admin-payment-detail > div {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;

  padding: 17px 0;

  border-bottom: 1px solid rgba(222, 219, 210, 0.7);
}

.admin-payment-detail > div:last-child {
  border-bottom: none;
}

.admin-payment-detail > div > span:first-child {
  color: var(--muted);

  font-size: 13px;
  font-weight: 600;
}

.admin-payment-detail strong {
  max-width: 65%;

  color: var(--text);

  font-size: 13px;
  font-weight: 800;

  text-align: right;
  overflow-wrap: anywhere;
}


/* =========================================================
   STATUS BADGES
========================================================= */

.admin-status-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;

  min-width: 76px;

  padding: 7px 11px;

  border-radius: 999px;

  font-size: 10px;
  font-weight: 900;

  letter-spacing: 0.07em;
  text-transform: uppercase;

  border: 1px solid transparent;

  transition:
    transform 0.2s ease,
    box-shadow 0.2s ease;
}

.admin-status-badge:hover {
  transform: translateY(-1px);
}

.payment-paid {
  color: #17633e;
  background: #e8f7ee;
  border-color: #bde6cd;
}

.payment-pending {
  color: #856404;
  background: #fff7d8;
  border-color: #eadb91;
}

.payment-failed {
  color: #a22b2b;
  background: #fdeaea;
  border-color: #f0c2c2;
}


/* =========================================================
   ORDER TOTAL
========================================================= */

.admin-order-total-panel {
  background:
    linear-gradient(
      145deg,
      var(--primary-dark),
      var(--primary)
    ) !important;

  border-color: var(--primary-dark) !important;
}

.admin-order-total-panel .admin-panel-header {
  background: transparent;
  border-bottom-color: rgba(255, 255, 255, 0.12);
}

.admin-order-total-panel .admin-panel-header::before {
  background: var(--secondary);
}

.admin-order-total-panel
.admin-panel-header span {
  color: var(--secondary);
}

.admin-order-total-panel
.admin-panel-header h2 {
  color: var(--white);
}

.admin-total-list {
  padding: 10px 26px 24px;
}

.admin-total-list > div {
  display: flex;
  align-items: center;
  justify-content: space-between;

  padding: 15px 0;

  color: rgba(255, 255, 255, 0.72);

  border-bottom: 1px solid rgba(255, 255, 255, 0.1);
}

.admin-total-list > div strong {
  color: var(--white);

  font-size: 14px;
}

.admin-total-list .admin-grand-total {
  margin-top: 10px;
  padding-top: 22px;

  border-bottom: none;

  color: var(--secondary);
}

.admin-total-list .admin-grand-total span {
  font-size: 14px;
  font-weight: 900;
  text-transform: uppercase;
  letter-spacing: 0.08em;
}

.admin-total-list .admin-grand-total strong {
  color: var(--secondary);

  font-size: 25px;
  font-weight: 950;
}


/* =========================================================
   NOTES
========================================================= */

.admin-notes-panel {
  margin-bottom: 30px;

  animation-delay: 0.25s;
}

.admin-notes-panel > p {
  margin: 0;

  padding: 24px 26px 28px;

  color: var(--text);

  font-size: 14px;
  line-height: 1.8;
}


/* =========================================================
   ERROR STATE
========================================================= */

.admin-error-card {
  width: min(620px, calc(100% - 40px));

  margin: 80px auto;
  padding: 50px 35px;

  text-align: center;

  background: var(--white);

  border: 1px solid var(--border);
  border-radius: 24px;

  box-shadow:
    0 20px 60px rgba(16, 37, 29, 0.08);

  animation: adminPanelReveal 0.6s ease both;
}

.admin-error-icon {
  width: 64px;
  height: 64px;

  display: flex;
  align-items: center;
  justify-content: center;

  margin: 0 auto 20px;

  border-radius: 50%;

  color: #a22b2b;
  background: #fdeaea;

  font-size: 26px;
  font-weight: 900;
}

.admin-error-card h1 {
  margin: 0 0 10px;

  color: var(--primary-dark);

  font-size: 28px;
}

.admin-error-card p {
  margin: 0 0 25px;

  color: var(--muted);

  line-height: 1.7;
}

.admin-error-back {
  display: inline-flex;
  align-items: center;
  justify-content: center;

  min-height: 48px;

  padding: 0 22px;

  border-radius: 12px;

  color: var(--white);
  background: var(--primary);

  text-decoration: none;

  font-size: 12px;
  font-weight: 900;
  letter-spacing: 0.06em;

  transition:
    transform 0.25s ease,
    background 0.25s ease,
    box-shadow 0.25s ease;
}

.admin-error-back:hover {
  background: var(--primary-dark);

  transform: translateY(-3px);

  box-shadow:
    0 10px 25px rgba(11, 61, 46, 0.2);
}


/* =========================================================
   ANIMATIONS
========================================================= */

@keyframes adminOrderHeaderReveal {
  from {
    opacity: 0;
    transform: translateY(18px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes adminPanelReveal {
  from {
    opacity: 0;
    transform: translateY(20px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}


/* =========================================================
   RESPONSIVE
========================================================= */

@media (max-width: 1050px) {
  .admin-order-bottom-grid {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 800px) {
  .admin-order-detail-grid {
    grid-template-columns: 1fr;
  }

  .admin-order-detail-top {
    padding: 28px 22px;
  }

  .admin-panel-header {
    padding: 21px;
  }

  .admin-detail-list,
  .admin-payment-detail,
  .admin-order-items,
  .admin-total-list {
    padding-left: 21px;
    padding-right: 21px;
  }
}

@media (max-width: 620px) {
  .admin-order-item {
    grid-template-columns: 60px minmax(0, 1fr);
    gap: 13px;
  }

  .admin-order-item-image {
    width: 60px;
    height: 60px;
  }

  .admin-order-item-price {
    grid-column: 2;
    align-items: flex-start;

    margin-top: -4px;
  }

  .admin-detail-list > div,
  .admin-payment-detail > div {
    flex-direction: column;
    align-items: flex-start;

    gap: 7px;
  }

  .admin-detail-list strong,
  .admin-payment-detail strong {
    max-width: 100%;

    text-align: left;
  }

  .admin-order-detail-top h1 {
    font-size: 32px;
  }
}

@media (max-width: 430px) {
  .admin-order-detail-top {
    padding: 24px 18px;
    border-radius: 18px;
  }

  .admin-panel-header {
    padding: 18px;
  }

  .admin-detail-list,
  .admin-payment-detail,
  .admin-order-items,
  .admin-total-list {
    padding-left: 18px;
    padding-right: 18px;
  }

  .admin-order-item-price strong {
    font-size: 14px;
  }

  .admin-total-list .admin-grand-total strong {
    font-size: 21px;
  }
}


/* =========================================================
   ACCESSIBILITY
========================================================= */

@media (prefers-reduced-motion: reduce) {
  .admin-order-detail-top,
  .admin-order-detail-grid .admin-panel,
  .admin-order-items-panel,
  .admin-order-bottom-grid .admin-panel,
  .admin-notes-panel,
  .admin-error-card {
    animation: none;
  }

  .admin-order-detail-grid .admin-panel,
  .admin-order-bottom-grid .admin-panel,
  .admin-order-items-panel,
  .admin-notes-panel,
  .admin-order-item,
  .admin-order-item-image img,
  .admin-back-link,
  .admin-status-badge,
  .admin-error-back {
    transition: none;
  }
}

```css
/* =========================================================
   ABS CUT — ADMIN ORDER STATUS CONTROL
========================================================= */

.admin-order-status-control {
  position: relative;
  margin-top: 28px;
  padding: 22px 24px;

  display: flex;
  align-items: center;
  gap: 18px;
  flex-wrap: wrap;

  background:
    linear-gradient(
      135deg,
      rgba(11, 61, 46, 0.06),
      rgba(201, 162, 39, 0.08)
    );

  border: 1px solid rgba(201, 162, 39, 0.25);
  border-radius: 18px;

  box-shadow:
    0 12px 35px rgba(16, 37, 29, 0.08);

  overflow: hidden;

  animation: adminStatusReveal 0.55s ease both;
}


/* Gold accent line */

.admin-order-status-control::before {
  content: "";

  position: absolute;
  top: 0;
  left: 0;

  width: 100%;
  height: 3px;

  background:
    linear-gradient(
      90deg,
      var(--primary),
      var(--secondary),
      var(--primary)
    );

  background-size: 200% 100%;

  animation: adminStatusAccent 4s linear infinite;
}


/* Soft background glow */

.admin-order-status-control::after {
  content: "";

  position: absolute;

  width: 180px;
  height: 180px;

  right: -80px;
  bottom: -100px;

  background: rgba(201, 162, 39, 0.08);

  border-radius: 50%;

  filter: blur(4px);

  pointer-events: none;
}


/* =========================================================
   STATUS HEADING
========================================================= */

.admin-order-status-heading {
  min-width: 150px;

  display: flex;
  flex-direction: column;
  gap: 5px;

  position: relative;
  z-index: 2;
}

.admin-order-status-heading span {
  color: var(--secondary);

  font-size: 0.68rem;
  font-weight: 800;

  letter-spacing: 0.16em;
  text-transform: uppercase;
}

.admin-order-status-heading strong {
  color: var(--primary-dark);

  font-size: 1rem;
  font-weight: 800;

  text-transform: capitalize;

  transition:
    color 0.25s ease,
    transform 0.25s ease;
}


/* =========================================================
   SELECT
========================================================= */

.admin-order-status-control select {
  position: relative;
  z-index: 2;

  min-width: 190px;
  height: 50px;

  padding: 0 42px 0 16px;

  appearance: none;
  -webkit-appearance: none;

  color: var(--primary-dark);

  background-color: var(--white);

  border: 1px solid var(--border);
  border-radius: 12px;

  font-family: inherit;
  font-size: 0.9rem;
  font-weight: 700;

  cursor: pointer;

  outline: none;

  box-shadow:
    0 5px 16px rgba(16, 37, 29, 0.06);

  transition:
    border-color 0.25s ease,
    box-shadow 0.25s ease,
    transform 0.25s ease,
    background-color 0.25s ease;
}


/* Custom dropdown arrow */

.admin-order-status-control {
  --status-arrow: "⌄";
}

.admin-order-status-control select {
  background-image:
    linear-gradient(
      45deg,
      transparent 50%,
      var(--primary) 50%
    ),
    linear-gradient(
      135deg,
      var(--primary) 50%,
      transparent 50%
    );

  background-position:
    calc(100% - 18px) 21px,
    calc(100% - 13px) 21px;

  background-size:
    6px 6px,
    6px 6px;

  background-repeat: no-repeat;
}


/* Hover */

.admin-order-status-control select:hover:not(:disabled) {
  border-color: rgba(201, 162, 39, 0.7);

  transform: translateY(-2px);

  box-shadow:
    0 9px 22px rgba(16, 37, 29, 0.1);
}


/* Focus */

.admin-order-status-control select:focus {
  border-color: var(--secondary);

  box-shadow:
    0 0 0 4px rgba(201, 162, 39, 0.12),
    0 10px 25px rgba(16, 37, 29, 0.08);
}


/* Disabled */

.admin-order-status-control select:disabled {
  opacity: 0.65;
  cursor: not-allowed;
}


/* =========================================================
   UPDATING STATE
========================================================= */

.admin-status-updating {
  position: relative;
  z-index: 2;

  display: inline-flex;
  align-items: center;
  gap: 8px;

  color: var(--primary);

  font-size: 0.78rem;
  font-weight: 700;

  animation: adminStatusPulse 1.2s ease-in-out infinite;
}

.admin-status-updating::before {
  content: "";

  width: 8px;
  height: 8px;

  border: 2px solid rgba(11, 61, 46, 0.2);
  border-top-color: var(--secondary);

  border-radius: 50%;

  animation: adminStatusSpinner 0.7s linear infinite;
}


/* =========================================================
   SUCCESS MESSAGE
========================================================= */

.admin-status-success {
  position: relative;
  z-index: 2;

  display: inline-flex;
  align-items: center;

  min-height: 34px;

  padding: 7px 12px;

  color: #17633f;

  background: rgba(38, 166, 102, 0.1);

  border: 1px solid rgba(38, 166, 102, 0.2);
  border-radius: 999px;

  font-size: 0.75rem;
  font-weight: 700;

  animation: adminStatusMessageIn 0.35s ease both;
}


/* =========================================================
   ERROR MESSAGE
========================================================= */

.admin-status-error {
  position: relative;
  z-index: 2;

  display: inline-flex;
  align-items: center;

  min-height: 34px;

  padding: 7px 12px;

  color: #a12828;

  background: rgba(190, 55, 55, 0.08);

  border: 1px solid rgba(190, 55, 55, 0.18);
  border-radius: 999px;

  font-size: 0.75rem;
  font-weight: 700;

  animation: adminStatusMessageIn 0.35s ease both;
}


/* =========================================================
   ANIMATIONS
========================================================= */

@keyframes adminStatusReveal {
  from {
    opacity: 0;
    transform: translateY(14px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}


@keyframes adminStatusAccent {
  0% {
    background-position: 0% 50%;
  }

  100% {
    background-position: 200% 50%;
  }
}


@keyframes adminStatusSpinner {
  to {
    transform: rotate(360deg);
  }
}


@keyframes adminStatusPulse {
  0%,
  100% {
    opacity: 0.55;
  }

  50% {
    opacity: 1;
  }
}


@keyframes adminStatusMessageIn {
  from {
    opacity: 0;
    transform: translateY(5px) scale(0.96);
  }

  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}


/* =========================================================
   TABLET
========================================================= */

@media (max-width: 800px) {
  .admin-order-status-control {
    align-items: stretch;
    flex-direction: column;
  }

  .admin-order-status-heading {
    min-width: 100%;
  }

  .admin-order-status-control select {
    width: 100%;
  }

  .admin-status-updating,
  .admin-status-success,
  .admin-status-error {
    align-self: flex-start;
  }
}


/* =========================================================
   MOBILE
========================================================= */

@media (max-width: 620px) {
  .admin-order-status-control {
    margin-top: 22px;
    padding: 18px;

    border-radius: 15px;
  }

  .admin-order-status-heading strong {
    font-size: 0.95rem;
  }

  .admin-order-status-control select {
    min-width: 0;
    height: 48px;
  }
}


@media (max-width: 430px) {
  .admin-order-status-control {
    padding: 16px;
  }

  .admin-order-status-heading span {
    font-size: 0.62rem;
  }

  .admin-order-status-heading strong {
    font-size: 0.9rem;
  }

  .admin-status-success,
  .admin-status-error {
    width: 100%;
    justify-content: center;
    text-align: center;
  }
}


/* =========================================================
   REDUCED MOTION
========================================================= */

@media (prefers-reduced-motion: reduce) {
  .admin-order-status-control,
  .admin-status-success,
  .admin-status-error {
    animation: none;
  }

  .admin-order-status-control::before {
    animation: none;
  }

  .admin-status-updating {
    animation: none;
  }

  .admin-status-updating::before {
    animation: none;
  }

  .admin-order-status-control select {
    transition: none;
  }
}

```css
/* =========================================================
   ABS CUT — ORDER STATUS TIMELINE
========================================================= */

.admin-order-status-timeline {
  position: relative;

  margin-top: 22px;
  padding: 26px;

  background: var(--white);

  border: 1px solid var(--border);
  border-radius: 18px;

  box-shadow:
    0 12px 35px rgba(16, 37, 29, 0.06);

  overflow: hidden;

  animation:
    adminTimelineReveal
    0.6s ease
    0.12s both;
}


/* Gold accent */

.admin-order-status-timeline::before {
  content: "";

  position: absolute;
  top: 0;
  left: 0;

  width: 100%;
  height: 3px;

  background:
    linear-gradient(
      90deg,
      var(--primary),
      var(--secondary),
      var(--primary)
    );

  background-size: 200% 100%;

  animation:
    adminTimelineAccent
    4s linear infinite;
}


/* =========================================================
   HEADER
========================================================= */

.admin-status-timeline-header {
  display: flex;
  align-items: center;
  justify-content: space-between;

  gap: 20px;

  margin-bottom: 32px;
}

.admin-status-timeline-header span {
  display: block;

  margin-bottom: 5px;

  color: var(--secondary);

  font-size: 0.68rem;
  font-weight: 800;

  letter-spacing: 0.16em;
  text-transform: uppercase;
}

.admin-status-timeline-header h2 {
  margin: 0;

  color: var(--primary-dark);

  font-size: 1.15rem;
  font-weight: 800;
}

.admin-status-timeline-current {
  padding: 8px 14px;

  color: var(--primary);

  background:
    rgba(11, 61, 46, 0.07);

  border: 1px solid
    rgba(11, 61, 46, 0.12);

  border-radius: 999px;

  font-size: 0.75rem;
  font-weight: 800;

  text-transform: capitalize;

  white-space: nowrap;
}


/* =========================================================
   TIMELINE TRACK
========================================================= */

.admin-status-timeline-track {
  display: flex;
  align-items: flex-start;

  width: 100%;
}


/* =========================================================
   STEP
========================================================= */

.admin-status-step {
  position: relative;

  flex: 1;

  min-width: 0;

  display: flex;
  flex-direction: column;
  align-items: center;

  text-align: center;
}


/* =========================================================
   MARKER
========================================================= */

.admin-status-step-marker {
  position: relative;
  z-index: 3;

  width: 42px;
  height: 42px;

  display: flex;
  align-items: center;
  justify-content: center;

  color: var(--muted);

  background: var(--background);

  border: 2px solid var(--border);
  border-radius: 50%;

  font-size: 0.8rem;
  font-weight: 800;

  transition:
    color 0.35s ease,
    background 0.35s ease,
    border-color 0.35s ease,
    transform 0.35s ease,
    box-shadow 0.35s ease;
}


/* =========================================================
   STEP CONTENT
========================================================= */

.admin-status-step-content {
  display: flex;
  flex-direction: column;

  gap: 5px;

  margin-top: 12px;

  padding: 0 8px;
}

.admin-status-step-content strong {
  color: var(--muted);

  font-size: 0.78rem;
  font-weight: 800;

  text-transform: capitalize;

  transition:
    color 0.3s ease;
}

.admin-status-step-content span {
  color: var(--muted);

  font-size: 0.68rem;
  line-height: 1.4;

  transition:
    color 0.3s ease;
}


/* =========================================================
   CONNECTING LINE
========================================================= */

.admin-status-step-line {
  position: absolute;
  z-index: 1;

  top: 20px;
  left: calc(50% + 21px);

  width: calc(100% - 42px);
  height: 3px;

  background:
    var(--border);

  border-radius: 10px;

  overflow: hidden;
}


/* =========================================================
   COMPLETED STEP
========================================================= */

.admin-status-step.completed
  .admin-status-step-marker {
  color: var(--white);

  background:
    var(--primary);

  border-color:
    var(--primary);

  box-shadow:
    0 6px 18px
    rgba(11, 61, 46, 0.2);
}

.admin-status-step.completed
  .admin-status-step-content strong {
  color: var(--primary-dark);
}

.admin-status-step.completed
  .admin-status-step-content span {
  color: var(--muted);
}


/* Completed connecting line */

.admin-status-step-line.completed {
  background:
    linear-gradient(
      90deg,
      var(--primary),
      var(--secondary)
    );

  animation:
    adminTimelineLine
    0.7s ease both;
}


/* =========================================================
   CURRENT STEP
========================================================= */

.admin-status-step.current
  .admin-status-step-marker {
  color: var(--white);

  background:
    var(--secondary);

  border-color:
    var(--secondary);

  box-shadow:
    0 0 0 6px
    rgba(201, 162, 39, 0.13),
    0 8px 22px
    rgba(201, 162, 39, 0.25);

  animation:
    adminCurrentStatusPulse
    2s ease-in-out infinite;
}

.admin-status-step.current
  .admin-status-step-content strong {
  color: var(--primary-dark);
}

.admin-status-step.current
  .admin-status-step-content span {
  color: var(--primary);
}


/* =========================================================
   HOVER
========================================================= */

.admin-status-step:hover
  .admin-status-step-marker {
  transform: translateY(-3px);
}


/* =========================================================
   ANIMATIONS
========================================================= */

@keyframes adminTimelineReveal {
  from {
    opacity: 0;
    transform: translateY(16px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}


@keyframes adminTimelineAccent {
  0% {
    background-position: 0% 50%;
  }

  100% {
    background-position: 200% 50%;
  }
}


@keyframes adminTimelineLine {
  from {
    transform: scaleX(0);
    transform-origin: left;
  }

  to {
    transform: scaleX(1);
    transform-origin: left;
  }
}


@keyframes adminCurrentStatusPulse {
  0%,
  100% {
    box-shadow:
      0 0 0 5px
      rgba(201, 162, 39, 0.1),
      0 8px 22px
      rgba(201, 162, 39, 0.2);
  }

  50% {
    box-shadow:
      0 0 0 9px
      rgba(201, 162, 39, 0.04),
      0 10px 28px
      rgba(201, 162, 39, 0.28);
  }
}


/* =========================================================
   TABLET
========================================================= */

@media (max-width: 800px) {
  .admin-order-status-timeline {
    padding: 22px 18px;
  }

  .admin-status-timeline-header {
    align-items: flex-start;
    flex-direction: column;

    margin-bottom: 28px;
  }

  .admin-status-timeline-track {
    overflow-x: auto;

    padding-bottom: 8px;
  }

  .admin-status-step {
    min-width: 125px;
  }
}


/* =========================================================
   MOBILE
========================================================= */

@media (max-width: 620px) {
  .admin-order-status-timeline {
    padding: 20px 15px;
  }

  .admin-status-timeline-header h2 {
    font-size: 1rem;
  }

  .admin-status-timeline-current {
    font-size: 0.7rem;
  }

  .admin-status-step-marker {
    width: 38px;
    height: 38px;
  }

  .admin-status-step-line {
    top: 18px;

    left: calc(50% + 19px);

    width: calc(100% - 38px);
  }

  .admin-status-step-content strong {
    font-size: 0.72rem;
  }

  .admin-status-step-content span {
    font-size: 0.63rem;
  }
}


/* =========================================================
   REDUCED MOTION
========================================================= */

@media (prefers-reduced-motion: reduce) {
  .admin-order-status-timeline,
  .admin-status-step-line.completed,
  .admin-status-step.current
    .admin-status-step-marker {
    animation: none;
  }

  .admin-order-status-timeline::before {
    animation: none;
  }
}


```css
/* =========================================================
   ABS CUT — ADMIN PRODUCTS PAGE
========================================================= */

.admin-products-header {
  position: relative;

  display: flex;
  align-items: flex-end;
  justify-content: space-between;

  gap: 30px;

  margin-bottom: 30px;
  padding: 30px;

  background:
    radial-gradient(
      circle at 90% 20%,
      rgba(201, 162, 39, 0.12),
      transparent 35%
    ),
    linear-gradient(
      135deg,
      rgba(11, 61, 46, 0.04),
      rgba(255, 255, 255, 0.9)
    );

  border: 1px solid var(--border);
  border-radius: 22px;

  box-shadow:
    0 16px 45px rgba(16, 37, 29, 0.06);

  overflow: hidden;

  animation:
    adminProductsHeaderReveal
    0.65s ease both;
}


.admin-products-header::before {
  content: "";

  position: absolute;

  top: 0;
  left: 0;

  width: 100%;
  height: 4px;

  background:
    linear-gradient(
      90deg,
      var(--primary),
      var(--secondary),
      var(--primary)
    );

  background-size: 200% 100%;

  animation:
    adminProductsAccent
    4s linear infinite;
}


.admin-products-header::after {
  content: "";

  position: absolute;

  width: 220px;
  height: 220px;

  right: -100px;
  top: -130px;

  border-radius: 50%;

  background:
    rgba(201, 162, 39, 0.07);

  pointer-events: none;
}


/* =========================================================
   HEADER TEXT
========================================================= */

.admin-products-header > div {
  position: relative;
  z-index: 2;
}


.admin-products-header h1 {
  margin: 6px 0 8px;

  color: var(--primary-dark);

  font-size: clamp(
    2rem,
    4vw,
    3rem
  );

  font-weight: 900;

  letter-spacing: -0.04em;
}


.admin-products-header p {
  margin: 0;

  max-width: 560px;

  color: var(--muted);

  font-size: 0.95rem;
  line-height: 1.7;
}


/* =========================================================
   ADD PRODUCT BUTTON
========================================================= */

.admin-add-product-btn {
  position: relative;
  z-index: 3;

  min-height: 52px;

  display: inline-flex;
  align-items: center;
  justify-content: center;

  gap: 10px;

  padding: 0 20px;

  color: var(--white);

  background:
    linear-gradient(
      135deg,
      var(--primary),
      var(--primary-dark)
    );

  border: 1px solid
    rgba(201, 162, 39, 0.5);

  border-radius: 12px;

  font-family: inherit;

  font-size: 0.76rem;
  font-weight: 800;

  letter-spacing: 0.08em;

  cursor: pointer;

  box-shadow:
    0 10px 25px
    rgba(11, 61, 46, 0.18);

  transition:
    transform 0.3s ease,
    box-shadow 0.3s ease,
    border-color 0.3s ease;
}


.admin-add-product-btn span {
  display: flex;
  align-items: center;
  justify-content: center;

  width: 25px;
  height: 25px;

  color: var(--primary-dark);

  background: var(--secondary);

  border-radius: 50%;

  font-size: 1.1rem;
  line-height: 1;

  transition:
    transform 0.3s ease;
}


.admin-add-product-btn:hover {
  transform: translateY(-3px);

  border-color: var(--secondary);

  box-shadow:
    0 16px 32px
    rgba(11, 61, 46, 0.25);
}


.admin-add-product-btn:hover span {
  transform: rotate(90deg);
}


.admin-add-product-btn:active {
  transform: translateY(-1px);
}


/* =========================================================
   PRODUCTS TOOLBAR
========================================================= */

.admin-products-toolbar {
  display: grid;

  grid-template-columns:
    minmax(0, 1fr)
    250px;

  gap: 18px;

  margin-bottom: 20px;

  animation:
    adminProductsReveal
    0.55s ease
    0.1s both;
}


/* =========================================================
   SEARCH
========================================================= */

.admin-products-search {
  position: relative;

  display: flex;
  align-items: center;

  min-height: 56px;

  background: var(--white);

  border: 1px solid var(--border);
  border-radius: 14px;

  box-shadow:
    0 8px 25px
    rgba(16, 37, 29, 0.04);

  transition:
    border-color 0.25s ease,
    box-shadow 0.25s ease,
    transform 0.25s ease;
}


.admin-products-search:focus-within {
  border-color: var(--secondary);

  transform: translateY(-2px);

  box-shadow:
    0 0 0 4px
    rgba(201, 162, 39, 0.1),
    0 12px 30px
    rgba(16, 37, 29, 0.08);
}


.admin-products-search > span {
  display: flex;
  align-items: center;
  justify-content: center;

  width: 50px;

  color: var(--secondary);

  font-size: 1.45rem;
}


.admin-products-search input {
  width: 100%;
  height: 54px;

  padding: 0 18px 0 0;

  color: var(--text);

  background: transparent;

  border: 0;
  outline: none;

  font-family: inherit;
  font-size: 0.9rem;
}


.admin-products-search input::placeholder {
  color: #929b96;
}


/* =========================================================
   CATEGORY FILTER
========================================================= */

.admin-products-filter {
  display: flex;
  flex-direction: column;

  gap: 6px;
}


.admin-products-filter label {
  padding-left: 3px;

  color: var(--secondary);

  font-size: 0.64rem;
  font-weight: 800;

  letter-spacing: 0.13em;
}


.admin-products-filter select {
  width: 100%;
  height: 56px;

  padding: 0 15px;

  color: var(--primary-dark);

  background-color: var(--white);

  border: 1px solid var(--border);
  border-radius: 14px;

  outline: none;

  font-family: inherit;
  font-size: 0.84rem;
  font-weight: 700;

  cursor: pointer;

  transition:
    border-color 0.25s ease,
    box-shadow 0.25s ease;
}


.admin-products-filter select:hover {
  border-color:
    rgba(201, 162, 39, 0.6);
}


.admin-products-filter select:focus {
  border-color: var(--secondary);

  box-shadow:
    0 0 0 4px
    rgba(201, 162, 39, 0.1);
}


/* =========================================================
   SUMMARY CARDS
========================================================= */

.admin-products-summary {
  display: grid;

  grid-template-columns:
    repeat(4, 1fr);

  gap: 15px;

  margin-bottom: 28px;
}


.admin-products-summary > div {
  position: relative;

  min-height: 105px;

  display: flex;
  flex-direction: column;
  justify-content: center;

  padding: 20px;

  background: var(--white);

  border: 1px solid var(--border);
  border-radius: 16px;

  overflow: hidden;

  box-shadow:
    0 8px 25px
    rgba(16, 37, 29, 0.04);

  transition:
    transform 0.3s ease,
    box-shadow 0.3s ease,
    border-color 0.3s ease;
}


.admin-products-summary > div::after {
  content: "";

  position: absolute;

  width: 70px;
  height: 70px;

  right: -25px;
  bottom: -30px;

  border-radius: 50%;

  background:
    rgba(201, 162, 39, 0.08);

  transition:
    transform 0.4s ease;
}


.admin-products-summary > div:hover {
  transform: translateY(-4px);

  border-color:
    rgba(201, 162, 39, 0.3);

  box-shadow:
    0 15px 35px
    rgba(16, 37, 29, 0.08);
}


.admin-products-summary > div:hover::after {
  transform: scale(1.5);
}


.admin-products-summary span {
  color: var(--muted);

  font-size: 0.62rem;
  font-weight: 800;

  letter-spacing: 0.12em;
}


.admin-products-summary strong {
  margin-top: 7px;

  color: var(--primary-dark);

  font-size: 1.8rem;
  font-weight: 900;
}


/* =========================================================
   PRODUCT GRID
========================================================= */

.admin-products-grid {
  display: grid;

  grid-template-columns:
    repeat(
      auto-fill,
      minmax(245px, 1fr)
    );

  gap: 22px;
}


/* =========================================================
   PRODUCT CARD
========================================================= */

.admin-product-card {
  position: relative;

  display: flex;
  flex-direction: column;

  background: var(--white);

  border: 1px solid var(--border);
  border-radius: 18px;

  overflow: hidden;

  box-shadow:
    0 10px 30px
    rgba(16, 37, 29, 0.05);

  animation:
    adminProductCardReveal
    0.55s ease both;

  transition:
    transform 0.35s ease,
    box-shadow 0.35s ease,
    border-color 0.35s ease;
}


.admin-product-card:hover {
  transform: translateY(-7px);

  border-color:
    rgba(201, 162, 39, 0.35);

  box-shadow:
    0 22px 45px
    rgba(16, 37, 29, 0.12);
}


/* =========================================================
   PRODUCT IMAGE
========================================================= */

.admin-product-image {
  position: relative;

  height: 255px;

  display: flex;
  align-items: center;
  justify-content: center;

  overflow: hidden;

  background:
    linear-gradient(
      135deg,
      #f4f1e8,
      #ebe7db
    );
}


.admin-product-image::after {
  content: "";

  position: absolute;
  inset: 0;

  background:
    linear-gradient(
      115deg,
      transparent 30%,
      rgba(255,255,255,0.3) 50%,
      transparent 70%
    );

  transform:
    translateX(-120%);

  transition:
    transform 0.8s ease;

  pointer-events: none;
}


.admin-product-card:hover
.admin-product-image::after {
  transform:
    translateX(120%);
}


.admin-product-image img {
  width: 100%;
  height: 100%;

  object-fit: cover;

  transition:
    transform 0.65s cubic-bezier(
      0.22,
      1,
      0.36,
      1
    );
}


.admin-product-card:hover
.admin-product-image img {
  transform: scale(1.07);
}


.admin-product-image > span {
  color: var(--primary);

  font-size: 1.2rem;
  font-weight: 900;

  letter-spacing: 0.1em;
}


/* =========================================================
   STOCK BADGE
========================================================= */

.admin-product-stock {
  position: absolute;

  top: 14px;
  right: 14px;

  z-index: 3;

  padding: 7px 10px;

  border-radius: 999px;

  font-size: 0.61rem;
  font-weight: 900;

  letter-spacing: 0.04em;

  backdrop-filter: blur(8px);

  box-shadow:
    0 6px 15px
    rgba(0,0,0,0.08);
}


.admin-product-stock.good {
  color: #17633f;

  background:
    rgba(229, 248, 238, 0.92);

  border: 1px solid
    rgba(38, 166, 102, 0.2);
}


.admin-product-stock.low {
  color: #886500;

  background:
    rgba(255, 248, 219, 0.94);

  border: 1px solid
    rgba(201, 162, 39, 0.25);
}


.admin-product-stock.out {
  color: #a12828;

  background:
    rgba(255, 235, 235, 0.94);

  border: 1px solid
    rgba(190, 55, 55, 0.2);
}


/* =========================================================
   PRODUCT CONTENT
========================================================= */

.admin-product-content {
  display: flex;
  flex-direction: column;

  flex: 1;

  padding: 20px;
}


.admin-product-category {
  color: var(--secondary);

  font-size: 0.64rem;
  font-weight: 900;

  letter-spacing: 0.14em;

  text-transform: uppercase;
}


.admin-product-content h2 {
  margin: 7px 0 9px;

  color: var(--primary-dark);

  font-size: 1.08rem;
  font-weight: 850;

  line-height: 1.35;
}


.admin-product-price {
  color: var(--primary);

  font-size: 1.05rem;
  font-weight: 900;
}


/* =========================================================
   PRODUCT META
========================================================= */

.admin-product-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;

  gap: 10px;

  margin-top: 16px;
  padding-top: 14px;

  border-top: 1px solid var(--border);

  font-size: 0.68rem;
  font-weight: 700;
}


.admin-product-meta > span:first-child {
  color: var(--muted);
}


.admin-product-meta .active,
.admin-product-meta .inactive {
  padding: 5px 9px;

  border-radius: 999px;

  font-size: 0.6rem;

  text-transform: uppercase;
}


.admin-product-meta .active {
  color: #17633f;

  background:
    rgba(38, 166, 102, 0.09);
}


.admin-product-meta .inactive {
  color: #777;

  background:
    rgba(100, 100, 100, 0.08);
}


/* =========================================================
   MANAGE BUTTON
========================================================= */

.admin-product-manage-btn {
  position: relative;

  width: 100%;

  min-height: 46px;

  display: flex;
  align-items: center;
  justify-content: space-between;

  margin-top: 18px;
  padding: 0 15px;

  color: var(--primary);

  background:
    rgba(11, 61, 46, 0.055);

  border: 1px solid
    rgba(11, 61, 46, 0.12);

  border-radius: 10px;

  font-family: inherit;

  font-size: 0.7rem;
  font-weight: 900;

  letter-spacing: 0.07em;

  cursor: pointer;

  overflow: hidden;

  transition:
    color 0.3s ease,
    background 0.3s ease,
    transform 0.3s ease,
    border-color 0.3s ease;
}


.admin-product-manage-btn::before {
  content: "";

  position: absolute;
  inset: 0;

  background:
    linear-gradient(
      90deg,
      var(--primary),
      var(--primary-dark)
    );

  transform:
    translateX(-101%);

  transition:
    transform 0.35s ease;

  z-index: 0;
}


.admin-product-manage-btn > * {
  position: relative;
  z-index: 1;
}


.admin-product-manage-btn:hover {
  color: var(--white);

  border-color:
    var(--primary);

  transform: translateY(-2px);
}


.admin-product-manage-btn:hover::before {
  transform:
    translateX(0);
}


.admin-product-manage-btn span {
  font-size: 1.05rem;

  transition:
    transform 0.3s ease;
}


.admin-product-manage-btn:hover span {
  transform:
    translateX(5px);
}


/* =========================================================
   EMPTY STATE
========================================================= */

.admin-products-empty {
  min-height: 320px;

  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;

  padding: 40px;

  background: var(--white);

  border: 1px dashed
    var(--border);

  border-radius: 18px;

  text-align: center;

  animation:
    adminProductsReveal
    0.5s ease both;
}


.admin-products-empty > div {
  width: 64px;
  height: 64px;

  display: flex;
  align-items: center;
  justify-content: center;

  margin-bottom: 18px;

  color: var(--secondary);

  background:
    rgba(201, 162, 39, 0.1);

  border-radius: 50%;

  font-size: 1.8rem;
}


.admin-products-empty h2 {
  margin: 0 0 8px;

  color: var(--primary-dark);

  font-size: 1.2rem;
}


.admin-products-empty p {
  margin: 0;

  color: var(--muted);

  font-size: 0.85rem;
}


/* =========================================================
   ERROR
========================================================= */

.admin-products-error {
  display: flex;
  align-items: center;

  gap: 14px;

  margin-bottom: 25px;
  padding: 18px 20px;

  color: #8d2828;

  background:
    rgba(190, 55, 55, 0.06);

  border: 1px solid
    rgba(190, 55, 55, 0.18);

  border-radius: 14px;

  animation:
    adminProductsReveal
    0.45s ease both;
}


.admin-products-error strong {
  font-size: 0.82rem;
}


.admin-products-error span {
  flex: 1;

  font-size: 0.78rem;
}


.admin-products-error button {
  min-height: 36px;

  padding: 0 13px;

  color: #8d2828;

  background: transparent;

  border: 1px solid
    rgba(190, 55, 55, 0.25);

  border-radius: 8px;

  font-family: inherit;

  font-size: 0.65rem;
  font-weight: 800;

  cursor: pointer;

  transition:
    background 0.25s ease,
    color 0.25s ease;
}


.admin-products-error button:hover {
  color: var(--white);

  background: #8d2828;
}


/* =========================================================
   ANIMATIONS
========================================================= */

@keyframes adminProductsHeaderReveal {
  from {
    opacity: 0;
    transform: translateY(18px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}


@keyframes adminProductsReveal {
  from {
    opacity: 0;
    transform: translateY(12px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}


@keyframes adminProductCardReveal {
  from {
    opacity: 0;
    transform:
      translateY(18px)
      scale(0.98);
  }

  to {
    opacity: 1;
    transform:
      translateY(0)
      scale(1);
  }
}


@keyframes adminProductsAccent {
  0% {
    background-position: 0% 50%;
  }

  100% {
    background-position: 200% 50%;
  }
}


/* =========================================================
   RESPONSIVE
========================================================= */

@media (max-width: 1050px) {
  .admin-products-summary {
    grid-template-columns:
      repeat(2, 1fr);
  }
}


@media (max-width: 800px) {
  .admin-products-header {
    align-items: flex-start;

    flex-direction: column;

    padding: 25px;
  }

  .admin-add-product-btn {
    width: 100%;
  }

  .admin-products-toolbar {
    grid-template-columns: 1fr;
  }

  .admin-products-filter {
    width: 100%;
  }
}


@media (max-width: 620px) {
  .admin-products-header {
    padding: 21px;

    border-radius: 17px;
  }

  .admin-products-header h1 {
    font-size: 2rem;
  }

  .admin-products-header p {
    font-size: 0.82rem;
  }

  .admin-products-summary {
    grid-template-columns: 1fr 1fr;

    gap: 10px;
  }

  .admin-products-summary > div {
    min-height: 90px;

    padding: 15px;
  }

  .admin-products-summary strong {
    font-size: 1.45rem;
  }

  .admin-products-grid {
    grid-template-columns: 1fr;

    gap: 16px;
  }

  .admin-product-image {
    height: 280px;
  }
}


@media (max-width: 430px) {
  .admin-products-summary {
    grid-template-columns: 1fr;
  }

  .admin-products-summary > div {
    min-height: 80px;
  }

  .admin-products-search {
    min-height: 52px;
  }

  .admin-products-search input {
    height: 50px;
  }

  .admin-product-image {
    height: 250px;
  }

  .admin-products-error {
    align-items: flex-start;
    flex-direction: column;
  }

  .admin-products-error button {
    width: 100%;
  }
}


/* =========================================================
   REDUCED MOTION
========================================================= */

@media (prefers-reduced-motion: reduce) {
  .admin-products-header,
  .admin-products-toolbar,
  .admin-products-empty,
  .admin-products-error,
  .admin-product-card {
    animation: none;
  }

  .admin-products-header::before {
    animation: none;
  }

  .admin-product-card,
  .admin-product-image img,
  .admin-add-product-btn,
  .admin-product-manage-btn {
    transition: none;
  }

  .admin-product-image::after {
    display: none;
  }
}

```css
/* =========================================================
   ABS CUT — ADMIN PRODUCT DETAILS
   Premium Product Management Interface
========================================================= */

.admin-product-details-page {
  position: relative;
  overflow: hidden;
}

/* =========================================================
   HEADER
========================================================= */

.admin-product-details-header {
  position: relative;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 30px;

  padding: 34px 36px;
  margin-bottom: 22px;

  border: 1px solid rgba(201, 162, 39, 0.18);
  border-radius: 24px;

  background:
    radial-gradient(
      circle at 90% 10%,
      rgba(201, 162, 39, 0.13),
      transparent 28%
    ),
    linear-gradient(
      135deg,
      rgba(11, 61, 46, 0.08),
      rgba(255, 255, 255, 0.96)
    );

  box-shadow:
    0 18px 45px rgba(16, 37, 29, 0.07);

  overflow: hidden;

  animation:
    adminProductDetailsHeaderReveal
    0.65s ease both;
}

.admin-product-details-header::before {
  content: "";
  position: absolute;

  left: 0;
  top: 0;
  bottom: 0;

  width: 5px;

  background:
    linear-gradient(
      180deg,
      var(--secondary),
      var(--primary)
    );

  animation:
    adminProductDetailsAccent
    2.8s ease-in-out infinite;
}

.admin-product-details-header::after {
  content: "";

  position: absolute;

  width: 220px;
  height: 220px;

  right: -80px;
  top: -100px;

  border-radius: 50%;

  border: 1px solid
    rgba(201, 162, 39, 0.12);

  pointer-events: none;
}

.admin-product-details-header > div:first-child {
  position: relative;
  z-index: 2;
}

.admin-product-back-link {
  display: inline-flex;
  align-items: center;
  gap: 8px;

  margin-bottom: 18px;

  color: var(--muted);

  font-size: 13px;
  font-weight: 700;
  letter-spacing: 0.04em;

  text-decoration: none;

  transition:
    color 0.25s ease,
    transform 0.25s ease;
}

.admin-product-back-link:hover {
  color: var(--primary);
  transform: translateX(-4px);
}

.admin-product-details-header .admin-eyebrow {
  display: block;

  margin-bottom: 8px;

  color: var(--secondary);

  font-size: 11px;
  font-weight: 800;
  letter-spacing: 0.18em;
}

.admin-product-details-header h1 {
  margin: 0;

  color: var(--primary-dark);

  font-size: clamp(32px, 4vw, 48px);
  line-height: 1.05;
  letter-spacing: -0.04em;
}

.admin-product-details-header p {
  margin: 12px 0 0;

  max-width: 620px;

  color: var(--muted);

  font-size: 15px;
  line-height: 1.7;
}

/* =========================================================
   LIVE STATUS
========================================================= */

.admin-product-live-status {
  position: relative;
  z-index: 2;

  display: inline-flex;
  align-items: center;
  gap: 10px;

  padding: 12px 18px;

  border-radius: 999px;

  font-size: 11px;
  font-weight: 800;
  letter-spacing: 0.13em;

  white-space: nowrap;

  transition:
    transform 0.25s ease,
    box-shadow 0.25s ease;
}

.admin-product-live-status:hover {
  transform: translateY(-2px);
}

.admin-product-live-status span {
  width: 8px;
  height: 8px;

  border-radius: 50%;

  animation:
    adminProductStatusPulse
    1.8s ease-in-out infinite;
}

.admin-product-live-status.active {
  color: var(--primary);

  background:
    rgba(11, 61, 46, 0.08);

  border: 1px solid
    rgba(11, 61, 46, 0.15);
}

.admin-product-live-status.active span {
  background: #2f8f65;

  box-shadow:
    0 0 0 5px
    rgba(47, 143, 101, 0.12);
}

.admin-product-live-status.inactive {
  color: #8a5a16;

  background:
    rgba(201, 162, 39, 0.1);

  border: 1px solid
    rgba(201, 162, 39, 0.2);
}

.admin-product-live-status.inactive span {
  background: var(--secondary);
}

/* =========================================================
   MESSAGE
========================================================= */

.admin-product-message {
  display: flex;
  align-items: center;
  gap: 13px;

  padding: 15px 18px;

  margin-bottom: 22px;

  border-radius: 14px;

  animation:
    adminProductMessageReveal
    0.4s ease both;
}

.admin-product-message > span {
  display: grid;
  place-items: center;

  width: 28px;
  height: 28px;

  flex: 0 0 28px;

  border-radius: 50%;

  font-size: 13px;
  font-weight: 800;
}

.admin-product-message p {
  margin: 0;

  font-size: 14px;
  font-weight: 600;
}

.admin-product-message.success {
  color: var(--primary);

  background:
    rgba(11, 61, 46, 0.07);

  border: 1px solid
    rgba(11, 61, 46, 0.14);
}

.admin-product-message.success > span {
  color: white;
  background: var(--primary);
}

.admin-product-message.error {
  color: #8d2d2d;

  background:
    rgba(170, 50, 50, 0.07);

  border: 1px solid
    rgba(170, 50, 50, 0.14);
}

.admin-product-message.error > span {
  color: white;
  background: #a83232;
}

/* =========================================================
   MAIN LAYOUT
========================================================= */

.admin-product-details-layout {
  display: grid;

  grid-template-columns:
    minmax(0, 1fr)
    350px;

  gap: 24px;

  align-items: start;
}

.admin-product-details-main {
  display: grid;
  gap: 22px;

  min-width: 0;
}

.admin-product-details-side {
  display: grid;
  gap: 22px;

  position: sticky;
  top: 24px;
}

/* =========================================================
   EDIT CARDS
========================================================= */

.admin-product-edit-card {
  position: relative;

  padding: 28px;

  border: 1px solid var(--border);
  border-radius: 22px;

  background: rgba(255, 255, 255, 0.96);

  box-shadow:
    0 12px 34px
    rgba(16, 37, 29, 0.055);

  overflow: hidden;

  animation:
    adminProductCardReveal
    0.65s ease both;

  transition:
    transform 0.3s ease,
    box-shadow 0.3s ease,
    border-color 0.3s ease;
}

.admin-product-edit-card::before {
  content: "";

  position: absolute;

  left: 0;
  top: 0;

  width: 100%;
  height: 3px;

  background:
    linear-gradient(
      90deg,
      var(--primary),
      var(--secondary),
      transparent
    );

  transform: scaleX(0);
  transform-origin: left;

  transition:
    transform 0.4s ease;
}

.admin-product-edit-card:hover {
  transform: translateY(-3px);

  border-color:
    rgba(11, 61, 46, 0.15);

  box-shadow:
    0 20px 45px
    rgba(16, 37, 29, 0.09);
}

.admin-product-edit-card:hover::before {
  transform: scaleX(1);
}

.admin-product-edit-card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;

  margin-bottom: 24px;
}

.admin-product-edit-card-header span,
.admin-product-summary-card > span,
.admin-product-danger-card > span,
.admin-product-record-card > span {
  display: block;

  color: var(--secondary);

  font-size: 10px;
  font-weight: 800;
  letter-spacing: 0.17em;
}

.admin-product-edit-card-header h2 {
  margin: 6px 0 0;

  color: var(--primary-dark);

  font-size: 21px;
  line-height: 1.2;
}

/* =========================================================
   PRODUCT IMAGE
========================================================= */

.admin-product-preview {
  position: relative;

  display: flex;
  align-items: center;
  justify-content: center;

  min-height: 360px;

  margin-bottom: 24px;

  overflow: hidden;

  border-radius: 18px;

  background:
    radial-gradient(
      circle at 50% 30%,
      rgba(201, 162, 39, 0.08),
      transparent 42%
    ),
    linear-gradient(
      135deg,
      #f0ede4,
      #faf9f5
    );

  border: 1px solid
    rgba(222, 219, 210, 0.9);
}

.admin-product-preview::after {
  content: "";

  position: absolute;

  inset: 0;

  background:
    linear-gradient(
      115deg,
      transparent 25%,
      rgba(255, 255, 255, 0.4) 45%,
      transparent 65%
    );

  transform: translateX(-120%);

  transition:
    transform 0.8s ease;

  pointer-events: none;
}

.admin-product-preview:hover::after {
  transform: translateX(120%);
}

.admin-product-preview img {
  width: 100%;
  height: 360px;

  object-fit: contain;

  padding: 24px;

  transition:
    transform 0.55s
    cubic-bezier(0.2, 0.8, 0.2, 1);
}

.admin-product-preview:hover img {
  transform: scale(1.045);
}

.admin-product-preview > div {
  color: var(--primary);

  font-size: 28px;
  font-weight: 900;
  letter-spacing: 0.12em;
}

.admin-product-preview > span {
  position: absolute;

  left: 16px;
  bottom: 16px;

  z-index: 2;

  padding: 8px 11px;

  color: var(--primary-dark);

  background:
    rgba(255, 255, 255, 0.86);

  border: 1px solid
    rgba(201, 162, 39, 0.18);

  border-radius: 7px;

  font-size: 9px;
  font-weight: 800;
  letter-spacing: 0.13em;

  backdrop-filter: blur(8px);
}

/* =========================================================
   FORM
========================================================= */

.admin-product-form-grid {
  display: grid;

  grid-template-columns:
    repeat(2, minmax(0, 1fr));

  gap: 20px;
}

.admin-product-form-group {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.admin-product-form-group.full {
  grid-column: 1 / -1;
}

.admin-product-form-group label {
  color: var(--primary-dark);

  font-size: 10px;
  font-weight: 800;
  letter-spacing: 0.13em;
}

.admin-product-form-group input,
.admin-product-form-group textarea {
  width: 100%;

  box-sizing: border-box;

  border: 1px solid var(--border);
  border-radius: 12px;

  background:
    rgba(248, 245, 237, 0.55);

  color: var(--text);

  font-family: inherit;
  font-size: 14px;

  outline: none;

  transition:
    border-color 0.25s ease,
    background 0.25s ease,
    box-shadow 0.25s ease,
    transform 0.25s ease;
}

.admin-product-form-group input {
  min-height: 52px;

  padding: 0 15px;
}

.admin-product-form-group textarea {
  min-height: 145px;

  padding: 15px;

  resize: vertical;

  line-height: 1.65;
}

.admin-product-form-group input:hover,
.admin-product-form-group textarea:hover {
  border-color:
    rgba(11, 61, 46, 0.25);

  background: white;
}

.admin-product-form-group input:focus,
.admin-product-form-group textarea:focus {
  border-color: var(--primary);

  background: white;

  box-shadow:
    0 0 0 4px
    rgba(11, 61, 46, 0.08),
    0 8px 20px
    rgba(16, 37, 29, 0.05);

  transform: translateY(-1px);
}

.admin-product-form-group input::placeholder,
.admin-product-form-group textarea::placeholder {
  color: #9aa29d;
}

/* =========================================================
   SETTINGS
========================================================= */

.admin-product-setting-row {
  display: flex;
  align-items: center;
  justify-content: space-between;

  gap: 20px;

  padding: 18px 0;

  border-top: 1px solid
    rgba(222, 219, 210, 0.75);
}

.admin-product-setting-row:first-of-type {
  border-top: none;
}

.admin-product-setting-row strong {
  display: block;

  color: var(--primary-dark);

  font-size: 14px;
}

.admin-product-setting-row p {
  margin: 5px 0 0;

  color: var(--muted);

  font-size: 12px;
  line-height: 1.5;
}

/* =========================================================
   CUSTOM SWITCH
========================================================= */

.admin-product-switch {
  position: relative;

  display: inline-flex;

  width: 52px;
  height: 30px;

  flex: 0 0 52px;

  cursor: pointer;
}

.admin-product-switch input {
  position: absolute;

  opacity: 0;

  pointer-events: none;
}

.admin-product-switch span {
  position: relative;

  width: 100%;
  height: 100%;

  border-radius: 999px;

  background:
    #c8cbc7;

  transition:
    background 0.3s ease,
    box-shadow 0.3s ease;
}

.admin-product-switch span::after {
  content: "";

  position: absolute;

  top: 4px;
  left: 4px;

  width: 22px;
  height: 22px;

  border-radius: 50%;

  background: white;

  box-shadow:
    0 2px 7px
    rgba(0, 0, 0, 0.15);

  transition:
    transform 0.3s
    cubic-bezier(0.2, 0.8, 0.2, 1);
}

.admin-product-switch input:checked + span {
  background: var(--primary);

  box-shadow:
    0 0 0 4px
    rgba(11, 61, 46, 0.08);
}

.admin-product-switch input:checked + span::after {
  transform: translateX(22px);
}

.admin-product-switch:hover span {
  box-shadow:
    0 0 0 4px
    rgba(201, 162, 39, 0.1);
}

/* =========================================================
   ACTION BUTTONS
========================================================= */

.admin-product-actions {
  display: flex;
  align-items: center;

  gap: 12px;
}

.admin-product-save-btn,
.admin-product-cancel-btn {
  min-height: 56px;

  border-radius: 12px;

  font-family: inherit;
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 0.11em;

  cursor: pointer;

  transition:
    transform 0.25s ease,
    box-shadow 0.25s ease,
    background 0.25s ease,
    border-color 0.25s ease;
}

.admin-product-save-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 24px;

  min-width: 210px;

  padding: 0 20px;

  color: white;

  border: 1px solid var(--primary);

  background:
    linear-gradient(
      135deg,
      var(--primary),
      var(--primary-dark)
    );

  box-shadow:
    0 10px 24px
    rgba(11, 61, 46, 0.18);
}

.admin-product-save-btn span {
  display: grid;
  place-items: center;

  width: 30px;
  height: 30px;

  border-radius: 50%;

  color: var(--primary);

  background: var(--secondary);

  font-size: 16px;

  transition:
    transform 0.3s ease;
}

.admin-product-save-btn:hover:not(:disabled) {
  transform: translateY(-3px);

  box-shadow:
    0 16px 30px
    rgba(11, 61, 46, 0.25);
}

.admin-product-save-btn:hover:not(:disabled) span {
  transform: translateX(5px);
}

.admin-product-save-btn:active:not(:disabled) {
  transform: translateY(-1px);
}

.admin-product-save-btn:disabled {
  opacity: 0.6;
  cursor: not-allowed;
}

.admin-product-cancel-btn {
  padding: 0 24px;

  color: var(--primary-dark);

  background: white;

  border: 1px solid var(--border);
}

.admin-product-cancel-btn:hover {
  border-color: var(--primary);

  background:
    rgba(11, 61, 46, 0.04);

  transform: translateY(-2px);
}

/* =========================================================
   SUMMARY CARD
========================================================= */

.admin-product-summary-card {
  text-align: center;
}

.admin-product-summary-image {
  position: relative;

  display: flex;
  align-items: center;
  justify-content: center;

  height: 220px;

  margin: 20px 0;

  overflow: hidden;

  border-radius: 16px;

  background:
    linear-gradient(
      135deg,
      #f1eee6,
      #faf9f5
    );

  border: 1px solid var(--border);
}

.admin-product-summary-image img {
  width: 100%;
  height: 100%;

  padding: 16px;

  object-fit: contain;

  transition:
    transform 0.45s ease;
}

.admin-product-summary-image:hover img {
  transform: scale(1.06);
}

.admin-product-summary-image > span {
  color: var(--primary);

  font-weight: 900;
  letter-spacing: 0.1em;
}

.admin-product-summary-card h2 {
  margin: 0;

  color: var(--primary-dark);

  font-size: 20px;
  line-height: 1.3;
}

.admin-product-summary-card > strong {
  display: block;

  margin-top: 8px;

  color: var(--primary);

  font-size: 21px;
}

.admin-product-summary-details {
  display: grid;

  grid-template-columns: 1fr 1fr;

  gap: 10px;

  margin-top: 22px;
}

.admin-product-summary-details > div {
  padding: 13px;

  text-align: left;

  border-radius: 11px;

  background:
    var(--background);

  border: 1px solid var(--border);
}

.admin-product-summary-details span {
  display: block;

  margin-bottom: 5px;

  color: var(--muted);

  font-size: 9px;
  font-weight: 800;
  letter-spacing: 0.1em;
}

.admin-product-summary-details b {
  color: var(--primary-dark);

  font-size: 13px;
}

/* =========================================================
   DANGER CARD
========================================================= */

.admin-product-danger-card {
  border-color:
    rgba(165, 61, 61, 0.15);
}

.admin-product-danger-card > span {
  color: #a45353;
}

.admin-product-danger-card h2 {
  margin: 9px 0 8px;

  color: var(--primary-dark);

  font-size: 19px;
}

.admin-product-danger-card p {
  margin: 0 0 20px;

  color: var(--muted);

  font-size: 12px;
  line-height: 1.7;
}

.admin-product-danger-card button {
  width: 100%;

  min-height: 48px;

  padding: 0 15px;

  color: #9a3535;

  background:
    rgba(165, 61, 61, 0.05);

  border: 1px solid
    rgba(165, 61, 61, 0.2);

  border-radius: 10px;

  font-family: inherit;

  font-size: 10px;
  font-weight: 800;
  letter-spacing: 0.1em;

  cursor: pointer;

  transition:
    background 0.25s ease,
    color 0.25s ease,
    transform 0.25s ease,
    box-shadow 0.25s ease;
}

.admin-product-danger-card button:hover:not(:disabled) {
  color: white;

  background: #a53d3d;

  transform: translateY(-2px);

  box-shadow:
    0 10px 20px
    rgba(165, 61, 61, 0.18);
}

.admin-product-danger-card button:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

/* =========================================================
   DATABASE RECORD
========================================================= */

.admin-product-record-card {
  display: grid;
  gap: 0;
}

.admin-product-record-card > span {
  margin-bottom: 17px;
}

.admin-product-record-card > div {
  padding: 13px 0;

  border-top: 1px solid
    rgba(222, 219, 210, 0.75);
}

.admin-product-record-card small {
  display: block;

  margin-bottom: 6px;

  color: var(--muted);

  font-size: 9px;
  font-weight: 800;
  letter-spacing: 0.1em;
}

.admin-product-record-card strong {
  color: var(--primary-dark);

  font-size: 12px;
}

.admin-product-record-card code {
  display: block;

  overflow: hidden;

  color: var(--primary);

  font-family:
    "Courier New",
    monospace;

  font-size: 10px;

  line-height: 1.5;

  word-break: break-all;
}

/* =========================================================
   ERROR PAGE
========================================================= */

.admin-product-details-error {
  max-width: 650px;

  margin: 80px auto;

  padding: 45px;

  text-align: center;

  border-radius: 24px;

  background: white;

  border: 1px solid var(--border);

  box-shadow:
    0 20px 50px
    rgba(16, 37, 29, 0.08);

  animation:
    adminProductCardReveal
    0.55s ease both;
}

.admin-product-details-error > span {
  color: #a45353;

  font-size: 10px;
  font-weight: 800;
  letter-spacing: 0.15em;
}

.admin-product-details-error h1 {
  margin: 12px 0 8px;

  color: var(--primary-dark);

  font-size: 30px;
}

.admin-product-details-error p {
  margin: 0 0 25px;

  color: var(--muted);

  line-height: 1.6;
}

.admin-product-back-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;

  min-height: 48px;

  padding: 0 20px;

  color: white;

  background: var(--primary);

  border-radius: 10px;

  font-size: 10px;
  font-weight: 800;
  letter-spacing: 0.1em;

  text-decoration: none;

  transition:
    transform 0.25s ease,
    box-shadow 0.25s ease;
}

.admin-product-back-btn:hover {
  transform: translateY(-2px);

  box-shadow:
    0 10px 22px
    rgba(11, 61, 46, 0.2);
}

/* =========================================================
   ANIMATIONS
========================================================= */

@keyframes adminProductDetailsHeaderReveal {
  from {
    opacity: 0;
    transform: translateY(18px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes adminProductCardReveal {
  from {
    opacity: 0;
    transform: translateY(22px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes adminProductMessageReveal {
  from {
    opacity: 0;
    transform: translateY(-8px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes adminProductDetailsAccent {
  0%,
  100% {
    opacity: 0.7;
  }

  50% {
    opacity: 1;
  }
}

@keyframes adminProductStatusPulse {
  0%,
  100% {
    transform: scale(1);
    opacity: 1;
  }

  50% {
    transform: scale(1.3);
    opacity: 0.65;
  }
}

/* =========================================================
   RESPONSIVE — 1050px
========================================================= */

@media (max-width: 1050px) {
  .admin-product-details-layout {
    grid-template-columns: 1fr;
  }

  .admin-product-details-side {
    position: static;

    grid-template-columns:
      repeat(2, minmax(0, 1fr));

    align-items: start;
  }

  .admin-product-summary-card {
    grid-column: span 2;
  }
}

/* =========================================================
   RESPONSIVE — 800px
========================================================= */

@media (max-width: 800px) {
  .admin-product-details-header {
    align-items: flex-start;
    flex-direction: column;

    padding: 28px 24px;
  }

  .admin-product-live-status {
    align-self: flex-start;
  }

  .admin-product-edit-card {
    padding: 22px;
  }

  .admin-product-form-grid {
    grid-template-columns: 1fr;
  }

  .admin-product-form-group.full {
    grid-column: auto;
  }

  .admin-product-preview {
    min-height: 300px;
  }

  .admin-product-preview img {
    height: 300px;
  }
}

/* =========================================================
   RESPONSIVE — 620px
========================================================= */

@media (max-width: 620px) {
  .admin-product-details-header {
    margin-bottom: 16px;

    border-radius: 18px;
  }

  .admin-product-details-header h1 {
    font-size: 32px;
  }

  .admin-product-details-header p {
    font-size: 13px;
  }

  .admin-product-details-side {
    grid-template-columns: 1fr;
  }

  .admin-product-summary-card {
    grid-column: auto;
  }

  .admin-product-actions {
    flex-direction: column;
  }

  .admin-product-save-btn,
  .admin-product-cancel-btn {
    width: 100%;
  }

  .admin-product-preview {
    min-height: 250px;
  }

  .admin-product-preview img {
    height: 250px;
  }
}

/* =========================================================
   RESPONSIVE — 430px
========================================================= */

@media (max-width: 430px) {
  .admin-product-details-header {
    padding: 23px 18px;
  }

  .admin-product-edit-card {
    padding: 18px;

    border-radius: 17px;
  }

  .admin-product-edit-card-header {
    margin-bottom: 19px;
  }

  .admin-product-edit-card-header h2 {
    font-size: 18px;
  }

  .admin-product-form-group input {
    min-height: 48px;
  }

  .admin-product-setting-row {
    gap: 12px;
  }

  .admin-product-setting-row p {
    font-size: 11px;
  }

  .admin-product-summary-details {
    grid-template-columns: 1fr;
  }

  .admin-product-details-error {
    margin: 40px 15px;

    padding: 30px 20px;
  }
}

/* =========================================================
   REDUCED MOTION
========================================================= */

@media (prefers-reduced-motion: reduce) {
  .admin-product-details-header,
  .admin-product-edit-card,
  .admin-product-message {
    animation: none;
  }

  .admin-product-details-header::before,
  .admin-product-live-status span {
    animation: none;
  }

  .admin-product-edit-card,
  .admin-product-preview img,
  .admin-product-save-btn,
  .admin-product-cancel-btn,
  .admin-product-danger-card button,
  .admin-product-back-link {
    transition: none;
  }
}

```css
/* =========================================================
   ABS CUT — ADMIN PRODUCT CREATE
========================================================= */

.admin-product-create-page {
  position: relative;
  overflow: hidden;
}

/* HEADER */

.admin-product-create-header {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 30px;
  margin-bottom: 30px;
  animation: adminCreateHeaderReveal 0.7s ease both;
}

.admin-product-create-header h1 {
  margin: 8px 0 8px;
  color: var(--primary-dark);
  font-size: clamp(2rem, 4vw, 3rem);
  line-height: 1.05;
  letter-spacing: -0.04em;
}

.admin-product-create-header p {
  margin: 0;
  color: var(--muted);
  font-size: 0.98rem;
}

.admin-product-create-back {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 14px;
  padding: 0;
  border: 0;
  background: transparent;
  color: var(--primary);
  font: inherit;
  font-size: 0.82rem;
  font-weight: 800;
  cursor: pointer;
  transition:
    color 0.25s ease,
    transform 0.25s ease;
}

.admin-product-create-back:hover {
  color: var(--secondary);
  transform: translateX(-4px);
}

.admin-product-create-badge {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  padding: 12px 17px;
  border: 1px solid rgba(201, 162, 39, 0.35);
  border-radius: 999px;
  background: rgba(201, 162, 39, 0.08);
  color: var(--primary-dark);
  font-size: 0.72rem;
  font-weight: 900;
  letter-spacing: 0.12em;
  white-space: nowrap;
}

.admin-product-create-badge span {
  display: grid;
  width: 24px;
  height: 24px;
  place-items: center;
  border-radius: 50%;
  background: var(--secondary);
  color: var(--white);
  font-size: 1rem;
}

/* ERROR */

.admin-product-create-error {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 24px;
  padding: 15px 18px;
  border: 1px solid rgba(180, 50, 50, 0.18);
  border-radius: 14px;
  background: rgba(180, 50, 50, 0.06);
  color: #9b3030;
  animation: adminCreateMessageReveal 0.35s ease both;
}

.admin-product-create-error span {
  display: grid;
  width: 28px;
  height: 28px;
  flex-shrink: 0;
  place-items: center;
  border-radius: 50%;
  background: #9b3030;
  color: var(--white);
  font-weight: 900;
}

.admin-product-create-error p {
  margin: 0;
  font-size: 0.9rem;
  font-weight: 700;
}

/* LAYOUT */

.admin-product-create-layout {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 340px;
  align-items: start;
  gap: 26px;
}

.admin-product-create-main {
  display: grid;
  gap: 24px;
  min-width: 0;
}

.admin-product-create-side {
  position: sticky;
  top: 24px;
  display: grid;
  gap: 24px;
}

/* CARDS */

.admin-product-create-card {
  position: relative;
  overflow: hidden;
  padding: 28px;
  border: 1px solid var(--border);
  border-radius: 20px;
  background: var(--white);
  box-shadow: 0 14px 40px rgba(16, 37, 29, 0.055);
  animation: adminCreateCardReveal 0.7s ease both;
}

.admin-product-create-card::before {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 4px;
  background: linear-gradient(
    90deg,
    var(--secondary),
    transparent
  );
  transform: scaleX(0);
  transform-origin: left;
  transition: transform 0.45s ease;
}

.admin-product-create-card:hover::before {
  transform: scaleX(1);
}

.admin-product-create-card-header {
  display: flex;
  justify-content: space-between;
  margin-bottom: 24px;
}

.admin-product-create-card-header span,
.admin-product-create-summary > span,
.admin-product-create-tip > span {
  display: block;
  margin-bottom: 7px;
  color: var(--secondary);
  font-size: 0.68rem;
  font-weight: 900;
  letter-spacing: 0.15em;
}

.admin-product-create-card-header h2 {
  margin: 0;
  color: var(--primary-dark);
  font-size: 1.25rem;
  letter-spacing: -0.025em;
}

/* IMAGE PREVIEW */

.admin-product-create-preview {
  position: relative;
  display: flex;
  min-height: 310px;
  align-items: center;
  justify-content: center;
  margin-bottom: 22px;
  overflow: hidden;
  border: 1px solid var(--border);
  border-radius: 16px;
  background:
    radial-gradient(
      circle at 50% 35%,
      rgba(201, 162, 39, 0.13),
      transparent 45%
    ),
    #f2eee4;
}

.admin-product-create-preview img {
  width: 100%;
  height: 310px;
  object-fit: contain;
  padding: 20px;
  transition:
    transform 0.5s ease,
    filter 0.5s ease;
}

.admin-product-create-preview:hover img {
  transform: scale(1.035);
}

.admin-product-create-empty-preview {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: var(--primary-dark);
}

.admin-product-create-empty-preview span {
  display: grid;
  width: 68px;
  height: 68px;
  margin-bottom: 12px;
  place-items: center;
  border: 1px solid rgba(201, 162, 39, 0.5);
  border-radius: 50%;
  background: rgba(201, 162, 39, 0.1);
  color: var(--secondary);
  font-size: 1.8rem;
  font-weight: 900;
}

.admin-product-create-empty-preview strong {
  font-size: 1.05rem;
  letter-spacing: 0.15em;
}

.admin-product-create-empty-preview small {
  margin-top: 6px;
  color: var(--muted);
  font-size: 0.65rem;
  font-weight: 800;
  letter-spacing: 0.12em;
}

.admin-product-create-preview-label {
  position: absolute;
  right: 14px;
  bottom: 14px;
  padding: 7px 10px;
  border: 1px solid rgba(255, 255, 255, 0.7);
  border-radius: 7px;
  background: rgba(16, 37, 29, 0.82);
  color: var(--white);
  font-size: 0.62rem;
  font-weight: 800;
  letter-spacing: 0.12em;
}

/* FORM */

.admin-product-create-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 20px;
}

.admin-product-create-field {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.admin-product-create-field.full {
  grid-column: 1 / -1;
}

.admin-product-create-field label {
  margin-bottom: 8px;
  color: var(--primary-dark);
  font-size: 0.68rem;
  font-weight: 900;
  letter-spacing: 0.1em;
}

.admin-product-create-field input,
.admin-product-create-field textarea {
  width: 100%;
  box-sizing: border-box;
  border: 1px solid var(--border);
  border-radius: 11px;
  outline: none;
  background: #fcfbf7;
  color: var(--text);
  font: inherit;
  transition:
    border-color 0.25s ease,
    box-shadow 0.25s ease,
    transform 0.25s ease,
    background 0.25s ease;
}

.admin-product-create-field input {
  min-height: 52px;
  padding: 0 15px;
}

.admin-product-create-field textarea {
  min-height: 155px;
  padding: 15px;
  resize: vertical;
  line-height: 1.65;
}

.admin-product-create-field input:hover,
.admin-product-create-field textarea:hover {
  border-color: rgba(11, 61, 46, 0.35);
  background: var(--white);
}

.admin-product-create-field input:focus,
.admin-product-create-field textarea:focus {
  border-color: var(--primary);
  background: var(--white);
  box-shadow:
    0 0 0 4px rgba(11, 61, 46, 0.08),
    0 8px 22px rgba(11, 61, 46, 0.06);
  transform: translateY(-1px);
}

.admin-product-create-field small {
  margin-top: 7px;
  color: var(--muted);
  font-size: 0.72rem;
}

/* SETTINGS */

.admin-product-create-setting {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  padding: 18px 0;
  border-bottom: 1px solid var(--border);
}

.admin-product-create-setting:first-of-type {
  padding-top: 0;
}

.admin-product-create-setting:last-child {
  padding-bottom: 0;
  border-bottom: 0;
}

.admin-product-create-setting strong {
  display: block;
  margin-bottom: 5px;
  color: var(--primary-dark);
  font-size: 0.95rem;
}

.admin-product-create-setting p {
  max-width: 520px;
  margin: 0;
  color: var(--muted);
  font-size: 0.8rem;
  line-height: 1.6;
}

/* SWITCH */

.admin-product-create-switch {
  position: relative;
  display: block;
  width: 54px;
  height: 30px;
  flex-shrink: 0;
  cursor: pointer;
}

.admin-product-create-switch input {
  position: absolute;
  opacity: 0;
  pointer-events: none;
}

.admin-product-create-switch span {
  position: absolute;
  inset: 0;
  border-radius: 999px;
  background: #d9ddd8;
  transition: background 0.3s ease;
}

.admin-product-create-switch span::after {
  content: "";
  position: absolute;
  top: 4px;
  left: 4px;
  width: 22px;
  height: 22px;
  border-radius: 50%;
  background: var(--white);
  box-shadow: 0 3px 8px rgba(0, 0, 0, 0.16);
  transition: transform 0.3s ease;
}

.admin-product-create-switch input:checked + span {
  background: var(--primary);
}

.admin-product-create-switch input:checked + span::after {
  transform: translateX(24px);
}

/* ACTIONS */

.admin-product-create-actions {
  display: flex;
  align-items: center;
  gap: 12px;
  padding-bottom: 20px;
}

.admin-product-create-save,
.admin-product-create-cancel {
  min-height: 56px;
  border-radius: 12px;
  font: inherit;
  font-weight: 900;
  cursor: pointer;
  transition:
    transform 0.25s ease,
    box-shadow 0.25s ease,
    background 0.25s ease;
}

.admin-product-create-save {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 16px;
  min-width: 210px;
  padding: 0 24px;
  border: 0;
  background: var(--primary);
  color: var(--white);
}

.admin-product-create-save span {
  font-size: 1.2rem;
  transition: transform 0.25s ease;
}

.admin-product-create-save:hover:not(:disabled) {
  background: var(--primary-dark);
  box-shadow: 0 14px 28px rgba(11, 61, 46, 0.2);
  transform: translateY(-2px);
}

.admin-product-create-save:hover:not(:disabled) span {
  transform: translateX(5px);
}

.admin-product-create-save:disabled {
  cursor: not-allowed;
  opacity: 0.65;
}

.admin-product-create-cancel {
  padding: 0 24px;
  border: 1px solid var(--border);
  background: var(--white);
  color: var(--primary-dark);
}

.admin-product-create-cancel:hover {
  border-color: var(--primary);
  transform: translateY(-2px);
}

/* SUMMARY */

.admin-product-create-summary {
  padding: 24px;
}

.admin-product-create-summary-image {
  display: flex;
  min-height: 210px;
  align-items: center;
  justify-content: center;
  margin: 18px 0;
  overflow: hidden;
  border-radius: 14px;
  background: #f1eee5;
}

.admin-product-create-summary-image img {
  width: 100%;
  height: 210px;
  object-fit: contain;
  padding: 15px;
  transition: transform 0.4s ease;
}

.admin-product-create-summary-image:hover img {
  transform: scale(1.05);
}

.admin-product-create-summary-image strong {
  color: var(--secondary);
  font-size: 1.3rem;
  letter-spacing: 0.15em;
}

.admin-product-create-summary h2 {
  margin: 0 0 8px;
  color: var(--primary-dark);
  font-size: 1.15rem;
}

.admin-product-create-summary-price {
  display: block;
  color: var(--primary);
  font-size: 1.25rem;
}

.admin-product-create-summary-meta {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 10px;
  margin-top: 20px;
}

.admin-product-create-summary-meta div {
  padding: 13px;
  border: 1px solid var(--border);
  border-radius: 10px;
  background: #fcfbf7;
}

.admin-product-create-summary-meta span {
  display: block;
  margin-bottom: 5px;
  color: var(--muted);
  font-size: 0.6rem;
  font-weight: 800;
  letter-spacing: 0.1em;
}

.admin-product-create-summary-meta b {
  color: var(--primary-dark);
  font-size: 0.85rem;
}

.admin-product-create-status {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-top: 16px;
  padding: 10px 12px;
  border-radius: 9px;
  font-size: 0.65rem;
  font-weight: 900;
  letter-spacing: 0.08em;
}

.admin-product-create-status span {
  width: 7px;
  height: 7px;
  border-radius: 50%;
}

.admin-product-create-status.active {
  background: rgba(11, 61, 46, 0.08);
  color: var(--primary);
}

.admin-product-create-status.active span {
  background: var(--primary);
  box-shadow: 0 0 0 4px rgba(11, 61, 46, 0.1);
}

.admin-product-create-status.inactive {
  background: rgba(120, 120, 120, 0.08);
  color: var(--muted);
}

.admin-product-create-status.inactive span {
  background: var(--muted);
}

/* TIP */

.admin-product-create-tip {
  padding: 24px;
}

.admin-product-create-tip h2 {
  margin: 0 0 10px;
  color: var(--primary-dark);
  font-size: 1.05rem;
}

.admin-product-create-tip p {
  margin: 0;
  color: var(--muted);
  font-size: 0.82rem;
  line-height: 1.75;
}

/* ANIMATIONS */

@keyframes adminCreateHeaderReveal {
  from {
    opacity: 0;
    transform: translateY(18px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes adminCreateCardReveal {
  from {
    opacity: 0;
    transform: translateY(22px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes adminCreateMessageReveal {
  from {
    opacity: 0;
    transform: translateY(-8px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* RESPONSIVE */

@media (max-width: 1050px) {
  .admin-product-create-layout {
    grid-template-columns: 1fr;
  }

  .admin-product-create-side {
    position: static;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (max-width: 800px) {
  .admin-product-create-header {
    align-items: flex-start;
    flex-direction: column;
  }

  .admin-product-create-grid {
    grid-template-columns: 1fr;
  }

  .admin-product-create-field.full {
    grid-column: auto;
  }

  .admin-product-create-side {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 620px) {
  .admin-product-create-card {
    padding: 20px;
    border-radius: 16px;
  }

  .admin-product-create-preview,
  .admin-product-create-preview img {
    min-height: 240px;
    height: 240px;
  }

  .admin-product-create-actions {
    flex-direction: column;
    align-items: stretch;
  }

  .admin-product-create-save {
    width: 100%;
  }

  .admin-product-create-cancel {
    width: 100%;
  }
}

@media (max-width: 430px) {
  .admin-product-create-header h1 {
    font-size: 1.8rem;
  }

  .admin-product-create-badge {
    font-size: 0.62rem;
  }

  .admin-product-create-setting {
    align-items: flex-start;
  }

  .admin-product-create-summary-meta {
    grid-template-columns: 1fr;
  }
}

/* REDUCED MOTION */

@media (prefers-reduced-motion: reduce) {
  .admin-product-create-header,
  .admin-product-create-card,
  .admin-product-create-error {
    animation: none;
  }

  .admin-product-create-card,
  .admin-product-create-preview img,
  .admin-product-create-summary-image img,
  .admin-product-create-save,
  .admin-product-create-cancel,
  .admin-product-create-back {
    transition: none;
  }
}

```css
/* =========================================================
   ABS CUT — PRODUCT IMAGE UPLOAD
========================================================= */

.admin-product-create-upload-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12px;
  margin-top: 24px;
  padding: 28px;
  border: 1px dashed var(--border);
  border-radius: 18px;
  background:
    linear-gradient(
      135deg,
      rgba(11, 61, 46, 0.03),
      rgba(201, 162, 39, 0.05)
    );
  transition:
    border-color 0.3s ease,
    background 0.3s ease,
    transform 0.3s ease;
}

.admin-product-create-upload-area:hover {
  border-color: var(--secondary);
  background:
    linear-gradient(
      135deg,
      rgba(11, 61, 46, 0.05),
      rgba(201, 162, 39, 0.08)
    );
  transform: translateY(-2px);
}

.admin-product-create-upload-button {
  position: relative;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  min-width: 210px;
  min-height: 54px;
  padding: 0 24px;
  border-radius: 12px;
  background: var(--primary);
  color: var(--white);
  font-size: 0.78rem;
  font-weight: 800;
  letter-spacing: 0.12em;
  cursor: pointer;
  overflow: hidden;
  box-shadow:
    0 12px 25px
    rgba(11, 61, 46, 0.16);
  transition:
    transform 0.3s ease,
    background 0.3s ease,
    box-shadow 0.3s ease;
}

.admin-product-create-upload-button:hover {
  background: var(--primary-dark);
  transform: translateY(-3px);
  box-shadow:
    0 16px 30px
    rgba(11, 61, 46, 0.22);
}

.admin-product-create-upload-button:active {
  transform: translateY(-1px);
}

.admin-product-create-upload-button.uploading {
  cursor: wait;
  opacity: 0.85;
}

.admin-product-create-upload-button input {
  position: absolute;
  width: 1px;
  height: 1px;
  opacity: 0;
  pointer-events: none;
}

.admin-product-create-upload-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 28px;
  height: 28px;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.14);
  font-size: 1rem;
}

.admin-product-create-upload-button.uploading
.admin-product-create-upload-icon {
  animation:
    adminProductUploadSpin
    1s linear infinite;
}

.admin-product-create-upload-area p {
  margin: 0;
  text-align: center;
  color: var(--muted);
  font-size: 0.78rem;
  line-height: 1.7;
}

.admin-product-create-image-divider {
  display: flex;
  align-items: center;
  gap: 14px;
  margin: 22px 0;
  color: var(--muted);
  font-size: 0.7rem;
  font-weight: 800;
  letter-spacing: 0.12em;
}

.admin-product-create-image-divider::before,
.admin-product-create-image-divider::after {
  content: "";
  width: 70px;
  height: 1px;
  background: var(--border);
}

.admin-product-create-remove-image {
  position: absolute;
  top: 16px;
  right: 16px;
  z-index: 3;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 38px;
  height: 38px;
  border: 1px solid rgba(255, 255, 255, 0.35);
  border-radius: 50%;
  background: rgba(16, 37, 29, 0.85);
  color: var(--white);
  font-size: 1.4rem;
  line-height: 1;
  cursor: pointer;
  backdrop-filter: blur(8px);
  transition:
    transform 0.3s ease,
    background 0.3s ease;
}

.admin-product-create-remove-image:hover {
  background: #9b2c2c;
  transform: rotate(90deg) scale(1.08);
}

.admin-product-create-success {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 22px;
  padding: 15px 18px;
  border: 1px solid rgba(11, 61, 46, 0.16);
  border-radius: 12px;
  background: rgba(11, 61, 46, 0.06);
  color: var(--primary);
  animation:
    adminProductUploadMessage
    0.45s ease both;
}

.admin-product-create-success span {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 28px;
  height: 28px;
  border-radius: 50%;
  background: var(--primary);
  color: var(--white);
  font-weight: 800;
}

.admin-product-create-success p {
  margin: 0;
  font-size: 0.88rem;
  font-weight: 700;
}

@keyframes adminProductUploadSpin {
  from {
    transform: rotate(0deg);
  }

  to {
    transform: rotate(360deg);
  }
}

@keyframes adminProductUploadMessage {
  from {
    opacity: 0;
    transform: translateY(-8px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@media (max-width: 600px) {
  .admin-product-create-upload-area {
    padding: 22px 16px;
  }

  .admin-product-create-upload-button {
    width: 100%;
  }

  .admin-product-create-image-divider::before,
  .admin-product-create-image-divider::after {
    width: 40px;
  }
}

@media (prefers-reduced-motion: reduce) {
  .admin-product-create-upload-area,
  .admin-product-create-upload-button,
  .admin-product-create-remove-image {
    transition: none;
  }

  .admin-product-create-upload-button.uploading
  .admin-product-create-upload-icon {
    animation: none;
  }

  .admin-product-create-success {
    animation: none;
  }
}


```css
/* =========================================================
   ABS CUT — PRODUCT VIDEO
========================================================= */

.admin-product-create-video-preview {
  position: relative;
  min-height: 360px;
  overflow: hidden;
  border-radius: 18px;
  background: var(--primary-dark);
  border: 1px solid var(--border);
}

.admin-product-create-video-preview video {
  display: block;
  width: 100%;
  height: 360px;
  object-fit: cover;
  background: var(--primary-dark);
}

.admin-product-create-empty-video {
  min-height: 360px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10px;
  color: var(--white);
  background:
    radial-gradient(
      circle at center,
      rgba(201, 162, 39, 0.16),
      transparent 55%
    );
}

.admin-product-create-empty-video span {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 70px;
  height: 70px;
  border: 1px solid rgba(201, 162, 39, 0.5);
  border-radius: 50%;
  color: var(--secondary);
  font-size: 1.5rem;
  animation: adminVideoPulse 2.5s ease-in-out infinite;
}

.admin-product-create-empty-video strong {
  font-size: 0.9rem;
  letter-spacing: 0.12em;
}

.admin-product-create-empty-video small {
  color: rgba(255, 255, 255, 0.6);
  font-size: 0.65rem;
  letter-spacing: 0.1em;
}

.admin-product-create-remove-video {
  position: absolute;
  top: 16px;
  right: 16px;
  z-index: 5;
  width: 40px;
  height: 40px;
  border: 1px solid rgba(255, 255, 255, 0.25);
  border-radius: 50%;
  background: rgba(16, 37, 29, 0.85);
  color: var(--white);
  font-size: 1.4rem;
  cursor: pointer;
  backdrop-filter: blur(8px);
  transition:
    transform 0.3s ease,
    background 0.3s ease;
}

.admin-product-create-remove-video:hover {
  background: #9b2c2c;
  transform: rotate(90deg) scale(1.08);
}

.admin-product-create-video-duration {
  position: absolute;
  left: 16px;
  bottom: 16px;
  z-index: 5;
  display: flex;
  align-items: center;
  gap: 7px;
  padding: 8px 12px;
  border-radius: 20px;
  background: rgba(16, 37, 29, 0.85);
  color: var(--white);
  font-size: 0.72rem;
  font-weight: 700;
  backdrop-filter: blur(8px);
}

.admin-product-create-video-duration span {
  color: var(--secondary);
  font-size: 0.55rem;
}

.admin-product-create-video-badge {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-top: 18px;
  padding: 10px 13px;
  border: 1px solid rgba(201, 162, 39, 0.3);
  border-radius: 10px;
  background: rgba(201, 162, 39, 0.07);
  color: var(--secondary);
  font-size: 0.7rem;
  font-weight: 800;
  letter-spacing: 0.08em;
}

@keyframes adminVideoPulse {
  0%,
  100% {
    transform: scale(1);
    box-shadow: 0 0 0 0
      rgba(201, 162, 39, 0);
  }

  50% {
    transform: scale(1.06);
    box-shadow: 0 0 0 12px
      rgba(201, 162, 39, 0.06);
  }
}

@media (max-width: 600px) {
  .admin-product-create-video-preview {
    min-height: 240px;
  }

  .admin-product-create-video-preview video {
    height: 240px;
  }

  .admin-product-create-empty-video {
    min-height: 240px;
  }
}

@media (prefers-reduced-motion: reduce) {
  .admin-product-create-empty-video span {
    animation: none;
  }

  .admin-product-create-remove-video {
    transition: none;
  }
}


```css
/* =========================================================
   ABS CUT — ADMIN PRODUCT MEDIA
   Image + Video Management
========================================================= */

.admin-product-media-card {
  overflow: hidden;
}

.admin-product-media-count {
  display: inline-flex;
  align-items: center;
  min-height: 32px;
  padding: 7px 11px;
  border: 1px solid rgba(201, 162, 39, 0.3);
  border-radius: 999px;
  background: rgba(201, 162, 39, 0.07);
  color: var(--secondary);
  font-size: 0.62rem;
  font-weight: 800;
  letter-spacing: 0.08em;
}

.admin-product-media-preview,
.admin-product-video-preview {
  position: relative;
  overflow: hidden;
  margin-bottom: 24px;
  border-radius: 18px;
  background: var(--primary-dark);
  border: 1px solid var(--border);
}

.admin-product-media-preview {
  min-height: 360px;
}

.admin-product-media-preview img {
  display: block;
  width: 100%;
  height: 360px;
  object-fit: cover;
  transition: transform 0.7s ease;
}

.admin-product-media-preview:hover img {
  transform: scale(1.025);
}

.admin-product-media-label {
  position: absolute;
  left: 18px;
  bottom: 18px;
  display: flex;
  flex-direction: column;
  gap: 3px;
  padding: 10px 13px;
  border: 1px solid rgba(255, 255, 255, 0.18);
  border-radius: 10px;
  background: rgba(16, 37, 29, 0.82);
  color: var(--white);
  backdrop-filter: blur(10px);
}

.admin-product-media-label span {
  color: var(--secondary);
  font-size: 0.65rem;
  font-weight: 800;
  letter-spacing: 0.12em;
}

.admin-product-media-label small {
  color: rgba(255, 255, 255, 0.6);
  font-size: 0.58rem;
  letter-spacing: 0.08em;
}

/* VIDEO */

.admin-product-video-preview {
  min-height: 360px;
}

.admin-product-video-preview video {
  display: block;
  width: 100%;
  height: 360px;
  object-fit: cover;
  background: var(--primary-dark);
}

.admin-product-video-overlay {
  position: absolute;
  left: 18px;
  bottom: 58px;
  display: flex;
  align-items: center;
  gap: 9px;
  padding: 8px 12px;
  border-radius: 999px;
  background: rgba(16, 37, 29, 0.84);
  color: var(--white);
  backdrop-filter: blur(10px);
  pointer-events: none;
}

.admin-product-video-overlay span {
  color: var(--secondary);
  font-size: 0.62rem;
  font-weight: 800;
  letter-spacing: 0.1em;
}

.admin-product-video-overlay small {
  color: rgba(255, 255, 255, 0.65);
  font-size: 0.65rem;
}

.admin-product-remove-video {
  position: absolute;
  top: 16px;
  right: 16px;
  z-index: 5;
  width: 42px;
  height: 42px;
  border: 1px solid rgba(255, 255, 255, 0.22);
  border-radius: 50%;
  background: rgba(16, 37, 29, 0.85);
  color: var(--white);
  font-size: 1.35rem;
  cursor: pointer;
  backdrop-filter: blur(10px);
  transition:
    transform 0.3s ease,
    background 0.3s ease;
}

.admin-product-remove-video:hover {
  background: #9b2c2c;
  transform: rotate(90deg) scale(1.08);
}

.admin-product-remove-video:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

/* VIDEO UPLOAD */

.admin-product-video-upload {
  margin-top: 26px;
  padding: 22px;
  border: 1px solid var(--border);
  border-radius: 16px;
  background:
    radial-gradient(
      circle at 90% 10%,
      rgba(201, 162, 39, 0.08),
      transparent 35%
    ),
    rgba(248, 245, 237, 0.45);
}

.admin-product-video-upload-heading {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20px;
  margin-bottom: 18px;
}

.admin-product-video-upload-heading > div {
  display: flex;
  flex-direction: column;
  gap: 5px;
}

.admin-product-video-upload-heading span {
  color: var(--secondary);
  font-size: 0.62rem;
  font-weight: 800;
  letter-spacing: 0.12em;
}

.admin-product-video-upload-heading h3 {
  margin: 0;
  color: var(--primary-dark);
  font-size: 1rem;
}

.admin-product-video-upload-heading > small {
  color: var(--muted);
  font-size: 0.6rem;
  font-weight: 700;
  letter-spacing: 0.08em;
}

.admin-product-video-upload-button {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 52px;
  padding: 0 20px;
  overflow: hidden;
  border: 1px solid var(--primary);
  border-radius: 10px;
  background: var(--primary);
  color: var(--white);
  cursor: pointer;
  font-size: 0.68rem;
  font-weight: 800;
  letter-spacing: 0.08em;
  transition:
    transform 0.25s ease,
    background 0.25s ease,
    box-shadow 0.25s ease;
}

.admin-product-video-upload-button:hover {
  background: var(--primary-dark);
  transform: translateY(-2px);
  box-shadow: 0 12px 28px rgba(11, 61, 46, 0.16);
}

.admin-product-video-upload-button.uploading {
  opacity: 0.7;
  cursor: wait;
}

.admin-product-video-upload-button input {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  opacity: 0;
  cursor: pointer;
}

.admin-product-remove-video-btn {
  width: 100%;
  min-height: 46px;
  margin-top: 10px;
  border: 1px solid rgba(155, 44, 44, 0.3);
  border-radius: 10px;
  background: transparent;
  color: #9b2c2c;
  cursor: pointer;
  font-size: 0.65rem;
  font-weight: 800;
  letter-spacing: 0.08em;
  transition:
    background 0.25s ease,
    color 0.25s ease;
}

.admin-product-remove-video-btn:hover {
  background: #9b2c2c;
  color: var(--white);
}

.admin-product-remove-video-btn:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

/* VIDEO STATUS */

.admin-product-video-status {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-top: 14px;
  padding: 12px 14px;
  border: 1px solid rgba(201, 162, 39, 0.25);
  border-radius: 10px;
  background: rgba(201, 162, 39, 0.06);
}

.admin-product-video-status > span {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 28px;
  height: 28px;
  border-radius: 50%;
  background: var(--secondary);
  color: var(--primary-dark);
  font-size: 0.72rem;
  font-weight: 900;
}

.admin-product-video-status div {
  display: flex;
  flex-direction: column;
  gap: 3px;
}

.admin-product-video-status strong {
  color: var(--primary-dark);
  font-size: 0.62rem;
  letter-spacing: 0.08em;
}

.admin-product-video-status small {
  color: var(--muted);
  font-size: 0.62rem;
}

/* MEDIA NOTE */

.admin-product-media-note {
  display: flex;
  align-items: flex-start;
  gap: 10px;
  margin-top: 18px;
  padding: 12px 14px;
  border-left: 3px solid var(--secondary);
  background: rgba(201, 162, 39, 0.06);
}

.admin-product-media-note > span {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  width: 20px;
  height: 20px;
  border: 1px solid rgba(201, 162, 39, 0.5);
  border-radius: 50%;
  color: var(--secondary);
  font-size: 0.65rem;
  font-weight: 800;
}

.admin-product-media-note p {
  margin: 0;
  color: var(--muted);
  font-size: 0.68rem;
  line-height: 1.6;
}

/* EMPTY MEDIA */

.admin-product-empty-media {
  min-height: 220px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8px;
  margin-bottom: 24px;
  border: 1px dashed var(--border);
  border-radius: 18px;
  background:
    radial-gradient(
      circle at center,
      rgba(201, 162, 39, 0.08),
      transparent 55%
    );
}

.admin-product-empty-media > span {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 58px;
  height: 58px;
  border: 1px solid rgba(201, 162, 39, 0.4);
  border-radius: 50%;
  color: var(--secondary);
  font-size: 1.3rem;
  animation: adminProductMediaPulse 2.5s ease-in-out infinite;
}

.admin-product-empty-media strong {
  color: var(--primary-dark);
  font-size: 0.7rem;
  letter-spacing: 0.1em;
}

.admin-product-empty-media small {
  color: var(--muted);
  font-size: 0.62rem;
}

/* OPTIONAL LABEL */

.admin-product-form-group label {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
}

.admin-product-form-group label small {
  color: var(--secondary);
  font-size: 0.55rem;
  letter-spacing: 0.08em;
}

/* SUMMARY VIDEO */

.admin-product-summary-image {
  overflow: hidden;
}

.admin-product-summary-image video {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
  background: var(--primary-dark);
}

/* SUMMARY MEDIA BADGES */

.admin-product-summary-media {
  display: flex;
  flex-wrap: wrap;
  gap: 7px;
  margin-top: 16px;
}

.admin-product-summary-media span {
  padding: 6px 9px;
  border: 1px solid rgba(201, 162, 39, 0.28);
  border-radius: 999px;
  background: rgba(201, 162, 39, 0.06);
  color: var(--secondary);
  font-size: 0.55rem;
  font-weight: 800;
  letter-spacing: 0.06em;
}

@keyframes adminProductMediaPulse {
  0%,
  100% {
    transform: scale(1);
    box-shadow: 0 0 0 0 rgba(201, 162, 39, 0);
  }

  50% {
    transform: scale(1.05);
    box-shadow:
      0 0 0 10px
      rgba(201, 162, 39, 0.05);
  }
}

/* RESPONSIVE */

@media (max-width: 700px) {
  .admin-product-media-preview,
  .admin-product-video-preview {
    min-height: 260px;
  }

  .admin-product-media-preview img,
  .admin-product-video-preview video {
    height: 260px;
  }

  .admin-product-video-upload-heading {
    flex-direction: column;
    gap: 8px;
  }
}

@media (max-width: 430px) {
  .admin-product-media-preview,
  .admin-product-video-preview {
    min-height: 220px;
  }

  .admin-product-media-preview img,
  .admin-product-video-preview video {
    height: 220px;
  }

  .admin-product-video-upload {
    padding: 16px;
  }
}

@media (prefers-reduced-motion: reduce) {
  .admin-product-media-preview img,
  .admin-product-remove-video,
  .admin-product-video-upload-button {
    transition: none;
  }

  .admin-product-empty-media > span {
    animation: none;
  }
}

```css
/* =========================================================
   ABS CUT — PRODUCT DETAILS MEDIA
========================================================= */

.product-details-media {
  display: flex;
  flex-direction: column;
  gap: 24px;
}

.product-details-image-wrapper,
.product-details-video-wrapper {
  position: relative;
  overflow: hidden;

  width: 100%;
  min-height: 560px;

  border: 1px solid var(--border);
  border-radius: 24px;

  background: var(--primary-dark);

  box-shadow:
    0 24px 60px
    rgba(16, 37, 29, 0.12);

  animation:
    productDetailsMediaIn
    0.8s
    cubic-bezier(0.22, 1, 0.36, 1)
    both;
}

.product-details-image {
  display: block;

  width: 100%;
  height: 560px;

  object-fit: cover;

  transition:
    transform 0.9s
    cubic-bezier(0.22, 1, 0.36, 1);
}

.product-details-image-wrapper:hover
.product-details-image {
  transform: scale(1.025);
}

/* =========================================================
   VIDEO
========================================================= */

.product-details-video-wrapper {
  background: var(--primary-dark);
}

.product-details-video {
  display: block;

  width: 100%;
  min-height: 420px;

  max-height: 650px;

  object-fit: contain;

  background: var(--primary-dark);
}

.product-details-video-wrapper.video-only
.product-details-video {
  min-height: 560px;
}

.product-details-video-label {
  position: absolute;

  top: 18px;
  left: 18px;

  display: inline-flex;
  align-items: center;
  gap: 8px;

  padding: 9px 13px;

  border: 1px solid
    rgba(255, 255, 255, 0.18);

  border-radius: 999px;

  background:
    rgba(16, 37, 29, 0.88);

  color: var(--white);

  font-size: 0.58rem;
  font-weight: 800;

  letter-spacing: 0.08em;

  backdrop-filter: blur(12px);

  pointer-events: none;
}

.product-details-video-label span {
  color: var(--secondary);
}

/* =========================================================
   IMAGE + VIDEO BADGE
========================================================= */

.product-details-media-badge {
  position: absolute;

  top: 18px;
  left: 18px;

  z-index: 3;

  display: inline-flex;
  align-items: center;
  gap: 8px;

  padding: 9px 13px;

  border-radius: 999px;

  background:
    rgba(16, 37, 29, 0.9);

  border: 1px solid
    rgba(201, 162, 39, 0.35);

  color: var(--white);

  font-size: 0.58rem;
  font-weight: 800;

  letter-spacing: 0.08em;

  backdrop-filter: blur(12px);

  animation:
    productDetailsBadgeIn
    0.6s
    ease
    both;
}

.product-details-media-badge span {
  color: var(--secondary);
}

/* =========================================================
   SECONDARY VIDEO
========================================================= */

.product-details-secondary-video {
  overflow: hidden;

  border: 1px solid var(--border);
  border-radius: 24px;

  background: var(--white);

  box-shadow:
    0 18px 45px
    rgba(16, 37, 29, 0.08);

  animation:
    productDetailsMediaIn
    0.8s
    0.12s
    cubic-bezier(0.22, 1, 0.36, 1)
    both;
}

.product-details-secondary-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;

  padding: 18px 20px;

  border-bottom: 1px solid var(--border);
}

.product-details-secondary-heading span {
  color: var(--primary);

  font-size: 0.68rem;
  font-weight: 900;

  letter-spacing: 0.1em;
}

.product-details-secondary-heading small {
  color: var(--muted);

  font-size: 0.7rem;
}

/* =========================================================
   MEDIA STATUS
========================================================= */

.product-details-media-status {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;

  margin: 20px 0;
}

.product-details-media-status span {
  display: inline-flex;
  align-items: center;
  gap: 6px;

  padding: 7px 10px;

  border: 1px solid var(--border);
  border-radius: 999px;

  background:
    rgba(248, 245, 237, 0.75);

  color: var(--muted);

  font-size: 0.56rem;
  font-weight: 800;

  letter-spacing: 0.07em;
}

.product-details-media-status span i {
  font-style: normal;
  font-size: 0.5rem;
}

.product-details-media-status
span.has-video {
  color: var(--primary);

  border-color:
    rgba(201, 162, 39, 0.35);

  background:
    rgba(201, 162, 39, 0.08);
}

.product-details-media-status
span.has-video i {
  color: var(--secondary);
}

/* =========================================================
   EMPTY MEDIA
========================================================= */

.product-details-empty-media {
  display: flex;
  align-items: center;
  justify-content: center;

  min-height: 560px;

  border-radius: 24px;

  background:
    linear-gradient(
      135deg,
      var(--primary-dark),
      var(--primary)
    );

  color: var(--secondary);

  font-size: 1.3rem;
  font-weight: 900;

  letter-spacing: 0.2em;
}

/* =========================================================
   ANIMATIONS
========================================================= */

@keyframes productDetailsMediaIn {
  from {
    opacity: 0;
    transform:
      translateY(24px)
      scale(0.985);
  }

  to {
    opacity: 1;
    transform:
      translateY(0)
      scale(1);
  }
}

@keyframes productDetailsBadgeIn {
  from {
    opacity: 0;
    transform:
      translateY(-10px)
      scale(0.94);
  }

  to {
    opacity: 1;
    transform:
      translateY(0)
      scale(1);
  }
}

/* =========================================================
   MOBILE
========================================================= */

@media (max-width: 900px) {
  .product-details-image-wrapper,
  .product-details-video-wrapper {
    min-height: 440px;
  }

  .product-details-image {
    height: 440px;
  }

  .product-details-video-wrapper.video-only
  .product-details-video {
    min-height: 440px;
  }
}

@media (max-width: 620px) {
  .product-details-media {
    gap: 16px;
  }

  .product-details-image-wrapper,
  .product-details-video-wrapper,
  .product-details-secondary-video {
    border-radius: 18px;
  }

  .product-details-image-wrapper,
  .product-details-video-wrapper {
    min-height: 360px;
  }

  .product-details-image {
    height: 360px;
  }

  .product-details-video,
  .product-details-video-wrapper.video-only
  .product-details-video {
    min-height: 360px;
  }

  .product-details-media-badge,
  .product-details-video-label {
    top: 12px;
    left: 12px;

    padding: 7px 10px;

    font-size: 0.5rem;
  }

  .product-details-secondary-heading {
    align-items: flex-start;
    flex-direction: column;
    gap: 5px;

    padding: 15px;
  }

  .product-details-empty-media {
    min-height: 360px;
  }
}

/* =========================================================
   REDUCED MOTION
========================================================= */

@media (prefers-reduced-motion: reduce) {
  .product-details-image {
    transition: none;
  }

  .product-details-image-wrapper:hover
  .product-details-image {
    transform: none;
  }

  .product-details-image-wrapper,
  .product-details-video-wrapper,
  .product-details-secondary-video,
  .product-details-media-badge {
    animation: none;
  }
}

```css
/* =========================================================
   ABS CUT — PRODUCT DETAILS VIDEO
========================================================= */

.video-wrapper {
  position: relative;
  width: 100%;
  overflow: hidden;

  background: var(--primary-dark);

  border: 1px solid var(--border);
  border-radius: 18px;

  box-shadow:
    0 18px 45px
    rgba(16, 37, 29, 0.14);

  animation:
    productVideoReveal
    0.8s
    cubic-bezier(0.22, 1, 0.36, 1)
    both;
}

.video-wrapper video {
  display: block;

  width: 100%;
  min-height: 420px;
  max-height: 620px;

  object-fit: contain;

  background: var(--primary-dark);

  transition:
    transform 0.7s
    cubic-bezier(0.22, 1, 0.36, 1);
}

.video-wrapper:hover video {
  transform: scale(1.015);
}

/* =========================================================
   VIDEO CONTROLS
========================================================= */

.video-wrapper video::-webkit-media-controls-panel {
  background:
    linear-gradient(
      transparent,
      rgba(16, 37, 29, 0.92)
    );
}

.video-wrapper video::-webkit-media-controls-play-button,
.video-wrapper video::-webkit-media-controls-mute-button {
  filter: brightness(1.15);
}

/* =========================================================
   VIDEO GLOW
========================================================= */

.video-wrapper::before {
  content: "";

  position: absolute;
  inset: 0;

  pointer-events: none;

  border-radius: inherit;

  box-shadow:
    inset 0 0 0 1px
    rgba(201, 162, 39, 0.12);

  z-index: 2;
}

/* =========================================================
   VIDEO LABEL
========================================================= */

.video-wrapper::after {
  content: "PRODUCT VIDEO";

  position: absolute;

  top: 16px;
  left: 16px;

  padding: 8px 12px;

  border-radius: 999px;

  background:
    rgba(16, 37, 29, 0.9);

  border: 1px solid
    rgba(201, 162, 39, 0.35);

  color: var(--white);

  font-size: 0.58rem;
  font-weight: 800;

  letter-spacing: 0.1em;

  backdrop-filter: blur(10px);

  pointer-events: none;

  z-index: 3;

  animation:
    productVideoLabel
    0.6s
    ease
    both;
}

/* =========================================================
   NO MEDIA
========================================================= */

.no-product-media {
  display: flex;
  align-items: center;
  justify-content: center;

  width: 100%;
  min-height: 420px;

  border-radius: 18px;

  background:
    linear-gradient(
      135deg,
      var(--primary-dark),
      var(--primary)
    );

  color: var(--secondary);

  font-size: 1.2rem;
  font-weight: 900;

  letter-spacing: 0.18em;
}

/* =========================================================
   ANIMATIONS
========================================================= */

@keyframes productVideoReveal {
  from {
    opacity: 0;
    transform:
      translateY(20px)
      scale(0.98);
  }

  to {
    opacity: 1;
    transform:
      translateY(0)
      scale(1);
  }
}

@keyframes productVideoLabel {
  from {
    opacity: 0;
    transform:
      translateY(-8px)
      scale(0.94);
  }

  to {
    opacity: 1;
    transform:
      translateY(0)
      scale(1);
  }
}

/* =========================================================
   MOBILE
========================================================= */

@media (max-width: 700px) {
  .video-wrapper {
    border-radius: 14px;
  }

  .video-wrapper video {
    min-height: 300px;
    max-height: 480px;
  }

  .video-wrapper::after {
    top: 10px;
    left: 10px;

    padding: 6px 9px;

    font-size: 0.5rem;
  }

  .no-product-media {
    min-height: 300px;
  }
}

/* =========================================================
   REDUCED MOTION
========================================================= */

@media (prefers-reduced-motion: reduce) {
  .video-wrapper,
  .video-wrapper::after {
    animation: none;
  }

  .video-wrapper video {
    transition: none;
  }

  .video-wrapper:hover video {
    transform: none;
  }
}


/* =========================================================
   ABS CUT — ADMIN CUSTOM ORDERS
   Matches existing admin-dashboard structure
========================================================= */

.admin-custom-orders-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 30px;

  margin-bottom: 30px;
}

.admin-custom-orders-header > div:first-child {
  position: relative;

  padding-left: 18px;
}

.admin-custom-orders-header > div:first-child::before {
  content: "";

  position: absolute;

  left: 0;
  top: 0;
  bottom: 0;

  width: 4px;

  border-radius: 20px;

  background: linear-gradient(
    to bottom,
    #c9a227,
    #0b3d2e
  );
}

.admin-custom-orders-header h1 {
  margin: 5px 0 8px;

  color: #10251d;

  font-size: clamp(30px, 4vw, 42px);
  font-weight: 850;

  letter-spacing: -1.5px;
}

.admin-custom-orders-header p {
  max-width: 650px;

  margin: 0;

  color: #66736d;

  font-size: 14px;
  line-height: 1.7;
}

.admin-custom-orders-header-stat {
  min-width: 170px;

  padding: 18px 22px;

  border: 1px solid #dedbd2;
  border-radius: 16px;

  background: #ffffff;

  box-shadow:
    0 8px 25px rgba(16, 37, 29, 0.05);

  text-align: center;
}

.admin-custom-orders-header-stat span {
  display: block;

  color: #66736d;

  font-size: 9px;
  font-weight: 800;

  letter-spacing: 1.5px;
}

.admin-custom-orders-header-stat strong {
  display: block;

  margin-top: 4px;

  color: #0b3d2e;

  font-size: 30px;
}


/* =========================================================
   SUMMARY
========================================================= */

.admin-custom-orders-summary {
  display: grid;

  grid-template-columns:
    repeat(3, 1fr);

  gap: 18px;

  margin-bottom: 24px;
}

.admin-custom-summary-card {
  position: relative;

  overflow: hidden;

  padding: 20px 22px;

  border: 1px solid #dedbd2;
  border-radius: 16px;

  background: #ffffff;

  box-shadow:
    0 8px 25px rgba(16, 37, 29, 0.045);

  transition:
    transform 0.3s ease,
    box-shadow 0.3s ease,
    border-color 0.3s ease;
}

.admin-custom-summary-card::after {
  content: "";

  position: absolute;

  right: -35px;
  top: -35px;

  width: 90px;
  height: 90px;

  border-radius: 50%;

  background: rgba(201, 162, 39, 0.08);
}

.admin-custom-summary-card:hover {
  transform: translateY(-4px);

  border-color: rgba(201, 162, 39, 0.4);

  box-shadow:
    0 15px 35px rgba(16, 37, 29, 0.08);
}

.admin-custom-summary-card span {
  display: block;

  color: #66736d;

  font-size: 9px;
  font-weight: 800;

  letter-spacing: 1.3px;
}

.admin-custom-summary-card strong {
  display: block;

  margin-top: 5px;

  color: #10251d;

  font-size: 28px;
}

.admin-custom-summary-card small {
  display: block;

  margin-top: 3px;

  color: #929b96;

  font-size: 10px;
}


/* =========================================================
   TABLE CARD
========================================================= */

.admin-custom-orders-card {
  overflow: hidden;

  border: 1px solid #dedbd2;
  border-radius: 18px;

  background: #ffffff;

  box-shadow:
    0 10px 35px rgba(16, 37, 29, 0.055);

  animation:
    adminCustomOrdersIn 0.45s ease both;
}

@keyframes adminCustomOrdersIn {
  from {
    opacity: 0;
    transform: translateY(10px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}


/* =========================================================
   CARD HEADER
========================================================= */

.admin-custom-orders-card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;

  padding: 21px 23px;

  border-bottom: 1px solid #ebe8e0;
}

.admin-custom-orders-card-header span {
  color: #c9a227;

  font-size: 9px;
  font-weight: 800;

  letter-spacing: 1.5px;
}

.admin-custom-orders-card-header h2 {
  margin: 4px 0 0;

  color: #10251d;

  font-size: 18px;
}

.admin-custom-orders-refresh {
  display: inline-flex;
  align-items: center;
  gap: 7px;

  padding: 9px 13px;

  border: 1px solid #dedbd2;
  border-radius: 9px;

  background: #ffffff;

  color: #0b3d2e;

  font-size: 9px;
  font-weight: 800;

  letter-spacing: 1px;

  cursor: pointer;

  transition:
    background 0.25s ease,
    color 0.25s ease,
    transform 0.25s ease;
}

.admin-custom-orders-refresh span {
  font-size: 17px;
}

.admin-custom-orders-refresh:hover {
  background: #0b3d2e;

  color: #ffffff;

  transform: translateY(-2px);
}


/* =========================================================
   TABLE
========================================================= */

.admin-custom-orders-table-wrapper {
  width: 100%;

  overflow-x: auto;
}

.admin-custom-orders-table {
  width: 100%;

  min-width: 1050px;

  border-collapse: collapse;
}

.admin-custom-orders-table th {
  padding: 13px 17px;

  background: #faf9f5;

  border-bottom: 1px solid #e8e5dc;

  color: #78827d;

  font-size: 9px;
  font-weight: 850;

  letter-spacing: 1px;

  text-align: left;

  white-space: nowrap;
}

.admin-custom-orders-table td {
  padding: 16px 17px;

  border-bottom: 1px solid #efede7;

  vertical-align: middle;

  color: #66736d;

  font-size: 11px;
}

.admin-custom-orders-table tbody tr {
  transition:
    background 0.25s ease;
}

.admin-custom-orders-table tbody tr:hover {
  background: #fcfbf7;
}

.admin-custom-orders-table tbody tr:last-child td {
  border-bottom: none;
}


/* =========================================================
   CUSTOMER
========================================================= */

.admin-custom-customer {
  display: flex;
  align-items: center;
  gap: 10px;

  min-width: 190px;
}

.admin-custom-avatar {
  width: 38px;
  height: 38px;

  display: grid;
  place-items: center;

  flex-shrink: 0;

  border-radius: 50%;

  background:
    linear-gradient(
      135deg,
      #0b3d2e,
      #174e3c
    );

  color: #ffffff;

  font-size: 12px;
  font-weight: 800;
}

.admin-custom-customer > div:last-child {
  display: flex;
  flex-direction: column;
}

.admin-custom-customer strong {
  color: #10251d;

  font-size: 11px;
}

.admin-custom-customer span {
  margin-top: 3px;

  color: #78827d;

  font-size: 9px;
}

.admin-custom-customer small {
  margin-top: 2px;

  color: #9ba29e;

  font-size: 8px;
}


/* =========================================================
   OUTFIT / SERVICE / MATERIAL
========================================================= */

.admin-custom-outfit {
  color: #10251d;

  font-size: 11px;

  white-space: nowrap;
}

.admin-custom-service {
  display: inline-block;

  max-width: 165px;

  padding: 6px 8px;

  border-radius: 7px;

  background: rgba(11, 61, 46, 0.07);

  color: #0b3d2e;

  font-size: 8px;
  font-weight: 750;

  line-height: 1.4;
}

.admin-custom-material {
  color: #66736d;

  font-size: 10px;
}


/* =========================================================
   STATUS
========================================================= */

.admin-custom-status {
  display: inline-flex;
  align-items: center;
  gap: 6px;

  padding: 6px 9px;

  border-radius: 30px;

  font-size: 8px;
  font-weight: 800;

  white-space: nowrap;
}

.admin-custom-status i {
  width: 6px;
  height: 6px;

  border-radius: 50%;

  background: currentColor;
}


/* Pending */

.admin-custom-status.pending-review {
  color: #92720f;

  background:
    rgba(201, 162, 39, 0.12);
}


/* Under Review */

.admin-custom-status.under-review {
  color: #80670c;

  background:
    rgba(201, 162, 39, 0.12);
}


/* Quote */

.admin-custom-status.quote-sent {
  color: #315b8c;

  background:
    rgba(49, 91, 140, 0.1);
}


/* Awaiting Payment */

.admin-custom-status.awaiting-payment {
  color: #9a6411;

  background:
    rgba(201, 162, 39, 0.12);
}


/* Confirmed */

.admin-custom-status.confirmed {
  color: #08704d;

  background:
    rgba(8, 112, 77, 0.1);
}


/* Production */

.admin-custom-status.in-production {
  color: #276458;

  background:
    rgba(39, 100, 88, 0.1);
}


/* Ready */

.admin-custom-status.ready {
  color: #28723e;

  background:
    rgba(40, 114, 62, 0.1);
}


/* Completed */

.admin-custom-status.completed {
  color: #166534;

  background:
    rgba(22, 101, 52, 0.1);
}


/* Cancelled */

.admin-custom-status.cancelled {
  color: #9b3030;

  background:
    rgba(155, 48, 48, 0.09);
}


/* =========================================================
   QUOTATION / DATE
========================================================= */

.admin-custom-quotation {
  color: #0b3d2e;

  font-size: 11px;

  white-space: nowrap;
}

.admin-custom-date {
  color: #78827d;

  font-size: 9px;

  white-space: nowrap;
}


/* =========================================================
   VIEW BUTTON
========================================================= */

.admin-custom-view-button {
  display: inline-flex;
  align-items: center;
  gap: 6px;

  padding: 8px 11px;

  border-radius: 8px;

  background: #0b3d2e;

  color: #ffffff;

  font-size: 8px;
  font-weight: 850;

  letter-spacing: 0.8px;

  text-decoration: none;

  transition:
    transform 0.25s ease,
    background 0.25s ease,
    box-shadow 0.25s ease;
}

.admin-custom-view-button span {
  font-size: 13px;

  transition:
    transform 0.25s ease;
}

.admin-custom-view-button:hover {
  background: #10251d;

  transform: translateY(-2px);

  box-shadow:
    0 7px 18px rgba(11, 61, 46, 0.18);
}

.admin-custom-view-button:hover span {
  transform: translateX(3px);
}


/* =========================================================
   LOADING
========================================================= */

.admin-custom-orders-loading {
  min-height: 300px;

  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;

  border: 1px solid #dedbd2;
  border-radius: 18px;

  background: #ffffff;

  text-align: center;
}

.admin-custom-orders-spinner {
  width: 40px;
  height: 40px;

  border: 3px solid #e6e3da;
  border-top-color: #0b3d2e;

  border-radius: 50%;

  animation:
    adminCustomSpinner 0.8s linear infinite;
}

@keyframes adminCustomSpinner {
  to {
    transform: rotate(360deg);
  }
}

.admin-custom-orders-loading h2 {
  margin: 16px 0 5px;

  color: #10251d;

  font-size: 18px;
}

.admin-custom-orders-loading p {
  margin: 0;

  color: #78827d;

  font-size: 12px;
}


/* =========================================================
   EMPTY
========================================================= */

.admin-custom-orders-empty {
  min-height: 300px;

  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;

  padding: 30px;

  border: 1px solid #dedbd2;
  border-radius: 18px;

  background: #ffffff;

  text-align: center;
}

.admin-custom-orders-empty-icon {
  width: 58px;
  height: 58px;

  display: grid;
  place-items: center;

  border-radius: 17px;

  background:
    rgba(201, 162, 39, 0.1);

  color: #c9a227;

  font-size: 24px;
}

.admin-custom-orders-empty h2 {
  margin: 15px 0 5px;

  color: #10251d;

  font-size: 19px;
}

.admin-custom-orders-empty p {
  max-width: 420px;

  margin: 0;

  color: #78827d;

  font-size: 12px;
  line-height: 1.7;
}


/* =========================================================
   ERROR
========================================================= */

.admin-custom-orders-error {
  display: flex;
  align-items: center;
  justify-content: space-between;

  gap: 20px;

  margin-bottom: 24px;

  padding: 17px 20px;

  border: 1px solid rgba(155, 48, 48, 0.2);
  border-radius: 14px;

  background: rgba(155, 48, 48, 0.05);
}

.admin-custom-orders-error strong {
  display: block;

  color: #8d2f2f;

  font-size: 12px;
}

.admin-custom-orders-error span {
  display: block;

  margin-top: 3px;

  color: #7d6565;

  font-size: 10px;
}

.admin-custom-orders-error button {
  padding: 9px 14px;

  border: none;
  border-radius: 8px;

  background: #0b3d2e;

  color: #ffffff;

  font-size: 9px;
  font-weight: 800;

  cursor: pointer;
}


/* =========================================================
   RESPONSIVE
========================================================= */

@media (max-width: 1000px) {

  .admin-custom-orders-header {
    align-items: flex-start;
  }

  .admin-custom-orders-summary {
    grid-template-columns:
      repeat(3, 1fr);
  }

}


@media (max-width: 750px) {

  .admin-custom-orders-header {
    flex-direction: column;
  }

  .admin-custom-orders-header-stat {
    width: 100%;

    text-align: left;
  }

  .admin-custom-orders-summary {
    grid-template-columns: 1fr;
  }

}


@media (max-width: 500px) {

  .admin-custom-orders-header h1 {
    font-size: 30px;
  }

  .admin-custom-orders-card-header {
    padding: 18px;
  }

  .admin-custom-orders-refresh {
    font-size: 0;

    width: 38px;
    height: 38px;

    justify-content: center;

    padding: 0;
  }

  .admin-custom-orders-refresh span {
    font-size: 18px;
  }

  .admin-custom-orders-error {
    flex-direction: column;
    align-items: flex-start;
  }

}


@media (prefers-reduced-motion: reduce) {

  .admin-custom-orders-card,
  .admin-custom-summary-card,
  .admin-custom-orders-refresh,
  .admin-custom-view-button,
  .admin-custom-orders-spinner {
    animation: none;
    transition: none;
  }

}

/* =========================================================
   ABS CUT — ADMIN CUSTOM ORDER DETAILS
   Professional Admin Interface
========================================================= */

/* =========================================================
   PAGE
========================================================= */

.admin-custom-details-header {
  position: relative;

  display: flex;
  align-items: flex-end;
  justify-content: space-between;

  gap: 32px;

  margin-bottom: 30px;
  padding-bottom: 8px;

  animation: adminCustomDetailsHeaderIn 0.65s ease both;
}

.admin-custom-details-header::after {
  content: "";

  position: absolute;

  left: 0;
  bottom: 0;

  width: 100%;
  height: 1px;

  background:
    linear-gradient(
      90deg,
      rgba(201, 162, 39, 0.55),
      rgba(201, 162, 39, 0.08),
      transparent
    );
}

.admin-custom-details-header > div:first-child {
  max-width: 820px;
}

/* =========================================================
   BACK BUTTON
========================================================= */

.admin-custom-details-back {
  display: inline-flex;
  align-items: center;

  gap: 8px;

  margin-bottom: 17px;

  color: var(--primary);

  font-size: 12px;
  font-weight: 900;

  letter-spacing: 0.08em;

  text-decoration: none;

  transition:
    color 0.25s ease,
    transform 0.25s ease;
}

.admin-custom-details-back:hover {
  color: var(--secondary);

  transform: translateX(-5px);
}

/* =========================================================
   HEADER
========================================================= */

.admin-custom-details-header .admin-eyebrow {
  display: block;

  margin-bottom: 9px;

  color: var(--secondary);

  font-size: 11px;
  font-weight: 900;

  letter-spacing: 0.16em;
}

.admin-custom-details-header h1 {
  margin: 0;

  color: var(--primary-dark);

  font-size: clamp(30px, 3vw, 44px);

  line-height: 1.05;

  letter-spacing: -0.035em;
}

.admin-custom-details-header p {
  margin: 13px 0 0;

  max-width: 700px;

  color: var(--muted);

  font-size: 15px;

  line-height: 1.7;
}

/* =========================================================
   ORDER ID PANEL
========================================================= */

.admin-custom-details-id {
  min-width: 235px;

  padding: 20px 22px;

  border: 1px solid var(--border);

  border-radius: 18px;

  background:
    linear-gradient(
      145deg,
      rgba(255, 255, 255, 0.98),
      rgba(248, 245, 237, 0.95)
    );

  box-shadow:
    0 14px 40px rgba(16, 37, 29, 0.07);

  text-align: right;

  animation: adminCustomDetailsFloatIn 0.7s ease 0.1s both;
}

.admin-custom-details-id span {
  display: block;

  margin-bottom: 7px;

  color: var(--secondary);

  font-size: 10px;
  font-weight: 900;

  letter-spacing: 0.15em;
}

.admin-custom-details-id strong {
  display: block;

  overflow: hidden;

  color: var(--primary-dark);

  font-size: 12px;
  font-weight: 800;

  text-overflow: ellipsis;
  white-space: nowrap;
}

.admin-custom-details-id small {
  display: block;

  margin-top: 7px;

  color: var(--muted);

  font-size: 12px;
}

/* =========================================================
   ALERTS
========================================================= */

.admin-custom-details-alert {
  display: flex;
  align-items: center;

  min-height: 52px;

  margin-bottom: 22px;
  padding: 14px 18px;

  border-radius: 14px;

  font-size: 14px;
  font-weight: 700;

  animation: adminCustomAlertIn 0.4s ease both;
}

.admin-custom-details-alert.error {
  border: 1px solid rgba(150, 40, 40, 0.18);

  background: rgba(150, 40, 40, 0.06);

  color: #8a2c2c;
}

.admin-custom-details-alert.success {
  border: 1px solid rgba(11, 61, 46, 0.16);

  background: rgba(11, 61, 46, 0.06);

  color: var(--primary);
}

/* =========================================================
   MAIN GRID
========================================================= */

.admin-custom-details-grid {
  display: grid;

  grid-template-columns:
    repeat(2, minmax(0, 1fr));

  gap: 22px;
}

/* =========================================================
   CARDS
========================================================= */

.admin-custom-details-card {
  position: relative;

  overflow: hidden;

  padding: 25px;

  border: 1px solid var(--border);

  border-radius: 20px;

  background: var(--white);

  box-shadow:
    0 12px 35px rgba(16, 37, 29, 0.055);

  animation:
    adminCustomCardIn
    0.6s
    ease
    both;

  transition:
    transform 0.3s ease,
    box-shadow 0.3s ease,
    border-color 0.3s ease;
}

.admin-custom-details-card::before {
  content: "";

  position: absolute;

  top: 0;
  left: 0;

  width: 4px;
  height: 100%;

  background:
    linear-gradient(
      180deg,
      var(--secondary),
      rgba(201, 162, 39, 0.12)
    );

  transform: scaleY(0);

  transform-origin: top;

  transition:
    transform 0.35s ease;
}

.admin-custom-details-card:hover {
  transform: translateY(-3px);

  border-color: rgba(201, 162, 39, 0.3);

  box-shadow:
    0 20px 45px rgba(16, 37, 29, 0.09);
}

.admin-custom-details-card:hover::before {
  transform: scaleY(1);
}

/* =========================================================
   CARD HEADING
========================================================= */

.admin-custom-details-card-heading {
  display: flex;

  align-items: flex-start;
  justify-content: space-between;

  gap: 20px;

  margin-bottom: 23px;
}

.admin-custom-details-card-heading span {
  display: block;

  margin-bottom: 7px;

  color: var(--secondary);

  font-size: 10px;
  font-weight: 900;

  letter-spacing: 0.15em;
}

.admin-custom-details-card-heading h2 {
  margin: 0;

  color: var(--primary-dark);

  font-size: 20px;

  line-height: 1.2;

  letter-spacing: -0.02em;
}

.admin-custom-details-card-icon {
  display: flex;

  align-items: center;
  justify-content: center;

  flex-shrink: 0;

  width: 43px;
  height: 43px;

  border-radius: 13px;

  background:
    linear-gradient(
      145deg,
      var(--primary),
      var(--primary-dark)
    );

  color: var(--secondary);

  font-size: 18px;
  font-weight: 900;

  box-shadow:
    0 8px 20px rgba(11, 61, 46, 0.16);
}

/* =========================================================
   CUSTOMER PROFILE
========================================================= */

.admin-custom-customer-profile {
  display: flex;

  align-items: center;

  gap: 17px;

  padding: 17px;

  border: 1px solid var(--border);

  border-radius: 15px;

  background:
    linear-gradient(
      145deg,
      #fff,
      #fbf9f3
    );
}

.admin-custom-customer-large-avatar {
  display: flex;

  align-items: center;
  justify-content: center;

  flex-shrink: 0;

  width: 62px;
  height: 62px;

  border-radius: 18px;

  background:
    linear-gradient(
      145deg,
      var(--primary),
      var(--primary-dark)
    );

  color: var(--secondary);

  font-size: 22px;
  font-weight: 900;

  box-shadow:
    0 8px 22px rgba(11, 61, 46, 0.15);
}

.admin-custom-customer-profile h3 {
  margin: 0 0 6px;

  color: var(--primary-dark);

  font-size: 17px;
}

.admin-custom-customer-profile p {
  margin: 3px 0;

  color: var(--muted);

  font-size: 13px;
}

/* =========================================================
   DETAIL LIST
========================================================= */

.admin-custom-detail-list {
  display: grid;

  grid-template-columns:
    repeat(2, minmax(0, 1fr));

  gap: 13px;
}

.admin-custom-detail-list > div {
  padding: 14px;

  border: 1px solid var(--border);

  border-radius: 13px;

  background: #fcfbf7;

  transition:
    transform 0.25s ease,
    border-color 0.25s ease,
    background 0.25s ease;
}

.admin-custom-detail-list > div:hover {
  transform: translateY(-2px);

  border-color: rgba(201, 162, 39, 0.35);

  background: #fff;
}

.admin-custom-detail-list span {
  display: block;

  margin-bottom: 6px;

  color: var(--muted);

  font-size: 10px;
  font-weight: 800;

  letter-spacing: 0.08em;

  text-transform: uppercase;
}

.admin-custom-detail-list strong {
  display: block;

  color: var(--primary-dark);

  font-size: 13px;

  line-height: 1.45;
}

/* =========================================================
   DESIGN SERVICES
========================================================= */

.admin-custom-service-boxes {
  display: grid;

  grid-template-columns:
    repeat(2, minmax(0, 1fr));

  gap: 15px;
}

.admin-custom-service-boxes > div {
  padding: 17px;

  border: 1px solid var(--border);

  border-radius: 15px;

  background: #fcfbf7;
}

.admin-custom-service-boxes span {
  display: block;

  margin-bottom: 7px;

  color: var(--muted);

  font-size: 10px;
  font-weight: 900;

  letter-spacing: 0.1em;
}

.admin-custom-service-boxes strong {
  display: block;

  color: var(--primary);

  font-size: 14px;
}

.admin-custom-service-boxes p {
  margin: 9px 0 0;

  color: var(--muted);

  font-size: 13px;

  line-height: 1.55;
}

/* =========================================================
   MEASUREMENTS
========================================================= */

.admin-custom-measurements {
  min-height: 100px;

  padding: 18px;

  border: 1px dashed rgba(11, 61, 46, 0.22);

  border-radius: 15px;

  background:
    linear-gradient(
      145deg,
      rgba(11, 61, 46, 0.025),
      rgba(201, 162, 39, 0.04)
    );
}

.admin-custom-measurements p {
  margin: 0;

  color: var(--text);

  font-size: 14px;

  line-height: 1.8;

  white-space: pre-wrap;
}

.admin-custom-measurements span {
  color: var(--muted);

  font-size: 13px;
}

/* =========================================================
   MATERIAL
========================================================= */

.admin-custom-material-details {
  display: grid;

  gap: 14px;
}

.admin-custom-material-details > div {
  padding: 15px;

  border-radius: 14px;

  background: #fcfbf7;

  border: 1px solid var(--border);
}

.admin-custom-material-details span {
  display: block;

  margin-bottom: 6px;

  color: var(--muted);

  font-size: 10px;
  font-weight: 900;

  letter-spacing: 0.1em;

  text-transform: uppercase;
}

.admin-custom-material-details strong {
  color: var(--primary-dark);

  font-size: 14px;
}

.admin-custom-material-details p {
  margin: 0;

  color: var(--text);

  font-size: 13px;

  line-height: 1.65;
}

/* =========================================================
   REFERENCE IMAGE
========================================================= */

.admin-custom-reference-image-link {
  position: relative;

  display: block;

  overflow: hidden;

  min-height: 220px;

  border-radius: 16px;

  background: #f3f1ea;

  text-decoration: none;
}

.admin-custom-reference-image-link img {
  display: block;

  width: 100%;
  height: 300px;

  object-fit: cover;

  transition:
    transform 0.5s ease,
    filter 0.5s ease;
}

.admin-custom-reference-image-link::after {
  content: "";

  position: absolute;

  inset: 0;

  background:
    linear-gradient(
      180deg,
      transparent 45%,
      rgba(16, 37, 29, 0.72)
    );

  opacity: 0.7;

  transition:
    opacity 0.35s ease;
}

.admin-custom-reference-image-link:hover img {
  transform: scale(1.045);

  filter: brightness(0.9);
}

.admin-custom-reference-image-link:hover::after {
  opacity: 1;
}

.admin-custom-reference-image-link span {
  position: absolute;

  z-index: 2;

  right: 18px;
  bottom: 17px;

  color: #fff;

  font-size: 11px;
  font-weight: 900;

  letter-spacing: 0.1em;
}

/* =========================================================
   LOCATION
========================================================= */

.admin-custom-location {
  padding: 18px;

  border: 1px solid var(--border);

  border-radius: 15px;

  background:
    linear-gradient(
      145deg,
      #fff,
      #fbf9f3
    );
}

.admin-custom-location strong {
  display: inline-flex;

  align-items: center;

  margin-bottom: 12px;

  color: var(--primary);

  font-size: 14px;
}

.admin-custom-location strong::before {
  content: "";

  width: 8px;
  height: 8px;

  margin-right: 8px;

  border-radius: 50%;

  background: var(--secondary);

  box-shadow:
    0 0 0 5px rgba(201, 162, 39, 0.12);
}

.admin-custom-location p {
  margin: 5px 0;

  color: var(--text);

  font-size: 13px;

  line-height: 1.6;
}

.admin-custom-location span {
  display: block;

  margin-top: 13px;
  padding-top: 13px;

  border-top: 1px solid var(--border);

  color: var(--muted);

  font-size: 12px;
  font-weight: 700;
}

.admin-custom-not-required {
  padding: 18px;

  border: 1px dashed var(--border);

  border-radius: 15px;

  color: var(--muted);

  background: #fcfbf7;

  font-size: 13px;
}

/* =========================================================
   NOTES
========================================================= */

.admin-custom-note-box {
  padding: 18px;

  border-left: 3px solid var(--secondary);

  border-radius: 0 13px 13px 0;

  background:
    rgba(201, 162, 39, 0.06);
}

.admin-custom-note-box span {
  display: block;

  margin-bottom: 8px;

  color: var(--secondary);

  font-size: 10px;
  font-weight: 900;

  letter-spacing: 0.1em;
}

.admin-custom-note-box p {
  margin: 0;

  color: var(--text);

  font-size: 13px;

  line-height: 1.7;
}

/* =========================================================
   MANAGEMENT
========================================================= */

.admin-custom-management-card,
.admin-custom-quotation-card {
  grid-column: 1 / -1;
}

.admin-custom-form-grid {
  display: grid;

  grid-template-columns:
    repeat(2, minmax(0, 1fr));

  gap: 18px;
}

.admin-custom-form-grid label,
.admin-custom-fee-grid label,
.admin-custom-textareas label {
  display: flex;

  flex-direction: column;

  gap: 8px;
}

.admin-custom-form-grid label > span,
.admin-custom-fee-grid label > span,
.admin-custom-textareas label > span {
  color: var(--primary-dark);

  font-size: 10px;
  font-weight: 900;

  letter-spacing: 0.1em;
}

/* =========================================================
   INPUTS / SELECTS / TEXTAREAS
========================================================= */

.admin-custom-form-grid select,
.admin-custom-fee-grid input,
.admin-custom-textareas textarea {
  width: 100%;

  border: 1px solid var(--border);

  border-radius: 12px;

  background: #fff;

  color: var(--text);

  font-family: inherit;

  font-size: 14px;

  outline: none;

  transition:
    border-color 0.25s ease,
    box-shadow 0.25s ease,
    transform 0.25s ease,
    background 0.25s ease;
}

.admin-custom-form-grid select,
.admin-custom-fee-grid input {
  height: 52px;

  padding: 0 15px;
}

.admin-custom-textareas textarea {
  min-height: 125px;

  padding: 14px 15px;

  resize: vertical;

  line-height: 1.6;
}

.admin-custom-form-grid select:hover,
.admin-custom-fee-grid input:hover,
.admin-custom-textareas textarea:hover {
  border-color: rgba(11, 61, 46, 0.3);
}

.admin-custom-form-grid select:focus,
.admin-custom-fee-grid input:focus,
.admin-custom-textareas textarea:focus {
  border-color: var(--primary);

  background: #fff;

  box-shadow:
    0 0 0 4px rgba(11, 61, 46, 0.08);

  transform: translateY(-1px);
}

/* =========================================================
   QUOTATION
========================================================= */

.admin-custom-fee-grid {
  display: grid;

  grid-template-columns:
    repeat(3, minmax(0, 1fr));

  gap: 18px;

  margin-bottom: 25px;
}

.admin-custom-total-box {
  display: grid;

  grid-template-columns:
    1.3fr 1fr 1fr;

  align-items: center;

  gap: 18px;

  padding: 22px;

  border-radius: 17px;

  background:
    linear-gradient(
      135deg,
      var(--primary-dark),
      var(--primary)
    );

  box-shadow:
    0 15px 35px rgba(11, 61, 46, 0.18);
}

.admin-custom-total-box > div {
  padding-right: 18px;

  border-right: 1px solid
    rgba(255, 255, 255, 0.12);
}

.admin-custom-total-box > div:last-child {
  padding-right: 0;

  border-right: 0;
}

.admin-custom-total-box span {
  display: block;

  margin-bottom: 7px;

  color: rgba(255, 255, 255, 0.68);

  font-size: 10px;
  font-weight: 900;

  letter-spacing: 0.1em;
}

.admin-custom-total-box strong {
  display: block;

  color: var(--secondary);

  font-size: 23px;

  letter-spacing: -0.02em;
}

.admin-custom-total-box input {
  width: 100%;

  height: 45px;

  padding: 0 12px;

  border: 1px solid
    rgba(255, 255, 255, 0.2);

  border-radius: 10px;

  background:
    rgba(255, 255, 255, 0.08);

  color: #fff;

  font-family: inherit;

  font-size: 15px;

  outline: none;

  transition:
    background 0.25s ease,
    border-color 0.25s ease;
}

.admin-custom-total-box input:focus {
  border-color: var(--secondary);

  background:
    rgba(255, 255, 255, 0.13);
}

/* Remove number input arrows */

.admin-custom-fee-grid input[type="number"]::-webkit-inner-spin-button,
.admin-custom-fee-grid input[type="number"]::-webkit-outer-spin-button,
.admin-custom-total-box input[type="number"]::-webkit-inner-spin-button,
.admin-custom-total-box input[type="number"]::-webkit-outer-spin-button {
  margin: 0;

  -webkit-appearance: none;
}

.admin-custom-fee-grid input[type="number"],
.admin-custom-total-box input[type="number"] {
  -moz-appearance: textfield;
}

/* =========================================================
   TEXT AREAS
========================================================= */

.admin-custom-textareas {
  display: grid;

  grid-template-columns:
    repeat(2, minmax(0, 1fr));

  gap: 18px;
}

/* =========================================================
   SAVE BAR
========================================================= */

.admin-custom-details-save-bar {
  position: sticky;

  z-index: 20;

  bottom: 16px;

  display: flex;

  align-items: center;
  justify-content: flex-end;

  gap: 13px;

  margin-top: 25px;
  padding: 15px;

  border: 1px solid rgba(222, 219, 210, 0.85);

  border-radius: 17px;

  background:
    rgba(255, 255, 255, 0.9);

  box-shadow:
    0 16px 40px rgba(16, 37, 29, 0.12);

  backdrop-filter: blur(14px);

  -webkit-backdrop-filter: blur(14px);
}

.admin-custom-details-cancel,
.admin-custom-details-save {
  display: inline-flex;

  align-items: center;
  justify-content: center;

  min-height: 50px;

  padding: 0 20px;

  border-radius: 11px;

  font-family: inherit;

  font-size: 11px;
  font-weight: 900;

  letter-spacing: 0.08em;

  text-decoration: none;

  cursor: pointer;

  transition:
    transform 0.25s ease,
    box-shadow 0.25s ease,
    background 0.25s ease;
}

.admin-custom-details-cancel {
  border: 1px solid var(--border);

  background: #fff;

  color: var(--muted);
}

.admin-custom-details-cancel:hover {
  color: var(--primary);

  border-color: rgba(11, 61, 46, 0.3);

  transform: translateY(-2px);
}

.admin-custom-details-save {
  gap: 14px;

  min-width: 185px;

  border: 0;

  background:
    linear-gradient(
      135deg,
      var(--primary),
      var(--primary-dark)
    );

  color: #fff;

  box-shadow:
    0 10px 25px rgba(11, 61, 46, 0.2);
}

.admin-custom-details-save span {
  display: flex;

  align-items: center;
  justify-content: center;

  width: 25px;
  height: 25px;

  border-radius: 50%;

  background: var(--secondary);

  color: var(--primary-dark);

  transition:
    transform 0.25s ease;
}

.admin-custom-details-save:hover:not(:disabled) {
  transform: translateY(-3px);

  box-shadow:
    0 15px 32px rgba(11, 61, 46, 0.28);
}

.admin-custom-details-save:hover:not(:disabled) span {
  transform: translateX(3px);
}

.admin-custom-details-save:disabled {
  opacity: 0.65;

  cursor: not-allowed;
}

/* =========================================================
   LOADING
========================================================= */

.admin-custom-details-loading {
  min-height: 60vh;

  display: flex;

  flex-direction: column;

  align-items: center;
  justify-content: center;

  text-align: center;

  animation: adminCustomFadeIn 0.5s ease both;
}

.admin-custom-details-spinner {
  width: 50px;
  height: 50px;

  margin-bottom: 20px;

  border: 3px solid
    rgba(11, 61, 46, 0.12);

  border-top-color: var(--secondary);

  border-right-color: var(--primary);

  border-radius: 50%;

  animation:
    adminCustomSpinner 0.9s linear infinite;
}

.admin-custom-details-loading h2 {
  margin: 0;

  color: var(--primary-dark);

  font-size: 21px;
}

.admin-custom-details-loading p {
  margin: 8px 0 0;

  color: var(--muted);

  font-size: 14px;
}

/* =========================================================
   ERROR
========================================================= */

.admin-custom-details-error {
  min-height: 60vh;

  display: flex;

  flex-direction: column;

  align-items: center;
  justify-content: center;

  text-align: center;

  animation: adminCustomFadeIn 0.5s ease both;
}

.admin-custom-details-error > span {
  display: flex;

  align-items: center;
  justify-content: center;

  width: 60px;
  height: 60px;

  margin-bottom: 17px;

  border-radius: 50%;

  background:
    rgba(150, 40, 40, 0.08);

  color: #8a2c2c;

  font-size: 25px;
  font-weight: 900;
}

.admin-custom-details-error h2 {
  margin: 0;

  color: var(--primary-dark);

  font-size: 23px;
}

.admin-custom-details-error p {
  max-width: 500px;

  margin: 9px 0 20px;

  color: var(--muted);

  line-height: 1.6;
}

.admin-custom-details-error button {
  min-height: 47px;

  padding: 0 20px;

  border: 0;

  border-radius: 10px;

  background: var(--primary);

  color: #fff;

  font-family: inherit;

  font-size: 11px;
  font-weight: 900;

  letter-spacing: 0.08em;

  cursor: pointer;

  transition:
    transform 0.25s ease,
    box-shadow 0.25s ease;
}

.admin-custom-details-error button:hover {
  transform: translateY(-2px);

  box-shadow:
    0 10px 24px rgba(11, 61, 46, 0.2);
}

/* =========================================================
   ANIMATIONS
========================================================= */

@keyframes adminCustomDetailsHeaderIn {
  from {
    opacity: 0;

    transform:
      translateY(20px);
  }

  to {
    opacity: 1;

    transform:
      translateY(0);
  }
}

@keyframes adminCustomDetailsFloatIn {
  from {
    opacity: 0;

    transform:
      translateY(15px)
      scale(0.97);
  }

  to {
    opacity: 1;

    transform:
      translateY(0)
      scale(1);
  }
}

@keyframes adminCustomCardIn {
  from {
    opacity: 0;

    transform:
      translateY(22px);
  }

  to {
    opacity: 1;

    transform:
      translateY(0);
  }
}

@keyframes adminCustomAlertIn {
  from {
    opacity: 0;

    transform:
      translateY(-8px);
  }

  to {
    opacity: 1;

    transform:
      translateY(0);
  }
}

@keyframes adminCustomFadeIn {
  from {
    opacity: 0;
  }

  to {
    opacity: 1;
  }
}

@keyframes adminCustomSpinner {
  to {
    transform: rotate(360deg);
  }
}

/* =========================================================
   TABLET
========================================================= */

@media (max-width: 1100px) {
  .admin-custom-details-header {
    align-items: flex-start;

    flex-direction: column;
  }

  .admin-custom-details-id {
    width: 100%;

    text-align: left;
  }

  .admin-custom-details-grid {
    grid-template-columns: 1fr;
  }

  .admin-custom-management-card,
  .admin-custom-quotation-card {
    grid-column: auto;
  }

  .admin-custom-fee-grid {
    grid-template-columns:
      repeat(2, minmax(0, 1fr));
  }

  .admin-custom-textareas {
    grid-template-columns: 1fr;
  }
}

/* =========================================================
   TABLET / SMALL LAPTOP
========================================================= */

@media (max-width: 800px) {
  .admin-custom-details-card {
    padding: 21px;
  }

  .admin-custom-detail-list {
    grid-template-columns: 1fr;
  }

  .admin-custom-form-grid {
    grid-template-columns: 1fr;
  }

  .admin-custom-total-box {
    grid-template-columns: 1fr;
  }

  .admin-custom-total-box > div {
    padding-right: 0;
    padding-bottom: 15px;

    border-right: 0;

    border-bottom: 1px solid
      rgba(255, 255, 255, 0.12);
  }

  .admin-custom-total-box > div:last-child {
    padding-bottom: 0;

    border-bottom: 0;
  }
}

/* =========================================================
   MOBILE
========================================================= */

@media (max-width: 600px) {
  .admin-custom-details-header {
    margin-bottom: 23px;
  }

  .admin-custom-details-header h1 {
    font-size: 30px;
  }

  .admin-custom-details-header p {
    font-size: 13px;
  }

  .admin-custom-details-id {
    min-width: 0;

    padding: 17px;
  }

  .admin-custom-details-card {
    padding: 18px;

    border-radius: 16px;
  }

  .admin-custom-details-card-heading h2 {
    font-size: 18px;
  }

  .admin-custom-customer-profile {
    align-items: flex-start;

    padding: 14px;
  }

  .admin-custom-customer-large-avatar {
    width: 52px;
    height: 52px;

    border-radius: 15px;

    font-size: 19px;
  }

  .admin-custom-customer-profile h3 {
    font-size: 15px;
  }

  .admin-custom-service-boxes {
    grid-template-columns: 1fr;
  }

  .admin-custom-fee-grid {
    grid-template-columns: 1fr;

    gap: 14px;
  }

  .admin-custom-reference-image-link img {
    height: 230px;
  }

  .admin-custom-details-save-bar {
    bottom: 8px;

    justify-content: stretch;

    padding: 10px;

    border-radius: 14px;
  }

  .admin-custom-details-cancel,
  .admin-custom-details-save {
    flex: 1;

    min-height: 47px;

    padding: 0 12px;

    font-size: 10px;
  }

  .admin-custom-details-save {
    min-width: 0;
  }
}

/* =========================================================
   VERY SMALL MOBILE
========================================================= */

@media (max-width: 430px) {
  .admin-custom-details-header h1 {
    font-size: 27px;
  }

  .admin-custom-details-back {
    font-size: 10px;
  }

  .admin-custom-details-card {
    padding: 15px;
  }

  .admin-custom-details-card-heading {
    gap: 10px;
  }

  .admin-custom-details-card-icon {
    width: 37px;
    height: 37px;

    border-radius: 11px;

    font-size: 15px;
  }

  .admin-custom-details-save-bar {
    flex-direction: column;
  }

  .admin-custom-details-cancel,
  .admin-custom-details-save {
    width: 100%;
  }
}

/* =========================================================
   REDUCED MOTION
========================================================= */

@media (prefers-reduced-motion: reduce) {
  .admin-custom-details-header,
  .admin-custom-details-id,
  .admin-custom-details-card,
  .admin-custom-details-alert,
  .admin-custom-details-loading,
  .admin-custom-details-error {
    animation: none;
  }

  .admin-custom-details-card,
  .admin-custom-details-back,
  .admin-custom-reference-image-link img,
  .admin-custom-details-save,
  .admin-custom-details-save span,
  .admin-custom-details-cancel,
  .admin-custom-form-grid select,
  .admin-custom-fee-grid input,
  .admin-custom-textareas textarea {
    transition: none;
  }

  .admin-custom-details-spinner {
    animation: none;
  }
}

/* =========================================================
   ABS CUT — MY CUSTOM ORDERS
   Premium Customer Custom Order Dashboard
========================================================= */

.my-custom-orders-page {
  min-height: 100vh;
  padding: 80px 6% 100px;
  background:
    radial-gradient(
      circle at 8% 5%,
      rgba(201, 162, 39, 0.10),
      transparent 28%
    ),
    radial-gradient(
      circle at 92% 20%,
      rgba(11, 61, 46, 0.08),
      transparent 30%
    ),
    var(--background);
  position: relative;
  overflow: hidden;
}

/* ---------------------------------------------------------
   HEADER
--------------------------------------------------------- */

.my-custom-orders-header {
  max-width: 1250px;
  margin: 0 auto 42px;
  text-align: center;
  animation: customOrdersHeaderReveal 0.8s ease both;
}

.custom-orders-label {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  margin: 0 0 14px;
  color: var(--secondary);
  font-size: 0.76rem;
  font-weight: 800;
  letter-spacing: 0.18em;
  text-transform: uppercase;
}

.custom-orders-label::before,
.custom-orders-label::after {
  content: "";
  width: 28px;
  height: 1px;
  background: var(--secondary);
  opacity: 0.7;
}

.my-custom-orders-header h1 {
  margin: 0;
  color: var(--primary-dark);
  font-size: clamp(2.2rem, 5vw, 4rem);
  line-height: 1.05;
  font-weight: 900;
  letter-spacing: -0.04em;
}

.my-custom-orders-header > span {
  display: block;
  margin-top: 16px;
  color: var(--muted);
  font-size: 1rem;
  line-height: 1.7;
}

/* ---------------------------------------------------------
   SUMMARY CARDS
--------------------------------------------------------- */

.custom-orders-summary {
  width: min(1250px, 100%);
  margin: 0 auto 34px;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 18px;
}

.custom-orders-summary-card {
  position: relative;
  overflow: hidden;
  padding: 25px 26px;
  border: 1px solid rgba(11, 61, 46, 0.10);
  border-radius: 20px;
  background: rgba(255, 255, 255, 0.88);
  box-shadow:
    0 12px 35px rgba(16, 37, 29, 0.06),
    0 2px 8px rgba(16, 37, 29, 0.04);
  display: flex;
  flex-direction: column;
  gap: 8px;
  transition:
    transform 0.3s ease,
    box-shadow 0.3s ease,
    border-color 0.3s ease;
  animation: customOrdersCardReveal 0.7s ease both;
}

.custom-orders-summary-card:nth-child(2) {
  animation-delay: 0.08s;
}

.custom-orders-summary-card:nth-child(3) {
  animation-delay: 0.16s;
}

.custom-orders-summary-card::before {
  content: "";
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 3px;
  background: linear-gradient(
    90deg,
    var(--primary),
    var(--secondary)
  );
  transform: scaleX(0);
  transform-origin: left;
  transition: transform 0.35s ease;
}

.custom-orders-summary-card:hover {
  transform: translateY(-5px);
  border-color: rgba(201, 162, 39, 0.30);
  box-shadow:
    0 20px 45px rgba(16, 37, 29, 0.10),
    0 4px 12px rgba(16, 37, 29, 0.05);
}

.custom-orders-summary-card:hover::before {
  transform: scaleX(1);
}

.custom-orders-summary-card span {
  color: var(--muted);
  font-size: 0.75rem;
  font-weight: 800;
  letter-spacing: 0.10em;
  text-transform: uppercase;
}

.custom-orders-summary-card strong {
  color: var(--primary-dark);
  font-size: 2rem;
  line-height: 1;
  font-weight: 900;
}

/* ---------------------------------------------------------
   ORDERS CONTAINER
--------------------------------------------------------- */

.custom-orders-container {
  width: min(1250px, 100%);
  margin: 0 auto;
  display: grid;
  gap: 24px;
}

/* ---------------------------------------------------------
   ORDER CARD
--------------------------------------------------------- */

.custom-order-card {
  position: relative;
  overflow: hidden;
  border: 1px solid rgba(11, 61, 46, 0.10);
  border-radius: 24px;
  background: rgba(255, 255, 255, 0.94);
  box-shadow:
    0 15px 45px rgba(16, 37, 29, 0.07),
    0 2px 8px rgba(16, 37, 29, 0.04);
  animation: customOrderReveal 0.75s ease both;
  transition:
    transform 0.35s ease,
    box-shadow 0.35s ease,
    border-color 0.35s ease;
}

.custom-order-card:nth-child(2) {
  animation-delay: 0.08s;
}

.custom-order-card:nth-child(3) {
  animation-delay: 0.16s;
}

.custom-order-card:nth-child(4) {
  animation-delay: 0.24s;
}

.custom-order-card::before {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  width: 5px;
  height: 100%;
  background: linear-gradient(
    180deg,
    var(--secondary),
    var(--primary)
  );
}

.custom-order-card:hover {
  transform: translateY(-6px);
  border-color: rgba(201, 162, 39, 0.28);
  box-shadow:
    0 25px 60px rgba(16, 37, 29, 0.11),
    0 5px 15px rgba(16, 37, 29, 0.05);
}

/* ---------------------------------------------------------
   CARD TOP
--------------------------------------------------------- */

.custom-order-card-top {
  padding: 28px 30px 24px 34px;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 25px;
  border-bottom: 1px solid var(--border);
}

.custom-order-card-top > div:first-child span,
.custom-order-status > span {
  display: block;
  margin-bottom: 8px;
  color: var(--muted);
  font-size: 0.68rem;
  font-weight: 800;
  letter-spacing: 0.12em;
  text-transform: uppercase;
}

.custom-order-card-top h2 {
  margin: 0;
  color: var(--primary-dark);
  font-size: 0.92rem;
  font-weight: 700;
  word-break: break-all;
}

/* ---------------------------------------------------------
   STATUS
--------------------------------------------------------- */

.custom-order-status {
  text-align: right;
}

.custom-order-status strong {
  display: inline-flex;
  align-items: center;
  min-height: 34px;
  padding: 7px 13px;
  border-radius: 999px;
  background: rgba(201, 162, 39, 0.12);
  color: #806512;
  font-size: 0.72rem;
  font-weight: 800;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  white-space: nowrap;
}

/* Status variations */

.custom-order-status .status-pending-review,
.custom-order-status .status-under-review {
  background: rgba(201, 162, 39, 0.12);
  color: #806512;
}

.custom-order-status .status-quote-sent,
.custom-order-status .status-awaiting-payment {
  background: rgba(39, 91, 201, 0.10);
  color: #275b9a;
}

.custom-order-status .status-confirmed,
.custom-order-status .status-in-production {
  background: rgba(11, 61, 46, 0.10);
  color: var(--primary);
}

.custom-order-status .status-ready,
.custom-order-status .status-completed {
  background: rgba(28, 126, 79, 0.12);
  color: #1c7e4f;
}

.custom-order-status .status-cancelled {
  background: rgba(170, 55, 55, 0.10);
  color: #a13737;
}

/* ---------------------------------------------------------
   ORDER INFORMATION
--------------------------------------------------------- */

.custom-order-card-info {
  padding: 28px 30px 30px 34px;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 22px 30px;
}

.custom-order-card-info > div {
  min-width: 0;
}

.custom-order-card-info span {
  display: block;
  margin-bottom: 7px;
  color: var(--muted);
  font-size: 0.72rem;
  font-weight: 700;
  letter-spacing: 0.04em;
  text-transform: uppercase;
}

.custom-order-card-info strong {
  display: block;
  overflow: hidden;
  color: var(--text);
  font-size: 0.95rem;
  font-weight: 750;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ---------------------------------------------------------
   PAYMENT SUMMARY
--------------------------------------------------------- */

.custom-order-payment-summary {
  margin: 0 30px 28px 34px;
  padding: 20px;
  border: 1px solid rgba(201, 162, 39, 0.20);
  border-radius: 16px;
  background:
    linear-gradient(
      135deg,
      rgba(201, 162, 39, 0.07),
      rgba(11, 61, 46, 0.035)
    );
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 15px;
}

.custom-order-payment-summary > div {
  padding-right: 15px;
  border-right: 1px solid rgba(11, 61, 46, 0.10);
}

.custom-order-payment-summary > div:last-child {
  border-right: none;
}

.custom-order-payment-summary span {
  display: block;
  margin-bottom: 7px;
  color: var(--muted);
  font-size: 0.67rem;
  font-weight: 800;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.custom-order-payment-summary strong {
  color: var(--primary-dark);
  font-size: 0.95rem;
  font-weight: 850;
}

/* ---------------------------------------------------------
   ACTIONS
--------------------------------------------------------- */

.custom-order-card-actions {
  padding: 0 30px 30px 34px;
  display: flex;
  align-items: center;
  gap: 12px;
}

.view-custom-order-button,
.new-custom-order-button {
  min-height: 50px;
  padding: 0 22px;
  border-radius: 12px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 0.76rem;
  font-weight: 850;
  letter-spacing: 0.07em;
  text-decoration: none;
  transition:
    transform 0.25s ease,
    box-shadow 0.25s ease,
    background 0.25s ease,
    color 0.25s ease;
}

.view-custom-order-button {
  position: relative;
  overflow: hidden;
  background: var(--primary);
  color: var(--white);
  box-shadow:
    0 8px 20px rgba(11, 61, 46, 0.16);
}

.view-custom-order-button::after {
  content: "→";
  margin-left: 12px;
  font-size: 1rem;
  transition: transform 0.25s ease;
}

.view-custom-order-button:hover {
  transform: translateY(-2px);
  background: var(--primary-dark);
  box-shadow:
    0 12px 26px rgba(11, 61, 46, 0.22);
}

.view-custom-order-button:hover::after {
  transform: translateX(4px);
}

.new-custom-order-button {
  border: 1px solid var(--border);
  background: var(--white);
  color: var(--primary);
}

.new-custom-order-button:hover {
  transform: translateY(-2px);
  border-color: var(--secondary);
  color: var(--primary-dark);
  box-shadow:
    0 8px 20px rgba(16, 37, 29, 0.08);
}

/* ---------------------------------------------------------
   EMPTY STATE
--------------------------------------------------------- */

.empty-custom-orders {
  width: min(700px, 100%);
  min-height: 480px;
  margin: 40px auto 0;
  padding: 70px 40px;
  border: 1px solid rgba(11, 61, 46, 0.10);
  border-radius: 28px;
  background: rgba(255, 255, 255, 0.92);
  box-shadow:
    0 20px 55px rgba(16, 37, 29, 0.07);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  animation: customOrdersEmptyReveal 0.8s ease both;
}

.empty-custom-orders h1 {
  margin: 8px 0 14px;
  color: var(--primary-dark);
  font-size: clamp(1.8rem, 4vw, 2.6rem);
  font-weight: 900;
}

.empty-custom-orders > p:not(.custom-orders-label) {
  max-width: 520px;
  margin: 0 0 28px;
  color: var(--muted);
  font-size: 0.98rem;
  line-height: 1.8;
}

.custom-orders-create-button {
  min-height: 54px;
  padding: 0 25px;
  border-radius: 12px;
  background: var(--primary);
  color: var(--white);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  text-decoration: none;
  font-size: 0.76rem;
  font-weight: 850;
  letter-spacing: 0.08em;
  transition:
    transform 0.25s ease,
    background 0.25s ease,
    box-shadow 0.25s ease;
}

.custom-orders-create-button:hover {
  transform: translateY(-3px);
  background: var(--primary-dark);
  box-shadow:
    0 12px 25px rgba(11, 61, 46, 0.18);
}

/* ---------------------------------------------------------
   LOADING
--------------------------------------------------------- */

.custom-orders-loading {
  width: 58px;
  height: 58px;
  margin: 20px auto 22px;
  border-radius: 50%;
  border: 3px solid rgba(201, 162, 39, 0.20);
  border-top-color: var(--secondary);
  animation: customOrdersSpin 0.8s linear infinite;
}

.custom-orders-spinner {
  display: block;
}

/* ---------------------------------------------------------
   ERROR
--------------------------------------------------------- */

.custom-orders-error {
  border-color: rgba(161, 55, 55, 0.15);
}

.custom-orders-error h1 {
  color: #8e3333;
}

/* ---------------------------------------------------------
   ANIMATIONS
--------------------------------------------------------- */

@keyframes customOrdersHeaderReveal {
  from {
    opacity: 0;
    transform: translateY(25px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes customOrdersCardReveal {
  from {
    opacity: 0;
    transform: translateY(22px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes customOrderReveal {
  from {
    opacity: 0;
    transform: translateY(28px) scale(0.985);
  }

  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

@keyframes customOrdersEmptyReveal {
  from {
    opacity: 0;
    transform: translateY(25px) scale(0.98);
  }

  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

@keyframes customOrdersSpin {
  to {
    transform: rotate(360deg);
  }
}

/* ---------------------------------------------------------
   TABLET
--------------------------------------------------------- */

@media (max-width: 900px) {
  .my-custom-orders-page {
    padding: 65px 5% 80px;
  }

  .custom-orders-summary {
    grid-template-columns: repeat(3, 1fr);
  }

  .custom-order-card-info {
    grid-template-columns: repeat(2, 1fr);
  }

  .custom-order-payment-summary {
    grid-template-columns: repeat(2, 1fr);
  }

  .custom-order-payment-summary > div:nth-child(2) {
    border-right: none;
  }

  .custom-order-payment-summary > div:nth-child(-n + 2) {
    padding-bottom: 12px;
  }
}

/* ---------------------------------------------------------
   MOBILE
--------------------------------------------------------- */

@media (max-width: 650px) {
  .my-custom-orders-page {
    padding: 50px 4.5% 65px;
  }

  .my-custom-orders-header {
    margin-bottom: 30px;
  }

  .my-custom-orders-header h1 {
    font-size: 2.25rem;
  }

  .custom-orders-summary {
    grid-template-columns: 1fr;
    gap: 12px;
    margin-bottom: 25px;
  }

  .custom-orders-summary-card {
    padding: 20px;
    border-radius: 16px;
  }

  .custom-orders-summary-card strong {
    font-size: 1.7rem;
  }

  .custom-order-card {
    border-radius: 19px;
  }

  .custom-order-card-top {
    padding: 22px 20px 20px 25px;
    flex-direction: column;
    gap: 18px;
  }

  .custom-order-status {
    width: 100%;
    text-align: left;
  }

  .custom-order-card-info {
    padding: 22px 20px 24px 25px;
    grid-template-columns: 1fr 1fr;
    gap: 20px 14px;
  }

  .custom-order-card-info strong {
    font-size: 0.88rem;
  }

  .custom-order-payment-summary {
    margin: 0 20px 24px 25px;
    padding: 17px;
    grid-template-columns: 1fr 1fr;
    gap: 18px 12px;
  }

  .custom-order-payment-summary > div {
    padding-right: 0;
    border-right: none;
  }

  .custom-order-payment-summary strong {
    font-size: 0.87rem;
  }

  .custom-order-card-actions {
    padding: 0 20px 23px 25px;
    flex-direction: column;
    align-items: stretch;
  }

  .view-custom-order-button,
  .new-custom-order-button {
    width: 100%;
  }

  .empty-custom-orders {
    min-height: 430px;
    padding: 50px 25px;
    border-radius: 22px;
  }
}

/* ---------------------------------------------------------
   SMALL MOBILE
--------------------------------------------------------- */

@media (max-width: 430px) {
  .my-custom-orders-page {
    padding-left: 4%;
    padding-right: 4%;
  }

  .my-custom-orders-header h1 {
    font-size: 1.95rem;
  }

  .custom-orders-label {
    font-size: 0.67rem;
  }

  .custom-orders-label::before,
  .custom-orders-label::after {
    width: 18px;
  }

  .custom-order-card-info {
    grid-template-columns: 1fr;
  }

  .custom-order-payment-summary {
    grid-template-columns: 1fr;
  }

  .custom-order-payment-summary > div {
    padding-bottom: 12px;
    border-bottom: 1px solid rgba(11, 61, 46, 0.08);
  }

  .custom-order-payment-summary > div:last-child {
    padding-bottom: 0;
    border-bottom: none;
  }

  .empty-custom-orders {
    padding: 40px 20px;
  }
}

/* ---------------------------------------------------------
   ACCESSIBILITY
--------------------------------------------------------- */

.view-custom-order-button:focus-visible,
.new-custom-order-button:focus-visible,
.custom-orders-create-button:focus-visible {
  outline: 3px solid rgba(201, 162, 39, 0.45);
  outline-offset: 3px;
}

/* ---------------------------------------------------------
   REDUCED MOTION
--------------------------------------------------------- */

@media (prefers-reduced-motion: reduce) {
  .my-custom-orders-header,
  .custom-orders-summary-card,
  .custom-order-card,
  .empty-custom-orders {
    animation: none;
  }

  .custom-orders-loading {
    animation-duration: 1.5s;
  }

  .custom-orders-summary-card,
  .custom-order-card,
  .view-custom-order-button,
  .new-custom-order-button,
  .custom-orders-create-button {
    transition: none;
  }
}

/* =========================================================
   ABS CUT — CUSTOMER CUSTOM ORDER DETAILS
   Premium Custom Order Tracking Page
========================================================= */

.custom-order-details-page {
  min-height: 100vh;
  padding: 75px 6% 100px;
  background:
    radial-gradient(
      circle at 0% 0%,
      rgba(201, 162, 39, 0.12),
      transparent 30%
    ),
    radial-gradient(
      circle at 100% 15%,
      rgba(11, 61, 46, 0.09),
      transparent 32%
    ),
    var(--background);
  color: var(--text);
}

/* =========================================================
   HEADER
========================================================= */

.custom-order-details-header {
  max-width: 1200px;
  margin: 0 auto 28px;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 30px;
}

.custom-order-details-header > div {
  max-width: 750px;
}

.custom-order-details-label {
  margin: 0 0 12px;
  color: var(--secondary);
  font-size: 0.72rem;
  font-weight: 900;
  letter-spacing: 0.18em;
  text-transform: uppercase;
}

.custom-order-details-header h1 {
  margin: 0;
  color: var(--primary-dark);
  font-size: clamp(2rem, 4vw, 3.2rem);
  line-height: 1.05;
  font-weight: 900;
  letter-spacing: -0.04em;
}

.custom-order-details-header > div > p:last-child {
  margin: 14px 0 0;
  color: var(--muted);
  font-size: 0.98rem;
  line-height: 1.7;
}

.custom-order-details-back {
  flex-shrink: 0;
  min-height: 48px;
  padding: 0 18px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border: 1px solid var(--border);
  border-radius: 10px;
  background: var(--white);
  color: var(--primary);
  text-decoration: none;
  font-size: 0.72rem;
  font-weight: 900;
  letter-spacing: 0.07em;
  transition: 0.25s ease;
}

.custom-order-details-back:hover {
  border-color: var(--secondary);
  color: var(--primary-dark);
  transform: translateY(-2px);
  box-shadow: 0 8px 20px rgba(16, 37, 29, 0.08);
}

/* =========================================================
   ORDER HERO
========================================================= */

.custom-order-details-hero {
  max-width: 1200px;
  margin: 0 auto 28px;
  padding: 28px 32px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 30px;
  background: var(--primary-dark);
  border-radius: 18px;
  position: relative;
  overflow: hidden;
  box-shadow: 0 18px 45px rgba(16, 37, 29, 0.16);
}

.custom-order-details-hero::before {
  content: "";
  position: absolute;
  width: 240px;
  height: 240px;
  right: -80px;
  top: -120px;
  border: 1px solid rgba(201, 162, 39, 0.2);
  border-radius: 50%;
}

.custom-order-details-hero::after {
  content: "";
  position: absolute;
  width: 130px;
  height: 130px;
  right: 70px;
  bottom: -85px;
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 50%;
}

.custom-order-details-hero > div:first-child {
  position: relative;
  z-index: 1;
}

.custom-order-details-hero > div:first-child > span {
  display: block;
  margin-bottom: 8px;
  color: var(--secondary);
  font-size: 0.68rem;
  font-weight: 900;
  letter-spacing: 0.16em;
}

.custom-order-details-hero h2 {
  margin: 0;
  max-width: 700px;
  color: var(--white);
  font-size: 1rem;
  font-weight: 700;
  word-break: break-all;
}

.custom-order-details-hero p {
  margin: 9px 0 0;
  color: rgba(255, 255, 255, 0.62);
  font-size: 0.78rem;
}

.custom-order-details-status {
  min-width: 180px;
  padding: 16px 20px;
  border: 1px solid rgba(201, 162, 39, 0.3);
  border-radius: 12px;
  background: rgba(255, 255, 255, 0.06);
  position: relative;
  z-index: 1;
  text-align: center;
}

.custom-order-details-status span {
  display: block;
  margin-bottom: 7px;
  color: rgba(255, 255, 255, 0.55);
  font-size: 0.64rem;
  font-weight: 800;
  letter-spacing: 0.13em;
}

.custom-order-details-status strong {
  color: var(--secondary);
  font-size: 0.86rem;
  font-weight: 900;
}

/* =========================================================
   GENERAL CARD
========================================================= */

.custom-order-details-card {
  max-width: 1200px;
  margin: 0 auto 25px;
  padding: 28px;
  background: var(--white);
  border: 1px solid var(--border);
  border-radius: 18px;
  box-shadow: 0 10px 30px rgba(16, 37, 29, 0.055);
  position: relative;
  overflow: hidden;
}

.custom-order-details-card::before {
  content: "";
  position: absolute;
  left: 0;
  top: 0;
  width: 4px;
  height: 100%;
  background: linear-gradient(
    to bottom,
    var(--secondary),
    var(--primary)
  );
}

.custom-order-details-card-header {
  margin-bottom: 23px;
}

.custom-order-details-card-header p {
  margin: 0 0 7px;
  color: var(--secondary);
  font-size: 0.67rem;
  font-weight: 900;
  letter-spacing: 0.16em;
}

.custom-order-details-card-header h2 {
  margin: 0;
  color: var(--primary-dark);
  font-size: 1.25rem;
  font-weight: 900;
}

/* =========================================================
   PROGRESS TIMELINE
========================================================= */

.custom-order-timeline {
  display: grid;
  grid-template-columns: repeat(8, 1fr);
  gap: 0;
  padding: 10px 0 5px;
}

.custom-order-timeline-step {
  position: relative;
  text-align: center;
  min-width: 0;
}

.custom-order-timeline-step:not(:last-child)::after {
  content: "";
  position: absolute;
  height: 2px;
  background: var(--border);
  top: 19px;
  left: 50%;
  width: 100%;
  z-index: 0;
}

.custom-order-timeline-step.completed:not(:last-child)::after {
  background: var(--secondary);
}

.custom-order-timeline-marker {
  width: 40px;
  height: 40px;
  margin: 0 auto 12px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  border: 2px solid var(--border);
  background: var(--white);
  color: var(--muted);
  font-size: 0.76rem;
  font-weight: 900;
  position: relative;
  z-index: 2;
  transition: 0.3s ease;
}

.custom-order-timeline-step.completed
  .custom-order-timeline-marker {
  background: var(--primary);
  border-color: var(--primary);
  color: var(--white);
}

.custom-order-timeline-step.active
  .custom-order-timeline-marker {
  background: var(--secondary);
  border-color: var(--secondary);
  color: var(--primary-dark);
  box-shadow:
    0 0 0 6px rgba(201, 162, 39, 0.13);
}

.custom-order-timeline-step > span {
  display: block;
  padding: 0 5px;
  color: var(--muted);
  font-size: 0.67rem;
  font-weight: 700;
  line-height: 1.35;
}

.custom-order-timeline-step.completed > span,
.custom-order-timeline-step.active > span {
  color: var(--primary-dark);
  font-weight: 900;
}

/* =========================================================
   TWO COLUMN INFORMATION
========================================================= */

.custom-order-details-grid {
  max-width: 1200px;
  margin: 0 auto 25px;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 25px;
}

.custom-order-details-grid .custom-order-details-card {
  margin: 0;
  max-width: none;
}

/* =========================================================
   DETAIL LIST
========================================================= */

.custom-order-detail-list {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12px;
}

.custom-order-detail-list > div {
  min-height: 78px;
  padding: 15px 17px;
  border: 1px solid var(--border);
  border-radius: 11px;
  background: #fbfaf6;
  transition: 0.25s ease;
}

.custom-order-detail-list > div:hover {
  border-color: rgba(201, 162, 39, 0.4);
  transform: translateY(-2px);
}

.custom-order-detail-list span,
.custom-order-service-list span {
  display: block;
  margin-bottom: 6px;
  color: var(--muted);
  font-size: 0.67rem;
  font-weight: 800;
  letter-spacing: 0.04em;
  text-transform: uppercase;
}

.custom-order-detail-list strong,
.custom-order-service-list strong {
  display: block;
  color: var(--primary-dark);
  font-size: 0.84rem;
  line-height: 1.45;
}

/* =========================================================
   DESIGN SERVICES
========================================================= */

.custom-order-service-list {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px;
}

.custom-order-service-list > div {
  min-height: 78px;
  padding: 15px 17px;
  border: 1px solid var(--border);
  border-radius: 11px;
  background: #fbfaf6;
}

.custom-order-service-list > div.requested {
  background: rgba(201, 162, 39, 0.08);
  border-color: rgba(201, 162, 39, 0.45);
}

.custom-order-service-list > div.requested strong {
  color: var(--primary);
}

/* =========================================================
   LOCATION
========================================================= */

.custom-order-location {
  padding: 20px;
  border-radius: 13px;
  background:
    linear-gradient(
      135deg,
      rgba(11, 61, 46, 0.05),
      rgba(201, 162, 39, 0.06)
    );
  border: 1px solid var(--border);
}

.custom-order-location strong {
  display: block;
  margin-bottom: 10px;
  color: var(--primary-dark);
  font-size: 0.92rem;
}

.custom-order-location p {
  margin: 0 0 6px;
  color: var(--text);
  font-size: 0.86rem;
  line-height: 1.6;
}

.custom-order-location span {
  display: block;
  margin-top: 5px;
  color: var(--muted);
  font-size: 0.76rem;
  line-height: 1.5;
}

.custom-order-muted {
  margin: 0;
  padding: 18px;
  border-radius: 11px;
  background: #faf9f5;
  color: var(--muted);
  font-size: 0.84rem;
  text-align: center;
}

/* =========================================================
   PAYMENT
========================================================= */

.custom-order-payment-details {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  border: 1px solid var(--border);
  border-radius: 14px;
  overflow: hidden;
}

.custom-order-payment-details > div {
  padding: 20px;
  background: #fbfaf6;
  border-right: 1px solid var(--border);
}

.custom-order-payment-details > div:last-child {
  border-right: none;
}

.custom-order-payment-details span {
  display: block;
  margin-bottom: 8px;
  color: var(--muted);
  font-size: 0.68rem;
  font-weight: 800;
  letter-spacing: 0.05em;
  text-transform: uppercase;
}

.custom-order-payment-details strong {
  color: var(--primary-dark);
  font-size: 1rem;
  line-height: 1.4;
}

.custom-order-payment-details > div:nth-child(3) {
  background: rgba(201, 162, 39, 0.09);
}

.custom-order-payment-details > div:nth-child(3) strong {
  color: var(--primary);
  font-size: 1.12rem;
}

/* =========================================================
   REFERENCE IMAGE
========================================================= */

.custom-order-reference-image {
  width: 100%;
  max-width: 750px;
  margin: 0 auto;
  border-radius: 15px;
  overflow: hidden;
  border: 1px solid var(--border);
  background: #f1eee5;
}

.custom-order-reference-image img {
  width: 100%;
  max-height: 600px;
  display: block;
  object-fit: contain;
  transition: transform 0.45s ease;
}

.custom-order-reference-image:hover img {
  transform: scale(1.025);
}

/* =========================================================
   NOTES
========================================================= */

.custom-order-notes {
  margin: 0;
  padding: 20px;
  background: #fbfaf6;
  border: 1px solid var(--border);
  border-radius: 13px;
  color: var(--text);
  font-size: 0.9rem;
  line-height: 1.8;
  white-space: pre-wrap;
}

/* =========================================================
   FOOTER ACTIONS
========================================================= */

.custom-order-details-actions {
  max-width: 1200px;
  margin: 35px auto 0;
  display: flex;
  justify-content: space-between;
  gap: 15px;
}

.custom-order-details-primary-button,
.custom-order-details-secondary-button {
  min-height: 54px;
  padding: 0 24px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 11px;
  text-decoration: none;
  font-size: 0.74rem;
  font-weight: 900;
  letter-spacing: 0.06em;
  transition: 0.25s ease;
}

.custom-order-details-primary-button {
  background: var(--primary);
  color: var(--white);
  box-shadow: 0 8px 20px rgba(11, 61, 46, 0.14);
}

.custom-order-details-primary-button:hover {
  background: var(--primary-dark);
  transform: translateY(-3px);
  box-shadow: 0 14px 28px rgba(11, 61, 46, 0.2);
}

.custom-order-details-secondary-button {
  background: var(--white);
  color: var(--primary);
  border: 1px solid var(--border);
}

.custom-order-details-secondary-button:hover {
  border-color: var(--secondary);
  transform: translateY(-3px);
}

/* =========================================================
   LOADING
========================================================= */

.custom-order-details-loading {
  min-height: 75vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
}

.custom-order-details-spinner {
  width: 50px;
  height: 50px;
  margin-bottom: 20px;
  border: 3px solid rgba(201, 162, 39, 0.2);
  border-top-color: var(--secondary);
  border-radius: 50%;
  animation: customOrderDetailsSpin 0.8s linear infinite;
}

.custom-order-details-loading h1 {
  margin: 0 0 8px;
  color: var(--primary-dark);
  font-size: 1.6rem;
}

.custom-order-details-loading p {
  margin: 0;
  color: var(--muted);
}

/* =========================================================
   ERROR
========================================================= */

.custom-order-details-error {
  max-width: 600px;
  margin: 100px auto;
  padding: 50px 35px;
  background: var(--white);
  border: 1px solid var(--border);
  border-radius: 18px;
  text-align: center;
  box-shadow: 0 15px 40px rgba(16, 37, 29, 0.08);
}

.custom-order-details-error h1 {
  margin: 0 0 12px;
  color: var(--primary-dark);
  font-size: 2rem;
}

.custom-order-details-error > p:not(.custom-order-details-label) {
  margin: 0 0 25px;
  color: var(--muted);
  line-height: 1.7;
}

/* =========================================================
   ANIMATIONS
========================================================= */

@keyframes customOrderDetailsSpin {
  to {
    transform: rotate(360deg);
  }
}

.custom-order-details-header,
.custom-order-details-hero,
.custom-order-details-card,
.custom-order-details-grid,
.custom-order-details-actions {
  animation: customOrderDetailsAppear 0.55s ease both;
}

.custom-order-details-hero {
  animation-delay: 0.08s;
}

.custom-order-details-card {
  animation-delay: 0.14s;
}

@keyframes customOrderDetailsAppear {
  from {
    opacity: 0;
    transform: translateY(14px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* =========================================================
   TABLET
========================================================= */

@media (max-width: 1000px) {
  .custom-order-timeline {
    grid-template-columns: repeat(4, 1fr);
    row-gap: 25px;
  }

  .custom-order-timeline-step:nth-child(4)::after,
  .custom-order-timeline-step:nth-child(8)::after {
    display: none;
  }

  .custom-order-payment-details {
    grid-template-columns: repeat(2, 1fr);
  }

  .custom-order-payment-details > div:nth-child(2) {
    border-right: none;
  }

  .custom-order-payment-details > div:nth-child(-n + 2) {
    border-bottom: 1px solid var(--border);
  }
}

/* =========================================================
   MOBILE
========================================================= */

@media (max-width: 700px) {
  .custom-order-details-page {
    padding: 50px 5% 75px;
  }

  .custom-order-details-header {
    display: block;
  }

  .custom-order-details-back {
    margin-top: 20px;
  }

  .custom-order-details-hero {
    display: block;
    padding: 24px;
  }

  .custom-order-details-status {
    margin-top: 20px;
    width: auto;
  }

  .custom-order-details-card {
    padding: 22px;
  }

  .custom-order-details-grid {
    grid-template-columns: 1fr;
  }

  .custom-order-detail-list {
    grid-template-columns: 1fr;
  }

  .custom-order-service-list {
    grid-template-columns: 1fr;
  }

  .custom-order-timeline {
    grid-template-columns: 1fr;
    gap: 0;
  }

  .custom-order-timeline-step {
    min-height: 62px;
    display: grid;
    grid-template-columns: 42px 1fr;
    align-items: center;
    text-align: left;
  }

  .custom-order-timeline-step:not(:last-child)::after {
    width: 2px;
    height: 100%;
    left: 20px;
    top: 20px;
  }

  .custom-order-timeline-marker {
    margin: 0;
  }

  .custom-order-timeline-step > span {
    padding-left: 12px;
  }

  .custom-order-payment-details {
    grid-template-columns: 1fr;
  }

  .custom-order-payment-details > div {
    border-right: none;
    border-bottom: 1px solid var(--border);
  }

  .custom-order-payment-details > div:last-child {
    border-bottom: none;
  }

  .custom-order-details-actions {
    flex-direction: column-reverse;
  }

  .custom-order-details-primary-button,
  .custom-order-details-secondary-button {
    width: 100%;
  }
}

/* =========================================================
   SMALL MOBILE
========================================================= */

@media (max-width: 430px) {
  .custom-order-details-page {
    padding-left: 4%;
    padding-right: 4%;
  }

  .custom-order-details-header h1 {
    font-size: 1.85rem;
  }

  .custom-order-details-hero h2 {
    font-size: 0.82rem;
  }

  .custom-order-details-card {
    padding: 19px;
  }

  .custom-order-details-card-header h2 {
    font-size: 1.1rem;
  }
}

/* =========================================================
   REDUCED MOTION
========================================================= */

@media (prefers-reduced-motion: reduce) {
  .custom-order-details-header,
  .custom-order-details-hero,
  .custom-order-details-card,
  .custom-order-details-grid,
  .custom-order-details-actions {
    animation: none;
  }

  .custom-order-details-spinner {
    animation: none;
  }

  .custom-order-details-back,
  .custom-order-details-primary-button,
  .custom-order-details-secondary-button,
  .custom-order-detail-list > div,
  .custom-order-reference-image img {
    transition: none;
  }
}

/* =========================================================
   ABS CUT — CUSTOM ORDER QUOTATION & PAYMENT
========================================================= */

.custom-order-quotation-card {
  position: relative;
  overflow: hidden;
}

.custom-order-quotation-card::before {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  width: 4px;
  height: 100%;
  background: linear-gradient(
    180deg,
    var(--secondary),
    var(--primary)
  );
}

/* ---------------------------------------------------------
   PAYMENT STATUS
--------------------------------------------------------- */

.custom-order-payment-status {
  display: inline-flex;
  align-items: center;
  justify-content: center;

  padding: 8px 14px;

  border-radius: 999px;

  font-size: 0.72rem;
  font-weight: 800;
  letter-spacing: 0.08em;
  text-transform: uppercase;

  border: 1px solid var(--border);

  background: rgba(11, 61, 46, 0.06);
  color: var(--primary);
}

.custom-order-payment-status.paid {
  background: rgba(34, 139, 94, 0.12);
  color: #19704a;
  border-color: rgba(34, 139, 94, 0.2);
}

.custom-order-payment-status.partially-paid {
  background: rgba(201, 162, 39, 0.14);
  color: #8b6b08;
  border-color: rgba(201, 162, 39, 0.25);
}

.custom-order-payment-status.pending {
  background: rgba(108, 117, 125, 0.1);
  color: #5f666b;
}

.custom-order-payment-status.refunded {
  background: rgba(190, 70, 70, 0.1);
  color: #9c3333;
}

/* ---------------------------------------------------------
   QUOTATION BREAKDOWN
--------------------------------------------------------- */

.custom-order-quotation-breakdown {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));

  margin-top: 28px;

  border: 1px solid var(--border);
  border-radius: 18px;

  overflow: hidden;

  background: var(--background);
}

.custom-order-quotation-breakdown > div {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;

  min-height: 70px;

  padding: 18px 22px;

  background: var(--white);

  border-bottom: 1px solid var(--border);

  transition:
    background 0.25s ease,
    transform 0.25s ease;
}

.custom-order-quotation-breakdown > div:nth-child(odd) {
  border-right: 1px solid var(--border);
}

.custom-order-quotation-breakdown > div:nth-last-child(-n + 2) {
  border-bottom: none;
}

.custom-order-quotation-breakdown > div:hover {
  background: #fcfbf7;
}

.custom-order-quotation-breakdown span {
  color: var(--muted);

  font-size: 0.88rem;
  font-weight: 600;
}

.custom-order-quotation-breakdown strong {
  color: var(--text);

  font-size: 0.95rem;
  font-weight: 800;

  white-space: nowrap;
}

/* ---------------------------------------------------------
   TOTAL QUOTATION
--------------------------------------------------------- */

.custom-order-quotation-total {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;

  margin-top: 18px;
  padding: 22px 24px;

  border-radius: 18px;

  background:
    linear-gradient(
      135deg,
      rgba(11, 61, 46, 0.98),
      rgba(16, 37, 29, 0.98)
    );

  box-shadow:
    0 14px 30px rgba(16, 37, 29, 0.16);
}

.custom-order-quotation-total span {
  color: rgba(255, 255, 255, 0.72);

  font-size: 0.78rem;
  font-weight: 800;

  letter-spacing: 0.1em;
  text-transform: uppercase;
}

.custom-order-quotation-total strong {
  color: var(--secondary);

  font-size: 1.45rem;
  font-weight: 900;

  letter-spacing: -0.02em;
}

/* ---------------------------------------------------------
   PAYMENT SUMMARY
--------------------------------------------------------- */

.custom-order-quotation-card .custom-order-payment-details {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));

  gap: 14px;

  margin-top: 18px;
}

.custom-order-quotation-card .custom-order-payment-details > div {
  padding: 18px;

  border: 1px solid var(--border);
  border-radius: 16px;

  background: var(--white);

  transition:
    transform 0.25s ease,
    box-shadow 0.25s ease,
    border-color 0.25s ease;
}

.custom-order-quotation-card
  .custom-order-payment-details
  > div:hover {
  transform: translateY(-3px);

  border-color: rgba(201, 162, 39, 0.4);

  box-shadow:
    0 10px 25px rgba(16, 37, 29, 0.07);
}

.custom-order-quotation-card
  .custom-order-payment-details
  span {
  display: block;

  margin-bottom: 8px;

  color: var(--muted);

  font-size: 0.72rem;
  font-weight: 800;

  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.custom-order-quotation-card
  .custom-order-payment-details
  strong {
  display: block;

  color: var(--text);

  font-size: 1.05rem;
  font-weight: 850;
}

/* ---------------------------------------------------------
   PAYMENT ACTION
--------------------------------------------------------- */

.custom-order-payment-action {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;

  margin-top: 24px;
  padding: 20px;

  border: 1px solid rgba(201, 162, 39, 0.28);
  border-radius: 18px;

  background:
    linear-gradient(
      135deg,
      rgba(201, 162, 39, 0.08),
      rgba(11, 61, 46, 0.04)
    );
}

.custom-order-pay-button {
  position: relative;

  display: inline-flex;
  align-items: center;
  justify-content: center;

  min-height: 56px;

  padding: 0 28px;

  border: none;
  border-radius: 12px;

  background: var(--primary);

  color: var(--white);

  font-family: inherit;

  font-size: 0.78rem;
  font-weight: 900;

  letter-spacing: 0.08em;

  cursor: pointer;

  overflow: hidden;

  box-shadow:
    0 10px 24px rgba(11, 61, 46, 0.18);

  transition:
    transform 0.25s ease,
    box-shadow 0.25s ease,
    background 0.25s ease;
}

.custom-order-pay-button::before {
  content: "";

  position: absolute;

  top: 0;
  left: -120%;

  width: 100%;
  height: 100%;

  background:
    linear-gradient(
      90deg,
      transparent,
      rgba(255, 255, 255, 0.16),
      transparent
    );

  transition: left 0.55s ease;
}

.custom-order-pay-button:hover {
  transform: translateY(-3px);

  background: var(--primary-dark);

  box-shadow:
    0 15px 30px rgba(11, 61, 46, 0.24);
}

.custom-order-pay-button:hover::before {
  left: 120%;
}

.custom-order-pay-button:active {
  transform: translateY(-1px);
}

.custom-order-payment-action p {
  margin: 0;

  max-width: 420px;

  color: var(--muted);

  font-size: 0.82rem;
  line-height: 1.65;
}

/* ---------------------------------------------------------
   RESPONSIVE
--------------------------------------------------------- */

@media (max-width: 850px) {
  .custom-order-quotation-breakdown {
    grid-template-columns: 1fr;
  }

  .custom-order-quotation-breakdown > div:nth-child(odd) {
    border-right: none;
  }

  .custom-order-quotation-breakdown > div:nth-last-child(-n + 2) {
    border-bottom: 1px solid var(--border);
  }

  .custom-order-quotation-breakdown > div:last-child {
    border-bottom: none;
  }

  .custom-order-quotation-card .custom-order-payment-details {
    grid-template-columns: 1fr;
  }

  .custom-order-payment-action {
    align-items: stretch;
    flex-direction: column;
  }

  .custom-order-payment-action p {
    max-width: none;
  }

  .custom-order-pay-button {
    width: 100%;
  }
}

@media (max-width: 520px) {
  .custom-order-quotation-breakdown > div {
    min-height: 64px;
    padding: 16px;
  }

  .custom-order-quotation-total {
    align-items: flex-start;
    flex-direction: column;
    gap: 8px;

    padding: 20px;
  }

  .custom-order-quotation-total strong {
    font-size: 1.25rem;
  }

  .custom-order-quotation-card
    .custom-order-payment-details
    > div {
    padding: 16px;
  }

  .custom-order-payment-action {
    padding: 16px;
  }

  .custom-order-pay-button {
    min-height: 52px;
  }
}

/* ---------------------------------------------------------
   REDUCED MOTION
--------------------------------------------------------- */

@media (prefers-reduced-motion: reduce) {
  .custom-order-quotation-breakdown > div,
  .custom-order-quotation-card
    .custom-order-payment-details
    > div,
  .custom-order-pay-button {
    transition: none;
  }

  .custom-order-pay-button::before {
    display: none;
  }
}


/* =========================================================
   CUSTOM ORDER PAYMENT — EXTRA STATES
========================================================= */

.custom-order-pay-button:disabled {
  opacity: 0.65;
  cursor: not-allowed;
  transform: none;
  box-shadow: none;
}

.custom-order-payment-error {
  flex-basis: 100%;
  width: 100%;
  margin: 4px 0 0;

  color: #a83232;

  font-size: 0.82rem;
  font-weight: 700;
  line-height: 1.5;
}

.custom-order-payment-success {
  display: flex;
  align-items: center;
  gap: 14px;

  margin-top: 24px;
  padding: 18px 20px;

  border: 1px solid rgba(34, 139, 94, 0.2);
  border-radius: 16px;

  background: rgba(34, 139, 94, 0.07);
}

.custom-order-payment-success > span {
  display: flex;
  align-items: center;
  justify-content: center;

  width: 40px;
  height: 40px;

  flex-shrink: 0;

  border-radius: 50%;

  background: #19704a;
  color: #ffffff;

  font-size: 1rem;
  font-weight: 900;
}

.custom-order-payment-success strong {
  display: block;

  margin-bottom: 3px;

  color: var(--primary);

  font-size: 0.95rem;
  font-weight: 900;
}

.custom-order-payment-success p {
  margin: 0;

  color: var(--muted);

  font-size: 0.8rem;
  line-height: 1.5;
}

@media (max-width: 600px) {
  .custom-order-payment-success {
    align-items: flex-start;
  }
}

.custom-order-payment-action-content {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;

  margin-top: 24px;
  padding: 22px;

  border: 1px solid rgba(201, 162, 39, 0.2);
  border-radius: 18px;

  background:
    linear-gradient(
      135deg,
      rgba(201, 162, 39, 0.08),
      rgba(11, 61, 46, 0.04)
    );
}

.custom-order-payment-action-label {
  display: block;

  margin-bottom: 6px;

  color: var(--muted);

  font-size: 0.72rem;
  font-weight: 900;
  letter-spacing: 0.12em;
}

.custom-order-payment-action-content strong {
  display: block;

  color: var(--primary);

  font-size: 1.5rem;
  font-weight: 900;
}

.custom-order-payment-waiting {
  display: flex;
  align-items: flex-start;
  gap: 14px;

  margin-top: 24px;
  padding: 18px 20px;

  border: 1px solid rgba(201, 162, 39, 0.2);
  border-radius: 16px;

  background: rgba(201, 162, 39, 0.06);
}

.custom-order-payment-waiting > span {
  display: flex;
  align-items: center;
  justify-content: center;

  width: 40px;
  height: 40px;

  flex-shrink: 0;

  border-radius: 50%;

  background: rgba(201, 162, 39, 0.15);
  color: var(--secondary);

  font-size: 1.1rem;
  font-weight: 900;
}

.custom-order-payment-waiting strong {
  display: block;

  margin-bottom: 4px;

  color: var(--primary);

  font-size: 0.95rem;
  font-weight: 900;
}

.custom-order-payment-waiting p {
  margin: 0;

  color: var(--muted);

  font-size: 0.82rem;
  line-height: 1.5;
}

@media (max-width: 600px) {
  .custom-order-payment-action-content {
    align-items: flex-start;
    flex-direction: column;
  }

  .custom-order-pay-button {
    width: 100%;
  }
}

/* =====================================================
   ABS CUT — LOCATION MAP
===================================================== */

.custom-location-picker {
  margin-top: 28px;
  padding: 22px;
  border: 1px solid var(--border);
  border-radius: 18px;
  background: rgba(248, 245, 237, 0.72);
  overflow: hidden;
  animation: customLocationReveal 0.55s ease both;
}

.custom-location-picker-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20px;
  margin-bottom: 18px;
}

.custom-location-picker-header > div {
  display: flex;
  flex-direction: column;
  gap: 5px;
}

.custom-location-picker-header span {
  color: var(--secondary);
  font-size: 0.72rem;
  font-weight: 800;
  letter-spacing: 0.16em;
  text-transform: uppercase;
}

.custom-location-picker-header strong {
  color: var(--primary-dark);
  font-size: 1rem;
  font-weight: 800;
}

.custom-location-picker-header small {
  color: var(--muted);
  font-size: 0.86rem;
  line-height: 1.6;
}


/* =====================================================
   MAP WRAPPER
===================================================== */

.custom-location-map-wrapper {
  position: relative;
  width: 100%;
  height: 370px;
  overflow: hidden;
  border: 1px solid var(--border);
  border-radius: 16px;
  background: #e9e5db;
  box-shadow:
    0 18px 45px rgba(16, 37, 29, 0.08);
}

.custom-location-map {
  width: 100%;
  height: 100%;
  z-index: 1;
}


/* =====================================================
   MAP INSTRUCTION
===================================================== */

.custom-map-instruction {
  position: absolute;
  z-index: 500;
  left: 50%;
  bottom: 18px;
  transform: translateX(-50%);
  display: flex;
  align-items: center;
  gap: 10px;
  width: max-content;
  max-width: calc(100% - 30px);
  padding: 11px 16px;
  border: 1px solid rgba(255, 255, 255, 0.62);
  border-radius: 999px;
  background: rgba(16, 37, 29, 0.88);
  backdrop-filter: blur(12px);
  box-shadow:
    0 12px 28px rgba(16, 37, 29, 0.18);
  pointer-events: none;
  animation: customMapInstruction 0.6s ease both;
}

.custom-map-instruction span {
  display: grid;
  width: 25px;
  height: 25px;
  place-items: center;
  border-radius: 50%;
  background: var(--secondary);
  color: var(--primary-dark);
  font-size: 1rem;
  font-weight: 900;
}

.custom-map-instruction p {
  margin: 0;
  color: #ffffff;
  font-size: 0.78rem;
  font-weight: 700;
}


/* =====================================================
   LOCATION ACTIONS
===================================================== */

.custom-location-actions {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 12px;
  margin-top: 15px;
}

.custom-location-button,
.custom-location-clear-button {
  min-height: 48px;
  padding: 0 17px;
  border-radius: 12px;
  font: inherit;
  font-size: 0.76rem;
  font-weight: 800;
  letter-spacing: 0.04em;
  cursor: pointer;
  transition:
    transform 0.25s ease,
    box-shadow 0.25s ease,
    background 0.25s ease,
    color 0.25s ease,
    border-color 0.25s ease;
}

.custom-location-button {
  display: inline-flex;
  align-items: center;
  gap: 9px;
  border: 1px solid var(--primary);
  background: var(--primary);
  color: #ffffff;
}

.custom-location-button span {
  font-size: 1.05rem;
}

.custom-location-button:hover:not(:disabled) {
  transform: translateY(-2px);
  box-shadow:
    0 10px 22px rgba(11, 61, 46, 0.18);
}

.custom-location-button:disabled {
  cursor: wait;
  opacity: 0.68;
}

.custom-location-clear-button {
  border: 1px solid var(--border);
  background: transparent;
  color: var(--primary-dark);
}

.custom-location-clear-button:hover {
  transform: translateY(-2px);
  border-color: var(--secondary);
  color: var(--secondary);
}


/* =====================================================
   LOCATION ERROR
===================================================== */

.custom-location-error {
  display: flex;
  align-items: flex-start;
  gap: 10px;
  margin-top: 14px;
  padding: 12px 14px;
  border: 1px solid rgba(170, 55, 55, 0.2);
  border-radius: 12px;
  background: rgba(170, 55, 55, 0.06);
  color: #8f3131;
}

.custom-location-error span {
  display: grid;
  flex: 0 0 auto;
  width: 22px;
  height: 22px;
  place-items: center;
  border-radius: 50%;
  background: #8f3131;
  color: #ffffff;
  font-size: 0.74rem;
  font-weight: 900;
}

.custom-location-error p {
  margin: 0;
  font-size: 0.82rem;
  line-height: 1.55;
}


/* =====================================================
   SELECTED LOCATION
===================================================== */

.custom-location-selected {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  margin-top: 14px;
  padding: 15px 16px;
  border: 1px solid rgba(11, 61, 46, 0.14);
  border-radius: 13px;
  background: rgba(11, 61, 46, 0.05);
}

.custom-location-selected > div:first-child {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.custom-location-selected span {
  color: var(--secondary);
  font-size: 0.66rem;
  font-weight: 800;
  letter-spacing: 0.12em;
  text-transform: uppercase;
}

.custom-location-selected strong {
  color: var(--primary-dark);
  font-size: 0.85rem;
}

.custom-location-coordinates {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-end;
  gap: 15px;
}

.custom-location-coordinates span {
  display: flex;
  flex-direction: column;
  gap: 3px;
  color: var(--muted);
  font-size: 0.67rem;
}

.custom-location-coordinates strong {
  color: var(--primary);
  font-family: monospace;
  font-size: 0.75rem;
  letter-spacing: 0;
}


/* =====================================================
   LEAFLET OVERRIDES
===================================================== */

.custom-location-map .leaflet-control-zoom {
  margin: 14px;
  border: none;
  box-shadow:
    0 8px 20px rgba(16, 37, 29, 0.14);
}

.custom-location-map .leaflet-control-zoom a {
  width: 36px;
  height: 36px;
  line-height: 36px;
  border: none;
  color: var(--primary-dark);
  background: #ffffff;
  transition:
    background 0.2s ease,
    color 0.2s ease;
}

.custom-location-map .leaflet-control-zoom a:hover {
  background: var(--secondary);
  color: var(--primary-dark);
}

.custom-location-map .leaflet-control-attribution {
  font-size: 10px;
  padding: 4px 7px;
}

.custom-location-map .leaflet-popup-content-wrapper {
  border-radius: 12px;
}

.custom-location-map .leaflet-popup-content {
  margin: 12px 14px;
  color: var(--text);
  font-size: 0.82rem;
  line-height: 1.55;
}


/* =====================================================
   ANIMATIONS
===================================================== */

@keyframes customLocationReveal {
  from {
    opacity: 0;
    transform: translateY(10px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes customMapInstruction {
  from {
    opacity: 0;
    transform:
      translateX(-50%)
      translateY(10px);
  }

  to {
    opacity: 1;
    transform:
      translateX(-50%)
      translateY(0);
  }
}


/* =====================================================
   RESPONSIVE
===================================================== */

@media (max-width: 700px) {

  .custom-location-picker {
    padding: 16px;
  }

  .custom-location-map-wrapper {
    height: 320px;
  }

  .custom-location-selected {
    flex-direction: column;
    align-items: flex-start;
  }

  .custom-location-coordinates {
    justify-content: flex-start;
  }

  .custom-map-instruction {
    bottom: 12px;
    padding: 9px 13px;
  }

  .custom-map-instruction p {
    font-size: 0.7rem;
  }

  .custom-location-button,
  .custom-location-clear-button {
    width: 100%;
    justify-content: center;
  }
}


@media (max-width: 430px) {

  .custom-location-map-wrapper {
    height: 285px;
  }

  .custom-location-picker-header small {
    font-size: 0.78rem;
  }

  .custom-location-coordinates {
    width: 100%;
    flex-direction: column;
    gap: 8px;
  }

}


/* =====================================================
   REDUCED MOTION
===================================================== */

@media (prefers-reduced-motion: reduce) {

  .custom-location-picker,
  .custom-map-instruction {
    animation: none;
  }

  .custom-location-button,
  .custom-location-clear-button {
    transition: none;
  }

}
/* =========================================================
   ABS CUT — SOCIAL LOGIN
========================================================= */

.login-social-divider {
  display: flex;
  align-items: center;
  gap: 14px;
  margin: 28px 0 20px;
}

.login-social-divider span {
  flex: 1;
  height: 1px;
  background: var(--border);
}

.login-social-divider p {
  margin: 0;
  color: var(--muted);
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 1.5px;
  white-space: nowrap;
}


.login-social-login {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
}


.google-login-button-wrapper {
  width: 100%;
  display: flex;
  justify-content: center;
  overflow: hidden;
}


.google-login-button {
  width: 100%;
  min-height: 44px;
  display: flex;
  justify-content: center;
}


.google-login-button > div {
  max-width: 100%;
}


.login-social-loading {
  margin: 0 0 12px;
  color: var(--muted);
  font-size: 13px;
  text-align: center;
  animation: loginSocialPulse 1.2s ease-in-out infinite;
}


@keyframes loginSocialPulse {
  0%,
  100% {
    opacity: 0.55;
  }

  50% {
    opacity: 1;
  }
}


/* =========================================================
   REDUCED MOTION
========================================================= */

@media (
  prefers-reduced-motion: reduce
) {
  .login-social-loading {
    animation: none;
  }
}
/* =====================================================
   SOCIAL LOGIN — FACEBOOK
===================================================== */

.facebook-login-button {
  width: 100%;
  min-height: 56px;

  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12px;

  padding: 0 20px;

  border: 1px solid var(--border);
  border-radius: 14px;

  background: var(--white);
  color: var(--text);

  font-size: 15px;
  font-weight: 700;

  cursor: pointer;

  transition:
    transform 0.25s ease,
    box-shadow 0.25s ease,
    border-color 0.25s ease,
    background 0.25s ease;
}

.facebook-login-button:hover:not(:disabled) {
  transform: translateY(-2px);

  border-color: var(--primary);

  box-shadow:
    0 12px 28px rgba(16, 37, 29, 0.12);
}

.facebook-login-button:active:not(:disabled) {
  transform: translateY(0);
}

.facebook-login-button:disabled {
  opacity: 0.65;
  cursor: not-allowed;
}

.facebook-login-icon {
  width: 30px;
  height: 30px;

  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 50%;

  background: #1877f2;
  color: #ffffff;

  font-family: Arial, sans-serif;
  font-size: 21px;
  font-weight: 800;

  line-height: 1;
}


/* =========================================
   BANK TRANSFER RECEIPT UPLOAD
========================================= */

.receipt-upload {
  margin-top: 22px;
  padding: 20px;
  border: 1px dashed rgba(201, 162, 39, 0.65);
  border-radius: 12px;
  background: rgba(201, 162, 39, 0.045);
  transition:
    border-color 0.25s ease,
    background 0.25s ease;
}

.receipt-upload:focus-within {
  border-color: #c9a227;
  background: rgba(201, 162, 39, 0.08);
}

.receipt-upload > p {
  margin: 8px 0 14px;
  color: #777;
  font-size: 0.9rem;
  line-height: 1.6;
}

.receipt-upload input[type="file"] {
  display: block;
  width: 100%;
  padding: 12px;
  border: 1px solid rgba(0, 0, 0, 0.12);
  border-radius: 8px;
  background: #fff;
  color: #333;
  cursor: pointer;
}

.receipt-upload > small {
  display: block;
  margin-top: 10px;
  color: #777;
  font-size: 0.78rem;
}

.receipt-file-selected {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-top: 14px;
  padding: 12px;
  border-radius: 8px;
  background: rgba(35, 112, 62, 0.08);
  overflow-wrap: anywhere;
}

.receipt-file-selected > span:first-child {
  color: #23703e;
  font-size: 1.2rem;
  font-weight: 700;
}

.receipt-file-selected > span:nth-child(2) {
  display: flex;
  flex: 1;
  flex-direction: column;
  gap: 4px;
  min-width: 0;
}

.receipt-file-selected strong {
  font-size: 0.85rem;
  overflow-wrap: anywhere;
}

.receipt-file-selected small {
  color: #777;
  font-size: 0.75rem;
}

.receipt-file-selected button {
  border: 0;
  background: transparent;
  color: #a52a2a;
  font: inherit;
  font-size: 0.8rem;
  cursor: pointer;
}

.receipt-file-selected button:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

@media (max-width: 600px) {
  .receipt-upload {
    padding: 14px;
  }

  .receipt-file-selected {
    align-items: flex-start;
  }
}


/* =========================================================
   ABS CUT — ADMIN PAYMENTS
========================================================= */

.admin-payments-page {
  min-height: 100vh;
  background: #f5f6f8;
  color: #1b1d21;
}

.admin-payments-main {
  min-width: 0;
  margin-left: 260px;
  padding: 38px;
  animation: payments-enter 0.45s ease both;
}

@keyframes payments-enter {
  from {
    opacity: 0;
    transform: translateY(8px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.payments-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 24px;
  margin-bottom: 30px;
}

.payments-eyebrow,
.payments-modal-eyebrow {
  display: block;
  margin-bottom: 10px;
  color: #a17d18;
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 2px;
}

.payments-header h1 {
  margin: 0;
  color: #17191c;
  font-size: clamp(28px, 3vw, 38px);
  font-weight: 800;
  letter-spacing: -1.2px;
}

.payments-header p {
  max-width: 620px;
  margin: 10px 0 0;
  color: #777c84;
  font-size: 14px;
  line-height: 1.7;
}

.payments-refresh-button {
  display: inline-flex;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  gap: 9px;
  min-height: 44px;
  padding: 0 18px;
  border: 1px solid #e0e2e6;
  border-radius: 10px;
  background: #fff;
  color: #282a2e;
  font-size: 13px;
  font-weight: 700;
  cursor: pointer;
  transition: border-color 0.2s, transform 0.2s;
}

.payments-refresh-button:hover:not(:disabled) {
  border-color: #b8963b;
  transform: translateY(-2px);
}

.payments-refresh-button:disabled {
  cursor: wait;
  opacity: 0.65;
}

.payments-refresh-button span {
  font-size: 21px;
}

.payments-stats {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18px;
  margin-bottom: 26px;
}

.payments-stat-card {
  display: flex;
  align-items: center;
  gap: 17px;
  min-width: 0;
  padding: 25px;
  border: 1px solid #e9eaed;
  border-radius: 15px;
  background: #fff;
  box-shadow: 0 5px 22px rgb(25 29 35 / 3%);
  transition: transform 0.25s, box-shadow 0.25s;
}

.payments-stat-card:hover {
  transform: translateY(-3px);
  box-shadow: 0 12px 30px rgb(25 29 35 / 6%);
}

.payments-stat-icon {
  display: grid;
  flex-shrink: 0;
  width: 52px;
  height: 52px;
  place-items: center;
  border-radius: 13px;
  background: #fbf4df;
  color: #9b7510;
  font-size: 25px;
  font-weight: 800;
}

.payments-stat-card p {
  margin: 0 0 7px;
  color: #777c84;
  font-size: 12px;
  font-weight: 600;
}

.payments-stat-card h2 {
  margin: 0;
  overflow-wrap: anywhere;
  color: #1b1d21;
  font-size: clamp(21px, 2.3vw, 29px);
  font-weight: 800;
  letter-spacing: -0.8px;
}

.payments-stat-card div > span {
  display: block;
  margin-top: 7px;
  color: #9a9ea5;
  font-size: 11px;
}

.payments-panel {
  overflow: hidden;
  border: 1px solid #e8e9ed;
  border-radius: 15px;
  background: #fff;
  box-shadow: 0 5px 22px rgb(25 29 35 / 3%);
}

.payments-panel-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20px;
  padding: 25px;
  border-bottom: 1px solid #eceef1;
}

.payments-panel-header h2 {
  margin: 0;
  font-size: 17px;
  font-weight: 800;
  letter-spacing: -0.3px;
}

.payments-panel-header p {
  margin: 7px 0 0;
  color: #8a8e95;
  font-size: 12px;
  line-height: 1.6;
}

.payments-search {
  display: flex;
  align-items: center;
  gap: 9px;
  width: min(360px, 100%);
  min-height: 43px;
  padding: 0 13px;
  border: 1px solid #e5e7eb;
  border-radius: 9px;
  background: #fafbfc;
  transition: border-color 0.2s, box-shadow 0.2s;
}

.payments-search:focus-within {
  border-color: #b8963b;
  box-shadow: 0 0 0 3px rgb(184 150 59 / 10%);
}

.payments-search > span {
  color: #878b92;
  font-size: 23px;
}

.payments-search input {
  width: 100%;
  min-width: 0;
  padding: 11px 0;
  border: 0;
  outline: 0;
  background: transparent;
  color: #272a2e;
  font: inherit;
  font-size: 12px;
}

.payments-search input::placeholder {
  color: #a0a4ab;
}

.payments-table-wrap {
  width: 100%;
  overflow-x: auto;
}

.payments-table {
  width: 100%;
  border-collapse: collapse;
  text-align: left;
  white-space: nowrap;
}

.payments-table th {
  padding: 15px 18px;
  background: #fafbfc;
  color: #81858d;
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 0.7px;
  text-transform: uppercase;
}

.payments-table td {
  padding: 19px 18px;
  border-top: 1px solid #f0f1f3;
  color: #383b40;
  font-size: 12px;
  vertical-align: middle;
}

.payments-table tbody tr {
  transition: background 0.2s;
}

.payments-table tbody tr:hover {
  background: #fdfcf8;
}

.payments-table td > strong,
.payments-table td > span {
  display: block;
}

.payments-order-ref {
  max-width: 200px;
  overflow: hidden;
  color: #25272b;
  font-size: 12px;
  text-overflow: ellipsis;
}

.payments-reference {
  max-width: 200px;
  overflow: hidden;
  margin-top: 6px;
  color: #8a8e95;
  font-size: 10px;
  text-overflow: ellipsis;
}

.payments-order-type {
  margin-top: 6px;
  color: #a17d18;
  font-size: 10px;
  font-weight: 700;
}

.payments-muted {
  max-width: 190px;
  overflow: hidden;
  margin-top: 6px;
  color: #8c9097;
  font-size: 11px;
  text-overflow: ellipsis;
}

.payments-amount {
  color: #1c1f23;
  font-size: 13px;
  font-weight: 800;
}

.payments-status {
  width: fit-content;
  margin-top: 7px;
  padding: 5px 8px;
  border-radius: 20px;
  background: #fff5dc;
  color: #90690b;
  font-size: 10px;
  font-weight: 700;
}

.payments-date {
  color: #666b73;
  font-size: 11px;
}

.payments-receipt-link {
  color: #98710e;
  font-size: 11px;
  font-weight: 800;
  text-decoration: none;
}

.payments-receipt-link:hover {
  color: #5f4608;
  text-decoration: underline;
}

.payments-no-receipt {
  color: #a0a4ab;
  font-size: 11px;
}

.payments-actions {
  display: flex;
  align-items: center;
  gap: 7px;
}

.payments-approve-button,
.payments-reject-button,
.payments-cancel-button,
.payments-primary-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 35px;
  padding: 0 11px;
  border: 1px solid transparent;
  border-radius: 8px;
  font-family: inherit;
  font-size: 11px;
  font-weight: 800;
  cursor: pointer;
  transition: background 0.2s, transform 0.2s, opacity 0.2s;
}

.payments-approve-button {
  background: #202923;
  color: #fff;
}

.payments-approve-button:hover:not(:disabled) {
  background: #344839;
  transform: translateY(-1px);
}

.payments-reject-button {
  border-color: #f0dada;
  background: #fff5f5;
  color: #b43a3a;
}

.payments-reject-button:hover:not(:disabled) {
  background: #ffe6e6;
  transform: translateY(-1px);
}

.payments-cancel-button {
  border-color: #e4e6e9;
  background: #fff;
  color: #555a62;
}

.payments-cancel-button:hover:not(:disabled) {
  background: #f3f4f6;
}

.payments-primary-button {
  margin-top: 8px;
  padding: 0 18px;
  background: #202923;
  color: #fff;
}

.payments-approve-button:disabled,
.payments-reject-button:disabled,
.payments-cancel-button:disabled,
.payments-primary-button:disabled {
  cursor: not-allowed;
  opacity: 0.6;
}

.payments-table-footer {
  padding: 15px 22px;
  border-top: 1px solid #eceef1;
  color: #858991;
  font-size: 11px;
}

.payments-state {
  display: flex;
  min-height: 260px;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 35px 20px;
  text-align: center;
}

.payments-state h3 {
  margin: 12px 0 7px;
  color: #292c30;
  font-size: 16px;
}

.payments-state p {
  max-width: 390px;
  margin: 0;
  color: #858991;
  font-size: 12px;
  line-height: 1.7;
}

.payments-empty-icon {
  display: grid;
  width: 52px;
  height: 52px;
  place-items: center;
  border-radius: 15px;
  background: #fbf4df;
  color: #a17d18;
  font-size: 26px;
  font-weight: 800;
}

.payments-spinner {
  width: 31px;
  height: 31px;
  border: 3px solid #eee6d1;
  border-top-color: #a17d18;
  border-radius: 50%;
  animation: payments-spin 0.75s linear infinite;
}

@keyframes payments-spin {
  to {
    transform: rotate(360deg);
  }
}

.payments-notice,
.payments-error {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 20px;
  padding: 13px 15px;
  border-radius: 9px;
  font-size: 12px;
  line-height: 1.6;
}

.payments-notice {
  border: 1px solid #cfe8d5;
  background: #f0faf2;
  color: #28643a;
}

.payments-error {
  border: 1px solid #f1d3d3;
  background: #fff5f5;
  color: #a33232;
}

.payments-notice > button,
.payments-error > button {
  margin-left: auto;
  padding: 0 4px;
  border: 0;
  background: transparent;
  color: inherit;
  font-size: 19px;
  cursor: pointer;
}

.payments-modal-backdrop {
  position: fixed;
  z-index: 1000;
  inset: 0;
  display: grid;
  overflow-y: auto;
  place-items: center;
  padding: 22px;
  background: rgb(14 17 15 / 58%);
  backdrop-filter: blur(5px);
  animation: payments-backdrop-in 0.2s ease both;
}

@keyframes payments-backdrop-in {
  from { opacity: 0; }
  to { opacity: 1; }
}

.payments-modal {
  position: relative;
  width: min(100%, 510px);
  padding: 30px;
  border: 1px solid rgb(255 255 255 / 60%);
  border-radius: 17px;
  background: #fff;
  box-shadow: 0 25px 80px rgb(0 0 0 / 25%);
  animation: payments-modal-in 0.25s ease both;
}

@keyframes payments-modal-in {
  from {
    opacity: 0;
    transform: translateY(12px) scale(0.985);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

.payments-modal-close {
  position: absolute;
  top: 17px;
  right: 17px;
  display: grid;
  width: 33px;
  height: 33px;
  place-items: center;
  border: 1px solid #e9eaed;
  border-radius: 9px;
  background: #fff;
  color: #6c7077;
  font-size: 23px;
  cursor: pointer;
}

.payments-modal h2 {
  margin: 0;
  color: #202226;
  font-size: 26px;
  letter-spacing: -0.7px;
}

.payments-modal-description {
  margin: 10px 0 22px;
  color: #777c84;
  font-size: 12px;
  line-height: 1.7;
}

.payments-modal-summary {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
  gap: 13px;
  margin-bottom: 23px;
  padding: 17px;
  border: 1px solid #eceef1;
  border-radius: 11px;
  background: #fafbfc;
  font-size: 11px;
}

.payments-modal-summary > span {
  color: #82868e;
}

.payments-modal-summary > strong {
  overflow-wrap: anywhere;
  color: #292c30;
  text-align: right;
}

.payments-modal-summary > a {
  color: #98710e;
  font-weight: 800;
  text-align: right;
  text-decoration: none;
}

.payments-form-field {
  display: flex;
  flex-direction: column;
  gap: 8px;
  color: #34373b;
  font-size: 12px;
  font-weight: 800;
}

.payments-form-field input,
.payments-form-field textarea {
  width: 100%;
  box-sizing: border-box;
  padding: 12px 13px;
  border: 1px solid #dfe2e6;
  border-radius: 9px;
  outline: 0;
  background: #fff;
  color: #25282d;
  font-family: inherit;
  font-size: 12px;
  font-weight: 400;
  transition: border-color 0.2s, box-shadow 0.2s;
}

.payments-form-field input:focus,
.payments-form-field textarea:focus {
  border-color: #b8963b;
  box-shadow: 0 0 0 3px rgb(184 150 59 / 10%);
}

.payments-form-field textarea {
  resize: vertical;
  line-height: 1.6;
}

.payments-form-field > span {
  color: #8b9098;
  font-size: 10px;
  font-weight: 400;
  line-height: 1.6;
}

.payments-modal-actions {
  display: flex;
  justify-content: flex-end;
  gap: 9px;
  margin-top: 24px;
}

@media (max-width: 1100px) {
  .admin-payments-main {
    padding: 26px;
  }

  .payments-panel-header {
    align-items: flex-start;
    flex-direction: column;
  }

  .payments-search {
    width: 100%;
    box-sizing: border-box;
  }
}

@media (max-width: 768px) {
  .admin-payments-main {
    margin-left: 0;
    padding: 22px 15px;
  }

  .payments-header {
    align-items: flex-start;
    flex-direction: column;
    gap: 17px;
  }

  .payments-stats {
    grid-template-columns: 1fr;
  }

  .payments-stat-card {
    padding: 20px;
  }

  .payments-panel-header {
    padding: 20px 16px;
  }

  .payments-table th,
  .payments-table td {
    padding: 14px;
  }

  .payments-modal {
    padding: 25px 20px;
  }
}

@media (prefers-reduced-motion: reduce) {
  .admin-payments-main,
  .payments-spinner,
  .payments-modal-backdrop,
  .payments-modal {
    animation: none;
  }

  .payments-stat-card,
  .payments-refresh-button,
  .payments-approve-button,
  .payments-reject-button {
    transition: none;
  }
}

/* =========================================================
   ABS CUT — ADMIN PAYMENTS LAYOUT FIX
   Sidebar on the left, payment content on the right
========================================================= */

.admin-payments-page {
  display: flex;
  align-items: stretch;
  min-height: 100vh;
  width: 100%;
  background: #f5f6f8;
}

/* Keep the sidebar fixed on the left */
.admin-payments-page > aside,
.admin-payments-page > nav,
.admin-payments-page > .admin-sidebar {
  flex: 0 0 260px;
  width: 260px;
  min-width: 260px;
  min-height: 100vh;
  align-self: stretch;
}

/* Main payment content */
.admin-payments-main {
  flex: 1 1 auto;
  min-width: 0;
  width: calc(100% - 260px);
  margin-left: 0;
  padding: 38px;
  box-sizing: border-box;
  animation: payments-enter 0.45s ease both;
}

/* Keep the payment table responsive */
.payments-panel {
  width: 100%;
  min-width: 0;
}

.payments-table-wrap {
  width: 100%;
  max-width: 100%;
  overflow-x: auto;
}

/* Medium screens */
@media (max-width: 1100px) {
  .admin-payments-main {
    padding: 26px 20px;
  }
}

/* Mobile layout */
@media (max-width: 768px) {
  .admin-payments-page {
    display: block;
  }

  .admin-payments-page > aside,
  .admin-payments-page > nav,
  .admin-payments-page > .admin-sidebar {
    width: 100%;
    min-width: 0;
    min-height: auto;
  }

  .admin-payments-main {
    width: 100%;
    margin-left: 0;
    padding: 22px 15px;
  }
}


/* Payment provider filter */
.payments-provider-filter {
  display: flex;
  flex-direction: column;
  gap: 6px;
  min-width: 175px;
  color: #777c84;
  font-size: 11px;
  font-weight: 700;
}

.payments-provider-filter select {
  min-height: 43px;
  padding: 0 12px;
  border: 1px solid #e5e7eb;
  border-radius: 9px;
  background: #fafbfc;
  color: #272a2e;
  font: inherit;
  cursor: pointer;
}

.payments-provider-filter select:focus {
  outline: 2px solid rgb(184 150 59 / 25%);
  border-color: #b8963b;
}

/* Provider labels */
.payments-provider {
  display: inline-flex;
  width: fit-content;
  padding: 6px 9px;
  border-radius: 7px;
  font-size: 10px;
  font-weight: 800;
}

.payments-provider-paystack {
  background: #e9f4ff;
  color: #155ba6;
}

.payments-provider-flutterwave {
  background: #fff0e7;
  color: #a44c16;
}

.payments-provider-bank_transfer {
  background: #f3edff;
  color: #6741a5;
}

/* Payment status labels */
.payments-status-successful,
.payments-status-success,
.payments-status-paid {
  background: #e7f7ec;
  color: #237541;
}

.payments-status-pending,
.payments-status-processing,
.payments-status-awaiting_confirmation {
  background: #fff5dc;
  color: #90690b;
}

.payments-status-rejected,
.payments-status-failed {
  background: #fff0f0;
  color: #b43a3a;
}

@media (max-width: 768px) {
  .payments-provider-filter {
    width: 100%;
  }
}
 
.admin-installments-page {
  --installment-gold: #c9a227;
  --installment-ink: #171717;
  --installment-muted: #77736a;
  --installment-border: #e9e5dc;

  display: flex;
  min-height: 100vh;
  background: #f7f6f2;
  color: var(--installment-ink);
}

.admin-installments-main {
  flex: 1;
  min-width: 0;
  padding: 38px clamp(18px, 4vw, 58px);
  animation: installments-enter 0.4s ease both;
}

.installments-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24px;
  margin-bottom: 30px;
}

.installments-eyebrow {
  display: inline-block;
  color: #94751b;
  font-size: 0.72rem;
  font-weight: 800;
  letter-spacing: 0.16em;
}

.installments-header h1 {
  margin: 10px 0;
  font-size: clamp(1.8rem, 3vw, 2.6rem);
  line-height: 1.12;
  letter-spacing: -0.045em;
}

.installments-header p {
  max-width: 650px;
  margin: 0;
  color: var(--installment-muted);
  line-height: 1.7;
}

.installments-back-link {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  flex-shrink: 0;
  padding: 11px 15px;
  border: 1px solid var(--installment-border);
  border-radius: 12px;
  background: #fff;
  color: #292929;
  text-decoration: none;
  font-weight: 700;
  transition:
    border-color 0.2s ease,
    transform 0.2s ease;
}

.installments-back-link:hover {
  border-color: var(--installment-gold);
  transform: translateY(-2px);
}

.installments-panel {
  margin-bottom: 20px;
  padding: clamp(20px, 3vw, 30px);
  border: 1px solid var(--installment-border);
  border-radius: 20px;
  background: #fff;
  box-shadow: 0 8px 30px rgb(32 26 12 / 3%);
  transition:
    box-shadow 0.25s ease,
    border-color 0.25s ease;
}

.installments-panel:hover {
  border-color: #ddd1a9;
  box-shadow: 0 12px 34px rgb(32 26 12 / 6%);
}

.installments-panel-heading {
  display: flex;
  align-items: center;
  gap: 15px;
  margin-bottom: 25px;
}

.installments-heading-icon {
  display: grid;
  width: 46px;
  height: 46px;
  flex-shrink: 0;
  place-items: center;
  border-radius: 14px;
  background: #f8f1d9;
  color: #876b16;
  font-size: 1.35rem;
  font-weight: 800;
}

.installments-panel-heading h2 {
  margin: 0 0 6px;
  font-size: 1.12rem;
  letter-spacing: -0.02em;
}

.installments-panel-heading p {
  margin: 0;
  color: var(--installment-muted);
  font-size: 0.9rem;
  line-height: 1.6;
}

.installments-toggle-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 22px;
  padding-top: 20px;
  border-top: 1px solid #f0ede6;
  cursor: pointer;
}

.installments-toggle-row strong,
.installments-toggle-row small {
  display: block;
}

.installments-toggle-row strong {
  margin-bottom: 6px;
  font-size: 0.96rem;
}

.installments-toggle-row small {
  max-width: 620px;
  color: var(--installment-muted);
  line-height: 1.6;
}

.installments-toggle-row input {
  width: 21px;
  height: 21px;
  flex-shrink: 0;
  accent-color: var(--installment-gold);
  cursor: pointer;
}

.installments-form-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 23px;
}

.installments-field {
  display: flex;
  flex-direction: column;
  gap: 9px;
}

.installments-field > span {
  font-size: 0.88rem;
  font-weight: 750;
}

.installments-field input,
.installments-field select {
  width: 100%;
  min-height: 48px;
  padding: 12px 14px;
  border: 1px solid #ddd9cf;
  border-radius: 11px;
  outline: none;
  background: #fff;
  color: #222;
  font: inherit;
  transition:
    border-color 0.2s ease,
    box-shadow 0.2s ease;
}

.installments-field input:focus,
.installments-field select:focus {
  border-color: var(--installment-gold);
  box-shadow: 0 0 0 3px rgb(201 162 39 / 13%);
}

.installments-field input:disabled,
.installments-field select:disabled {
  background: #f3f2ef;
  color: #777;
  cursor: not-allowed;
}

.installments-field small {
  color: var(--installment-muted);
  font-size: 0.79rem;
  line-height: 1.5;
}

.installments-preview {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  margin-bottom: 22px;
  padding: 26px;
  overflow: hidden;
  border: 1px solid #e9dfbd;
  border-radius: 20px;
  background:
    radial-gradient(
      circle at 100% 0,
      rgb(201 162 39 / 13%),
      transparent 45%
    ),
    #fffdf7;
}

.installments-preview h3 {
  margin: 9px 0;
  font-size: 1.15rem;
}

.installments-preview p {
  max-width: 650px;
  margin: 0;
  color: #68645b;
  line-height: 1.7;
}

.installments-preview-symbol {
  display: grid;
  width: 64px;
  height: 64px;
  flex-shrink: 0;
  place-items: center;
  border-radius: 20px;
  background: #f1e5b9;
  color: #806313;
  font-size: 2rem;
  font-weight: 800;
}

.installments-form-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  padding: 10px 0 25px;
}

.installments-form-footer p {
  margin: 0;
  color: var(--installment-muted);
  font-size: 0.84rem;
  line-height: 1.6;
}

.installments-save-button {
  min-height: 48px;
  padding: 13px 22px;
  border: 0;
  border-radius: 12px;
  background: #1d1d1b;
  color: #fff;
  font: inherit;
  font-weight: 750;
  cursor: pointer;
  transition:
    background 0.2s ease,
    transform 0.2s ease,
    box-shadow 0.2s ease;
}

.installments-save-button:hover:not(:disabled) {
  transform: translateY(-2px);
  background: #38352b;
  box-shadow: 0 8px 18px rgb(0 0 0 / 12%);
}

.installments-save-button:disabled {
  cursor: wait;
  opacity: 0.65;
}

.installments-alert {
  margin-bottom: 20px;
  padding: 14px 16px;
  border: 1px solid;
  border-radius: 12px;
  line-height: 1.6;
}

.installments-alert-error {
  border-color: #edc5c5;
  background: #fff1f1;
  color: #9b2727;
}

.installments-alert-success {
  border-color: #c9e7d0;
  background: #effaf2;
  color: #246b38;
}

.installments-loading {
  display: grid;
  min-height: 260px;
  place-content: center;
  justify-items: center;
  gap: 14px;
  color: var(--installment-muted);
}

.installments-spinner {
  width: 34px;
  height: 34px;
  border: 3px solid #e7dfc8;
  border-top-color: var(--installment-gold);
  border-radius: 50%;
  animation: installments-spin 0.75s linear infinite;
}

@keyframes installments-spin {
  to {
    transform: rotate(360deg);
  }
}

@keyframes installments-enter {
  from {
    opacity: 0;
    transform: translateY(8px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@media (max-width: 760px) {
  .admin-installments-main {
    padding: 25px 16px;
  }

  .installments-header {
    flex-direction: column;
  }

  .installments-form-grid {
    grid-template-columns: 1fr;
  }

  .installments-preview {
    padding: 21px;
  }

  .installments-preview-symbol {
    width: 48px;
    height: 48px;
    border-radius: 15px;
    font-size: 1.5rem;
  }

  .installments-form-footer {
    align-items: stretch;
    flex-direction: column;
  }

  .installments-save-button {
    width: 100%;
  }
}

@media (prefers-reduced-motion: reduce) {
  .admin-installments-main,
  .installments-spinner {
    animation: none;
  }

  .installments-panel,
  .installments-back-link,
  .installments-save-button {
    transition: none;
  }
}



/* =====================================================
   ABS CUT — LUXURY FASHION HOMEPAGE
   Forest Green · Champagne Gold · Warm Ivory
===================================================== */

.abs-home {
  --abs-green: #103b2d;
  --abs-green-deep: #09271e;
  --abs-green-soft: #1a4c39;
  --abs-gold: #c9a45c;
  --abs-gold-light: #ead6a0;
  --abs-cream: #f8f5ed;
  --abs-paper: #fffdf8;
  --abs-ink: #1b2922;
  --abs-muted: #737a70;
  --abs-line: rgba(16, 59, 45, 0.13);

  overflow: hidden;
  color: var(--abs-ink);
  background: var(--abs-cream);
  font-family: inherit;
}

.abs-home *,
.abs-home *::before,
.abs-home *::after {
  box-sizing: border-box;
}

.abs-home a {
  text-decoration: none;
}

.abs-home a:focus-visible {
  outline: 3px solid var(--abs-gold);
  outline-offset: 5px;
}

.abs-home h1,
.abs-home h2,
.abs-home h3,
.abs-home p {
  margin-top: 0;
}

.abs-home h1,
.abs-home h2,
.abs-home h3 {
  text-wrap: balance;
}

.abs-home p {
  text-wrap: pretty;
}

/* =====================================================
   EYEBROW LABELS
===================================================== */

.abs-eyebrow {
  display: flex;
  align-items: center;
  gap: 12px;
  color: var(--abs-green);
  font-size: 0.68rem;
  font-weight: 800;
  letter-spacing: 0.19em;
  line-height: 1.8;
}

.abs-eyebrow-line {
  display: inline-block;
  width: 32px;
  height: 1px;
  flex: 0 0 32px;
  background: var(--abs-gold);
}

.abs-eyebrow-light {
  color: var(--abs-gold-light);
}

/* =====================================================
   HERO
===================================================== */

.abs-hero {
  position: relative;
  isolation: isolate;
  min-height: 660px;
  padding: 66px 6% 0;
  overflow: hidden;
  background:
    radial-gradient(
      ellipse at 80% 44%,
      rgba(201, 164, 92, 0.11),
      transparent 37%
    ),
    radial-gradient(
      ellipse at 8% 12%,
      rgba(255, 255, 255, 0.7),
      transparent 42%
    ),
    var(--abs-cream);
}

.abs-hero-glow {
  position: absolute;
  z-index: -1;
  top: -200px;
  right: -180px;
  width: 520px;
  height: 520px;
  border: 1px solid rgba(201, 164, 92, 0.16);
  border-radius: 50%;
  pointer-events: none;
}

.abs-hero-glow::before,
.abs-hero-glow::after {
  position: absolute;
  content: "";
  border: 1px solid rgba(201, 164, 92, 0.12);
  border-radius: 50%;
}

.abs-hero-glow::before {
  inset: 35px;
}

.abs-hero-glow::after {
  inset: 75px;
}

.abs-hero-inner {
  display: grid;
  grid-template-columns: minmax(0, 1.03fr) minmax(0, 0.97fr);
  align-items: center;
  gap: clamp(36px, 6vw, 92px);
  width: 100%;
  max-width: 1440px;
  margin: 0 auto;
}

.abs-hero-content {
  position: relative;
  z-index: 2;
  padding: 25px 0 45px;
  animation: absContentEnter 0.9s ease both;
}

.abs-hero-title {
  margin: 26px 0 15px;
  color: var(--abs-green-deep);
  font-family: Georgia, "Times New Roman", serif;
  font-size: clamp(2.8rem, 5.1vw, 5.1rem);
  font-weight: 500;
  letter-spacing: -0.065em;
  line-height: 0.98;
}

.abs-hero-title span {
  display: block;
  margin-top: 8px;
  color: var(--abs-green);
  font-weight: 700;
  letter-spacing: -0.075em;
}

.abs-hero-subtitle {
  margin-top: 22px;
  color: var(--abs-ink);
  font-family: Georgia, "Times New Roman", serif;
  font-size: clamp(1.5rem, 2.6vw, 2.5rem);
  line-height: 1.25;
}

.abs-hero-subtitle em {
  color: #99752f;
  font-weight: 400;
}

.abs-hero-description {
  max-width: 460px;
  margin: 22px 0 29px;
  color: #667168;
  font-size: 0.98rem;
  line-height: 1.95;
}

.abs-hero-actions {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 13px;
}

.abs-button {
  position: relative;
  display: inline-flex;
  min-height: 51px;
  align-items: center;
  justify-content: center;
  gap: 19px;
  padding: 0 23px;
  border: 1px solid transparent;
  border-radius: 3px;
  font-family: inherit;
  font-size: 0.67rem;
  font-weight: 800;
  letter-spacing: 0.1em;
  line-height: 1.4;
  text-align: center;
  transition:
    color 0.3s ease,
    background 0.3s ease,
    border-color 0.3s ease,
    box-shadow 0.3s ease,
    transform 0.3s ease;
}

.abs-button span:last-child {
  font-size: 1.05rem;
  transition: transform 0.3s ease;
}

.abs-button:hover {
  transform: translateY(-3px);
}

.abs-button:hover span:last-child {
  transform: translate(3px, -2px);
}

.abs-button-gold {
  color: var(--abs-green-deep);
  background: linear-gradient(
    120deg,
    var(--abs-gold-light),
    var(--abs-gold)
  );
  box-shadow: 0 8px 22px rgba(153, 117, 47, 0.14);
}

.abs-button-gold:hover {
  background: #f0dfb3;
  box-shadow: 0 13px 30px rgba(153, 117, 47, 0.23);
}

.abs-button-outline {
  border-color: rgba(16, 59, 45, 0.24);
  color: var(--abs-green);
  background: rgba(255, 253, 248, 0.55);
}

.abs-button-outline:hover {
  border-color: var(--abs-green);
  background: white;
}

.abs-hero-note {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-top: 33px;
  color: var(--abs-muted);
  font-size: 0.78rem;
  letter-spacing: 0.015em;
}

.abs-note-mark {
  color: #a9843b;
  font-size: 1.1rem;
}

/* =====================================================
   HERO IMAGE SLIDESHOW
===================================================== */

.abs-hero-visual {
  position: relative;
  justify-self: center;
  width: 100%;
  max-width: 490px;
  padding: 16px 18px 24px;
  animation: absVisualEnter 1s 0.12s ease both;
}

.abs-visual-decoration {
  position: absolute;
  z-index: -1;
  top: 0;
  right: 0;
  width: 76%;
  height: 83%;
  border: 1px solid rgba(201, 164, 92, 0.6);
  pointer-events: none;
}

.abs-visual-frame {
  position: relative;
  width: 100%;
  overflow: hidden;
  border: 1px solid rgba(201, 164, 92, 0.35);
  background: var(--abs-green-deep);
  box-shadow:
    0 26px 65px rgba(9, 39, 30, 0.18),
    0 4px 12px rgba(9, 39, 30, 0.08);
}

.abs-visual-topline,
.abs-visual-bottomline {
  position: relative;
  z-index: 3;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  padding: 16px 19px;
  color: var(--abs-gold-light);
  background: var(--abs-green-deep);
  font-size: 0.59rem;
  font-weight: 800;
  letter-spacing: 0.15em;
}

.abs-visual-topline span:last-child {
  color: rgba(255, 253, 248, 0.65);
  font-weight: 500;
}

.abs-visual-image {
  position: relative;
  height: clamp(280px, 34vw, 420px);
  overflow: hidden;
  background:
    radial-gradient(
      circle at 50% 40%,
      #28553f,
      #102f24 68%
    );
}

.abs-product-slide {
  position: absolute;
  inset: 0;
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
  animation: absProductReveal 1s ease both;
}

.abs-image-shade {
  position: absolute;
  z-index: 1;
  inset: 0;
  background:
    linear-gradient(
      to right,
      rgba(9, 39, 30, 0.12),
      transparent 22%,
      transparent 78%,
      rgba(9, 39, 30, 0.12)
    ),
    linear-gradient(
      to top,
      rgba(9, 39, 30, 0.18),
      transparent 24%
    );
  pointer-events: none;
}

.abs-visual-bottomline {
  justify-content: center;
  gap: 13px;
  padding-block: 17px;
  font-size: 0.62rem;
  letter-spacing: 0.14em;
}

.abs-visual-bottomline span + span::before {
  content: "✳";
  margin-right: 13px;
  color: var(--abs-gold);
  font-size: 0.55rem;
}

.abs-image-placeholder {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 16px;
  color: var(--abs-gold-light);
  font-size: 0.66rem;
  font-weight: 700;
  letter-spacing: 0.18em;
}

.abs-placeholder-monogram {
  color: var(--abs-gold);
  font-family: Georgia, "Times New Roman", serif;
  font-size: 5rem;
  font-weight: 400;
  letter-spacing: -0.09em;
}

.abs-image-loading {
  background: linear-gradient(
    110deg,
    #102f24 20%,
    #28553f 45%,
    #102f24 70%
  );
  background-size: 200% 100%;
  animation: absLoadingShimmer 1.6s linear infinite;
}

.abs-visual-stamp {
  position: absolute;
  z-index: 4;
  right: -7px;
  bottom: 67px;
  display: flex;
  width: 84px;
  height: 84px;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4px;
  border: 1px solid rgba(201, 164, 92, 0.75);
  border-radius: 50%;
  color: var(--abs-green-deep);
  background: var(--abs-gold-light);
  box-shadow: 0 8px 25px rgba(9, 39, 30, 0.2);
  font-size: 0.48rem;
  font-weight: 900;
  letter-spacing: 0.09em;
  animation: absStampFloat 5s ease-in-out infinite;
}

.abs-visual-stamp .abs-stamp-star {
  color: #94702e;
  font-size: 1.1rem;
}

/* =====================================================
   HERO FOOTER
===================================================== */

.abs-hero-footer {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20px;
  max-width: 1440px;
  margin: 35px auto 0;
  padding: 19px 0;
  border-top: 1px solid var(--abs-line);
  color: #727a70;
  font-size: 0.59rem;
  font-weight: 800;
  letter-spacing: 0.15em;
}

.abs-footer-line {
  width: 45px;
  height: 1px;
  background: var(--abs-gold);
}

/* =====================================================
   SERVICES
===================================================== */

.abs-services {
  padding: 105px 6% 115px;
  background:
    radial-gradient(
      ellipse at 50% 0,
      rgba(201, 164, 92, 0.08),
      transparent 42%
    ),
    var(--abs-paper);
}

.abs-section-heading {
  max-width: 760px;
  margin: 0 auto 55px;
  text-align: center;
}

.abs-section-heading .abs-eyebrow {
  justify-content: center;
}

.abs-section-heading h2 {
  margin: 22px 0 16px;
  color: var(--abs-green-deep);
  font-family: Georgia, "Times New Roman", serif;
  font-size: clamp(2.15rem, 4.2vw, 3.6rem);
  font-weight: 500;
  letter-spacing: -0.045em;
  line-height: 1.15;
}

.abs-section-heading h2 em {
  display: block;
  color: #99752f;
  font-weight: 400;
}

.abs-section-heading > p {
  max-width: 570px;
  margin: 0 auto;
  color: var(--abs-muted);
  font-size: 0.93rem;
  line-height: 1.9;
}

.abs-service-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 21px;
  max-width: 1280px;
  margin: 0 auto;
}

.abs-service-card {
  position: relative;
  display: flex;
  min-height: 350px;
  flex-direction: column;
  align-items: flex-start;
  padding: 34px 29px 29px;
  overflow: hidden;
  border: 1px solid rgba(16, 59, 45, 0.1);
  background: #fffdf8;
  box-shadow: 0 5px 20px rgba(16, 59, 45, 0.025);
  transition:
    transform 0.4s ease,
    box-shadow 0.4s ease,
    border-color 0.4s ease,
    background 0.4s ease;
}

.abs-service-card::before {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 3px;
  background: linear-gradient(
    90deg,
    var(--abs-green),
    var(--abs-gold)
  );
  content: "";
  transform: scaleX(0);
  transform-origin: left;
  transition: transform 0.4s ease;
}

.abs-service-card:hover {
  transform: translateY(-8px);
  border-color: rgba(201, 164, 92, 0.45);
  box-shadow: 0 20px 42px rgba(16, 59, 45, 0.09);
}

.abs-service-card:hover::before {
  transform: scaleX(1);
}

.abs-service-number {
  position: absolute;
  top: 25px;
  right: 27px;
  color: rgba(16, 59, 45, 0.12);
  font-family: Georgia, "Times New Roman", serif;
  font-size: 2.4rem;
  line-height: 1;
}

.abs-service-icon {
  display: grid;
  width: 53px;
  height: 53px;
  place-items: center;
  margin-bottom: 30px;
  border: 1px solid rgba(201, 164, 92, 0.42);
  border-radius: 50%;
  color: #a47e36;
  background: #fbf5e6;
  font-size: 1.45rem;
  transition:
    transform 0.35s ease,
    color 0.35s ease,
    background 0.35s ease;
}

.abs-service-card:hover .abs-service-icon {
  transform: rotate(12deg) scale(1.07);
  color: var(--abs-gold-light);
  background: var(--abs-green);
}

.abs-service-label {
  margin-bottom: 10px;
  color: #9b7a3d;
  font-size: 0.59rem;
  font-weight: 800;
  letter-spacing: 0.17em;
}

.abs-service-card h3 {
  margin-bottom: 13px;
  color: var(--abs-green-deep);
  font-family: Georgia, "Times New Roman", serif;
  font-size: 1.55rem;
  font-weight: 500;
  letter-spacing: -0.025em;
}

.abs-service-card p {
  margin-bottom: 26px;
  color: var(--abs-muted);
  font-size: 0.84rem;
  line-height: 1.85;
}

.abs-text-link {
  display: inline-flex;
  align-items: center;
  gap: 12px;
  margin-top: auto;
  color: var(--abs-green);
  font-size: 0.61rem;
  font-weight: 900;
  letter-spacing: 0.08em;
}

.abs-text-link span {
  color: #a47e36;
  font-size: 1rem;
  transition: transform 0.3s ease;
}

.abs-text-link:hover span {
  transform: translate(4px, -3px);
}

.abs-service-featured {
  border-color: rgba(201, 164, 92, 0.45);
  background:
    linear-gradient(
      155deg,
      rgba(201, 164, 92, 0.075),
      transparent 60%
    ),
    #fffdf8;
}

/* =====================================================
   CUSTOM ORDER FEATURE
===================================================== */

.abs-custom {
  position: relative;
  isolation: isolate;
  padding: 92px 6%;
  overflow: hidden;
  color: #fffdf8;
  background:
    radial-gradient(
      ellipse at 85% 40%,
      rgba(201, 164, 92, 0.14),
      transparent 36%
    ),
    linear-gradient(
      125deg,
      #09271e,
      #103b2d 60%,
      #174733
    );
}

.abs-custom-pattern {
  position: absolute;
  z-index: -1;
  top: -240px;
  right: -110px;
  width: 650px;
  height: 650px;
  border: 1px solid rgba(201, 164, 92, 0.16);
  border-radius: 50%;
}

.abs-custom-pattern::before,
.abs-custom-pattern::after {
  position: absolute;
  border: 1px solid rgba(201, 164, 92, 0.12);
  border-radius: 50%;
  content: "";
}

.abs-custom-pattern::before {
  inset: 35px;
}

.abs-custom-pattern::after {
  inset: 85px;
}

.abs-custom-inner {
  display: grid;
  grid-template-columns: minmax(0, 1.1fr) minmax(260px, 0.9fr);
  align-items: center;
  gap: 60px;
  max-width: 1250px;
  margin: 0 auto;
}

.abs-custom-copy {
  max-width: 650px;
}

.abs-custom-copy h2 {
  margin: 24px 0 20px;
  color: #fffdf8;
  font-family: Georgia, "Times New Roman", serif;
  font-size: clamp(2.4rem, 4.8vw, 4.4rem);
  font-weight: 500;
  letter-spacing: -0.055em;
  line-height: 1.08;
}

.abs-custom-copy h2 em {
  display: block;
  color: var(--abs-gold-light);
  font-weight: 400;
}

.abs-custom-copy p {
  max-width: 510px;
  margin-bottom: 29px;
  color: rgba(255, 253, 248, 0.73);
  font-size: 0.92rem;
  line-height: 1.95;
}

.abs-custom-art {
  position: relative;
  display: grid;
  width: 100%;
  max-width: 380px;
  aspect-ratio: 1;
  place-items: center;
  justify-self: center;
}

.abs-art-ring {
  position: absolute;
  border: 1px solid rgba(201, 164, 92, 0.45);
  border-radius: 50%;
}

.abs-art-ring-one {
  inset: 6%;
  animation: absRingRotate 35s linear infinite;
}

.abs-art-ring-two {
  inset: 18%;
  border-style: dashed;
  border-color: rgba(201, 164, 92, 0.34);
  animation: absRingRotate 48s linear infinite reverse;
}

.abs-art-center {
  display: flex;
  width: 48%;
  aspect-ratio: 1;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 9px;
  border: 1px solid rgba(201, 164, 92, 0.65);
  border-radius: 50%;
  background: rgba(9, 39, 30, 0.6);
  box-shadow: 0 0 50px rgba(201, 164, 92, 0.08);
}

.abs-art-center span:first-child {
  color: var(--abs-gold-light);
  font-family: Georgia, "Times New Roman", serif;
  font-size: clamp(3rem, 6vw, 5rem);
  letter-spacing: -0.1em;
}

.abs-art-center span:last-child {
  color: rgba(255, 253, 248, 0.72);
  font-size: 0.54rem;
  font-weight: 800;
  letter-spacing: 0.17em;
}

.abs-art-star {
  position: absolute;
  color: var(--abs-gold-light);
}

.abs-art-star-one {
  top: 11%;
  right: 21%;
  font-size: 1.7rem;
}

.abs-art-star-two {
  bottom: 17%;
  left: 12%;
  font-size: 2rem;
}

/* =====================================================
   AI / FASHION PREVIEW
===================================================== */

.abs-ai {
  padding: 72px 6%;
  background: #f0ecdf;
}

.abs-ai-inner {
  display: grid;
  grid-template-columns: auto minmax(0, 1fr) auto;
  align-items: center;
  gap: 35px;
  max-width: 1250px;
  margin: 0 auto;
}

.abs-ai-symbol {
  display: grid;
  width: 85px;
  height: 85px;
  flex: 0 0 85px;
  place-items: center;
  border: 1px solid rgba(201, 164, 92, 0.65);
  border-radius: 50%;
  color: #a47e36;
  background: rgba(255, 253, 248, 0.55);
  font-size: 2.2rem;
}

.abs-ai-copy h2 {
  margin: 13px 0 10px;
  color: var(--abs-green-deep);
  font-family: Georgia, "Times New Roman", serif;
  font-size: clamp(1.9rem, 3.4vw, 3rem);
  font-weight: 500;
  letter-spacing: -0.04em;
}

.abs-ai-copy h2 em {
  color: #99752f;
  font-weight: 400;
}

.abs-ai-copy p {
  max-width: 650px;
  margin-bottom: 0;
  color: var(--abs-muted);
  font-size: 0.86rem;
  line-height: 1.8;
}

.abs-button-dark {
  color: #fffdf8;
  background: var(--abs-green);
}

.abs-button-dark:hover {
  background: var(--abs-green-deep);
  box-shadow: 0 10px 24px rgba(9, 39, 30, 0.18);
}

/* =====================================================
   BRAND STRIP
===================================================== */

.abs-brand-strip {
  display: flex;
  min-height: 67px;
  align-items: center;
  justify-content: center;
  flex-wrap: wrap;
  gap: clamp(12px, 3vw, 35px);
  padding: 20px 5%;
  color: rgba(255, 253, 248, 0.8);
  background: var(--abs-green-deep);
  font-size: 0.61rem;
  font-weight: 800;
  letter-spacing: 0.17em;
  text-align: center;
}

.abs-brand-strip > span:first-child {
  color: var(--abs-gold-light);
  font-family: Georgia, "Times New Roman", serif;
  font-size: 1rem;
  letter-spacing: 0.1em;
}

.abs-brand-strip-star {
  color: var(--abs-gold);
  font-size: 0.8rem;
}

/* =====================================================
   ANIMATIONS
===================================================== */

@keyframes absContentEnter {
  from {
    opacity: 0;
    transform: translateY(25px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes absVisualEnter {
  from {
    opacity: 0;
    transform: translateY(22px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes absProductReveal {
  from {
    opacity: 0;
    transform: scale(1.045);
  }

  to {
    opacity: 1;
    transform: scale(1);
  }
}

@keyframes absStampFloat {
  0%, 100% {
    transform: translateY(0) rotate(5deg);
  }

  50% {
    transform: translateY(-8px) rotate(0deg);
  }
}

@keyframes absLoadingShimmer {
  to {
    background-position: -200% 0;
  }
}

@keyframes absRingRotate {
  to {
    transform: rotate(360deg);
  }
}

/* =====================================================
   RESPONSIVE — TABLETS
===================================================== */

@media (max-width: 1000px) {
  .abs-hero {
    padding-inline: 5%;
  }

  .abs-hero-inner {
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.9fr);
    gap: 28px;
  }

  .abs-hero-title {
    font-size: clamp(2.7rem, 5.3vw, 4rem);
  }

  .abs-hero-visual {
    max-width: 410px;
    padding-inline: 12px;
  }

  .abs-visual-image {
    height: clamp(280px, 38vw, 370px);
  }

  .abs-service-card {
    padding-inline: 22px;
  }

  .abs-custom-inner {
    gap: 30px;
  }

  .abs-ai-inner {
    grid-template-columns: auto minmax(0, 1fr);
  }

  .abs-ai-inner > .abs-button {
    grid-column: 2;
    justify-self: start;
  }
}

/* =====================================================
   RESPONSIVE — MOBILE
===================================================== */

@media (max-width: 700px) {
  .abs-hero {
    padding: 48px 6% 0;
  }

  .abs-hero-inner {
    grid-template-columns: minmax(0, 1fr);
    gap: 35px;
  }

  .abs-hero-content {
    padding: 0;
  }

  .abs-eyebrow {
    font-size: 0.59rem;
    letter-spacing: 0.13em;
  }

  .abs-eyebrow-line {
    width: 24px;
    flex-basis: 24px;
  }

  .abs-hero-title {
    margin-top: 22px;
    font-size: clamp(3rem, 11vw, 4.4rem);
  }

  .abs-hero-subtitle {
    font-size: clamp(1.65rem, 6vw, 2.2rem);
  }

  .abs-hero-description {
    font-size: 0.9rem;
  }

  .abs-hero-actions {
    align-items: stretch;
  }

  .abs-button {
    min-height: 49px;
    padding-inline: 16px;
    font-size: 0.61rem;
  }

  .abs-hero-note {
    margin-top: 24px;
    font-size: 0.71rem;
  }

  .abs-hero-visual {
    width: 100%;
    max-width: 440px;
    padding: 12px 10px 19px;
  }

  .abs-visual-image {
    height: clamp(300px, 105vw, 440px);
  }

  .abs-visual-stamp {
    right: -2px;
    bottom: 58px;
    width: 73px;
    height: 73px;
  }

  .abs-hero-footer {
    gap: 12px;
    margin-top: 25px;
    padding-block: 17px;
    font-size: 0.49rem;
    letter-spacing: 0.09em;
  }

  .abs-footer-line {
    width: 22px;
  }

  .abs-services {
    padding: 76px 6% 80px;
  }

  .abs-section-heading {
    margin-bottom: 35px;
  }

  .abs-section-heading h2 {
    font-size: clamp(2.1rem, 8vw, 3rem);
  }

  .abs-section-heading > p {
    font-size: 0.86rem;
  }

  .abs-service-grid {
    grid-template-columns: minmax(0, 1fr);
    gap: 15px;
  }

  .abs-service-card {
    min-height: 300px;
    padding: 28px 25px;
  }

  .abs-service-icon {
    margin-bottom: 23px;
  }

  .abs-custom {
    padding: 72px 6%;
  }

  .abs-custom-inner {
    grid-template-columns: minmax(0, 1fr);
    gap: 25px;
  }

  .abs-custom-copy h2 {
    font-size: clamp(2.5rem, 9vw, 3.7rem);
  }

  .abs-custom-copy p {
    font-size: 0.88rem;
  }

  .abs-custom-art {
    max-width: 300px;
  }

  .abs-ai {
    padding: 58px 6%;
  }

  .abs-ai-inner {
    grid-template-columns: minmax(0, 1fr);
    gap: 20px;
  }

  .abs-ai-symbol {
    width: 65px;
    height: 65px;
    min-width: 65px;
    font-size: 1.8rem;
  }

  .abs-ai-copy h2 {
    font-size: clamp(2rem, 8vw, 2.8rem);
    line-height: 1.2;
  }

  .abs-ai-inner > .abs-button {
    grid-column: auto;
    justify-self: start;
  }

  .abs-brand-strip {
    gap: 12px;
    font-size: 0.48rem;
    letter-spacing: 0.1em;
  }
}

/* =====================================================
   ACCESSIBILITY
===================================================== */

@media (prefers-reduced-motion: reduce) {
  .abs-home *,
  .abs-home *::before,
  .abs-home *::after {
    scroll-behavior: auto !important;
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
  }
}


/* =========================================
   ABS CUT — CONTACT PAGE
========================================= */

.contact-page {
  --contact-green: #0b3d2e;
  --contact-deep: #10251d;
  --contact-gold: #c9a227;
  --contact-cream: #f8f5ed;
  --contact-muted: #68746c;

  min-height: 100vh;
  padding: 65px 6% 100px;
  color: var(--contact-deep);
  background:
    radial-gradient(circle at 5% 5%, rgba(201, 162, 39, 0.09), transparent 27%),
    radial-gradient(circle at 95% 40%, rgba(11, 61, 46, 0.06), transparent 30%),
    var(--contact-cream);
}

.contact-header {
  max-width: 820px;
  margin: 0 auto 55px;
  text-align: center;
  animation: contactEnter 0.7s ease both;
}

.contact-eyebrow {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12px;
  color: #8b702a;
  font-size: 0.7rem;
  font-weight: 800;
  letter-spacing: 0.2em;
}

.contact-eyebrow-line {
  width: 30px;
  height: 1px;
  background: var(--contact-gold);
}

.contact-header h1 {
  margin: 22px 0 16px;
  font-family: Georgia, "Times New Roman", serif;
  font-size: clamp(2.6rem, 5.5vw, 4.5rem);
  font-weight: 500;
  letter-spacing: -0.055em;
  line-height: 1.1;
}

.contact-header h1 em {
  color: #967426;
  font-weight: 400;
}

.contact-header > p {
  max-width: 610px;
  margin: 0 auto;
  color: var(--contact-muted);
  font-size: 0.96rem;
  line-height: 1.9;
}

.contact-content {
  display: grid;
  grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
  align-items: start;
  gap: 30px;
  max-width: 1200px;
  margin: 0 auto;
}

.contact-information {
  overflow: hidden;
  padding: 35px;
  border-radius: 5px;
  color: #fffdf7;
  background:
    radial-gradient(circle at 100% 0%, rgba(201, 162, 39, 0.16), transparent 35%),
    linear-gradient(145deg, #103e2e, #09291f);
  box-shadow: 0 20px 50px rgba(16, 37, 29, 0.13);
  animation: contactEnter 0.8s 0.08s ease both;
}

.contact-info-card {
  padding-bottom: 27px;
  border-bottom: 1px solid rgba(255, 255, 255, 0.14);
}

.contact-small-label {
  display: block;
  margin-bottom: 13px;
  color: var(--contact-gold);
  font-size: 0.66rem;
  font-weight: 800;
  letter-spacing: 0.17em;
}

.contact-info-card h2 {
  margin: 0 0 16px;
  font-family: Georgia, "Times New Roman", serif;
  font-size: clamp(1.8rem, 3vw, 2.55rem);
  font-weight: 500;
  line-height: 1.2;
}

.contact-info-card p,
.contact-detail p {
  margin: 0;
  color: rgba(255, 253, 247, 0.73);
  font-size: 0.85rem;
  line-height: 1.9;
}

.contact-detail {
  display: flex;
  align-items: flex-start;
  gap: 17px;
  padding: 24px 0;
  border-bottom: 1px solid rgba(255, 255, 255, 0.12);
}

.contact-detail-icon {
  display: grid;
  width: 42px;
  height: 42px;
  flex: 0 0 42px;
  place-items: center;
  border: 1px solid rgba(201, 162, 39, 0.4);
  border-radius: 50%;
  color: var(--contact-gold);
  background: rgba(255, 255, 255, 0.04);
  font-size: 1.15rem;
  transition: color 0.3s ease, background 0.3s ease;
}

.contact-detail:hover .contact-detail-icon {
  color: var(--contact-deep);
  background: var(--contact-gold);
}

.contact-detail > div {
  display: flex;
  min-width: 0;
  flex-direction: column;
  gap: 7px;
}

.contact-detail-label {
  margin-bottom: 3px;
  color: var(--contact-gold);
  font-size: 0.63rem;
  font-weight: 800;
  letter-spacing: 0.15em;
}

.contact-detail a {
  width: fit-content;
  color: #fffdf7;
  font-size: 0.87rem;
  text-decoration: none;
  overflow-wrap: anywhere;
  transition: color 0.25s ease;
}

.contact-detail a:hover {
  color: var(--contact-gold);
}

.contact-services {
  padding-top: 27px;
}

.contact-services > div {
  display: flex;
  flex-wrap: wrap;
  gap: 9px;
}

.contact-services > div span {
  padding: 9px 12px;
  border: 1px solid rgba(255, 255, 255, 0.15);
  border-radius: 3px;
  color: rgba(255, 253, 247, 0.85);
  font-size: 0.71rem;
  transition: border-color 0.25s ease, background 0.25s ease;
}

.contact-services > div span:hover {
  border-color: var(--contact-gold);
  background: rgba(201, 162, 39, 0.08);
}

.contact-form-card {
  padding: clamp(25px, 4vw, 43px);
  border: 1px solid rgba(11, 61, 46, 0.1);
  border-radius: 5px;
  background: #fffefa;
  box-shadow: 0 20px 55px rgba(16, 37, 29, 0.065);
  animation: contactEnter 0.8s 0.18s ease both;
}

.contact-form-header {
  margin-bottom: 30px;
}

.contact-form-header h2 {
  margin: 0 0 10px;
  font-family: Georgia, "Times New Roman", serif;
  font-size: clamp(1.8rem, 3vw, 2.5rem);
  font-weight: 500;
  letter-spacing: -0.04em;
}

.contact-form-header p {
  margin: 0;
  color: var(--contact-muted);
  font-size: 0.85rem;
  line-height: 1.8;
}

.contact-form-row {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18px;
}

.contact-form-group {
  display: flex;
  min-width: 0;
  flex-direction: column;
  gap: 9px;
  margin-bottom: 21px;
}

.contact-form-group label {
  color: var(--contact-deep);
  font-size: 0.77rem;
  font-weight: 750;
}

.contact-form-group input,
.contact-form-group select,
.contact-form-group textarea {
  width: 100%;
  min-width: 0;
  padding: 14px 15px;
  border: 1px solid #e0e2d9;
  border-radius: 3px;
  outline: none;
  color: var(--contact-deep);
  background: #fdfcf8;
  font: inherit;
  font-size: 0.84rem;
  transition:
    border-color 0.25s ease,
    box-shadow 0.25s ease,
    background 0.25s ease;
}

.contact-form-group input,
.contact-form-group select {
  min-height: 49px;
}

.contact-form-group textarea {
  min-height: 145px;
  resize: vertical;
  line-height: 1.7;
}

.contact-form-group input::placeholder,
.contact-form-group textarea::placeholder {
  color: #9aa097;
}

.contact-form-group input:focus,
.contact-form-group select:focus,
.contact-form-group textarea:focus {
  border-color: var(--contact-gold);
  background: #fff;
  box-shadow: 0 0 0 3px rgba(201, 162, 39, 0.12);
}

.contact-form-group input:disabled,
.contact-form-group select:disabled,
.contact-form-group textarea:disabled {
  cursor: not-allowed;
  opacity: 0.7;
}

.contact-message-label-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
}

.contact-message-label-row > span {
  color: var(--contact-muted);
  font-size: 0.7rem;
}

.contact-submit-button {
  display: flex;
  width: 100%;
  min-height: 54px;
  align-items: center;
  justify-content: space-between;
  gap: 15px;
  padding: 0 21px;
  border: 1px solid var(--contact-green);
  border-radius: 3px;
  color: #fffdf7;
  background: var(--contact-green);
  cursor: pointer;
  font: inherit;
  font-size: 0.7rem;
  font-weight: 800;
  letter-spacing: 0.12em;
  transition:
    background 0.3s ease,
    border-color 0.3s ease,
    box-shadow 0.3s ease,
    transform 0.3s ease;
}

.contact-submit-button > span:last-child {
  color: var(--contact-gold);
  font-size: 1.2rem;
  transition: transform 0.3s ease;
}

.contact-submit-button:hover:not(:disabled) {
  transform: translateY(-2px);
  border-color: #174f3b;
  background: #174f3b;
  box-shadow: 0 10px 24px rgba(11, 61, 46, 0.15);
}

.contact-submit-button:hover:not(:disabled) > span:last-child {
  transform: translate(3px, -2px);
}

.contact-submit-button:disabled {
  cursor: wait;
  opacity: 0.7;
}

.contact-feedback {
  display: flex;
  flex-direction: column;
  gap: 6px;
  margin-top: 20px;
  padding: 16px;
  border: 1px solid transparent;
  border-radius: 3px;
  animation: contactEnter 0.3s ease both;
}

.contact-feedback strong {
  font-size: 0.86rem;
}

.contact-feedback span {
  font-size: 0.82rem;
  line-height: 1.7;
}

.contact-feedback-success {
  border-color: #b7d8bd;
  color: #174c2d;
  background: #eff8f0;
}

.contact-feedback-error {
  border-color: #e7bdb5;
  color: #852c21;
  background: #fff2ef;
}

@keyframes contactEnter {
  from {
    opacity: 0;
    transform: translateY(16px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@media (max-width: 900px) {
  .contact-content {
    grid-template-columns: minmax(0, 1fr);
    max-width: 680px;
  }

  .contact-information {
    padding: 30px;
  }
}

@media (max-width: 520px) {
  .contact-page {
    padding: 45px 5% 65px;
  }

  .contact-header {
    margin-bottom: 35px;
  }

  .contact-header h1 {
    font-size: 2.65rem;
  }

  .contact-form-row {
    grid-template-columns: minmax(0, 1fr);
    gap: 0;
  }

  .contact-information {
    padding: 25px 22px;
  }

  .contact-form-card {
    padding: 24px 19px;
  }
}

@media (prefers-reduced-motion: reduce) {
  .contact-page *,
  .contact-page *::before,
  .contact-page *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
  }
}



/* =====================================================
   ABS CUT — CUSTOMER CHAT
===================================================== */

.abs-chat-page {
  --chat-green: #0b3d2e;
  --chat-green-dark: #10251d;
  --chat-gold: #c9a227;
  --chat-cream: #f8f5ed;
  --chat-text: #1e2924;
  --chat-muted: #66736d;
  --chat-border: #dedbd2;

  min-height: 80vh;
  padding: 48px 20px;
  display: flex;
  justify-content: center;
  align-items: center;
  background:
    radial-gradient(
      circle at 10% 10%,
      rgba(201, 162, 39, 0.12),
      transparent 32%
    ),
    radial-gradient(
      circle at 90% 90%,
      rgba(11, 61, 46, 0.1),
      transparent 35%
    ),
    var(--chat-cream);
  color: var(--chat-text);
  animation: absChatPageEnter 0.55s ease both;
}

.abs-chat-card {
  width: 100%;
  max-width: 850px;
  min-height: 650px;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  border: 1px solid rgba(201, 162, 39, 0.24);
  border-radius: 24px;
  background: #fff;
  box-shadow:
    0 24px 65px rgba(16, 37, 29, 0.1),
    0 5px 16px rgba(16, 37, 29, 0.04);
  animation: absChatCardEnter 0.65s ease both;
}

/* Header */

.abs-chat-header {
  display: flex;
  align-items: center;
  gap: 16px;
  padding: 26px 28px;
  color: #fff;
  background:
    radial-gradient(
      circle at 90% 0%,
      rgba(201, 162, 39, 0.2),
      transparent 38%
    ),
    linear-gradient(125deg, #10251d, #0b3d2e);
}

.abs-chat-brand-icon {
  width: 58px;
  height: 58px;
  flex-shrink: 0;
  display: grid;
  place-items: center;
  border: 1px solid rgba(201, 162, 39, 0.8);
  border-radius: 17px;
  color: var(--chat-gold);
  background: rgba(255, 255, 255, 0.07);
  font-size: 18px;
  font-weight: 800;
  letter-spacing: 1px;
  transition: transform 0.3s ease, background 0.3s ease;
}

.abs-chat-brand-icon:hover {
  transform: rotate(-5deg) scale(1.05);
  background: rgba(255, 255, 255, 0.12);
}

.abs-chat-heading {
  min-width: 0;
  flex: 1;
}

.abs-chat-eyebrow {
  display: block;
  margin-bottom: 5px;
  color: var(--chat-gold);
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 2px;
}

.abs-chat-heading h2 {
  margin: 0 0 5px;
  font-size: clamp(22px, 4vw, 29px);
  font-weight: 750;
  letter-spacing: -0.6px;
}

.abs-chat-heading p {
  max-width: 470px;
  margin: 0;
  color: rgba(255, 255, 255, 0.76);
  font-size: 12px;
  line-height: 1.7;
}

.abs-chat-status {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  flex-shrink: 0;
  padding: 8px 11px;
  border: 1px solid rgba(255, 255, 255, 0.15);
  border-radius: 30px;
  color: rgba(255, 255, 255, 0.8);
  background: rgba(255, 255, 255, 0.06);
  font-size: 10px;
}

.abs-chat-status > span {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: #e5ad58;
  animation: absChatPulse 1.7s ease-in-out infinite;
}

.abs-chat-status.is-connected > span {
  background: #70d9a3;
}

/* Welcome notice */

.abs-chat-notice {
  display: flex;
  align-items: flex-start;
  gap: 11px;
  margin: 20px 24px 0;
  padding: 14px 16px;
  border: 1px solid rgba(201, 162, 39, 0.22);
  border-radius: 13px;
  background: linear-gradient(
    110deg,
    rgba(201, 162, 39, 0.1),
    rgba(248, 245, 237, 0.65)
  );
}

.abs-chat-notice-icon {
  color: #a78316;
  font-size: 19px;
}

.abs-chat-notice p {
  margin: 0;
  color: #48564e;
  font-size: 12px;
  line-height: 1.7;
}

/* Message history */

.abs-chat-messages {
  flex: 1;
  min-height: 300px;
  max-height: 480px;
  overflow-y: auto;
  overscroll-behavior: contain;
  padding: 25px 24px;
  background:
    radial-gradient(
      circle at 0% 100%,
      rgba(201, 162, 39, 0.035),
      transparent 40%
    ),
    #fff;
  scrollbar-width: thin;
  scrollbar-color: #c9c1aa transparent;
}

.abs-chat-messages::-webkit-scrollbar {
  width: 6px;
}

.abs-chat-messages::-webkit-scrollbar-thumb {
  border-radius: 10px;
  background: #c9c1aa;
}

.abs-chat-message-row {
  display: flex;
  margin-bottom: 17px;
  animation: absChatMessageEnter 0.28s ease both;
}

.abs-chat-message-row.is-customer {
  justify-content: flex-end;
}

.abs-chat-message-row.is-admin {
  justify-content: flex-start;
}

.abs-chat-message {
  max-width: min(80%, 510px);
  padding: 12px 15px 9px;
  border-radius: 17px;
  overflow-wrap: anywhere;
  box-shadow: 0 3px 10px rgba(16, 37, 29, 0.045);
}

.is-customer .abs-chat-message {
  border: 1px solid rgba(201, 162, 39, 0.5);
  border-bottom-right-radius: 5px;
  color: #fff;
  background: linear-gradient(135deg, #0b3d2e, #174d3b);
}

.is-admin .abs-chat-message {
  border: 1px solid #e7e3d9;
  border-bottom-left-radius: 5px;
  color: var(--chat-text);
  background: #f8f6f0;
}

.abs-chat-sender {
  display: block;
  margin-bottom: 7px;
  color: #997718;
  font-size: 11px;
  font-weight: 800;
}

.abs-chat-message p {
  margin: 0;
  font-size: 13px;
  line-height: 1.7;
  white-space: pre-wrap;
}

.abs-chat-message time {
  display: block;
  margin-top: 7px;
  text-align: right;
  font-size: 9px;
  opacity: 0.72;
}

/* Empty conversation */

.abs-chat-empty {
  min-height: 270px;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  text-align: center;
}

.abs-chat-empty-icon {
  width: 58px;
  height: 58px;
  display: grid;
  place-items: center;
  margin-bottom: 15px;
  border: 1px solid rgba(201, 162, 39, 0.4);
  border-radius: 20px;
  color: #a78316;
  background: var(--chat-cream);
  font-size: 25px;
  animation: absChatFloat 2.5s ease-in-out infinite;
}

.abs-chat-empty h3 {
  margin: 0 0 7px;
  color: var(--chat-green);
  font-size: 17px;
}

.abs-chat-empty p {
  margin: 0;
  color: var(--chat-muted);
  font-size: 12px;
}

/* Composer */

.abs-chat-composer {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  gap: 10px;
  padding: 19px 24px 14px;
  border-top: 1px solid var(--chat-border);
  background: #fff;
}

.abs-chat-composer textarea {
  width: 100%;
  min-height: 52px;
  max-height: 130px;
  resize: vertical;
  padding: 15px;
  border: 1px solid var(--chat-border);
  border-radius: 13px;
  outline: none;
  color: var(--chat-text);
  background: #fdfcf9;
  font: inherit;
  font-size: 13px;
  line-height: 1.6;
  transition:
    border-color 0.25s ease,
    box-shadow 0.25s ease,
    background 0.25s ease;
}

.abs-chat-composer textarea:focus {
  border-color: var(--chat-gold);
  background: #fff;
  box-shadow: 0 0 0 4px rgba(201, 162, 39, 0.12);
}

.abs-chat-composer textarea:disabled {
  opacity: 0.7;
}

.abs-chat-composer button {
  min-width: 100px;
  align-self: start;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 9px;
  padding: 15px 17px;
  border: 1px solid var(--chat-gold);
  border-radius: 12px;
  color: var(--chat-green-dark);
  background: linear-gradient(135deg, #dfbd55, #c9a227);
  font-size: 12px;
  font-weight: 800;
  cursor: pointer;
  transition:
    transform 0.22s ease,
    box-shadow 0.22s ease,
    filter 0.22s ease;
}

.abs-chat-composer button:hover:not(:disabled) {
  transform: translateY(-2px);
  box-shadow: 0 7px 17px rgba(201, 162, 39, 0.26);
  filter: brightness(1.04);
}

.abs-chat-composer button:active:not(:disabled) {
  transform: scale(0.97);
}

.abs-chat-composer button:disabled {
  opacity: 0.55;
  cursor: not-allowed;
}

.abs-chat-composer button span {
  font-size: 16px;
}

.abs-chat-composer small {
  grid-column: 1 / -1;
  color: var(--chat-muted);
  font-size: 10px;
}

/* Errors, loading and closed state */

.abs-chat-inline-error,
.abs-chat-error {
  margin: 12px 24px;
  padding: 12px 14px;
  border: 1px solid #efc5bd;
  border-radius: 10px;
  color: #8d3428;
  background: #fff5f3;
  font-size: 12px;
  line-height: 1.6;
}

.abs-chat-loading,
.abs-chat-error {
  max-width: 480px;
  margin: 0 auto;
  text-align: center;
}

.abs-chat-loading {
  padding: 50px 20px;
  color: var(--chat-green);
}

.abs-chat-loading p {
  font-size: 13px;
}

.abs-chat-spinner {
  display: inline-block;
  width: 34px;
  height: 34px;
  border: 3px solid #e7e0cc;
  border-top-color: var(--chat-gold);
  border-right-color: var(--chat-green);
  border-radius: 50%;
  animation: absChatSpin 0.8s linear infinite;
}

.abs-chat-error button {
  margin-top: 12px;
  padding: 11px 17px;
  border: 0;
  border-radius: 9px;
  color: #fff;
  background: var(--chat-green);
  cursor: pointer;
}

.abs-chat-closed {
  padding: 20px 24px;
  color: var(--chat-muted);
  background: #f8f6f0;
  text-align: center;
  font-size: 12px;
  line-height: 1.6;
}

.abs-chat-footer {
  padding: 12px;
  border-top: 1px solid #f0ede5;
  color: #879087;
  background: #fff;
  text-align: center;
  font-size: 10px;
  letter-spacing: 0.4px;
}

/* Animations */

@keyframes absChatPageEnter {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

@keyframes absChatCardEnter {
  from {
    opacity: 0;
    transform: translateY(15px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes absChatMessageEnter {
  from {
    opacity: 0;
    transform: translateY(7px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes absChatPulse {
  50% {
    opacity: 0.5;
    transform: scale(0.8);
  }
}

@keyframes absChatFloat {
  50% {
    transform: translateY(-5px);
  }
}

@keyframes absChatSpin {
  to {
    transform: rotate(360deg);
  }
}

/* Responsive layout */

@media (max-width: 600px) {
  .abs-chat-page {
    min-height: 75vh;
    padding: 16px 10px;
    align-items: stretch;
  }

  .abs-chat-card {
    min-height: 580px;
    border-radius: 17px;
  }

  .abs-chat-header {
    flex-wrap: wrap;
    gap: 12px;
    padding: 20px 16px;
  }

  .abs-chat-brand-icon {
    width: 47px;
    height: 47px;
    border-radius: 13px;
  }

  .abs-chat-heading {
    flex-basis: calc(100% - 65px);
  }

  .abs-chat-heading p {
    font-size: 11px;
  }

  .abs-chat-status {
    margin-left: 59px;
    padding: 6px 9px;
  }

  .abs-chat-notice {
    margin: 14px 12px 0;
    padding: 12px;
  }

  .abs-chat-messages {
    min-height: 300px;
    padding: 19px 13px;
  }

  .abs-chat-message {
    max-width: 88%;
    padding: 11px 12px 8px;
  }

  .abs-chat-composer {
    gap: 8px;
    padding: 14px 12px 12px;
  }

  .abs-chat-composer textarea {
    min-height: 48px;
    padding: 12px;
  }

  .abs-chat-composer button {
    min-width: 76px;
    gap: 5px;
    padding: 14px 10px;
  }
}

@media (prefers-reduced-motion: reduce) {
  .abs-chat-page,
  .abs-chat-card,
  .abs-chat-message-row,
  .abs-chat-spinner,
  .abs-chat-status > span,
  .abs-chat-empty-icon {
    animation: none !important;
  }

  .abs-chat-brand-icon,
  .abs-chat-composer textarea,
  .abs-chat-composer button {
    transition: none !important;
  }
}


/* =====================================================
   ABS CUT — FLOATING CHAT WIDGET
===================================================== */

.abs-chat-widget {
  --widget-green: #0b3d2e;
  --widget-dark: #10251d;
  --widget-gold: #c9a227;

  position: fixed;
  right: 26px;
  bottom: 24px;
  z-index: 9999;
  font-family: inherit;
}

/* Floating launcher */

.abs-chat-launcher {
  position: relative;
  width: 62px;
  height: 62px;
  display: grid;
  place-items: center;
  margin-left: auto;
  border: 2px solid rgba(201, 162, 39, 0.85);
  border-radius: 50%;
  color: #fff;
  background: linear-gradient(
    145deg,
    var(--widget-green),
    var(--widget-dark)
  );
  box-shadow:
    0 8px 25px rgba(11, 61, 46, 0.28),
    0 0 0 5px rgba(201, 162, 39, 0.09);
  cursor: pointer;
  transition:
    transform 0.3s ease,
    background 0.3s ease,
    box-shadow 0.3s ease;
  animation: absChatLauncherEnter 0.6s ease both;
}

.abs-chat-launcher:hover {
  transform: translateY(-4px) scale(1.05);
  box-shadow:
    0 13px 30px rgba(11, 61, 46, 0.32),
    0 0 0 7px rgba(201, 162, 39, 0.12);
}

.abs-chat-launcher:active {
  transform: scale(0.95);
}

.abs-chat-launcher.is-open {
  color: var(--widget-dark);
  background: linear-gradient(145deg, #e6c65f, var(--widget-gold));
}

.abs-chat-launcher:focus-visible,
.abs-chat-popup-close:focus-visible {
  outline: 3px solid #e6c65f;
  outline-offset: 4px;
}

/* Popup panel */

.abs-chat-popup {
  position: absolute;
  right: 0;
  bottom: 80px;
  width: min(400px, calc(100vw - 32px));
  height: min(620px, calc(100dvh - 125px));
  min-height: 360px;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  border: 1px solid rgba(201, 162, 39, 0.45);
  border-radius: 21px;
  background: #fff;
  box-shadow:
    0 24px 70px rgba(16, 37, 29, 0.25),
    0 5px 18px rgba(16, 37, 29, 0.1);
  transform-origin: bottom right;
  animation: absChatPopupEnter 0.28s cubic-bezier(0.2, 0.8, 0.2, 1) both;
}

/* Popup topbar */

.abs-chat-popup-topbar {
  position: relative;
  z-index: 2;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding: 16px 18px;
  color: #fff;
  background:
    radial-gradient(
      circle at 85% 0,
      rgba(201, 162, 39, 0.24),
      transparent 45%
    ),
    linear-gradient(125deg, #10251d, #0b3d2e);
}

.abs-chat-popup-brand {
  display: flex;
  align-items: center;
  gap: 11px;
}

.abs-chat-popup-logo {
  width: 42px;
  height: 42px;
  display: grid;
  place-items: center;
  border: 1px solid var(--widget-gold);
  border-radius: 12px;
  color: var(--widget-gold);
  background: rgba(255, 255, 255, 0.07);
  font-size: 13px;
  font-weight: 850;
  letter-spacing: 0.5px;
}

.abs-chat-popup-brand h3 {
  margin: 0 0 4px;
  font-size: 14px;
  font-weight: 750;
}

.abs-chat-popup-brand p {
  margin: 0;
  color: rgba(255, 255, 255, 0.75);
  font-size: 11px;
}

.abs-chat-popup-close {
  width: 35px;
  height: 35px;
  display: grid;
  flex-shrink: 0;
  place-items: center;
  border: 1px solid rgba(255, 255, 255, 0.17);
  border-radius: 10px;
  color: #fff;
  background: rgba(255, 255, 255, 0.07);
  cursor: pointer;
  transition:
    transform 0.25s ease,
    background 0.25s ease;
}

.abs-chat-popup-close:hover {
  transform: rotate(90deg);
  background: rgba(255, 255, 255, 0.16);
}

/* Fit the existing customer chat inside the popup */

.abs-chat-popup-content {
  min-height: 0;
  flex: 1;
  display: flex;
  overflow: hidden;
}

.abs-chat-popup-content .abs-chat-page {
  width: 100%;
  min-height: 0;
  height: 100%;
  padding: 0;
  display: flex;
  align-items: stretch;
  background: #fff;
  animation: none;
}

.abs-chat-popup-content .abs-chat-card {
  width: 100%;
  max-width: none;
  min-height: 0;
  height: 100%;
  border: 0;
  border-radius: 0;
  box-shadow: none;
  animation: none;
}

.abs-chat-popup-content .abs-chat-header {
  display: none;
}

.abs-chat-popup-content .abs-chat-notice {
  margin: 12px 12px 0;
  padding: 10px 12px;
}

.abs-chat-popup-content .abs-chat-notice p {
  font-size: 11px;
}

.abs-chat-popup-content .abs-chat-messages {
  flex: 1;
  min-height: 0;
  max-height: none;
  padding: 17px 12px;
}

.abs-chat-popup-content .abs-chat-message {
  max-width: 90%;
}

.abs-chat-popup-content .abs-chat-composer {
  flex-shrink: 0;
  grid-template-columns: minmax(0, 1fr) auto;
  gap: 7px;
  padding: 12px 10px 10px;
}

.abs-chat-popup-content .abs-chat-composer textarea {
  min-width: 0;
  min-height: 44px;
  max-height: 95px;
  padding: 10px;
  font-size: 12px;
}

.abs-chat-popup-content .abs-chat-composer button {
  min-width: 67px;
  gap: 4px;
  padding: 12px 9px;
  font-size: 11px;
}

.abs-chat-popup-content .abs-chat-composer small {
  font-size: 9px;
}

.abs-chat-popup-content .abs-chat-footer {
  display: none;
}

.abs-chat-popup-content .abs-chat-empty {
  min-height: 170px;
}

/* Motion */

@keyframes absChatPopupEnter {
  from {
    opacity: 0;
    transform: translateY(12px) scale(0.96);
  }

  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

@keyframes absChatLauncherEnter {
  from {
    opacity: 0;
    transform: translateY(12px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* Mobile */

@media (max-width: 480px) {
  .abs-chat-widget {
    right: 14px;
    bottom: 14px;
  }

  .abs-chat-launcher {
    width: 56px;
    height: 56px;
  }

  .abs-chat-popup {
    position: fixed;
    right: 10px;
    bottom: 82px;
    width: calc(100vw - 20px);
    height: min(650px, calc(100dvh - 110px));
    min-height: 320px;
    border-radius: 18px;
  }
}

@media (prefers-reduced-motion: reduce) {
  .abs-chat-launcher,
  .abs-chat-popup {
    animation: none !important;
  }

  .abs-chat-launcher,
  .abs-chat-popup-close {
    transition: none !important;
  }
}


/* ============================================================
   ABS CUT — ADMIN CHAT DASHBOARD
   Luxury green, gold and warm cream design
   ============================================================ */

.abs-admin-chat {
  --aac-primary: #0b3d2e;
  --aac-dark: #10251d;
  --aac-gold: #c9a227;
  --aac-cream: #f8f5ed;
  --aac-white: #ffffff;
  --aac-text: #1e2924;
  --aac-muted: #66736d;
  --aac-border: #dedbd2;
  --aac-success: #227b52;
  --aac-danger: #b84444;

  min-height: 100vh;
  padding: 32px;
  color: var(--aac-text);
  background:
    radial-gradient(
      circle at 5% 0%,
      rgba(201, 162, 39, 0.10),
      transparent 28%
    ),
    radial-gradient(
      circle at 100% 15%,
      rgba(11, 61, 46, 0.07),
      transparent 30%
    ),
    var(--aac-cream);

  font-family: inherit;
  animation: aacPageEnter 0.55s ease both;
}

.abs-admin-chat *,
.abs-admin-chat *::before,
.abs-admin-chat *::after {
  box-sizing: border-box;
}

.abs-admin-chat button,
.abs-admin-chat input,
.abs-admin-chat textarea {
  font: inherit;
}

.abs-admin-chat button {
  -webkit-tap-highlight-color: transparent;
}

.aac-page-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 24px;
  margin-bottom: 28px;
}

.aac-eyebrow {
  display: inline-block;
  color: #98751b;
  font-size: 0.7rem;
  font-weight: 800;
  letter-spacing: 0.18em;
}

.aac-page-header h1 {
  margin: 8px 0;
  color: var(--aac-dark);
  font-size: clamp(1.65rem, 3vw, 2.35rem);
  font-weight: 800;
  letter-spacing: -0.045em;
}

.aac-page-header p {
  margin: 0;
  color: var(--aac-muted);
  font-size: 0.92rem;
  line-height: 1.7;
}

.aac-refresh-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  padding: 12px 18px;
  border: 1px solid rgba(11, 61, 46, 0.16);
  border-radius: 12px;
  background: var(--aac-white);
  color: var(--aac-primary);
  font-size: 0.84rem;
  font-weight: 750;
  cursor: pointer;
  transition:
    transform 0.25s ease,
    background 0.25s ease,
    box-shadow 0.25s ease;
}

.aac-refresh-button:hover:not(:disabled) {
  transform: translateY(-2px);
  background: #fdfbf5;
  box-shadow: 0 8px 22px rgba(16, 37, 29, 0.09);
}

.aac-refresh-button:disabled {
  opacity: 0.65;
  cursor: wait;
}

.aac-refresh-button > span {
  font-size: 1.2rem;
}

.aac-spin {
  animation: aacSpin 0.8s linear infinite;
}

/* =========================
   SUMMARY CARDS
   ========================= */

.aac-stats {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 16px;
  margin-bottom: 24px;
}

.aac-stat-card {
  display: flex;
  align-items: center;
  gap: 14px;
  min-width: 0;
  padding: 21px;
  border: 1px solid rgba(222, 219, 210, 0.85);
  border-radius: 17px;
  background: rgba(255, 255, 255, 0.92);
  box-shadow: 0 7px 24px rgba(16, 37, 29, 0.035);
  transition:
    transform 0.25s ease,
    border-color 0.25s ease,
    box-shadow 0.25s ease;
  animation: aacCardEnter 0.5s ease both;
}

.aac-stat-card:nth-child(2) {
  animation-delay: 0.06s;
}

.aac-stat-card:nth-child(3) {
  animation-delay: 0.12s;
}

.aac-stat-card:nth-child(4) {
  animation-delay: 0.18s;
}

.aac-stat-card:hover {
  transform: translateY(-3px);
  border-color: rgba(201, 162, 39, 0.48);
  box-shadow: 0 12px 28px rgba(16, 37, 29, 0.07);
}

.aac-stat-icon {
  display: grid;
  flex-shrink: 0;
  width: 45px;
  height: 45px;
  place-items: center;
  border-radius: 14px;
  background: linear-gradient(
    145deg,
    var(--aac-primary),
    var(--aac-dark)
  );
  color: var(--aac-gold);
  font-size: 1.3rem;
}

.aac-stat-label {
  display: block;
  margin-bottom: 7px;
  color: var(--aac-muted);
  font-size: 0.76rem;
  font-weight: 650;
}

.aac-stat-card strong {
  display: block;
  color: var(--aac-dark);
  font-size: 1.65rem;
  line-height: 1.1;
  overflow-wrap: anywhere;
}

.aac-stat-card .aac-connection-text {
  font-size: 1rem;
}

.aac-connection-dot {
  width: 11px;
  height: 11px;
  flex-shrink: 0;
  border-radius: 50%;
  background: #d6a038;
  box-shadow: 0 0 0 5px rgba(214, 160, 56, 0.12);
}

.aac-connection-dot.is-connected {
  background: var(--aac-success);
  box-shadow: 0 0 0 5px rgba(34, 123, 82, 0.12);
}

/* =========================
   ALERTS
   ========================= */

.aac-alert {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
  margin-bottom: 18px;
  padding: 13px 16px;
  border: 1px solid transparent;
  border-radius: 12px;
  font-size: 0.86rem;
  animation: aacCardEnter 0.25s ease both;
}

.aac-alert-error {
  border-color: rgba(184, 68, 68, 0.18);
  background: #fff0ef;
  color: #9e3434;
}

.aac-alert-notice {
  border-color: rgba(201, 162, 39, 0.3);
  background: #fff9e8;
  color: #755b13;
}

.aac-alert button {
  border: 0;
  background: transparent;
  color: inherit;
  font-size: 1.4rem;
  cursor: pointer;
}

/* =========================
   MAIN WORKSPACE
   ========================= */

.aac-workspace {
  display: grid;
  grid-template-columns: minmax(285px, 350px) minmax(0, 1fr);
  min-height: 660px;
  max-height: 820px;
  overflow: hidden;
  border: 1px solid var(--aac-border);
  border-radius: 21px;
  background: var(--aac-white);
  box-shadow: 0 16px 50px rgba(16, 37, 29, 0.07);
}

/* =========================
   INBOX SIDEBAR
   ========================= */

.aac-inbox {
  display: flex;
  flex-direction: column;
  min-height: 0;
  border-right: 1px solid var(--aac-border);
  background: #fffefa;
}

.aac-inbox-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding: 23px 20px 17px;
}

.aac-inbox-heading h2 {
  margin: 0 0 5px;
  color: var(--aac-dark);
  font-size: 1.13rem;
}

.aac-inbox-heading > div > span {
  color: var(--aac-muted);
  font-size: 0.75rem;
}

.aac-inbox-symbol {
  display: grid;
  width: 39px;
  height: 39px;
  place-items: center;
  border-radius: 12px;
  background: #f5efdb;
  color: #98751b;
  font-size: 1.2rem;
}

.aac-search {
  display: flex;
  align-items: center;
  gap: 10px;
  margin: 0 16px 15px;
  padding: 0 12px;
  border: 1px solid var(--aac-border);
  border-radius: 11px;
  background: var(--aac-white);
  color: var(--aac-muted);
  transition:
    border-color 0.2s ease,
    box-shadow 0.2s ease;
}

.aac-search:focus-within {
  border-color: var(--aac-gold);
  box-shadow: 0 0 0 3px rgba(201, 162, 39, 0.12);
}

.aac-search > span {
  font-size: 1.5rem;
}

.aac-search input {
  width: 100%;
  min-width: 0;
  padding: 12px 0;
  border: 0;
  outline: none;
  background: transparent;
  color: var(--aac-text);
  font-size: 0.8rem;
}

.aac-search input::placeholder {
  color: #939b96;
}

.aac-filters {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  padding: 0 16px 16px;
  border-bottom: 1px solid #eeeae0;
}

.aac-filters button {
  padding: 7px 10px;
  border: 1px solid transparent;
  border-radius: 8px;
  background: transparent;
  color: var(--aac-muted);
  font-size: 0.7rem;
  font-weight: 700;
  cursor: pointer;
  transition:
    color 0.2s ease,
    background 0.2s ease,
    border-color 0.2s ease;
}

.aac-filters button:hover {
  background: #f5f2e8;
  color: var(--aac-primary);
}

.aac-filters button.is-active {
  border-color: rgba(201, 162, 39, 0.3);
  background: #f6efd8;
  color: var(--aac-primary);
}

.aac-conversation-list {
  flex: 1;
  min-height: 0;
  overflow-y: auto;
  overscroll-behavior: contain;
}

.aac-conversation-list::-webkit-scrollbar,
.aac-messages::-webkit-scrollbar {
  width: 5px;
}

.aac-conversation-list::-webkit-scrollbar-thumb,
.aac-messages::-webkit-scrollbar-thumb {
  border-radius: 10px;
  background: #d9d7cd;
}

.aac-conversation-item {
  display: flex;
  width: 100%;
  gap: 12px;
  padding: 17px 15px;
  border: 0;
  border-bottom: 1px solid #f0eee7;
  border-left: 3px solid transparent;
  background: transparent;
  text-align: left;
  cursor: pointer;
  transition:
    background 0.22s ease,
    border-color 0.22s ease;
  animation: aacCardEnter 0.3s ease both;
}

.aac-conversation-item:hover {
  background: #faf8f0;
}

.aac-conversation-item.is-active {
  border-left-color: var(--aac-gold);
  background: linear-gradient(
    100deg,
    rgba(201, 162, 39, 0.12),
    rgba(248, 245, 237, 0.35)
  );
}

.aac-avatar {
  display: grid;
  flex-shrink: 0;
  width: 43px;
  height: 43px;
  place-items: center;
  border: 1px solid rgba(201, 162, 39, 0.27);
  border-radius: 50%;
  background: linear-gradient(
    145deg,
    var(--aac-primary),
    var(--aac-dark)
  );
  color: #f1d779;
  font-size: 0.8rem;
  font-weight: 800;
}

.aac-conversation-details {
  display: block;
  flex: 1;
  min-width: 0;
}

.aac-conversation-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 8px;
}

.aac-conversation-top strong {
  overflow: hidden;
  color: var(--aac-dark);
  font-size: 0.81rem;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.aac-conversation-top time {
  flex-shrink: 0;
  color: var(--aac-muted);
  font-size: 0.65rem;
}

.aac-subject {
  display: block;
  margin-top: 5px;
  overflow: hidden;
  color: #6d6d58;
  font-size: 0.7rem;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.aac-last-message {
  display: block;
  margin-top: 6px;
  overflow: hidden;
  color: var(--aac-muted);
  font-size: 0.73rem;
  line-height: 1.5;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.aac-conversation-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 8px;
  margin-top: 9px;
}

.aac-status-pill {
  display: inline-flex;
  align-items: center;
  padding: 4px 8px;
  border-radius: 20px;
  font-size: 0.65rem;
  font-weight: 750;
  text-transform: capitalize;
}

.aac-status-pill.status-open {
  background: #e4f4e9;
  color: #237248;
}

.aac-status-pill.status-resolved {
  background: #e8efff;
  color: #365e9c;
}

.aac-status-pill.status-closed {
  background: #efefed;
  color: #666b67;
}

.aac-unread-badge {
  display: grid;
  min-width: 21px;
  height: 21px;
  padding: 0 6px;
  place-items: center;
  border-radius: 20px;
  background: var(--aac-primary);
  color: white;
  font-size: 0.66rem;
  font-weight: 800;
}

.aac-list-message,
.aac-list-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10px;
  min-height: 170px;
  padding: 22px;
  color: var(--aac-muted);
  font-size: 0.8rem;
  text-align: center;
}

.aac-list-empty > span {
  color: #b39a4d;
  font-size: 2rem;
}

.aac-list-empty strong {
  color: var(--aac-dark);
}

.aac-list-empty p {
  margin: 0;
}

/* =========================
   CHAT HEADER
   ========================= */

.aac-chat-panel {
  display: flex;
  flex-direction: column;
  min-width: 0;
  min-height: 0;
  background: var(--aac-white);
}

.aac-chat-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 18px;
  padding: 21px 25px;
  border-bottom: 1px solid var(--aac-border);
}

.aac-chat-customer {
  display: flex;
  align-items: center;
  gap: 13px;
  min-width: 0;
}

.aac-avatar-large {
  width: 48px;
  height: 48px;
}

.aac-chat-customer > div {
  min-width: 0;
}

.aac-chat-customer h2 {
  margin: 0 0 5px;
  overflow-wrap: anywhere;
  color: var(--aac-dark);
  font-size: 1rem;
}

.aac-chat-customer p {
  margin: 0 0 8px;
  overflow-wrap: anywhere;
  color: var(--aac-muted);
  font-size: 0.75rem;
}

.aac-chat-header-meta {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 7px;
  color: var(--aac-muted);
  font-size: 0.68rem;
  text-align: right;
}

.aac-chat-ref {
  color: #8d711f;
  font-weight: 800;
}

/* =========================
   TOPIC BANNER
   ========================= */

.aac-chat-topic {
  display: flex;
  align-items: flex-start;
  gap: 12px;
  margin: 17px 22px 0;
  padding: 13px 15px;
  border: 1px solid rgba(201, 162, 39, 0.2);
  border-radius: 12px;
  background: linear-gradient(
    115deg,
    #fbf6e5,
    #fffdf8
  );
}

.aac-chat-topic > span {
  color: #a4821f;
  font-size: 1.15rem;
}

.aac-chat-topic strong {
  color: var(--aac-primary);
  font-size: 0.79rem;
}

.aac-chat-topic p {
  margin: 5px 0 0;
  color: var(--aac-muted);
  font-size: 0.72rem;
  line-height: 1.5;
}

/* =========================
   MESSAGES
   ========================= */

.aac-messages {
  display: flex;
  flex: 1;
  flex-direction: column;
  gap: 18px;
  min-height: 200px;
  padding: 25px;
  overflow-y: auto;
  overscroll-behavior: contain;
  background:
    radial-gradient(
      circle at 100% 0%,
      rgba(201, 162, 39, 0.045),
      transparent 35%
    ),
    #fffefa;
}

.aac-message-row {
  display: flex;
  width: 100%;
  animation: aacMessageEnter 0.3s ease both;
}

.aac-message-row.is-customer {
  justify-content: flex-start;
}

.aac-message-row.is-admin {
  justify-content: flex-end;
}

.aac-message-bubble {
  max-width: min(76%, 520px);
  padding: 13px 15px 10px;
  border: 1px solid #e8e5dc;
  border-radius: 15px 15px 15px 4px;
  background: var(--aac-white);
  box-shadow: 0 4px 12px rgba(16, 37, 29, 0.035);
}

.aac-message-row.is-admin .aac-message-bubble {
  border-color: rgba(201, 162, 39, 0.3);
  border-radius: 15px 15px 4px 15px;
  background: linear-gradient(
    145deg,
    var(--aac-primary),
    var(--aac-dark)
  );
  color: white;
}

.aac-message-sender {
  display: block;
  margin-bottom: 7px;
  color: #8b711f;
  font-size: 0.68rem;
  font-weight: 800;
}

.aac-message-row.is-admin .aac-message-sender {
  color: #f0d77e;
}

.aac-message-bubble p {
  margin: 0;
  overflow-wrap: anywhere;
  font-size: 0.85rem;
  line-height: 1.75;
  white-space: pre-wrap;
}

.aac-message-bubble time {
  display: block;
  margin-top: 9px;
  color: #7a817c;
  font-size: 0.63rem;
  text-align: right;
}

.aac-message-row.is-admin .aac-message-bubble time {
  color: #d1ddd5;
}

.aac-empty-messages {
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 180px;
  text-align: center;
}

.aac-empty-messages > span {
  display: grid;
  width: 57px;
  height: 57px;
  place-items: center;
  border-radius: 18px;
  background: #f5efdb;
  color: #98751b;
  font-size: 1.6rem;
}

.aac-empty-messages h3 {
  margin: 17px 0 7px;
  color: var(--aac-dark);
  font-size: 1.05rem;
}

.aac-empty-messages p {
  margin: 0;
  color: var(--aac-muted);
  font-size: 0.82rem;
  line-height: 1.6;
}

/* =========================
   MESSAGE COMPOSER
   ========================= */

.aac-composer {
  display: flex;
  flex-direction: column;
  gap: 12px;
  padding: 17px 22px 20px;
  border-top: 1px solid var(--aac-border);
  background: var(--aac-white);
}

.aac-composer textarea {
  width: 100%;
  min-height: 67px;
  max-height: 180px;
  resize: vertical;
  padding: 13px 14px;
  border: 1px solid var(--aac-border);
  border-radius: 12px;
  outline: none;
  background: #fffefa;
  color: var(--aac-text);
  font-size: 0.84rem;
  line-height: 1.6;
  transition:
    border-color 0.2s ease,
    box-shadow 0.2s ease,
    background 0.2s ease;
}

.aac-composer textarea:focus {
  border-color: var(--aac-gold);
  background: white;
  box-shadow: 0 0 0 4px rgba(201, 162, 39, 0.12);
}

.aac-composer textarea::placeholder {
  color: #939b96;
}

.aac-composer-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 15px;
}

.aac-composer-footer > span {
  color: var(--aac-muted);
  font-size: 0.68rem;
  line-height: 1.5;
}

.aac-composer-footer button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 11px;
  min-height: 43px;
  padding: 0 19px;
  border: 1px solid var(--aac-gold);
  border-radius: 11px;
  background: linear-gradient(
    115deg,
    #d8b13d,
    var(--aac-gold)
  );
  color: var(--aac-dark);
  font-size: 0.78rem;
  font-weight: 850;
  cursor: pointer;
  box-shadow: 0 5px 13px rgba(201, 162, 39, 0.15);
  transition:
    transform 0.22s ease,
    box-shadow 0.22s ease,
    filter 0.22s ease;
}

.aac-composer-footer button:hover:not(:disabled) {
  transform: translateY(-2px);
  filter: brightness(1.04);
  box-shadow: 0 9px 20px rgba(201, 162, 39, 0.24);
}

.aac-composer-footer button:active:not(:disabled) {
  transform: translateY(0);
}

.aac-composer-footer button:disabled {
  opacity: 0.55;
  cursor: not-allowed;
  box-shadow: none;
}

.aac-closed-notice {
  padding: 17px 22px;
  border-top: 1px solid var(--aac-border);
  background: #f7f5ee;
  color: var(--aac-muted);
  font-size: 0.8rem;
  line-height: 1.6;
}

/* =========================
   WELCOME STATE
   ========================= */

.aac-welcome {
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 35px;
  text-align: center;
  animation: aacCardEnter 0.45s ease both;
}

.aac-welcome-icon {
  display: grid;
  width: 80px;
  height: 80px;
  margin-bottom: 23px;
  place-items: center;
  border: 1px solid rgba(201, 162, 39, 0.48);
  border-radius: 25px;
  background: linear-gradient(
    145deg,
    var(--aac-primary),
    var(--aac-dark)
  );
  color: #e8c75e;
  font-size: 1.6rem;
  font-weight: 900;
  box-shadow: 0 12px 32px rgba(11, 61, 46, 0.17);
  animation: aacBrandFloat 3.5s ease-in-out infinite;
}

.aac-welcome h2 {
  max-width: 420px;
  margin: 12px 0;
  color: var(--aac-dark);
  font-size: clamp(1.5rem, 3vw, 2.2rem);
  letter-spacing: -0.04em;
}

.aac-welcome p {
  max-width: 390px;
  margin: 0;
  color: var(--aac-muted);
  font-size: 0.9rem;
  line-height: 1.8;
}

/* =========================
   LOADING SPINNER
   ========================= */

.aac-loader {
  width: 23px;
  height: 23px;
  border: 2px solid #e9e4d4;
  border-top-color: var(--aac-gold);
  border-radius: 50%;
  animation: aacSpin 0.75s linear infinite;
}

/* =========================
   KEYBOARD ACCESSIBILITY
   ========================= */

.abs-admin-chat button:focus-visible {
  outline: 3px solid rgba(201, 162, 39, 0.65);
  outline-offset: 3px;
}

.abs-admin-chat textarea:focus-visible,
.abs-admin-chat input:focus-visible {
  outline: none;
}

/* =========================
   RESPONSIVE LAYOUT
   ========================= */

@media (max-width: 1200px) {
  .abs-admin-chat {
    padding: 25px;
  }

  .aac-stats {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .aac-workspace {
    grid-template-columns: minmax(250px, 310px) minmax(0, 1fr);
  }

  .aac-chat-header {
    padding: 19px;
  }

  .aac-messages {
    padding: 20px;
  }
}

@media (max-width: 900px) {
  .aac-workspace {
    grid-template-columns: minmax(0, 1fr);
    max-height: none;
    overflow: visible;
  }

  .aac-inbox {
    min-height: 320px;
    max-height: 410px;
    border-right: 0;
    border-bottom: 1px solid var(--aac-border);
  }

  .aac-chat-panel {
    min-height: 580px;
  }

  .aac-conversation-list {
    overflow-y: auto;
  }
}

@media (max-width: 600px) {
  .abs-admin-chat {
    padding: 17px 12px;
  }

  .aac-page-header {
    align-items: flex-start;
    flex-direction: column;
    gap: 15px;
  }

  .aac-page-header h1 {
    font-size: 1.65rem;
  }

  .aac-refresh-button {
    width: 100%;
  }

  .aac-stats {
    gap: 10px;
  }

  .aac-stat-card {
    gap: 10px;
    padding: 13px 11px;
    border-radius: 13px;
  }

  .aac-stat-icon {
    width: 35px;
    height: 35px;
    border-radius: 10px;
    font-size: 1rem;
  }

  .aac-stat-label {
    font-size: 0.66rem;
    line-height: 1.4;
  }

  .aac-stat-card strong {
    font-size: 1.25rem;
  }

  .aac-stat-card .aac-connection-text {
    font-size: 0.8rem;
  }

  .aac-workspace {
    border-radius: 15px;
  }

  .aac-chat-header {
    align-items: flex-start;
    flex-direction: column;
    gap: 13px;
    padding: 17px 14px;
  }

  .aac-chat-header-meta {
    align-items: flex-start;
    text-align: left;
  }

  .aac-chat-topic {
    margin: 12px;
    padding: 12px;
  }

  .aac-messages {
    min-height: 300px;
    padding: 16px 12px;
  }

  .aac-message-bubble {
    max-width: 90%;
    padding: 12px;
  }

  .aac-composer {
    padding: 13px 12px;
  }

  .aac-composer-footer {
    align-items: flex-start;
    flex-direction: column;
  }

  .aac-composer-footer button {
    width: 100%;
  }

  .aac-welcome {
    padding: 30px 20px;
  }
}

@media (prefers-reduced-motion: reduce) {
  .abs-admin-chat *,
  .abs-admin-chat *::before,
  .abs-admin-chat *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    scroll-behavior: auto !important;
    transition-duration: 0.01ms !important;
  }
}

/* =========================
   ANIMATIONS
   ========================= */

@keyframes aacPageEnter {
  from {
    opacity: 0;
    transform: translateY(12px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes aacCardEnter {
  from {
    opacity: 0;
    transform: translateY(7px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes aacMessageEnter {
  from {
    opacity: 0;
    transform: translateY(8px) scale(0.99);
  }

  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

@keyframes aacSpin {
  to {
    transform: rotate(360deg);
  }
}

@keyframes aacBrandFloat {
  0%, 100% {
    transform: translateY(0);
  }

  50% {
    transform: translateY(-5px);
  }
}

/* =========================================================
   ABS CUT — CUSTOMER CHAT
   Premium green, gold and warm cream design
========================================================= */

.abs-chat-page {
  box-sizing: border-box;
  min-height: 100%;
  padding: 18px;
  color: #1e2924;
  background:
    radial-gradient(
      circle at 8% 5%,
      rgba(201, 162, 39, 0.08),
      transparent 35%
    ),
    #f8f5ed;
  font-family: inherit;
}

.abs-chat-page *,
.abs-chat-page *::before,
.abs-chat-page *::after {
  box-sizing: border-box;
}

.abs-chat-card {
  display: flex;
  width: 100%;
  min-height: 600px;
  flex-direction: column;
  overflow: hidden;
  border: 1px solid #dedbd2;
  border-radius: 22px;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 16px 45px rgba(16, 37, 29, 0.08);
  animation: absChatCardEnter 0.4s ease both;
}

/* HEADER */

.abs-chat-header {
  display: flex;
  align-items: center;
  gap: 14px;
  padding: 21px;
  background: linear-gradient(115deg, #0b3d2e, #10251d);
  color: #fff;
}

.abs-chat-brand-icon {
  display: grid;
  width: 48px;
  height: 48px;
  flex-shrink: 0;
  place-items: center;
  border: 1px solid rgba(201, 162, 39, 0.85);
  border-radius: 15px;
  background: rgba(255, 255, 255, 0.06);
  color: #f1d675;
  font-size: 15px;
  font-weight: 900;
  letter-spacing: 0.04em;
}

.abs-chat-heading {
  min-width: 0;
  flex: 1;
}

.abs-chat-eyebrow {
  display: block;
  margin-bottom: 5px;
  color: #e1c35d;
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 0.16em;
}

.abs-chat-heading h2 {
  margin: 0;
  color: #fff;
  font-size: 22px;
  line-height: 1.25;
}

.abs-chat-heading p {
  margin: 5px 0 0;
  color: rgba(255, 255, 255, 0.76);
  font-size: 12px;
  line-height: 1.5;
}

.abs-chat-status {
  display: inline-flex;
  flex-shrink: 0;
  align-items: center;
  gap: 7px;
  padding: 7px 10px;
  border: 1px solid rgba(255, 255, 255, 0.17);
  border-radius: 999px;
  color: rgba(255, 255, 255, 0.8);
  font-size: 10px;
  white-space: nowrap;
}

.abs-chat-status > span {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: #e0b84b;
}

.abs-chat-status.is-connected > span {
  background: #65d69a;
  box-shadow: 0 0 0 4px rgba(101, 214, 154, 0.12);
}

/* WELCOME NOTICE */

.abs-chat-notice {
  display: flex;
  align-items: flex-start;
  gap: 10px;
  margin: 16px 16px 0;
  padding: 13px 15px;
  border: 1px solid rgba(201, 162, 39, 0.25);
  border-radius: 13px;
  background: linear-gradient(
    110deg,
    rgba(201, 162, 39, 0.11),
    rgba(248, 245, 237, 0.72)
  );
}

.abs-chat-notice-icon {
  color: #a17d18;
  font-size: 17px;
}

.abs-chat-notice p {
  margin: 0;
  color: #526057;
  font-size: 12px;
  line-height: 1.6;
}

/* MESSAGE HISTORY */

.abs-chat-messages {
  display: flex;
  min-height: 250px;
  max-height: 520px;
  flex: 1;
  flex-direction: column;
  gap: 3px;
  overflow-y: auto;
  overscroll-behavior: contain;
  padding: 18px 16px;
  scroll-behavior: smooth;
}

.abs-chat-messages::-webkit-scrollbar {
  width: 6px;
}

.abs-chat-messages::-webkit-scrollbar-thumb {
  border-radius: 999px;
  background: #d6d2c7;
}

.abs-chat-messages::-webkit-scrollbar-track {
  background: transparent;
}

.abs-chat-empty {
  display: flex;
  min-height: 220px;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
}

.abs-chat-empty-icon {
  display: grid;
  width: 55px;
  height: 55px;
  place-items: center;
  border: 1px solid #e8dfbd;
  border-radius: 18px;
  background: #faf5df;
  color: #97751b;
  font-size: 24px;
}

.abs-chat-empty h3 {
  margin: 14px 0 5px;
  color: #0b3d2e;
  font-size: 16px;
}

.abs-chat-empty p {
  max-width: 260px;
  margin: 0;
  color: #66736d;
  font-size: 12px;
  line-height: 1.6;
}

.abs-chat-date-divider {
  display: flex;
  align-items: center;
  gap: 12px;
  margin: 14px 0;
  color: #66736d;
  font-size: 10px;
  text-align: center;
}

.abs-chat-date-divider::before,
.abs-chat-date-divider::after {
  content: "";
  height: 1px;
  flex: 1;
  background: #e6e1d6;
}

/* MESSAGE BUBBLES */

.abs-chat-message-row {
  display: flex;
  width: 100%;
  margin: 5px 0;
  animation: absChatMessageEnter 0.22s ease both;
}

.abs-chat-message-row.is-customer {
  justify-content: flex-end;
}

.abs-chat-message-row.is-admin {
  justify-content: flex-start;
}

.abs-chat-message {
  max-width: min(82%, 480px);
  overflow-wrap: anywhere;
  padding: 11px 14px 9px;
  border-radius: 16px;
}

.abs-chat-message-row.is-customer .abs-chat-message {
  border: 1px solid rgba(201, 162, 39, 0.25);
  border-radius: 16px 16px 4px 16px;
  background: linear-gradient(135deg, #0b3d2e, #164d3a);
  color: #fff;
  box-shadow: 0 5px 14px rgba(11, 61, 46, 0.1);
}

.abs-chat-message-row.is-admin .abs-chat-message {
  border: 1px solid #e5e1d7;
  border-radius: 16px 16px 16px 4px;
  background: #fff;
  color: #1e2924;
  box-shadow: 0 4px 12px rgba(16, 37, 29, 0.035);
}

.abs-chat-sender {
  display: block;
  margin-bottom: 5px;
  color: #9a7718;
  font-size: 10px;
  font-weight: 800;
}

.abs-chat-message p {
  margin: 0;
  font-size: 13px;
  line-height: 1.6;
  white-space: pre-wrap;
  overflow-wrap: anywhere;
}

.abs-chat-message time {
  display: block;
  margin-top: 6px;
  font-size: 10px;
  opacity: 0.72;
  text-align: right;
}

/* TYPING INDICATOR */

.abs-chat-typing {
  display: flex;
  min-height: 34px;
  align-items: center;
  gap: 9px;
  padding: 5px 18px 10px;
  color: #66736d;
  font-size: 11px;
  animation: absChatTypingEnter 0.22s ease both;
}

.abs-chat-typing-dots {
  display: inline-flex;
  align-items: center;
  gap: 4px;
}

.abs-chat-typing-dots i {
  display: block;
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: #c9a227;
  animation: absChatDotBounce 1s ease-in-out infinite;
}

.abs-chat-typing-dots i:nth-child(2) {
  animation-delay: 0.15s;
}

.abs-chat-typing-dots i:nth-child(3) {
  animation-delay: 0.3s;
}

/* COMPOSER */

.abs-chat-composer {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  gap: 10px;
  padding: 14px 16px;
  border-top: 1px solid #e8e3d9;
  background: #fff;
}

.abs-chat-composer textarea {
  width: 100%;
  min-width: 0;
  min-height: 48px;
  max-height: 150px;
  resize: vertical;
  padding: 12px 13px;
  border: 1px solid #dedbd2;
  border-radius: 12px;
  outline: none;
  background: #fcfbf8;
  color: #1e2924;
  font: inherit;
  font-size: 13px;
  line-height: 1.5;
  transition:
    border-color 0.2s ease,
    box-shadow 0.2s ease,
    background 0.2s ease;
}

.abs-chat-composer textarea:focus {
  border-color: #c9a227;
  background: #fff;
  box-shadow: 0 0 0 3px rgba(201, 162, 39, 0.14);
}

.abs-chat-composer textarea::placeholder {
  color: #929a93;
}

.abs-chat-composer button {
  display: inline-flex;
  min-width: 84px;
  align-items: center;
  justify-content: center;
  gap: 8px;
  align-self: start;
  padding: 13px 15px;
  border: 1px solid #0b3d2e;
  border-radius: 12px;
  background: linear-gradient(135deg, #0b3d2e, #10251d);
  color: #fff;
  font: inherit;
  font-size: 12px;
  font-weight: 800;
  cursor: pointer;
  transition:
    transform 0.2s ease,
    box-shadow 0.2s ease,
    opacity 0.2s ease;
}

.abs-chat-composer button:hover:not(:disabled) {
  transform: translateY(-2px);
  box-shadow: 0 7px 17px rgba(11, 61, 46, 0.2);
}

.abs-chat-composer button:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

.abs-chat-composer small {
  grid-column: 1 / -1;
  color: #818a82;
  font-size: 10px;
}

/* ERROR AND CLOSED STATES */

.abs-chat-inline-error,
.abs-chat-closed {
  margin: 10px 16px;
  padding: 11px 13px;
  border-radius: 10px;
  font-size: 12px;
  line-height: 1.5;
}

.abs-chat-inline-error {
  border: 1px solid #f0caca;
  background: #fff3f2;
  color: #963c35;
}

.abs-chat-closed {
  border: 1px solid #e8dfbd;
  background: #faf5df;
  color: #6e591c;
}

/* LOADING AND ERROR SCREENS */

.abs-chat-loading,
.abs-chat-error {
  display: flex;
  min-height: 280px;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12px;
  padding: 24px;
  text-align: center;
}

.abs-chat-loading p,
.abs-chat-error p {
  margin: 0;
  color: #66736d;
  font-size: 13px;
  line-height: 1.6;
}

.abs-chat-error h2 {
  margin: 0;
  color: #0b3d2e;
  font-size: 20px;
}

.abs-chat-error button {
  padding: 10px 16px;
  border: 0;
  border-radius: 10px;
  background: #0b3d2e;
  color: #fff;
  cursor: pointer;
}

.abs-chat-spinner {
  width: 30px;
  height: 30px;
  border: 3px solid #e5e0d4;
  border-top-color: #c9a227;
  border-radius: 50%;
  animation: absChatSpin 0.8s linear infinite;
}

/* FOOTER */

.abs-chat-footer {
  padding: 12px;
  border-top: 1px solid #eee9df;
  background: #fcfbf8;
  color: #849087;
  font-size: 10px;
  text-align: center;
}

/* ANIMATIONS */

@keyframes absChatCardEnter {
  from {
    opacity: 0;
    transform: translateY(8px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes absChatMessageEnter {
  from {
    opacity: 0;
    transform: translateY(5px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes absChatTypingEnter {
  from {
    opacity: 0;
    transform: translateY(4px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes absChatDotBounce {
  0%, 60%, 100% {
    opacity: 0.55;
    transform: translateY(0);
  }

  30% {
    opacity: 1;
    transform: translateY(-4px);
  }
}

@keyframes absChatSpin {
  to {
    transform: rotate(360deg);
  }
}

/* RESPONSIVE */

@media (max-width: 560px) {
  .abs-chat-page {
    padding: 0;
  }

  .abs-chat-card {
    min-height: 520px;
    border-radius: 0;
    border-right: 0;
    border-left: 0;
  }

  .abs-chat-header {
    gap: 10px;
    padding: 15px 12px;
  }

  .abs-chat-brand-icon {
    width: 40px;
    height: 40px;
    border-radius: 12px;
  }

  .abs-chat-heading h2 {
    font-size: 18px;
  }

  .abs-chat-heading p {
    font-size: 11px;
  }

  .abs-chat-status {
    gap: 5px;
    padding: 6px 7px;
    font-size: 9px;
  }

  .abs-chat-notice {
    margin: 12px 10px 0;
    padding: 10px;
  }

  .abs-chat-messages {
    min-height: 220px;
    max-height: 440px;
    padding: 13px 10px;
  }

  .abs-chat-message {
    max-width: 90%;
    padding: 10px 12px;
  }

  .abs-chat-composer {
    grid-template-columns: minmax(0, 1fr);
    padding: 11px;
  }

  .abs-chat-composer button {
    width: 100%;
  }

  .abs-chat-composer small {
    grid-column: 1;
  }
}

@media (prefers-reduced-motion: reduce) {
  .abs-chat-card,
  .abs-chat-message-row,
  .abs-chat-typing,
  .abs-chat-typing-dots i,
  .abs-chat-spinner {
    animation: none !important;
  }

  .abs-chat-composer textarea,
  .abs-chat-composer button {
    transition: none !important;
  }
}

/* =========================================================
   ABS CUT — ADMIN CUSTOMER CHAT
========================================================= */

.abs-admin-chat {
  min-width: 0;
  min-height: 100vh;
  padding: 30px;
  color: #1e2924;
  background:
    radial-gradient(
      circle at 5% 0%,
      rgba(201, 162, 39, 0.1),
      transparent 28%
    ),
    #f8f5ed;
  font-family: inherit;
}

.abs-admin-chat *,
.abs-admin-chat *::before,
.abs-admin-chat *::after {
  box-sizing: border-box;
}

.aac-page-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  margin-bottom: 24px;
}

.aac-eyebrow {
  display: block;
  margin-bottom: 8px;
  color: #9a7718;
  font-size: 10px;
  font-weight: 900;
  letter-spacing: 0.16em;
}

.aac-page-header h1 {
  margin: 0;
  color: #0b3d2e;
  font-size: clamp(25px, 3vw, 34px);
  line-height: 1.2;
}

.aac-page-header p {
  margin: 9px 0 0;
  color: #66736d;
  font-size: 13px;
  line-height: 1.6;
}

.aac-refresh-button {
  display: inline-flex;
  min-height: 43px;
  align-items: center;
  justify-content: center;
  gap: 9px;
  padding: 10px 15px;
  border: 1px solid #0b3d2e;
  border-radius: 11px;
  background: #0b3d2e;
  color: #fff;
  font-size: 12px;
  font-weight: 800;
  cursor: pointer;
  transition:
    transform 0.2s ease,
    background 0.2s ease,
    box-shadow 0.2s ease;
}

.aac-refresh-button:hover:not(:disabled) {
  transform: translateY(-2px);
  background: #10251d;
  box-shadow: 0 8px 20px rgba(11, 61, 46, 0.17);
}

.aac-refresh-button:disabled {
  cursor: wait;
  opacity: 0.65;
}

.aac-spin {
  display: inline-block;
  animation: aacRotate 0.8s linear infinite;
}

/* STATS */

.aac-stats {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 15px;
  margin-bottom: 22px;
}

.aac-stat-card {
  display: flex;
  min-width: 0;
  min-height: 105px;
  align-items: center;
  gap: 14px;
  padding: 19px;
  border: 1px solid #e5e0d5;
  border-radius: 17px;
  background: rgba(255, 255, 255, 0.93);
  box-shadow: 0 8px 26px rgba(16, 37, 29, 0.045);
  transition:
    transform 0.22s ease,
    border-color 0.22s ease,
    box-shadow 0.22s ease;
}

.aac-stat-card:hover {
  transform: translateY(-3px);
  border-color: rgba(201, 162, 39, 0.55);
  box-shadow: 0 13px 30px rgba(16, 37, 29, 0.08);
}

.aac-stat-icon {
  display: grid;
  width: 43px;
  height: 43px;
  flex-shrink: 0;
  place-items: center;
  border: 1px solid #e9dfba;
  border-radius: 13px;
  background: #faf5df;
  color: #8c6e17;
  font-size: 20px;
}

.aac-stat-label {
  display: block;
  margin-bottom: 6px;
  color: #66736d;
  font-size: 11px;
  line-height: 1.4;
}

.aac-stat-card strong {
  display: block;
  color: #0b3d2e;
  font-size: 25px;
  line-height: 1.1;
}

.aac-connection-dot {
  width: 10px;
  height: 10px;
  flex-shrink: 0;
  border-radius: 50%;
  background: #c99b42;
}

.aac-connection-dot.is-connected {
  background: #279764;
  box-shadow: 0 0 0 5px rgba(39, 151, 100, 0.11);
}

.aac-stat-card strong.aac-connection-text {
  font-size: 15px;
}

/* ALERTS */

.aac-alert {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  margin-bottom: 15px;
  padding: 12px 15px;
  border-radius: 11px;
  font-size: 12px;
  line-height: 1.5;
}

.aac-alert button {
  border: 0;
  background: transparent;
  color: inherit;
  font-size: 20px;
  cursor: pointer;
}

.aac-alert-error {
  border: 1px solid #f0caca;
  background: #fff3f2;
  color: #963c35;
}

.aac-alert-notice {
  border: 1px solid #e8dfbd;
  background: #faf5df;
  color: #70591b;
}

/* MAIN WORKSPACE */

.aac-workspace {
  display: grid;
  grid-template-columns: minmax(270px, 340px) minmax(0, 1fr);
  min-height: 650px;
  gap: 18px;
}

.aac-inbox,
.aac-chat-panel {
  min-width: 0;
  overflow: hidden;
  border: 1px solid #e5e0d5;
  border-radius: 19px;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 10px 32px rgba(16, 37, 29, 0.05);
}

.aac-inbox {
  display: flex;
  flex-direction: column;
}

.aac-inbox-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 21px 19px 16px;
}

.aac-inbox-heading h2 {
  margin: 0;
  color: #0b3d2e;
  font-size: 19px;
}

.aac-inbox-heading span:not(.aac-inbox-symbol) {
  display: block;
  margin-top: 5px;
  color: #788279;
  font-size: 11px;
}

.aac-inbox-symbol {
  display: grid;
  width: 38px;
  height: 38px;
  place-items: center;
  border-radius: 12px;
  background: #faf5df;
  color: #97751b;
  font-size: 19px;
}

.aac-search {
  display: flex;
  align-items: center;
  gap: 8px;
  margin: 0 14px 13px;
  padding: 0 12px;
  border: 1px solid #e3dfd5;
  border-radius: 11px;
  background: #fcfbf8;
  color: #8b938b;
}

.aac-search > span {
  font-size: 21px;
}

.aac-search input {
  width: 100%;
  min-width: 0;
  height: 42px;
  border: 0;
  outline: 0;
  background: transparent;
  color: #1e2924;
  font: inherit;
  font-size: 12px;
}

.aac-search:focus-within {
  border-color: #c9a227;
  box-shadow: 0 0 0 3px rgba(201, 162, 39, 0.12);
}

.aac-filters {
  display: flex;
  gap: 6px;
  overflow-x: auto;
  padding: 0 14px 13px;
}

.aac-filters button {
  flex-shrink: 0;
  padding: 7px 10px;
  border: 1px solid #e5e0d5;
  border-radius: 999px;
  background: #fff;
  color: #66736d;
  font-size: 10px;
  font-weight: 700;
  cursor: pointer;
  transition:
    background 0.2s ease,
    color 0.2s ease,
    border-color 0.2s ease;
}

.aac-filters button:hover,
.aac-filters button.is-active {
  border-color: #0b3d2e;
  background: #0b3d2e;
  color: #fff;
}

.aac-conversation-list {
  min-height: 0;
  flex: 1;
  overflow-y: auto;
  border-top: 1px solid #eee9df;
}

.aac-conversation-list::-webkit-scrollbar,
.aac-messages::-webkit-scrollbar {
  width: 6px;
}

.aac-conversation-list::-webkit-scrollbar-thumb,
.aac-messages::-webkit-scrollbar-thumb {
  border-radius: 999px;
  background: #d9d4c9;
}

.aac-conversation-item {
  display: flex;
  width: 100%;
  align-items: flex-start;
  gap: 11px;
  padding: 15px 13px;
  border: 0;
  border-bottom: 1px solid #f0ede6;
  border-left: 3px solid transparent;
  background: #fff;
  color: inherit;
  text-align: left;
  cursor: pointer;
  transition:
    background 0.2s ease,
    border-color 0.2s ease;
}

.aac-conversation-item:hover {
  background: #fcfaf3;
}

.aac-conversation-item.is-active {
  border-left-color: #c9a227;
  background: linear-gradient(
    100deg,
    rgba(201, 162, 39, 0.13),
    rgba(11, 61, 46, 0.035)
  );
}

.aac-avatar {
  display: grid;
  width: 43px;
  height: 43px;
  flex-shrink: 0;
  place-items: center;
  border: 1px solid rgba(201, 162, 39, 0.35);
  border-radius: 14px;
  background: linear-gradient(135deg, #0b3d2e, #174f3d);
  color: #fff;
  font-size: 12px;
  font-weight: 900;
}

.aac-avatar-large {
  width: 49px;
  height: 49px;
  border-radius: 15px;
}

.aac-conversation-details {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
  gap: 5px;
}

.aac-conversation-top {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 8px;
}

.aac-conversation-top strong {
  overflow: hidden;
  color: #1e2924;
  font-size: 12px;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.aac-conversation-top time {
  flex-shrink: 0;
  color: #879087;
  font-size: 9px;
}

.aac-subject {
  overflow: hidden;
  color: #66736d;
  font-size: 10px;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.aac-last-message {
  overflow: hidden;
  color: #858d85;
  font-size: 11px;
  line-height: 1.5;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.aac-conversation-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  margin-top: 2px;
}

.aac-status-pill {
  display: inline-flex;
  width: fit-content;
  align-items: center;
  padding: 4px 8px;
  border: 1px solid transparent;
  border-radius: 999px;
  font-size: 9px;
  font-weight: 800;
  text-transform: capitalize;
}

.aac-status-pill.status-open {
  border-color: #c9e8d5;
  background: #edf9f1;
  color: #24754b;
}

.aac-status-pill.status-resolved {
  border-color: #d9e4f5;
  background: #f0f5ff;
  color: #365c91;
}

.aac-status-pill.status-closed {
  border-color: #e5e0d5;
  background: #f5f3ee;
  color: #73786f;
}

.aac-unread-badge {
  display: grid;
  min-width: 21px;
  height: 21px;
  place-items: center;
  padding: 0 5px;
  border-radius: 999px;
  background: #c9a227;
  color: #10251d;
  font-size: 10px;
  font-weight: 900;
}

/* EMPTY AND LOADING STATES */

.aac-list-message,
.aac-list-empty,
.aac-empty-messages,
.aac-welcome {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10px;
  padding: 30px 20px;
  color: #66736d;
  text-align: center;
}

.aac-list-message {
  flex-direction: row;
  font-size: 12px;
}

.aac-list-empty > span,
.aac-empty-messages > span {
  color: #a17d18;
  font-size: 27px;
}

.aac-list-empty strong,
.aac-empty-messages h3 {
  margin: 0;
  color: #0b3d2e;
  font-size: 14px;
}

.aac-list-empty p,
.aac-empty-messages p,
.aac-welcome p {
  max-width: 280px;
  margin: 0;
  color: #778178;
  font-size: 12px;
  line-height: 1.7;
}

.aac-loader {
  display: inline-block;
  width: 19px;
  height: 19px;
  flex-shrink: 0;
  border: 2px solid #e4dfd3;
  border-top-color: #c9a227;
  border-radius: 50%;
  animation: aacRotate 0.8s linear infinite;
}

/* ACTIVE CHAT PANEL */

.aac-chat-panel {
  display: flex;
  min-height: 650px;
  flex-direction: column;
}

.aac-welcome {
  flex: 1;
  padding: 45px 24px;
}

.aac-welcome-icon {
  display: grid;
  width: 72px;
  height: 72px;
  place-items: center;
  border: 1px solid rgba(201, 162, 39, 0.6);
  border-radius: 22px;
  background: linear-gradient(135deg, #0b3d2e, #10251d);
  color: #f1d675;
  font-size: 21px;
  font-weight: 900;
  box-shadow: 0 10px 25px rgba(11, 61, 46, 0.15);
}

.aac-welcome .aac-eyebrow {
  margin-top: 12px;
}

.aac-welcome h2 {
  margin: 0;
  color: #0b3d2e;
  font-size: 23px;
}

.aac-chat-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 15px;
  padding: 19px 21px;
  border-bottom: 1px solid #eee9df;
  background: linear-gradient(110deg, #fff, #fcfaf4);
}

.aac-chat-customer {
  display: flex;
  min-width: 0;
  align-items: center;
  gap: 12px;
}

.aac-chat-customer h2 {
  margin: 0 0 4px;
  color: #0b3d2e;
  font-size: 16px;
}

.aac-chat-customer p {
  margin: 0 0 7px;
  color: #778178;
  font-size: 11px;
  overflow-wrap: anywhere;
}

.aac-chat-header-meta {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 6px;
  color: #7c857c;
  font-size: 10px;
  text-align: right;
}

.aac-chat-ref {
  color: #9a7718;
  font-weight: 800;
}

.aac-chat-topic {
  display: flex;
  align-items: flex-start;
  gap: 10px;
  margin: 13px 17px 0;
  padding: 12px 14px;
  border: 1px solid rgba(201, 162, 39, 0.23);
  border-radius: 12px;
  background: #fcfaf2;
}

.aac-chat-topic > span {
  color: #a17d18;
}

.aac-chat-topic strong {
  color: #0b3d2e;
  font-size: 12px;
}

.aac-chat-topic p {
  margin: 4px 0 0;
  color: #778178;
  font-size: 10px;
  line-height: 1.5;
}

/* MESSAGE HISTORY */

.aac-messages {
  display: flex;
  min-height: 280px;
  max-height: 580px;
  flex: 1;
  flex-direction: column;
  overflow-y: auto;
  overscroll-behavior: contain;
  padding: 17px 20px;
  scroll-behavior: smooth;
}

.aac-empty-messages {
  flex: 1;
}

.aac-date-divider {
  display: flex;
  align-items: center;
  gap: 12px;
  margin: 14px 0;
  color: #7a837a;
  font-size: 10px;
  text-align: center;
}

.aac-date-divider::before,
.aac-date-divider::after {
  content: "";
  height: 1px;
  flex: 1;
  background: #e8e3d9;
}

.aac-message-row {
  display: flex;
  width: 100%;
  margin: 5px 0;
  animation: aacMessageEnter 0.22s ease both;
}

.aac-message-row.is-admin {
  justify-content: flex-end;
}

.aac-message-row.is-customer {
  justify-content: flex-start;
}

.aac-message-bubble {
  max-width: min(78%, 620px);
  overflow-wrap: anywhere;
  padding: 12px 15px 9px;
  border: 1px solid #e5e0d5;
  border-radius: 16px;
  box-shadow: 0 3px 12px rgba(16, 37, 29, 0.035);
}

.aac-message-row.is-admin .aac-message-bubble {
  border-color: rgba(201, 162, 39, 0.22);
  border-radius: 16px 16px 4px 16px;
  background: linear-gradient(135deg, #0b3d2e, #164d3a);
  color: #fff;
}

.aac-message-row.is-customer .aac-message-bubble {
  border-radius: 16px 16px 16px 4px;
  background: #fff;
  color: #1e2924;
}

.aac-message-sender {
  display: block;
  margin-bottom: 5px;
  color: #9a7718;
  font-size: 10px;
  font-weight: 800;
}

.aac-message-row.is-admin .aac-message-sender {
  color: #f1d675;
}

.aac-message-bubble p {
  margin: 0;
  font-size: 12px;
  line-height: 1.65;
  white-space: pre-wrap;
  overflow-wrap: anywhere;
}

.aac-message-bubble time {
  display: block;
  margin-top: 6px;
  font-size: 9px;
  opacity: 0.72;
  text-align: right;
}

/* TYPING INDICATOR */

.aac-typing {
  display: flex;
  min-height: 34px;
  align-items: center;
  gap: 9px;
  padding: 5px 20px 10px;
  color: #66736d;
  font-size: 11px;
  animation: aacMessageEnter 0.22s ease both;
}

.aac-typing-dots {
  display: inline-flex;
  align-items: center;
  gap: 4px;
}

.aac-typing-dots i {
  display: block;
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: #c9a227;
  animation: aacDotBounce 1s ease-in-out infinite;
}

.aac-typing-dots i:nth-child(2) {
  animation-delay: 0.15s;
}

.aac-typing-dots i:nth-child(3) {
  animation-delay: 0.3s;
}

/* REPLY COMPOSER */

.aac-composer {
  padding: 15px 18px;
  border-top: 1px solid #e8e3d9;
  background: #fff;
}

.aac-composer textarea {
  display: block;
  width: 100%;
  min-height: 68px;
  max-height: 180px;
  resize: vertical;
  padding: 12px 13px;
  border: 1px solid #dedbd2;
  border-radius: 12px;
  outline: none;
  background: #fcfbf8;
  color: #1e2924;
  font: inherit;
  font-size: 12px;
  line-height: 1.6;
  transition:
    border-color 0.2s ease,
    box-shadow 0.2s ease;
}

.aac-composer textarea:focus {
  border-color: #c9a227;
  box-shadow: 0 0 0 3px rgba(201, 162, 39, 0.13);
}

.aac-composer textarea:disabled {
  opacity: 0.7;
}

.aac-composer-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  margin-top: 11px;
}

.aac-composer-footer > span {
  color: #899087;
  font-size: 10px;
  line-height: 1.5;
}

.aac-composer-footer button {
  display: inline-flex;
  min-height: 39px;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  gap: 9px;
  padding: 9px 14px;
  border: 1px solid #0b3d2e;
  border-radius: 10px;
  background: #0b3d2e;
  color: #fff;
  font-size: 11px;
  font-weight: 800;
  cursor: pointer;
  transition:
    transform 0.2s ease,
    background 0.2s ease,
    box-shadow 0.2s ease;
}

.aac-composer-footer button:hover:not(:disabled) {
  transform: translateY(-2px);
  background: #10251d;
  box-shadow: 0 7px 18px rgba(11, 61, 46, 0.17);
}

.aac-composer-footer button:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

.aac-closed-notice {
  margin: 14px 18px 18px;
  padding: 12px 14px;
  border: 1px solid #e8dfbd;
  border-radius: 11px;
  background: #faf5df;
  color: #70591b;
  font-size: 12px;
  line-height: 1.6;
}

/* ANIMATIONS */

@keyframes aacRotate {
  to {
    transform: rotate(360deg);
  }
}

@keyframes aacMessageEnter {
  from {
    opacity: 0;
    transform: translateY(5px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes aacDotBounce {
  0%, 60%, 100% {
    opacity: 0.55;
    transform: translateY(0);
  }

  30% {
    opacity: 1;
    transform: translateY(-4px);
  }
}

/* RESPONSIVE */

@media (max-width: 1100px) {
  .aac-stats {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .aac-workspace {
    grid-template-columns: minmax(250px, 310px) minmax(0, 1fr);
  }

  .abs-admin-chat {
    padding: 22px;
  }
}

@media (max-width: 780px) {
  .abs-admin-chat {
    padding: 15px;
  }

  .aac-workspace {
    grid-template-columns: minmax(0, 1fr);
  }

  .aac-inbox {
    max-height: 430px;
  }

  .aac-chat-panel {
    min-height: 590px;
  }

  .aac-chat-header {
    align-items: flex-start;
  }

  .aac-chat-header-meta {
    max-width: 120px;
  }
}

@media (max-width: 480px) {
  .abs-admin-chat {
    padding: 10px;
  }

  .aac-page-header {
    align-items: flex-start;
    flex-direction: column;
  }

  .aac-refresh-button {
    width: 100%;
  }

  .aac-stats {
    gap: 9px;
  }

  .aac-stat-card {
    min-height: 90px;
    gap: 9px;
    padding: 12px;
  }

  .aac-stat-icon {
    width: 34px;
    height: 34px;
    font-size: 16px;
  }

  .aac-stat-card strong {
    font-size: 21px;
  }

  .aac-stat-label {
    font-size: 10px;
  }

  .aac-chat-header {
    flex-direction: column;
    padding: 15px;
  }

  .aac-chat-header-meta {
    max-width: none;
    align-items: flex-start;
    text-align: left;
  }

  .aac-messages {
    padding: 12px;
  }

  .aac-message-bubble {
    max-width: 92%;
    padding: 10px 12px;
  }

  .aac-composer-footer {
    align-items: stretch;
    flex-direction: column;
  }

  .aac-composer-footer button {
    width: 100%;
  }
}

@media (prefers-reduced-motion: reduce) {
  .aac-spin,
  .aac-loader,
  .aac-message-row,
  .aac-typing,
  .aac-typing-dots i {
    animation: none !important;
  }

  .aac-stat-card,
  .aac-refresh-button,
  .aac-filters button,
  .aac-conversation-item,
  .aac-composer-footer button {
    transition: none !important;
  }
}

/* =========================================================
   ABS CUT — FLOATING CHAT WIDGET
========================================================= */

.abs-chat-widget {
  position: relative;
  z-index: 1000;
}

.abs-chat-launcher {
  position: fixed;
  right: 24px;
  bottom: 24px;
  z-index: 1002;
  display: grid;
  width: 62px;
  height: 62px;
  place-items: center;
  border: 2px solid rgba(201, 162, 39, 0.85);
  border-radius: 50%;
  background: linear-gradient(135deg, #0b3d2e, #10251d);
  color: #fff;
  box-shadow: 0 10px 30px rgba(11, 61, 46, 0.27);
  cursor: pointer;
  transition:
    transform 0.25s ease,
    box-shadow 0.25s ease,
    background 0.25s ease;
}

.abs-chat-launcher:hover {
  transform: translateY(-4px) scale(1.04);
  box-shadow: 0 15px 36px rgba(11, 61, 46, 0.36);
}

.abs-chat-launcher:focus-visible,
.abs-chat-popup-close:focus-visible {
  outline: 3px solid #c9a227;
  outline-offset: 4px;
}

.abs-chat-launcher.is-open {
  background: #10251d;
}

.abs-chat-popup {
  position: fixed;
  right: 24px;
  bottom: 100px;
  z-index: 1001;
  display: flex;
  width: min(410px, calc(100vw - 32px));
  height: min(680px, calc(100dvh - 130px));
  flex-direction: column;
  overflow: hidden;
  border: 1px solid #dedbd2;
  border-radius: 22px;
  background: #f8f5ed;
  box-shadow: 0 22px 70px rgba(16, 37, 29, 0.23);
  transform-origin: bottom right;
  animation: absChatPopupEnter 0.25s ease both;
}

.abs-chat-popup-topbar {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding: 15px 17px;
  background: linear-gradient(115deg, #0b3d2e, #10251d);
  color: #fff;
}

.abs-chat-popup-brand {
  display: flex;
  min-width: 0;
  align-items: center;
  gap: 11px;
}

.abs-chat-popup-logo {
  display: grid;
  width: 42px;
  height: 42px;
  flex-shrink: 0;
  place-items: center;
  border: 1px solid #c9a227;
  border-radius: 13px;
  color: #f2d778;
  font-size: 14px;
  font-weight: 900;
}

.abs-chat-popup-brand h3 {
  margin: 0;
  color: #fff;
  font-size: 15px;
}

.abs-chat-popup-brand p {
  margin: 3px 0 0;
  color: rgba(255, 255, 255, 0.75);
  font-size: 12px;
}

.abs-chat-popup-close {
  display: grid;
  width: 38px;
  height: 38px;
  flex-shrink: 0;
  place-items: center;
  border: 1px solid rgba(255, 255, 255, 0.22);
  border-radius: 50%;
  background: transparent;
  color: #fff;
  cursor: pointer;
  transition:
    background 0.2s ease,
    transform 0.2s ease;
}

.abs-chat-popup-close:hover {
  transform: rotate(90deg);
  background: rgba(255, 255, 255, 0.12);
}

.abs-chat-popup-content {
  min-height: 0;
  flex: 1;
  overflow: auto;
  overscroll-behavior: contain;
}

.abs-chat-popup-content .abs-chat-page {
  min-height: 100%;
  padding: 0;
  background: transparent;
}

.abs-chat-popup-content .abs-chat-card {
  width: 100%;
  min-height: 100%;
  height: 100%;
  border: 0;
  border-radius: 0;
  box-shadow: none;
  animation: none;
}

.abs-chat-popup-content .abs-chat-messages {
  min-height: 120px;
  max-height: none;
}

/* POPUP OPEN ANIMATION */

@keyframes absChatPopupEnter {
  from {
    opacity: 0;
    transform: translateY(12px) scale(0.97);
  }

  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

/* MOBILE */

@media (max-width: 480px) {
  .abs-chat-popup {
    right: 12px;
    bottom: 82px;
    width: calc(100vw - 24px);
    height: min(680px, calc(100dvh - 96px));
    border-radius: 18px;
  }

  .abs-chat-launcher {
    right: 16px;
    bottom: 16px;
    width: 56px;
    height: 56px;
  }
}

@media (prefers-reduced-motion: reduce) {
  .abs-chat-popup,
  .abs-chat-launcher,
  .abs-chat-popup-close {
    animation: none !important;
    transition: none !important;
  }
}
 /* ABS CUT — Customer chat message alignment */
.abs-chat-messages {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.abs-chat-message-row {
  display: flex;
  width: 100%;
  min-width: 0;
}

.abs-chat-message-row.is-customer {
  justify-content: flex-end;
}

.abs-chat-message-row.is-admin {
  justify-content: flex-start;
}

.abs-chat-message {
  width: fit-content;
  max-width: min(78%, 460px);
  min-width: 0;
  padding: 12px 15px;
  border-radius: 16px;
  overflow-wrap: anywhere;
  animation: absChatBubbleIn 0.22s ease-out both;
}

.abs-chat-message-row.is-customer .abs-chat-message {
  color: #fff;
  background: #0b3d2e;
  border-bottom-right-radius: 5px;
}

.abs-chat-message-row.is-admin .abs-chat-message {
  color: #1e2924;
  background: #f0eadb;
  border: 1px solid #dedbd2;
  border-bottom-left-radius: 5px;
}

.abs-chat-message p {
  margin: 5px 0;
  white-space: pre-wrap;
  overflow-wrap: anywhere;
}

@keyframes absChatBubbleIn {
  from {
    opacity: 0;
    transform: translateY(5px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}
/* ABS CUT — Admin chat message alignment */
.aac-messages {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.aac-message-row {
  display: flex;
  width: 100%;
  min-width: 0;
}

.aac-message-row.is-customer {
  justify-content: flex-start;
}

.aac-message-row.is-admin {
  justify-content: flex-end;
}

.aac-message-bubble {
  width: fit-content;
  max-width: min(78%, 520px);
  min-width: 0;
  padding: 12px 15px;
  border-radius: 16px;
  overflow-wrap: anywhere;
  animation: absChatBubbleIn 0.22s ease-out both;
}

.aac-message-row.is-customer .aac-message-bubble {
  color: #1e2924;
  background: #f0eadb;
  border: 1px solid #dedbd2;
  border-bottom-left-radius: 5px;
}

.aac-message-row.is-admin .aac-message-bubble {
  color: #fff;
  background: #0b3d2e;
  border-bottom-right-radius: 5px;
}

.aac-message-bubble p {
  margin: 5px 0;
  white-space: pre-wrap;
  overflow-wrap: anywhere;
}

@keyframes absChatBubbleIn {
  from {
    opacity: 0;
    transform: translateY(5px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}
.admin-chat-messages {
  display: flex;
  flex-direction: column;
  overflow-y: auto;
  min-height: 0;
}

.admin-chat-typing {
  display: flex;
  align-items: center;
  gap: 9px;
  padding: 10px 14px;
  flex-shrink: 0;
  color: #66736d;
  font-size: 13px;
  background: #f8f5ed;
}

.admin-chat-typing-dots {
  display: inline-flex;
  align-items: center;
  gap: 4px;
}

.admin-chat-typing-dots i {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: #c9a227;
  animation: adminTypingBounce 0.8s ease-in-out infinite;
}

.admin-chat-typing-dots i:nth-child(2) {
  animation-delay: 0.12s;
}

.admin-chat-typing-dots i:nth-child(3) {
  animation-delay: 0.24s;
}

@keyframes adminTypingBounce {
  0%, 60%, 100% {
    transform: translateY(0);
    opacity: 0.45;
  }

  30% {
    transform: translateY(-4px);
    opacity: 1;
  }
}

/* =====================================================
   ABS CUT — CUSTOMER MANAGEMENT
===================================================== */

.ac-customers-page {
  --ac-green: #0b3d2e;
  --ac-green-dark: #10251d;
  --ac-gold: #c9a227;
  --ac-cream: #f8f5ed;
  --ac-text: #1e2924;
  --ac-muted: #66736d;
  --ac-border: #dedbd2;

  min-height: 100vh;
  padding: 42px 24px 70px;
  color: var(--ac-text);
  background:
    radial-gradient(
      circle at 8% 0%,
      rgba(201, 162, 39, 0.11),
      transparent 30%
    ),
    radial-gradient(
      circle at 100% 35%,
      rgba(11, 61, 46, 0.08),
      transparent 32%
    ),
    var(--ac-cream);
  animation: acPageEnter 0.65s ease both;
}

.ac-customers-page *,
.ac-customers-page *::before,
.ac-customers-page *::after {
  box-sizing: border-box;
}

.ac-customers-shell {
  width: 100%;
  max-width: 1500px;
  margin: 0 auto;
}

.ac-customers-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
  margin-bottom: 30px;
}

.ac-eyebrow {
  display: inline-block;
  margin-bottom: 10px;
  color: #917014;
  font-size: 0.72rem;
  font-weight: 800;
  letter-spacing: 0.15em;
}

.ac-customers-header h1 {
  margin: 0;
  color: var(--ac-green-dark);
  font-size: clamp(1.8rem, 3vw, 2.55rem);
  line-height: 1.15;
  letter-spacing: -0.045em;
}

.ac-customers-header p,
.ac-panel-heading p {
  margin: 10px 0 0;
  color: var(--ac-muted);
  font-size: 0.94rem;
  line-height: 1.7;
}

.ac-refresh-button,
.ac-primary-button,
.ac-secondary-button,
.ac-pagination-controls button,
.ac-edit-button,
.ac-delete-button,
.ac-danger-confirm {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  min-height: 42px;
  padding: 10px 16px;
  border: 1px solid transparent;
  border-radius: 10px;
  font: inherit;
  font-size: 0.85rem;
  font-weight: 700;
  cursor: pointer;
  transition:
    transform 0.22s ease,
    background 0.22s ease,
    border-color 0.22s ease,
    box-shadow 0.22s ease,
    color 0.22s ease;
}

.ac-refresh-button {
  flex-shrink: 0;
  color: var(--ac-green);
  background: #fff;
  border-color: var(--ac-border);
}

.ac-refresh-button span {
  font-size: 1.3rem;
  line-height: 1;
}

.ac-refresh-button:hover:not(:disabled),
.ac-secondary-button:hover:not(:disabled) {
  border-color: var(--ac-gold);
  transform: translateY(-2px);
  box-shadow: 0 6px 18px rgba(16, 37, 29, 0.08);
}

.ac-primary-button {
  color: #fff;
  background: var(--ac-green);
  box-shadow: 0 4px 12px rgba(11, 61, 46, 0.12);
}

.ac-primary-button:hover:not(:disabled) {
  background: var(--ac-green-dark);
  box-shadow: 0 8px 22px rgba(11, 61, 46, 0.2);
  transform: translateY(-2px);
}

.ac-secondary-button {
  color: var(--ac-green);
  background: #fff;
  border-color: var(--ac-border);
}

.ac-customers-page button:disabled {
  cursor: not-allowed;
  opacity: 0.58;
}

.ac-customers-page button:focus-visible,
.ac-customers-page input:focus-visible {
  outline: 3px solid rgba(201, 162, 39, 0.45);
  outline-offset: 3px;
}

/* Summary card */

.ac-customer-summary {
  position: relative;
  display: flex;
  align-items: center;
  gap: 18px;
  min-height: 130px;
  margin-bottom: 28px;
  padding: 26px 30px;
  overflow: hidden;
  border: 1px solid rgba(201, 162, 39, 0.38);
  border-radius: 18px;
  background:
    linear-gradient(
      115deg,
      rgba(11, 61, 46, 0.04),
      rgba(255, 255, 255, 0.96) 65%
    );
  box-shadow: 0 12px 32px rgba(16, 37, 29, 0.045);
}

.ac-customer-summary::after {
  position: absolute;
  top: -65px;
  right: -35px;
  width: 210px;
  height: 210px;
  border: 1px solid rgba(201, 162, 39, 0.23);
  border-radius: 50%;
  content: "";
  pointer-events: none;
}

.ac-summary-icon {
  display: grid;
  width: 58px;
  height: 58px;
  flex-shrink: 0;
  place-items: center;
  border-radius: 16px;
  color: var(--ac-gold);
  background: var(--ac-green);
  font-size: 1.9rem;
  transition: transform 0.3s ease;
}

.ac-customer-summary:hover .ac-summary-icon {
  transform: rotate(-5deg) scale(1.05);
}

.ac-customer-summary > div:nth-child(2) {
  display: grid;
  gap: 7px;
}

.ac-customer-summary > div:nth-child(2) span {
  color: var(--ac-muted);
  font-size: 0.86rem;
}

.ac-customer-summary > div:nth-child(2) strong {
  color: var(--ac-green);
  font-size: 2rem;
  line-height: 1;
  font-variant-numeric: tabular-nums;
}

.ac-summary-caption {
  margin-left: auto;
  color: var(--ac-muted);
  font-size: 0.8rem;
}

/* Main directory panel */

.ac-customer-panel {
  overflow: hidden;
  border: 1px solid rgba(222, 219, 210, 0.9);
  border-radius: 18px;
  background: #fff;
  box-shadow: 0 14px 40px rgba(16, 37, 29, 0.055);
  animation: acPanelEnter 0.7s ease both;
}

.ac-panel-heading {
  padding: 26px 28px 22px;
}

.ac-panel-heading h2 {
  margin: 0;
  color: var(--ac-green-dark);
  font-size: 1.2rem;
  letter-spacing: -0.02em;
}

.ac-panel-heading p {
  margin-top: 6px;
  font-size: 0.87rem;
}

.ac-search-form {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 0 28px 24px;
}

.ac-search-box {
  display: flex;
  flex: 1;
  align-items: center;
  gap: 10px;
  min-width: 0;
  min-height: 46px;
  padding: 0 14px;
  border: 1px solid var(--ac-border);
  border-radius: 11px;
  background: #fcfbf8;
  transition:
    border-color 0.2s ease,
    box-shadow 0.2s ease,
    background 0.2s ease;
}

.ac-search-box:focus-within {
  border-color: var(--ac-gold);
  background: #fff;
  box-shadow: 0 0 0 4px rgba(201, 162, 39, 0.1);
}

.ac-search-box > span {
  color: var(--ac-green);
  font-size: 1.7rem;
  line-height: 1;
}

.ac-search-box input {
  width: 100%;
  min-width: 0;
  padding: 11px 0;
  border: 0;
  outline: 0;
  color: var(--ac-text);
  background: transparent;
  font: inherit;
  font-size: 0.88rem;
}

.ac-search-box input:focus-visible {
  outline: 0;
}

/* Notifications */

.ac-notice,
.ac-error {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  margin: 0 28px 20px;
  padding: 13px 15px;
  border-radius: 10px;
  font-size: 0.88rem;
  line-height: 1.5;
  animation: acPanelEnter 0.25s ease both;
}

.ac-notice {
  color: var(--ac-green);
  border: 1px solid rgba(11, 61, 46, 0.15);
  background: #eff7f0;
}

.ac-error {
  color: #9b2929;
  border: 1px solid #f0cece;
  background: #fff2f2;
}

.ac-error button {
  flex-shrink: 0;
  border: 0;
  color: inherit;
  background: transparent;
  font-size: 1.3rem;
  cursor: pointer;
}

/* Customer table */

.ac-table-scroll {
  width: 100%;
  overflow-x: auto;
  overscroll-behavior-x: contain;
}

.ac-customer-table {
  width: 100%;
  border-collapse: separate;
  border-spacing: 0;
  text-align: left;
}

.ac-customer-table thead {
  background: #f7f6f1;
}

.ac-customer-table th {
  padding: 15px 18px;
  border-top: 1px solid #eeece5;
  border-bottom: 1px solid #eeece5;
  color: #6d756e;
  font-size: 0.71rem;
  font-weight: 800;
  letter-spacing: 0.055em;
  text-transform: uppercase;
  white-space: nowrap;
}

.ac-customer-table th:first-child,
.ac-customer-table td:first-child {
  padding-left: 28px;
}

.ac-customer-table th:last-child,
.ac-customer-table td:last-child {
  padding-right: 28px;
}

.ac-customer-table td {
  padding: 17px 18px;
  border-bottom: 1px solid #f0eee8;
  color: var(--ac-text);
  font-size: 0.82rem;
  vertical-align: middle;
}

.ac-customer-table tbody tr {
  animation: acRowEnter 0.35s ease both;
  transition: background 0.2s ease;
}

.ac-customer-table tbody tr:hover {
  background: #fbfaf6;
}

.ac-customer-table tbody tr:last-child td {
  border-bottom: 0;
}

.ac-customer-identity {
  display: flex;
  align-items: center;
  gap: 11px;
  min-width: 170px;
}

.ac-avatar {
  display: grid;
  width: 41px;
  height: 41px;
  flex-shrink: 0;
  place-items: center;
  border: 1px solid rgba(201, 162, 39, 0.35);
  border-radius: 13px;
  color: var(--ac-green);
  background: linear-gradient(145deg, #f8f5ed, #e9eee5);
  font-size: 0.76rem;
  font-weight: 800;
}

.ac-customer-identity > div:last-child,
.ac-contact-details {
  display: grid;
  gap: 5px;
  min-width: 0;
}

.ac-customer-identity strong {
  color: var(--ac-green-dark);
  font-size: 0.84rem;
  font-weight: 750;
  white-space: nowrap;
}

.ac-customer-id {
  color: #8a918b;
  font-size: 0.72rem;
}

.ac-contact-details {
  max-width: 240px;
}

.ac-contact-details span {
  overflow-wrap: anywhere;
}

.ac-contact-details span:first-child {
  color: var(--ac-text);
}

.ac-contact-details span:last-child {
  color: var(--ac-muted);
  font-size: 0.75rem;
}

.ac-role-pill,
.ac-status {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 6px 9px;
  border-radius: 7px;
  font-size: 0.7rem;
  font-weight: 750;
  white-space: nowrap;
}

.ac-role-pill {
  color: var(--ac-green);
  border: 1px solid #dce8df;
  background: #f0f6f0;
  text-transform: capitalize;
}

.ac-status-verified {
  color: #216b42;
  background: #eaf6ed;
}

.ac-status-unverified {
  color: #87621a;
  background: #fbf3df;
}

.ac-row-actions {
  display: flex;
  align-items: center;
  gap: 7px;
}

.ac-edit-button,
.ac-delete-button {
  min-height: 34px;
  padding: 7px 10px;
  border-radius: 8px;
  font-size: 0.75rem;
}

.ac-edit-button {
  color: var(--ac-green);
  border-color: #d9e5dc;
  background: #f1f6f1;
}

.ac-edit-button:hover {
  border-color: var(--ac-green);
  background: #e5f0e6;
  transform: translateY(-1px);
}

.ac-delete-button {
  color: #a33737;
  border-color: #f0d8d8;
  background: #fff5f5;
}

.ac-delete-button:hover {
  border-color: #c45c5c;
  background: #ffebeb;
  transform: translateY(-1px);
}

/* Pagination */

.ac-pagination {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18px;
  padding: 19px 28px;
  border-top: 1px solid #eeece5;
  background: #fdfcf9;
}

.ac-pagination > span {
  color: var(--ac-muted);
  font-size: 0.8rem;
}

.ac-pagination-controls {
  display: flex;
  align-items: center;
  gap: 12px;
}

.ac-pagination-controls button {
  min-height: 35px;
  padding: 7px 11px;
  border-color: var(--ac-border);
  color: var(--ac-green);
  background: #fff;
  font-size: 0.76rem;
}

.ac-pagination-controls button:hover:not(:disabled) {
  border-color: var(--ac-gold);
  transform: translateY(-1px);
}

.ac-pagination-controls span {
  color: var(--ac-muted);
  font-size: 0.79rem;
  white-space: nowrap;
}

/* Loading and empty states */

.ac-state {
  display: flex;
  min-height: 245px;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 35px 20px;
  text-align: center;
}

.ac-state h3 {
  margin: 15px 0 0;
  color: var(--ac-green-dark);
  font-size: 1.05rem;
}

.ac-state p {
  max-width: 360px;
  margin: 9px 0 0;
  color: var(--ac-muted);
  font-size: 0.85rem;
  line-height: 1.7;
}

.ac-empty-icon {
  display: grid;
  width: 55px;
  height: 55px;
  place-items: center;
  border-radius: 17px;
  color: var(--ac-green);
  background: #edf3eb;
  font-size: 1.8rem;
}

.ac-spinner {
  width: 36px;
  height: 36px;
  border: 3px solid #e6e4da;
  border-top-color: var(--ac-gold);
  border-right-color: var(--ac-green);
  border-radius: 50%;
  animation: acSpin 0.8s linear infinite;
}

/* Modals */

.ac-modal-backdrop {
  position: fixed;
  z-index: 1000;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow-y: auto;
  padding: 22px;
  background: rgba(12, 27, 21, 0.64);
  backdrop-filter: blur(6px);
  animation: acBackdropEnter 0.2s ease both;
}

.ac-modal {
  width: 100%;
  max-width: 580px;
  max-height: calc(100vh - 44px);
  overflow-y: auto;
  border: 1px solid rgba(201, 162, 39, 0.3);
  border-radius: 19px;
  background: #fff;
  box-shadow: 0 28px 90px rgba(0, 0, 0, 0.25);
  animation: acModalEnter 0.28s cubic-bezier(0.2, 0.8, 0.2, 1) both;
}

.ac-modal-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20px;
  padding: 27px 28px 22px;
  border-bottom: 1px solid #efede6;
  background: linear-gradient(130deg, #fbfaf5, #fff);
}

.ac-modal-header h2,
.ac-delete-modal h2 {
  margin: 0;
  color: var(--ac-green-dark);
  font-size: 1.4rem;
  letter-spacing: -0.035em;
}

.ac-modal-header p {
  margin: 8px 0 0;
  color: var(--ac-muted);
  font-size: 0.84rem;
  line-height: 1.6;
}

.ac-modal-close {
  display: grid;
  width: 37px;
  height: 37px;
  flex-shrink: 0;
  place-items: center;
  border: 1px solid var(--ac-border);
  border-radius: 10px;
  color: var(--ac-green);
  background: #fff;
  font-size: 1.5rem;
  cursor: pointer;
  transition: background 0.2s ease, transform 0.2s ease;
}

.ac-modal-close:hover:not(:disabled) {
  background: #f4f1e7;
  transform: rotate(90deg);
}

.ac-edit-form {
  padding: 26px 28px 28px;
}

.ac-form-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 19px 16px;
}

.ac-form-grid label {
  display: flex;
  flex-direction: column;
  gap: 8px;
  color: var(--ac-green-dark);
  font-size: 0.8rem;
  font-weight: 750;
}

.ac-form-grid .ac-full-field {
  grid-column: 1 / -1;
}

.ac-form-grid input {
  width: 100%;
  min-width: 0;
  min-height: 45px;
  padding: 11px 12px;
  border: 1px solid var(--ac-border);
  border-radius: 10px;
  color: var(--ac-text);
  background: #fcfbf8;
  font: inherit;
  font-size: 0.87rem;
  font-weight: 400;
  transition: border-color 0.2s ease, box-shadow 0.2s ease;
}

.ac-form-grid input:focus {
  border-color: var(--ac-gold);
  background: #fff;
  box-shadow: 0 0 0 4px rgba(201, 162, 39, 0.1);
  outline: 0;
}

.ac-verification-option {
  display: flex;
  align-items: flex-start;
  gap: 11px;
  margin-top: 23px;
  padding: 15px;
  border: 1px solid #e7e5dc;
  border-radius: 11px;
  background: #fbfaf6;
  cursor: pointer;
}

.ac-verification-option > input {
  width: 17px;
  height: 17px;
  flex-shrink: 0;
  margin-top: 3px;
  accent-color: var(--ac-green);
}

.ac-verification-option span {
  display: grid;
  gap: 5px;
}

.ac-verification-option strong {
  color: var(--ac-green-dark);
  font-size: 0.82rem;
}

.ac-verification-option small {
  color: var(--ac-muted);
  font-size: 0.76rem;
  font-weight: 400;
  line-height: 1.6;
}

.ac-modal-actions {
  display: flex;
  justify-content: flex-end;
  gap: 10px;
  margin-top: 25px;
  padding-top: 20px;
  border-top: 1px solid #efede6;
}

/* Delete confirmation */

.ac-delete-modal {
  max-width: 460px;
  padding: 30px;
  text-align: center;
}

.ac-delete-symbol {
  display: grid;
  width: 54px;
  height: 54px;
  margin: 0 auto 18px;
  place-items: center;
  border: 1px solid #f0d5d5;
  border-radius: 17px;
  color: #a33737;
  background: #fff1f1;
  font-size: 1.6rem;
  font-weight: 800;
}

.ac-delete-modal h2 {
  font-size: 1.35rem;
}

.ac-delete-modal > p {
  margin: 14px 0 0;
  color: var(--ac-muted);
  font-size: 0.87rem;
  line-height: 1.75;
}

.ac-delete-modal > p strong {
  color: var(--ac-green-dark);
}

.ac-delete-warning {
  padding: 12px;
  border-radius: 9px;
  color: #885d18 !important;
  background: #fcf5e6;
  font-size: 0.79rem !important;
}

.ac-danger-confirm {
  color: #fff;
  background: #a72f2f;
}

.ac-danger-confirm:hover:not(:disabled) {
  background: #842222;
  box-shadow: 0 6px 17px rgba(167, 47, 47, 0.2);
  transform: translateY(-2px);
}

.ac-delete-modal .ac-modal-actions {
  justify-content: center;
}

/* Animations */

@keyframes acPageEnter {
  from {
    opacity: 0;
    transform: translateY(12px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes acPanelEnter {
  from {
    opacity: 0;
    transform: translateY(8px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes acRowEnter {
  from {
    opacity: 0;
    transform: translateX(-5px);
  }

  to {
    opacity: 1;
    transform: translateX(0);
  }
}

@keyframes acSpin {
  to {
    transform: rotate(360deg);
  }
}

@keyframes acBackdropEnter {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes acModalEnter {
  from {
    opacity: 0;
    transform: translateY(16px) scale(0.98);
  }

  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

/* Responsive layout */

@media (max-width: 900px) {
  .ac-customers-page {
    padding: 30px 18px 50px;
  }

  .ac-customer-table th,
  .ac-customer-table td {
    padding-right: 14px;
    padding-left: 14px;
  }

  .ac-customer-table th:first-child,
  .ac-customer-table td:first-child {
    padding-left: 18px;
  }

  .ac-customer-table th:last-child,
  .ac-customer-table td:last-child {
    padding-right: 18px;
  }
}

@media (max-width: 600px) {
  .ac-customers-page {
    padding: 24px 12px 40px;
  }

  .ac-customers-header {
    align-items: flex-start;
    gap: 14px;
  }

  .ac-customers-header h1 {
    font-size: 1.7rem;
  }

  .ac-customers-header p {
    font-size: 0.84rem;
  }

  .ac-refresh-button {
    min-height: 38px;
    padding: 8px 10px;
    font-size: 0.76rem;
  }

  .ac-customer-summary {
    min-height: 105px;
    gap: 13px;
    padding: 20px 16px;
  }

  .ac-summary-icon {
    width: 46px;
    height: 46px;
    border-radius: 12px;
    font-size: 1.5rem;
  }

  .ac-customer-summary > div:nth-child(2) span {
    max-width: 170px;
    font-size: 0.76rem;
  }

  .ac-customer-summary > div:nth-child(2) strong {
    font-size: 1.7rem;
  }

  .ac-summary-caption {
    display: none;
  }

  .ac-panel-heading {
    padding: 22px 17px 17px;
  }

  .ac-search-form {
    flex-wrap: wrap;
    padding: 0 17px 20px;
  }

  .ac-search-box {
    flex-basis: 100%;
  }

  .ac-search-form > button {
    flex: 1;
  }

  .ac-notice,
  .ac-error {
    margin-right: 17px;
    margin-left: 17px;
  }

  .ac-pagination {
    align-items: flex-start;
    flex-direction: column;
    padding: 17px;
  }

  .ac-pagination-controls {
    width: 100%;
    justify-content: space-between;
  }

  .ac-modal-backdrop {
    align-items: flex-start;
    padding: 14px;
  }

  .ac-modal {
    max-height: calc(100vh - 28px);
    margin: auto 0;
    border-radius: 15px;
  }

  .ac-modal-header {
    padding: 22px 19px 18px;
  }

  .ac-edit-form {
    padding: 21px 19px;
  }

  .ac-form-grid {
    grid-template-columns: 1fr;
    gap: 16px;
  }

  .ac-form-grid .ac-full-field {
    grid-column: auto;
  }

  .ac-delete-modal {
    padding: 25px 20px;
  }

  .ac-modal-actions {
    flex-wrap: wrap;
  }
}

@media (prefers-reduced-motion: reduce) {
  .ac-customers-page *,
  .ac-customers-page *::before,
  .ac-customers-page *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    scroll-behavior: auto !important;
    transition-duration: 0.01ms !important;
  }
}

/* =========================================================
   ABS CUT — INVENTORY DASHBOARD
   Luxury green and gold · Responsive · Animated
========================================================= */

.inventory-page {
  --inv-green: #0b3d2e;
  --inv-dark: #10251d;
  --inv-gold: #c9a227;
  --inv-bg: #f8f5ed;
  --inv-text: #1e2924;
  --inv-muted: #66736d;
  --inv-border: #dedbd2;

  min-height: 100vh;
  padding: 30px;
  color: var(--inv-text);
  background:
    radial-gradient(
      circle at 100% 0%,
      rgba(201, 162, 39, 0.09),
      transparent 28%
    ),
    radial-gradient(
      circle at 0% 45%,
      rgba(11, 61, 46, 0.045),
      transparent 30%
    ),
    var(--inv-bg);
  animation: inventoryPageEnter 0.55s ease both;
}

@keyframes inventoryPageEnter {
  from {
    opacity: 0;
    transform: translateY(12px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.inventory-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  margin-bottom: 28px;
}

.inventory-eyebrow {
  display: block;
  margin-bottom: 7px;
  color: #9b7919;
  font-size: 0.7rem;
  font-weight: 800;
  letter-spacing: 0.17em;
}

.inventory-heading h1 {
  margin: 0;
  color: var(--inv-dark);
  font-size: clamp(1.8rem, 3vw, 2.5rem);
  font-weight: 800;
  letter-spacing: -0.045em;
}

.inventory-heading p,
.inventory-panel-heading p {
  margin: 8px 0 0;
  color: var(--inv-muted);
  font-size: 0.9rem;
  line-height: 1.65;
}

.inventory-refresh,
.inventory-select-button,
.inventory-submit-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 9px;
  border: 1px solid transparent;
  border-radius: 12px;
  font: inherit;
  font-weight: 700;
  cursor: pointer;
  transition:
    transform 0.22s ease,
    box-shadow 0.22s ease,
    background 0.22s ease;
}

.inventory-refresh {
  padding: 11px 17px;
  color: var(--inv-green);
  background: #fff;
  border-color: var(--inv-border);
  white-space: nowrap;
}

.inventory-refresh span {
  font-size: 1.2rem;
}

.inventory-refresh:hover:not(:disabled) {
  transform: translateY(-2px);
  box-shadow: 0 7px 18px rgba(16, 37, 29, 0.1);
}

.inventory-refresh:disabled {
  opacity: 0.6;
  cursor: wait;
}

.inventory-stats {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 18px;
  margin-bottom: 25px;
}

.inventory-stat-card {
  position: relative;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  min-height: 165px;
  padding: 23px;
  border: 1px solid rgba(222, 219, 210, 0.85);
  border-radius: 19px;
  background: rgba(255, 255, 255, 0.92);
  box-shadow: 0 7px 25px rgba(16, 37, 29, 0.035);
  animation: inventoryCardEnter 0.6s ease both;
  transition:
    transform 0.28s ease,
    box-shadow 0.28s ease,
    border-color 0.28s ease;
}

.inventory-stat-card:nth-child(2) {
  animation-delay: 0.07s;
}

.inventory-stat-card:nth-child(3) {
  animation-delay: 0.14s;
}

.inventory-stat-card:nth-child(4) {
  animation-delay: 0.21s;
}

@keyframes inventoryCardEnter {
  from {
    opacity: 0;
    transform: translateY(15px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.inventory-stat-card::after {
  position: absolute;
  right: -32px;
  bottom: -47px;
  width: 115px;
  height: 115px;
  border: 18px solid rgba(11, 61, 46, 0.045);
  border-radius: 50%;
  content: "";
  pointer-events: none;
  transition: transform 0.4s ease;
}

.inventory-stat-card:hover {
  transform: translateY(-5px);
  border-color: rgba(201, 162, 39, 0.5);
  box-shadow: 0 16px 32px rgba(16, 37, 29, 0.09);
}

.inventory-stat-card:hover::after {
  transform: scale(1.15);
}

.inventory-stat-icon {
  display: grid;
  place-items: center;
  width: 40px;
  height: 40px;
  margin-bottom: 16px;
  border-radius: 12px;
  color: var(--inv-green);
  background: rgba(11, 61, 46, 0.09);
  font-size: 1.35rem;
  font-weight: 800;
}

.stat-low .inventory-stat-icon {
  color: #986d08;
  background: #fff4d5;
}

.stat-out .inventory-stat-icon {
  color: #b33c36;
  background: #fff0ed;
}

.inventory-stat-label {
  color: var(--inv-muted);
  font-size: 0.82rem;
  font-weight: 600;
}

.inventory-stat-card > strong {
  margin-top: 7px;
  color: var(--inv-dark);
  font-size: 2rem;
  font-weight: 800;
  letter-spacing: -0.04em;
}

.inventory-stat-card > small {
  margin-top: 5px;
  color: var(--inv-muted);
  font-size: 0.76rem;
}

.inventory-workspace {
  display: grid;
  grid-template-columns: minmax(0, 1.65fr) minmax(290px, 0.85fr);
  align-items: start;
  gap: 22px;
}

.inventory-panel {
  min-width: 0;
  overflow: hidden;
  border: 1px solid rgba(222, 219, 210, 0.9);
  border-radius: 19px;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 7px 25px rgba(16, 37, 29, 0.035);
}

.inventory-products-panel,
.inventory-adjust-panel,
.inventory-history-panel {
  animation: inventoryCardEnter 0.55s ease both;
}

.inventory-panel-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14px;
  padding: 23px 23px 19px;
}

.inventory-panel-heading h2 {
  margin: 0;
  color: var(--inv-dark);
  font-size: 1.15rem;
  font-weight: 800;
  letter-spacing: -0.025em;
}

.inventory-panel-heading p {
  font-size: 0.82rem;
}

.inventory-count {
  flex-shrink: 0;
  padding: 7px 10px;
  border: 1px solid rgba(201, 162, 39, 0.25);
  border-radius: 9px;
  color: #806317;
  background: #fffaf0;
  font-size: 0.72rem;
  font-weight: 800;
}

.inventory-toolbar {
  display: flex;
  align-items: center;
  gap: 11px;
  padding: 0 23px 19px;
}

.inventory-search {
  display: flex;
  flex: 1;
  align-items: center;
  gap: 9px;
  min-width: 0;
  padding: 0 12px;
  border: 1px solid var(--inv-border);
  border-radius: 11px;
  background: #fff;
  transition:
    border-color 0.2s ease,
    box-shadow 0.2s ease;
}

.inventory-search:focus-within {
  border-color: var(--inv-gold);
  box-shadow: 0 0 0 3px rgba(201, 162, 39, 0.12);
}

.inventory-search > span {
  color: var(--inv-muted);
  font-size: 1.4rem;
}

.inventory-search input {
  width: 100%;
  min-width: 0;
  padding: 12px 0;
  border: 0;
  outline: 0;
  color: var(--inv-text);
  background: transparent;
  font: inherit;
  font-size: 0.8rem;
}

.inventory-toolbar select,
.inventory-form select,
.inventory-form input:not([type="radio"]),
.inventory-form textarea {
  width: 100%;
  min-width: 0;
  padding: 12px;
  border: 1px solid var(--inv-border);
  border-radius: 10px;
  outline: none;
  color: var(--inv-text);
  background: #fff;
  font: inherit;
  font-size: 0.82rem;
  transition:
    border-color 0.2s ease,
    box-shadow 0.2s ease;
}

.inventory-toolbar select {
  width: auto;
  max-width: 145px;
  cursor: pointer;
}

.inventory-form select:focus,
.inventory-form input:focus,
.inventory-form textarea:focus,
.inventory-toolbar select:focus {
  border-color: var(--inv-gold);
  box-shadow: 0 0 0 3px rgba(201, 162, 39, 0.12);
}

.inventory-table-wrap {
  width: 100%;
  overflow-x: auto;
  scrollbar-width: thin;
}

.inventory-table {
  width: 100%;
  border-collapse: collapse;
  text-align: left;
}

.inventory-table thead {
  background: #f7f5ef;
}

.inventory-table th {
  padding: 13px 17px;
  color: #68746e;
  font-size: 0.69rem;
  font-weight: 800;
  letter-spacing: 0.035em;
  white-space: nowrap;
}

.inventory-table td {
  padding: 15px 17px;
  border-bottom: 1px solid #efede7;
  color: var(--inv-text);
  font-size: 0.78rem;
  vertical-align: middle;
}

.inventory-table tbody tr {
  transition: background 0.2s ease;
}

.inventory-table tbody tr:hover {
  background: #fcfaf4;
}

.inventory-table tbody tr:last-child td {
  border-bottom: 0;
}

.inventory-product-cell {
  display: flex;
  align-items: center;
  gap: 11px;
  min-width: 160px;
}

.inventory-product-cell img,
.inventory-product-placeholder {
  display: grid;
  flex-shrink: 0;
  place-items: center;
  width: 44px;
  height: 48px;
  border-radius: 9px;
  object-fit: cover;
  color: var(--inv-gold);
  background: var(--inv-green);
  font-size: 1.15rem;
  font-weight: 800;
}

.inventory-product-cell > div {
  display: flex;
  flex-direction: column;
  gap: 5px;
}

.inventory-product-cell strong {
  max-width: 175px;
  overflow-wrap: anywhere;
  color: var(--inv-dark);
  font-size: 0.78rem;
}

.inventory-product-cell small {
  color: var(--inv-muted);
  font-size: 0.7rem;
}

.inventory-stock-number {
  font-size: 0.9rem;
}

.inventory-status {
  display: inline-block;
  padding: 6px 9px;
  border-radius: 7px;
  font-size: 0.68rem;
  font-weight: 800;
  white-space: nowrap;
}

.inventory-status-available {
  color: #176443;
  background: #e8f6ed;
}

.inventory-status-low {
  color: #8b6509;
  background: #fff3d2;
}

.inventory-status-out {
  color: #b43732;
  background: #ffebe8;
}

.inventory-status-inactive {
  color: #68716c;
  background: #eceeea;
}

.inventory-select-button {
  padding: 8px 11px;
  border: 1px solid rgba(11, 61, 46, 0.14);
  border-radius: 8px;
  color: var(--inv-green);
  background: #eff5f0;
  font-size: 0.73rem;
  white-space: nowrap;
}

.inventory-select-button:hover {
  transform: translateY(-1px);
  background: #e0ede3;
}

.inventory-adjust-panel {
  position: relative;
  border-top: 3px solid var(--inv-gold);
}

.inventory-adjust-panel .inventory-panel-heading {
  align-items: flex-start;
  padding-bottom: 14px;
}

.inventory-form {
  display: flex;
  flex-direction: column;
  gap: 18px;
  padding: 0 23px 23px;
}

.inventory-form > label {
  display: flex;
  flex-direction: column;
  gap: 8px;
  color: var(--inv-dark);
  font-size: 0.78rem;
  font-weight: 700;
}

.inventory-form input::placeholder,
.inventory-form textarea::placeholder {
  color: #9aa19c;
}

.inventory-current-stock {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  padding: 13px;
  border: 1px solid rgba(201, 162, 39, 0.25);
  border-radius: 11px;
  background: linear-gradient(120deg, #fffaf0, #fff);
}

.inventory-current-stock span {
  color: var(--inv-muted);
  font-size: 0.78rem;
}

.inventory-current-stock strong {
  color: var(--inv-green);
  font-size: 0.95rem;
}

.inventory-change-options {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 10px;
  min-width: 0;
  margin: 0;
  padding: 0;
  border: 0;
}

.inventory-change-options legend {
  margin-bottom: 10px;
  color: var(--inv-dark);
  font-size: 0.78rem;
  font-weight: 700;
}

.inventory-change-options label {
  display: flex;
  align-items: center;
  gap: 7px;
  min-width: 0;
  padding: 12px 9px;
  border: 1px solid var(--inv-border);
  border-radius: 10px;
  color: var(--inv-muted);
  font-size: 0.73rem;
  font-weight: 700;
  cursor: pointer;
  transition: all 0.2s ease;
}

.inventory-change-options label.selected {
  border-color: var(--inv-green);
  color: var(--inv-green);
  background: #edf5ef;
  box-shadow: inset 0 0 0 1px var(--inv-green);
}

.inventory-change-options input {
  width: 14px;
  height: 14px;
  accent-color: var(--inv-green);
}

.inventory-change-options label > span:nth-of-type(1) {
  font-size: 1.05rem;
  font-weight: 800;
}

.inventory-character-count {
  align-self: flex-end;
  color: var(--inv-muted);
  font-size: 0.68rem;
  font-weight: 400;
}

.inventory-submit-button {
  width: 100%;
  min-height: 47px;
  padding: 13px 16px;
  color: #fff;
  background: linear-gradient(120deg, #0b3d2e, #174c39);
  box-shadow: 0 6px 15px rgba(11, 61, 46, 0.15);
}

.inventory-submit-button:hover:not(:disabled) {
  transform: translateY(-2px);
  background: linear-gradient(120deg, #10251d, #0b3d2e);
  box-shadow: 0 10px 22px rgba(11, 61, 46, 0.22);
}

.inventory-submit-button:disabled {
  opacity: 0.6;
  cursor: not-allowed;
}

.inventory-form-note {
  margin: -5px 0 0;
  color: var(--inv-muted);
  font-size: 0.72rem;
  line-height: 1.65;
}

.inventory-history-panel {
  margin-top: 23px;
}

.inventory-history-table {
  min-width: 950px;
}

.inventory-change-value {
  white-space: nowrap;
}

.inventory-change-value.positive {
  color: #168052;
}

.inventory-change-value.negative {
  color: #bd4138;
}

.inventory-change-value.neutral {
  color: #8b6509;
}

.inventory-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8px;
  min-height: 170px;
  padding: 24px;
  color: var(--inv-muted);
  text-align: center;
  font-size: 0.85rem;
}

.inventory-empty > span:not(.inventory-loader) {
  color: var(--inv-gold);
  font-size: 2rem;
}

.inventory-empty strong {
  color: var(--inv-dark);
}

.inventory-empty p {
  margin: 0;
  font-size: 0.8rem;
}

.inventory-loader {
  width: 26px;
  height: 26px;
  border: 3px solid #e5e5db;
  border-top-color: var(--inv-green);
  border-radius: 50%;
  animation: inventorySpin 0.75s linear infinite;
}

@keyframes inventorySpin {
  to {
    transform: rotate(360deg);
  }
}

.inventory-alert {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 15px;
  margin-bottom: 18px;
  padding: 13px 16px;
  border: 1px solid transparent;
  border-radius: 11px;
  font-size: 0.85rem;
  line-height: 1.6;
  animation: inventoryCardEnter 0.25s ease both;
}

.inventory-alert button {
  flex-shrink: 0;
  border: 0;
  color: inherit;
  background: transparent;
  font-size: 1.3rem;
  cursor: pointer;
}

.inventory-alert-error {
  border-color: #f2c6c2;
  color: #a32e29;
  background: #fff0ed;
}

.inventory-alert-success {
  border-color: #bce4c9;
  color: #176443;
  background: #edf8f0;
}

.inventory-page button:focus-visible,
.inventory-page input:focus-visible,
.inventory-page select:focus-visible,
.inventory-page textarea:focus-visible {
  outline: 2px solid var(--inv-gold);
  outline-offset: 3px;
}

@media (max-width: 1200px) {
  .inventory-page {
    padding: 24px;
  }

  .inventory-stats {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .inventory-workspace {
    grid-template-columns: minmax(0, 1fr);
  }

  .inventory-adjust-panel {
    max-width: none;
  }
}

@media (max-width: 650px) {
  .inventory-page {
    padding: 17px 12px 28px;
  }

  .inventory-heading {
    align-items: flex-start;
    gap: 12px;
  }

  .inventory-heading h1 {
    font-size: 1.75rem;
  }

  .inventory-heading p {
    font-size: 0.8rem;
  }

  .inventory-refresh {
    padding: 10px;
    font-size: 0.75rem;
  }

  .inventory-stats {
    gap: 11px;
    margin-bottom: 17px;
  }

  .inventory-stat-card {
    min-height: 145px;
    padding: 15px;
    border-radius: 15px;
  }

  .inventory-stat-icon {
    width: 34px;
    height: 34px;
    margin-bottom: 12px;
  }

  .inventory-stat-card > strong {
    font-size: 1.65rem;
  }

  .inventory-stat-label,
  .inventory-stat-card > small {
    font-size: 0.7rem;
  }

  .inventory-panel {
    border-radius: 15px;
  }

  .inventory-panel-heading {
    align-items: flex-start;
    padding: 18px 15px 15px;
  }

  .inventory-panel-heading h2 {
    font-size: 1.05rem;
  }

  .inventory-panel-heading p {
    font-size: 0.76rem;
  }

  .inventory-toolbar {
    align-items: stretch;
    flex-direction: column;
    padding: 0 15px 15px;
  }

  .inventory-toolbar select {
    width: 100%;
    max-width: none;
  }

  .inventory-table th,
  .inventory-table td {
    padding: 12px;
  }

  .inventory-form {
    gap: 16px;
    padding: 0 15px 18px;
  }

  .inventory-history-panel {
    margin-top: 17px;
  }
}

@media (prefers-reduced-motion: reduce) {
  .inventory-page *,
  .inventory-page *::before,
  .inventory-page *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    scroll-behavior: auto !important;
    transition-duration: 0.01ms !important;
  }
}

/* ============================================================
   ABS CUT — ADMIN REPORTS
   Luxury green, gold and warm ivory
   ============================================================ */

.admin-reports-page {
  --reports-green: #0b3d2e;
  --reports-dark: #10251d;
  --reports-gold: #c9a227;
  --reports-ivory: #f8f5ed;
  --reports-white: #ffffff;
  --reports-text: #1e2924;
  --reports-muted: #66736d;
  --reports-border: #dedbd2;

  min-height: 100vh;
  padding: 30px;
  color: var(--reports-text);
  background:
    radial-gradient(
      circle at 8% 4%,
      rgba(201, 162, 39, 0.09),
      transparent 24%
    ),
    radial-gradient(
      circle at 95% 28%,
      rgba(11, 61, 46, 0.07),
      transparent 28%
    ),
    var(--reports-ivory);
  animation: reportsPageEnter 0.65s ease both;
}

.admin-reports-container {
  width: 100%;
  max-width: 1500px;
  margin: 0 auto;
}

.admin-reports-page *,
.admin-reports-page *::before,
.admin-reports-page *::after {
  box-sizing: border-box;
}

.admin-reports-page button,
.admin-reports-page input {
  font: inherit;
}

.admin-reports-page button:focus-visible,
.admin-reports-page input:focus-visible {
  outline: 3px solid rgba(201, 162, 39, 0.5);
  outline-offset: 3px;
}

/* HERO */

.reports-hero {
  position: relative;
  isolation: isolate;
  overflow: hidden;
  min-height: 285px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 30px;
  padding: 42px 48px;
  color: white;
  border: 1px solid rgba(201, 162, 39, 0.36);
  border-radius: 26px;
  background:
    radial-gradient(
      circle at 82% 22%,
      rgba(201, 162, 39, 0.19),
      transparent 30%
    ),
    linear-gradient(120deg, #10251d 0%, #0b3d2e 57%, #174b38 100%);
  box-shadow: 0 20px 48px rgba(16, 37, 29, 0.15);
}

.reports-hero::after {
  position: absolute;
  z-index: -1;
  inset: 0;
  content: "";
  pointer-events: none;
  background: linear-gradient(
    110deg,
    transparent 25%,
    rgba(255, 255, 255, 0.045) 46%,
    transparent 65%
  );
  transform: translateX(-100%);
  animation: reportsHeroShine 1.8s ease 0.5s both;
}

.reports-hero-content {
  position: relative;
  z-index: 2;
  max-width: 760px;
}

.reports-hero-eyebrow,
.report-eyebrow {
  margin: 0 0 10px;
  color: var(--reports-gold);
  font-size: 0.72rem;
  font-weight: 800;
  letter-spacing: 0.16em;
  line-height: 1.5;
}

.reports-hero-eyebrow {
  display: flex;
  align-items: center;
  gap: 10px;
  color: #e5cc73;
}

.reports-hero-eyebrow span,
.reports-live-dot {
  width: 8px;
  height: 8px;
  flex: 0 0 auto;
  border-radius: 50%;
  background: var(--reports-gold);
  box-shadow: 0 0 0 4px rgba(201, 162, 39, 0.13);
}

.reports-hero h1 {
  margin: 0;
  font-family: Georgia, "Times New Roman", serif;
  font-size: clamp(2.1rem, 4vw, 3.45rem);
  font-weight: 600;
  letter-spacing: -0.045em;
  line-height: 1.13;
}

.reports-hero h1 span {
  color: #e4c65f;
  font-style: italic;
}

.reports-hero-description {
  max-width: 620px;
  margin: 18px 0 22px;
  color: rgba(255, 255, 255, 0.76);
  font-size: 0.96rem;
  line-height: 1.8;
}

.reports-hero-meta {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 10px;
  color: rgba(255, 255, 255, 0.78);
  font-size: 0.78rem;
}

.reports-live-dot {
  width: 7px;
  height: 7px;
  background: #8fe1a8;
  box-shadow: 0 0 0 4px rgba(143, 225, 168, 0.12);
}

.reports-meta-divider {
  color: rgba(255, 255, 255, 0.35);
}

.reports-hero-decoration {
  position: absolute;
  z-index: -1;
  width: 230px;
  height: 230px;
  border: 1px solid rgba(201, 162, 39, 0.15);
  border-radius: 50%;
  pointer-events: none;
}

.reports-hero-decoration-one {
  top: -130px;
  right: 170px;
}

.reports-hero-decoration-two {
  right: 60px;
  bottom: -165px;
  width: 320px;
  height: 320px;
}

.reports-hero-monogram {
  position: relative;
  display: flex;
  flex: 0 0 170px;
  align-items: center;
  justify-content: center;
  width: 170px;
  height: 170px;
  border: 1px solid rgba(228, 198, 95, 0.48);
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.035);
  box-shadow:
    inset 0 0 0 10px rgba(255, 255, 255, 0.025),
    0 0 0 12px rgba(255, 255, 255, 0.018);
  animation: reportsMonogramFloat 5s ease-in-out infinite;
}

.reports-hero-monogram span {
  margin: 0 -4px;
  color: #e4c65f;
  font-family: Georgia, "Times New Roman", serif;
  font-size: 4rem;
  font-style: italic;
}

.reports-hero-monogram span + span {
  margin-top: 30px;
  color: white;
}

.reports-hero-monogram i {
  position: absolute;
  right: 22px;
  bottom: 26px;
  width: 11px;
  height: 11px;
  border-radius: 50%;
  background: var(--reports-gold);
}

/* TOOLBAR */

.reports-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  margin: 34px 0 22px;
}

.reports-toolbar-title h2,
.reports-section-heading h2 {
  margin: 0;
  color: var(--reports-dark);
  font-family: Georgia, "Times New Roman", serif;
  font-size: clamp(1.45rem, 2.4vw, 2rem);
  font-weight: 600;
  letter-spacing: -0.025em;
}

.reports-toolbar-title .report-eyebrow,
.reports-section-heading .report-eyebrow {
  margin-bottom: 6px;
}

.reports-toolbar-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
}

.report-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 9px;
  min-height: 44px;
  padding: 11px 17px;
  border: 1px solid transparent;
  border-radius: 12px;
  cursor: pointer;
  font-size: 0.84rem;
  font-weight: 750;
  transition:
    transform 0.25s ease,
    box-shadow 0.25s ease,
    background 0.25s ease,
    border-color 0.25s ease;
}

.report-button:hover:not(:disabled) {
  transform: translateY(-2px);
}

.report-button:disabled {
  cursor: not-allowed;
  opacity: 0.6;
}

.report-button-primary {
  color: #fff;
  border-color: var(--reports-green);
  background: linear-gradient(135deg, #0b3d2e, #17533e);
  box-shadow: 0 6px 15px rgba(11, 61, 46, 0.13);
}

.report-button-primary:hover:not(:disabled) {
  background: linear-gradient(135deg, #17533e, #0b3d2e);
  box-shadow: 0 10px 22px rgba(11, 61, 46, 0.2);
}

.report-button-secondary {
  color: var(--reports-green);
  border-color: var(--reports-border);
  background: rgba(255, 255, 255, 0.78);
}

.report-button-secondary:hover:not(:disabled) {
  border-color: var(--reports-gold);
  box-shadow: 0 7px 18px rgba(16, 37, 29, 0.07);
}

.report-button-text {
  color: var(--reports-muted);
  border-color: transparent;
  background: transparent;
}

.report-button-text:hover:not(:disabled) {
  color: var(--reports-green);
  background: rgba(11, 61, 46, 0.06);
}

.report-refresh-spin {
  display: inline-block;
  animation: reportsSpin 0.9s linear infinite;
}

/* DATE FILTER */

.reports-filter-panel {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 25px;
  margin-bottom: 25px;
  padding: 23px 25px;
  border: 1px solid rgba(222, 219, 210, 0.95);
  border-radius: 19px;
  background: rgba(255, 255, 255, 0.8);
  box-shadow: 0 9px 28px rgba(16, 37, 29, 0.035);
}

.reports-filter-heading {
  display: flex;
  align-items: center;
  gap: 13px;
  flex: 0 0 auto;
}

.reports-filter-icon {
  display: grid;
  width: 44px;
  height: 44px;
  place-items: center;
  border: 1px solid rgba(201, 162, 39, 0.3);
  border-radius: 13px;
  color: var(--reports-green);
  background: #fbf4da;
  font-size: 1.35rem;
}

.reports-filter-heading h3 {
  margin: 0 0 5px;
  color: var(--reports-dark);
  font-size: 0.95rem;
}

.reports-filter-heading p {
  margin: 0;
  color: var(--reports-muted);
  font-size: 0.78rem;
  line-height: 1.6;
}

.reports-filter-fields {
  display: flex;
  flex: 1;
  flex-wrap: wrap;
  align-items: end;
  justify-content: flex-end;
  gap: 11px;
}

.reports-filter-fields label {
  display: grid;
  gap: 7px;
  min-width: 150px;
  color: var(--reports-muted);
  font-size: 0.74rem;
  font-weight: 750;
}

.reports-filter-fields input {
  width: 100%;
  min-height: 43px;
  padding: 9px 11px;
  color: var(--reports-text);
  border: 1px solid var(--reports-border);
  border-radius: 10px;
  background: white;
  transition:
    border-color 0.2s ease,
    box-shadow 0.2s ease;
}

.reports-filter-fields input:focus {
  border-color: var(--reports-gold);
  box-shadow: 0 0 0 3px rgba(201, 162, 39, 0.12);
}

/* SUMMARY CARDS */

.reports-stats-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 18px;
  margin: 0 0 44px;
}

.report-stat-card {
  position: relative;
  overflow: hidden;
  min-width: 0;
  padding: 24px;
  border: 1px solid rgba(222, 219, 210, 0.95);
  border-radius: 19px;
  background: linear-gradient(145deg, #fff 0%, #fffdf8 100%);
  box-shadow: 0 8px 25px rgba(16, 37, 29, 0.045);
  animation: reportsCardEnter 0.6s ease both;
  transition:
    transform 0.3s ease,
    box-shadow 0.3s ease,
    border-color 0.3s ease;
}

.report-stat-card:nth-child(2) {
  animation-delay: 0.07s;
}

.report-stat-card:nth-child(3) {
  animation-delay: 0.14s;
}

.report-stat-card:nth-child(4) {
  animation-delay: 0.21s;
}

.report-stat-card::after {
  position: absolute;
  right: -35px;
  bottom: -48px;
  width: 115px;
  height: 115px;
  border: 1px solid rgba(11, 61, 46, 0.08);
  border-radius: 50%;
  content: "";
  transition: transform 0.45s ease;
}

.report-stat-card:hover {
  transform: translateY(-5px);
  border-color: rgba(201, 162, 39, 0.55);
  box-shadow: 0 17px 32px rgba(16, 37, 29, 0.09);
}

.report-stat-card:hover::after {
  transform: scale(1.2);
}

.report-stat-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  margin-bottom: 24px;
}

.report-stat-icon {
  display: grid;
  width: 45px;
  height: 45px;
  place-items: center;
  border: 1px solid rgba(11, 61, 46, 0.12);
  border-radius: 14px;
  color: var(--reports-green);
  background: #eaf2ec;
  font-size: 1.35rem;
  font-weight: 800;
  transition:
    transform 0.3s ease,
    background 0.3s ease;
}

.report-stat-card:hover .report-stat-icon {
  transform: rotate(-5deg) scale(1.07);
  background: #dcebe0;
}

.report-stat-mark {
  color: #a4aaa3;
  font-size: 0.62rem;
  font-weight: 850;
  letter-spacing: 0.1em;
}

.report-stat-label {
  margin: 0 0 9px;
  color: var(--reports-muted);
  font-size: 0.82rem;
  font-weight: 650;
  line-height: 1.6;
}

.report-stat-card h2 {
  overflow-wrap: anywhere;
  margin: 0;
  color: var(--reports-dark);
  font-size: clamp(1.55rem, 2.3vw, 2.05rem);
  font-weight: 800;
  letter-spacing: -0.045em;
  line-height: 1.25;
}

.report-stat-note {
  margin: 11px 0 0;
  color: #89918b;
  font-size: 0.72rem;
  line-height: 1.6;
}

.report-stat-gold .report-stat-icon {
  color: #846612;
  border-color: rgba(201, 162, 39, 0.22);
  background: #fbf1cf;
}

.report-stat-revenue {
  border-top: 3px solid var(--reports-gold);
}

.report-stat-revenue .report-stat-icon {
  color: #866b17;
  border-color: rgba(201, 162, 39, 0.25);
  background: #fbf3d9;
}

.report-stat-inventory .report-stat-icon {
  color: #315e50;
  background: #e9f0ed;
}

/* SECTION HEADINGS */

.reports-section-heading {
  display: flex;
  align-items: center;
  gap: 22px;
  margin: 37px 0 20px;
}

.reports-section-line {
  flex: 1;
  height: 1px;
  background: linear-gradient(
    90deg,
    rgba(201, 162, 39, 0.55),
    rgba(222, 219, 210, 0.1)
  );
}

/* REPORT PANELS */

.reports-two-column {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 20px;
  align-items: start;
}

.reports-second-row {
  margin-top: 20px;
}

.report-panel {
  min-width: 0;
  padding: 25px;
  border: 1px solid rgba(222, 219, 210, 0.95);
  border-radius: 19px;
  background: rgba(255, 255, 255, 0.88);
  box-shadow: 0 9px 28px rgba(16, 37, 29, 0.035);
  animation: reportsCardEnter 0.55s ease both;
}

.report-panel-heading {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 14px;
  margin-bottom: 23px;
}

.report-panel-heading .report-eyebrow {
  margin-bottom: 7px;
  font-size: 0.63rem;
}

.report-panel-heading h2 {
  margin: 0;
  color: var(--reports-dark);
  font-family: Georgia, "Times New Roman", serif;
  font-size: 1.28rem;
  font-weight: 650;
  line-height: 1.35;
}

.report-panel-heading > div > p:last-child:not(.report-eyebrow) {
  margin: 7px 0 0;
  color: var(--reports-muted);
  font-size: 0.78rem;
  line-height: 1.65;
}

.report-record-count {
  flex: 0 0 auto;
  padding: 6px 9px;
  color: var(--reports-muted);
  border-radius: 8px;
  background: #f1f2ec;
  font-size: 0.7rem;
}

.report-breakdown-list {
  display: grid;
  gap: 20px;
}

.report-breakdown-labels {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 15px;
  margin-bottom: 9px;
  font-size: 0.82rem;
}

.report-breakdown-labels > span {
  overflow-wrap: anywhere;
  color: #56645c;
}

.report-breakdown-labels strong {
  flex: 0 0 auto;
  color: var(--reports-dark);
  font-size: 0.82rem;
  font-weight: 800;
}

.report-progress-track {
  overflow: hidden;
  width: 100%;
  height: 7px;
  border-radius: 99px;
  background: #edf0e9;
}

.report-progress-fill {
  display: block;
  height: 100%;
  min-width: 0;
  border-radius: inherit;
  background: linear-gradient(90deg, #0b3d2e, #428265);
  animation: reportsBarGrow 0.85s cubic-bezier(0.22, 1, 0.36, 1) both;
}

.report-breakdown-item:nth-child(even) .report-progress-fill {
  background: linear-gradient(90deg, #ad861b, #d9bd60);
}

.report-empty {
  display: grid;
  min-height: 95px;
  place-items: center;
  padding: 20px;
  color: #858d85;
  border: 1px dashed var(--reports-border);
  border-radius: 12px;
  background: #fcfbf7;
  font-size: 0.83rem;
  text-align: center;
}

/* TABLES */

.admin-reports-page .report-panel:has(.report-table-wrap) {
  margin-bottom: 20px;
}

.report-table-wrap {
  overflow-x: auto;
  width: 100%;
  border: 1px solid #ebe8df;
  border-radius: 12px;
}

.report-table {
  width: 100%;
  border-collapse: collapse;
  text-align: left;
}

.report-table th {
  padding: 13px 15px;
  color: #647168;
  background: #f6f5ef;
  font-size: 0.69rem;
  font-weight: 800;
  letter-spacing: 0.035em;
  white-space: nowrap;
}

.report-table td {
  padding: 15px;
  color: #4d5a52;
  border-top: 1px solid #efede6;
  font-size: 0.79rem;
  line-height: 1.6;
  white-space: nowrap;
}

.report-table tbody tr {
  transition: background 0.2s ease;
}

.report-table tbody tr:hover {
  background: #fbf9f1;
}

.report-status-label {
  display: inline-flex;
  align-items: center;
  padding: 5px 9px;
  color: var(--reports-green);
  border: 1px solid rgba(11, 61, 46, 0.1);
  border-radius: 7px;
  background: #edf4ee;
  font-size: 0.72rem;
  font-weight: 750;
}

.report-quantity-positive {
  color: #26784d;
  font-weight: 800;
}

.report-quantity-negative {
  color: #b3483f;
  font-weight: 800;
}

/* ERRORS AND LOADING */

.report-inline-error {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 15px;
  margin-bottom: 20px;
  padding: 14px 17px;
  color: #8c312a;
  border: 1px solid #efd0c9;
  border-radius: 12px;
  background: #fff2ef;
  font-size: 0.83rem;
}

.report-inline-error button {
  padding: 7px 10px;
  color: #8c312a;
  border: 1px solid #e7b8ae;
  border-radius: 8px;
  background: white;
  cursor: pointer;
  font-weight: 750;
}

.report-state-card {
  display: flex;
  min-height: 360px;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 35px;
  border: 1px solid var(--reports-border);
  border-radius: 22px;
  background: white;
  text-align: center;
  box-shadow: 0 15px 40px rgba(16, 37, 29, 0.06);
}

.report-state-card h2,
.report-state-card h1 {
  margin: 18px 0 8px;
  color: var(--reports-dark);
  font-family: Georgia, "Times New Roman", serif;
}

.report-state-card p:not(.report-eyebrow) {
  max-width: 450px;
  color: var(--reports-muted);
  font-size: 0.88rem;
  line-height: 1.7;
}

.report-spinner {
  width: 45px;
  height: 45px;
  border: 3px solid #e8e9df;
  border-top-color: var(--reports-gold);
  border-right-color: var(--reports-green);
  border-radius: 50%;
  animation: reportsSpin 0.8s linear infinite;
}

.report-state-symbol {
  display: grid;
  width: 48px;
  height: 48px;
  place-items: center;
  color: #9b3c30;
  border-radius: 50%;
  background: #fff0ec;
  font-size: 1.5rem;
  font-weight: 850;
}

/* FOOTER */

.reports-footer {
  display: flex;
  align-items: center;
  gap: 14px;
  margin-top: 32px;
  padding: 23px 0 5px;
  border-top: 1px solid rgba(201, 162, 39, 0.32);
}

.reports-footer-mark {
  display: grid;
  width: 43px;
  height: 43px;
  flex: 0 0 auto;
  place-items: center;
  color: #e4c65f;
  border-radius: 50%;
  background: var(--reports-green);
  font-family: Georgia, "Times New Roman", serif;
  font-weight: 800;
}

.reports-footer strong {
  color: var(--reports-green);
  font-size: 0.77rem;
  letter-spacing: 0.1em;
}

.reports-footer p {
  max-width: 850px;
  margin: 5px 0 0;
  color: var(--reports-muted);
  font-size: 0.72rem;
  line-height: 1.6;
}

.reports-footer-star {
  margin-left: auto;
  color: var(--reports-gold);
  font-size: 1.4rem;
}

/* ANIMATIONS */

@keyframes reportsPageEnter {
  from {
    opacity: 0;
    transform: translateY(10px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes reportsCardEnter {
  from {
    opacity: 0;
    transform: translateY(12px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes reportsHeroShine {
  to {
    transform: translateX(100%);
  }
}

@keyframes reportsMonogramFloat {
  0%,
  100% {
    transform: translateY(0) rotate(0);
  }
  50% {
    transform: translateY(-6px) rotate(2deg);
  }
}

@keyframes reportsBarGrow {
  from {
    width: 0;
  }
}

@keyframes reportsSpin {
  to {
    transform: rotate(360deg);
  }
}

/* RESPONSIVE */

@media (max-width: 1150px) {
  .admin-reports-page {
    padding: 22px;
  }

  .reports-hero {
    padding: 35px;
  }

  .reports-hero-monogram {
    width: 135px;
    height: 135px;
    flex-basis: 135px;
  }

  .reports-hero-monogram span {
    font-size: 3.2rem;
  }

  .reports-stats-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .reports-filter-panel {
    align-items: flex-start;
    flex-direction: column;
  }

  .reports-filter-fields {
    width: 100%;
    justify-content: flex-start;
  }
}

@media (max-width: 760px) {
  .admin-reports-page {
    padding: 14px;
  }

  .reports-hero {
    min-height: 0;
    padding: 28px 23px;
    border-radius: 20px;
  }

  .reports-hero-content {
    max-width: 100%;
  }

  .reports-hero h1 {
    font-size: clamp(2rem, 8vw, 2.8rem);
  }

  .reports-hero-description {
    font-size: 0.86rem;
  }

  .reports-hero-monogram {
    display: none;
  }

  .reports-toolbar {
    align-items: flex-start;
    flex-direction: column;
    margin-top: 27px;
  }

  .reports-toolbar-actions {
    width: 100%;
  }

  .reports-toolbar-actions .report-button {
    flex: 1;
  }

  .reports-filter-panel {
    padding: 18px;
  }

  .reports-filter-fields {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .reports-filter-fields label {
    min-width: 0;
  }

  .reports-filter-fields .report-button {
    width: 100%;
  }

  .reports-stats-grid {
    gap: 12px;
    margin-bottom: 35px;
  }

  .report-stat-card {
    padding: 17px;
    border-radius: 15px;
  }

  .report-stat-top {
    margin-bottom: 19px;
  }

  .report-stat-icon {
    width: 38px;
    height: 38px;
  }

  .report-stat-mark {
    font-size: 0.52rem;
  }

  .report-stat-card h2 {
    font-size: clamp(1.2rem, 5vw, 1.65rem);
  }

  .report-stat-label {
    font-size: 0.75rem;
  }

  .report-stat-note {
    font-size: 0.67rem;
  }

  .reports-two-column {
    grid-template-columns: minmax(0, 1fr);
    gap: 15px;
  }

  .reports-section-heading {
    gap: 12px;
    margin-top: 30px;
  }

  .report-panel {
    padding: 19px;
  }

  .report-table th,
  .report-table td {
    padding: 12px;
  }
}

@media (max-width: 420px) {
  .reports-hero {
    padding: 25px 19px;
  }

  .reports-hero h1 {
    font-size: 2rem;
  }

  .reports-hero-meta {
    align-items: flex-start;
    line-height: 1.6;
  }

  .reports-filter-fields {
    grid-template-columns: minmax(0, 1fr);
  }

  .reports-stats-grid {
    grid-template-columns: minmax(0, 1fr);
  }

  .report-stat-card {
    padding: 20px;
  }

  .report-stat-top {
    margin-bottom: 13px;
  }
}

@media (prefers-reduced-motion: reduce) {
  .admin-reports-page *,
  .admin-reports-page *::before,
  .admin-reports-page *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    scroll-behavior: auto !important;
    transition-duration: 0.01ms !important;
  }
}

/* ============================================================
   ABS CUT — RESPONSIVE NAVBAR
   Luxury green & gold
   ============================================================ */

.abs-navbar {
  --nav-green: #0b3d2e;
  --nav-dark: #10251d;
  --nav-gold: #c9a227;
  --nav-ivory: #f8f5ed;
  --nav-text: #1e2924;

  position: relative;
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 22px;
  width: 100%;
  padding: 12px 5%;
  color: var(--nav-text);
  border-bottom: 1px solid rgba(201, 162, 39, 0.28);
  background: rgba(248, 245, 237, 0.97);
  box-shadow: 0 5px 22px rgba(16, 37, 29, 0.07);
  backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);
}

.abs-navbar *,
.abs-navbar *::before,
.abs-navbar *::after {
  box-sizing: border-box;
}

/* LOGO */

.abs-navbar-logo {
  display: inline-flex;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  border-radius: 12px;
  transition:
    transform 0.3s ease,
    filter 0.3s ease;
}

.abs-navbar-logo:hover {
  transform: translateY(-2px) scale(1.035);
  filter: drop-shadow(0 5px 8px rgba(201, 162, 39, 0.2));
}

.abs-navbar-logo img {
  display: block;
  width: 50px;
  height: 50px;
  object-fit: contain;
}

/* DESKTOP MENU */

.abs-navbar-menu {
  display: flex;
  flex: 1;
  align-items: center;
  justify-content: space-between;
  gap: 22px;
  min-width: 0;
}

.abs-navbar-links {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: center;
  gap: 5px;
}

.abs-navbar-link {
  position: relative;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 11px 10px;
  color: #435148;
  border-radius: 9px;
  font-size: 0.88rem;
  font-weight: 650;
  text-decoration: none;
  white-space: nowrap;
  transition:
    color 0.25s ease,
    background 0.25s ease,
    transform 0.25s ease;
}

.abs-navbar-link::after {
  position: absolute;
  right: 10px;
  bottom: 5px;
  left: 10px;
  height: 2px;
  content: "";
  border-radius: 5px;
  background: var(--nav-gold);
  transform: scaleX(0);
  transform-origin: left;
  transition: transform 0.25s ease;
}

.abs-navbar-link:hover {
  color: var(--nav-green);
  background: rgba(11, 61, 46, 0.055);
}

.abs-navbar-link:hover::after,
.abs-navbar-link.active::after {
  transform: scaleX(1);
}

.abs-navbar-link.active {
  color: var(--nav-green);
  background: rgba(11, 61, 46, 0.055);
  font-weight: 800;
}

/* CART, LOGIN AND ACCOUNT ACTIONS */

.abs-navbar-actions {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  justify-content: flex-end;
  gap: 13px;
}

.abs-navbar-cart {
  position: relative;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  min-height: 42px;
  padding: 9px 11px;
  color: var(--nav-green);
  border: 1px solid transparent;
  border-radius: 11px;
  font-size: 0.95rem;
  text-decoration: none;
  transition:
    background 0.25s ease,
    border-color 0.25s ease,
    transform 0.25s ease;
}

.abs-navbar-cart:hover,
.abs-navbar-cart.active {
  border-color: rgba(201, 162, 39, 0.35);
  background: rgba(201, 162, 39, 0.1);
  transform: translateY(-1px);
}

.abs-navbar-cart-label {
  font-size: 0.82rem;
  font-weight: 750;
}

.abs-navbar-cart .navbar-cart-badge {
  position: absolute;
  top: -5px;
  left: 25px;
  display: grid;
  min-width: 19px;
  height: 19px;
  place-items: center;
  padding: 0 4px;
  color: white;
  border: 2px solid var(--nav-ivory);
  border-radius: 99px;
  background: #b88c16;
  font-size: 0.65rem;
  font-weight: 850;
}

.abs-navbar-auth {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 10px;
}

.abs-navbar-greeting {
  max-width: 130px;
  overflow: hidden;
  color: #4c5b51;
  font-size: 0.82rem;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.navbar-logout-button {
  padding: 10px 14px;
  color: white;
  border: 1px solid var(--nav-green);
  border-radius: 10px;
  background: var(--nav-green);
  cursor: pointer;
  font-size: 0.82rem;
  font-weight: 750;
  transition:
    background 0.25s ease,
    border-color 0.25s ease,
    transform 0.25s ease,
    box-shadow 0.25s ease;
}

.navbar-logout-button:hover {
  border-color: var(--nav-dark);
  background: var(--nav-dark);
  box-shadow: 0 5px 13px rgba(11, 61, 46, 0.17);
  transform: translateY(-2px);
}

.abs-navbar-login,
.abs-navbar-register {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 40px;
  padding: 9px 13px;
  border: 1px solid transparent;
  border-radius: 10px;
  font-size: 0.84rem;
  font-weight: 750;
  text-decoration: none;
  white-space: nowrap;
  transition:
    color 0.25s ease,
    background 0.25s ease,
    transform 0.25s ease;
}

.abs-navbar-login {
  color: var(--nav-green);
  border-color: rgba(11, 61, 46, 0.18);
  background: transparent;
}

.abs-navbar-login:hover {
  background: rgba(11, 61, 46, 0.07);
  transform: translateY(-1px);
}

.abs-navbar-register {
  color: #fff;
  border-color: var(--nav-green);
  background: var(--nav-green);
}

.abs-navbar-register:hover {
  background: var(--nav-dark);
  transform: translateY(-1px);
}

/* MOBILE MENU BUTTON */

.abs-navbar-toggle {
  display: none;
  width: 44px;
  height: 44px;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  color: var(--nav-green);
  border: 1px solid rgba(201, 162, 39, 0.4);
  border-radius: 12px;
  background: white;
  cursor: pointer;
  font-size: 1.25rem;
  transition:
    color 0.25s ease,
    background 0.25s ease,
    transform 0.25s ease;
}

.abs-navbar-toggle:hover {
  color: white;
  background: var(--nav-green);
  transform: scale(1.04);
}

.abs-navbar a:focus-visible,
.abs-navbar button:focus-visible {
  outline: 3px solid rgba(201, 162, 39, 0.65);
  outline-offset: 3px;
}

/* ============================================================
   TABLETS AND SMALL LAPTOPS
   ============================================================ */

@media (max-width: 1150px) {
  .abs-navbar {
    gap: 13px;
    padding-right: 3%;
    padding-left: 3%;
  }

  .abs-navbar-menu {
    gap: 12px;
  }

  .abs-navbar-links {
    gap: 1px;
  }

  .abs-navbar-link {
    padding: 10px 7px;
    font-size: 0.82rem;
  }

  .abs-navbar-actions {
    gap: 7px;
  }

  .abs-navbar-greeting {
    max-width: 95px;
  }
}

/* ============================================================
   MOBILE NAVIGATION
   ============================================================ */

@media (max-width: 900px) {
  .abs-navbar {
    justify-content: space-between;
    gap: 12px;
    padding: 10px 5%;
  }

  .abs-navbar-logo img {
    width: 46px;
    height: 46px;
  }

  .abs-navbar-toggle {
    display: inline-flex;
    order: 3;
  }

  .abs-navbar-menu {
    position: absolute;
    top: calc(100% + 1px);
    right: 0;
    left: 0;
    display: flex;
    max-height: calc(100dvh - 75px);
    flex-direction: column;
    align-items: stretch;
    justify-content: flex-start;
    gap: 15px;
    overflow-x: hidden;
    overflow-y: auto;
    padding: 0 5%;
    border-bottom: 1px solid rgba(201, 162, 39, 0.3);
    background: rgba(248, 245, 237, 0.99);
    box-shadow: 0 18px 28px rgba(16, 37, 29, 0.12);
    visibility: hidden;
    opacity: 0;
    pointer-events: none;
    transform: translateY(-9px);
    transition:
      opacity 0.25s ease,
      transform 0.25s ease,
      visibility 0.25s ease,
      padding 0.25s ease;
  }

  .abs-navbar-menu.is-open {
    padding-top: 17px;
    padding-bottom: 20px;
    visibility: visible;
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0);
  }

  .abs-navbar-links {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 5px;
    width: 100%;
  }

  .abs-navbar-link {
    justify-content: flex-start;
    width: 100%;
    min-height: 44px;
    padding: 12px 14px;
    border: 1px solid transparent;
    border-radius: 10px;
    font-size: 0.91rem;
    white-space: normal;
  }

  .abs-navbar-link::after {
    display: none;
  }

  .abs-navbar-link:hover,
  .abs-navbar-link.active {
    border-color: rgba(201, 162, 39, 0.24);
    background: rgba(11, 61, 46, 0.07);
  }

  .abs-navbar-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    width: 100%;
    padding-top: 14px;
    border-top: 1px solid rgba(201, 162, 39, 0.28);
  }

  .abs-navbar-cart {
    min-height: 42px;
  }

  .abs-navbar-auth {
    flex-wrap: wrap;
    gap: 9px;
  }

  .abs-navbar-greeting {
    max-width: 145px;
  }
}

/* SMALL PHONES */

@media (max-width: 480px) {
  .abs-navbar {
    padding: 9px 16px;
  }

  .abs-navbar-logo img {
    width: 43px;
    height: 43px;
  }

  .abs-navbar-toggle {
    width: 42px;
    height: 42px;
  }

  .abs-navbar-menu {
    max-height: calc(100dvh - 64px);
    padding-right: 16px;
    padding-left: 16px;
  }

  .abs-navbar-menu.is-open {
    padding-top: 13px;
    padding-bottom: 16px;
  }

  .abs-navbar-actions {
    align-items: flex-start;
  }

  .abs-navbar-auth {
    flex: 1;
    justify-content: flex-end;
  }

  .abs-navbar-greeting {
    max-width: 105px;
    font-size: 0.76rem;
  }

  .navbar-logout-button {
    padding: 9px 11px;
  }

  .abs-navbar-login,
  .abs-navbar-register {
    padding: 9px 11px;
    font-size: 0.79rem;
  }

  .abs-navbar-cart-label {
    font-size: 0.78rem;
  }
}

/* REDUCED MOTION ACCESSIBILITY */

@media (prefers-reduced-motion: reduce) {
  .abs-navbar *,
  .abs-navbar *::before,
  .abs-navbar *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    scroll-behavior: auto !important;
    transition-duration: 0.01ms !important;
  }
}

/* ==========================================
   ABS CUT — WHATSAPP COMMUNITY
   ========================================== */

.whatsapp-contact {
  align-items: flex-start;
  gap: 16px;
}

.whatsapp-main-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 46px;
  width: 46px;
  height: 46px;
  border-radius: 15px;
  color: #ffffff;
  background: #0b3d2e;
  box-shadow: 0 6px 18px rgba(11, 61, 46, 0.18);
}

.whatsapp-contact-content {
  flex: 1;
  min-width: 0;
}

.whatsapp-contact-content h3 {
  margin: 8px 0;
  color: var(--primary, #0b3d2e);
  font-size: 1.15rem;
  font-weight: 700;
}

.whatsapp-contact-content > p {
  margin: 0 0 18px;
  color: var(--muted, #66736d);
  font-size: 0.92rem;
  line-height: 1.7;
}

.whatsapp-community-links {
  display: grid;
  gap: 10px;
}

.whatsapp-community-button {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  width: 100%;
  min-height: 48px;
  padding: 12px 15px;
  border: 1px solid rgba(11, 61, 46, 0.13);
  border-radius: 12px;
  background: #ffffff;
  color: var(--primary, #0b3d2e);
  font-size: 0.88rem;
  font-weight: 650;
  text-decoration: none;
  box-sizing: border-box;
  transition:
    transform 0.25s ease,
    background 0.25s ease,
    color 0.25s ease,
    border-color 0.25s ease,
    box-shadow 0.25s ease;
}

.whatsapp-community-button span:first-child {
  font-size: 1.15rem;
}

.whatsapp-community-button span:nth-child(2) {
  flex: 1;
}

.whatsapp-community-button:hover {
  transform: translateY(-2px);
  border-color: var(--secondary, #c9a227);
  background: #f8f5ed;
  box-shadow: 0 7px 18px rgba(11, 61, 46, 0.09);
}

.whatsapp-community-button:focus-visible {
  outline: 2px solid var(--secondary, #c9a227);
  outline-offset: 3px;
}

.whatsapp-chat-button {
  color: #ffffff;
  background: var(--primary, #0b3d2e);
  border-color: var(--primary, #0b3d2e);
}

.whatsapp-chat-button:hover {
  color: #ffffff;
  background: var(--primary-dark, #10251d);
  border-color: var(--secondary, #c9a227);
}

.whatsapp-group-button:hover,
.whatsapp-channel-button:hover {
  color: var(--primary, #0b3d2e);
}

/* Respect reduced-motion preferences */
@media (prefers-reduced-motion: reduce) {
  .whatsapp-community-button {
    transition: none;
  }

  .whatsapp-community-button:hover {
    transform: none;
  }
}

@media (max-width: 480px) {
  .whatsapp-contact {
    gap: 12px;
  }

  .whatsapp-community-button {
    padding: 12px;
    font-size: 0.82rem;
  }
} */



